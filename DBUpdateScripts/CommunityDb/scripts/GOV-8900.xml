<databaseChangeLog    
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet author="SDooley" id="GOV-8900">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="false">
<![CDATA[
  Update [dbo].[Setting] set DefaultValue = 'Data360 Workflow' where ID = 48 AND FieldName = 'WorkflowFromName'
]]>
    </sql>
	<rollback>
<![CDATA[
  Update [dbo].[Setting] set DefaultValue = 'Data3Sixty Workflow' where ID = 48 AND FieldName = 'WorkflowFromName'
]]>
	</rollback>
  </changeSet>
  <changeSet author="SDooley" id="GOV-8900-2">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="false">
      <![CDATA[
  UPDATE [dbo].[Setting] set DefaultValue ='/Content/images/govern-small-white.png' where FieldName = 'CompanyLogo'
]]>
    </sql>
    <rollback>
      <![CDATA[
  UPDATE [dbo].[Setting] set DefaultValue ='/Content/images/logo.new.png' where FieldName = 'CompanyLogo'
]]>
    </rollback>
  </changeSet>

  </databaseChangeLog>