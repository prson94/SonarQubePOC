<databaseChangeLog
    
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet author="Sebastian Abraham" id="GOV-7783">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="true">
<![CDATA[
If not Exists (Select 1 from dbo.ResourceType where ID=1)
begin
	insert into dbo.ResourceType
	(Name,DateCreated,DateUpdated) values ('Employee',getutcdate(),getutcdate());
end
]]>
    </sql>
    <rollback>
<![CDATA[
DELETE   dbo.ResourceType;
DBCC CHECKIDENT ('dbo.ResourceType',RESEED, 0);
]]>
    </rollback>
  </changeSet>
</databaseChangeLog>