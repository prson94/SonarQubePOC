<databaseChangeLog    
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
	<changeSet author="tklok" id="GOV-8130">
		<sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="true">
			UPDATE [dbo].[CompanySetting] SET [Value] =  REPLACE([Value], 'Users', 'Resource') WHERE SettingID = 13
		</sql>
		<rollback>
			UPDATE [dbo].[CompanySetting] SET [Value] =  REPLACE([Value], 'Resource','Users') WHERE SettingID = 13
		</rollback>

	</changeSet>
</databaseChangeLog>