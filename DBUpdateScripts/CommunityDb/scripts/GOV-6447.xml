<databaseChangeLog
    
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet author="Sebastian Abraham" id="GOV-6447">
  
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="true">
  
			ALTER TABLE dbo.[resource]
			drop CONSTRAINT  FK_Resource_ResourceType 

    </sql>
	

    <rollback>
		<![CDATA[
			ALTER TABLE dbo.[resource]    
			ADD CONSTRAINT FK_Resource_ResourceType FOREIGN KEY (ResourceTypeID)     
			REFERENCES dbo.ResourceType (ID)     
			ON DELETE CASCADE 

		]]>

    </rollback>
  </changeSet>
  
</databaseChangeLog>
