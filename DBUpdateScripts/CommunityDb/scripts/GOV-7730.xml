<databaseChangeLog    
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet author="SDooley" id="GOV-7730">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="true">
<![CDATA[
insert into [dbo].[Setting]([ID],[FieldName],[Name],[Description],[DefaultValue]) values((SELECT ISNULL(MAX(ID) + 1, 1) FROM Setting),'EnableTagging','Enable Tagging','This system setting is to enable/disable tagging ','false')
]]>
    </sql>
	<rollback>
<![CDATA[
Delete from [dbo].[Setting] where [FieldName] = 'EnableTagging' and [Name] = 'Enable Tagging'
]]>
	</rollback>
  </changeSet>

  </databaseChangeLog>