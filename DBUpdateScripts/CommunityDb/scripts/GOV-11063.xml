<databaseChangeLog
    
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet author="MDonato" id="GOV-11063-v2">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="false">
		<![CDATA[
update Setting set SettingType = 2 where ID in (60,71)
update Setting set Locked = 0 where ID = 4
		]]>
    </sql>
	<rollback>
	<![CDATA[	
update Setting set SettingType = 0 where ID in (60,71)
update Setting set Locked = 1 where ID = 4
]]>
	</rollback>
  </changeSet>
  </databaseChangeLog>
