<databaseChangeLog
    
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

   <changeSet author="Andy Kelly" id="D3S-Environment-Schema">
        <preConditions onFail="MARK_RAN" onFailMessage="The initial schema has already been created. Skipping changeset and will mark as ran">
          <sqlCheck expectedResult="0">select count(*) from INFORMATION_SCHEMA.TABLES where TABLE_NAME = 'asset'</sqlCheck>
        </preConditions>
        <sqlFile dbms="mssql"
                encoding="UTF-16LE"
                endDelimiter="GO"
                path="D3S_Environment_20181113.sql"
                relativeToChangelogFile="true"
                splitStatements="true"
                stripComments="true"/>

    </changeSet>

</databaseChangeLog>