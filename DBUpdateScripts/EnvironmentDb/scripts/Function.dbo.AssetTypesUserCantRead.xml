 <changeSet author="Pappas" id="Function.dbo.AssetTypesUserCantRead-v5">
  <sql dbms="mssql" endDelimiter="\nGO" splitStatements="true" stripComments="false">
<![CDATA[
create or alter function [dbo].[AssetTypesUserCantRead]
(
	@ResourceID int
)
returns table
as
return 
(
	select	AssetTypeID
	from	dbo.ResponsibilitySummary 
	where	ResourceId = @ResourceID
			and [Permissions] & 1 = 0
			and ApplyToType = 1
)
]]>
  </sql>
 </changeSet>

</databaseChangeLog>

