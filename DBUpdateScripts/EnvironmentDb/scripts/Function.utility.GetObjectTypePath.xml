<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet author="Pappas" id="Function.utility.GetObjectTypePath-v2">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="false">
		<![CDATA[
CREATE OR ALTER FUNCTION [utility].[GetObjectTypePath]
(
	@object varchar(20),
	@objectId int
)
RETURNS nvarchar(max)
AS
BEGIN
	declare @typeName nvarchar(max);
	select @typeName = TypeName from utility.objectdetail(@object,@objectId)
	return @typeName;
END
		]]>
    </sql>
	<rollback>
		<![CDATA[	

		]]>
	</rollback>
  </changeSet>

</databaseChangeLog>