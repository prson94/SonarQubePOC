<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
  <changeSet author="TKlok" id="GOV-6360">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="true">
UPDATE [dbo].[FieldType]
SET [Type] = [Type]
WHERE [Type] = 'Lookup'
AND [LookupObjectType] = 'Taxonomy';
    </sql>
	<rollback>
		<comment>The update statement's purpose is firing a trigger on the FieldType table, there is no rollback for this.</comment>
    </rollback>
	</changeSet>
</databaseChangeLog>
