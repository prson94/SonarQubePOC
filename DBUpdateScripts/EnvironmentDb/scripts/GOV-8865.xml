<databaseChangeLog    
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
	<changeSet author="tklok" id="GOV-8865">
		<dropTable cascadeConstraints="true"
            tableName="SearchBoost"/>
		<createTable
				tableName="SearchBoost">
			<column name="Field" type="varchar(255)">
				<constraints primaryKey="true" nullable="false"/>
				</column>
			<column name="Boost" type="decimal(5,2)"/>
		</createTable>
	    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="true">
<![CDATA[
INSERT INTO [dbo].[SearchBoost] (Field, Boost) VALUES ('fields.Name', 1.25);
GO
]]>
    </sql>
    <rollback>
		    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="true">
<![CDATA[
DELETE FROM [dbo].[SearchBoost];
GO]]>
    </sql>
	</rollback>
	</changeSet>
	</databaseChangeLog>
