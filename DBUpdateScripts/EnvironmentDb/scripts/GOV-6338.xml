<databaseChangeLog
    
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet author="KMcNamee" id="gov-6338">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="true">
      if not exists (SELECT * FROM sys.indexes WHERE name='PXML_WorkflowItemStep_Fields' AND object_id = OBJECT_ID('Workflow.ItemStep'))
      begin
      CREATE PRIMARY XML INDEX PXML_WorkflowItemStep_Fields  ON Workflow.ItemStep (Fields);
      end
    </sql>
    <rollback>
      drop index PXML_WorkflowItemStep_Fields ON Workflow.ItemStep
    </rollback>
  </changeSet>
</databaseChangeLog>