  <changeSet author="kmcnamee" id="Udt.dbo.AuditFieldTable-v1.1">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="false">
		<![CDATA[
    IF TYPE_ID(N'dbo.IDTable') IS NULL 
  BEGIN
  CREATE TYPE [dbo].[AuditFieldTable] AS TABLE(
	  [FieldTypeID] [int] NOT NULL,
	  [FieldName] [nvarchar](250) NOT NULL,	
	  [Value] [nvarchar](max) NULL,
	  PRIMARY KEY CLUSTERED 
  (
	  [FieldTypeID] ASC
  )WITH (IGNORE_DUP_KEY = OFF)
  )
  END
		]]>
    </sql>
	<rollback>
		<![CDATA[	

		]]>
	</rollback>
  </changeSet>

</databaseChangeLog>