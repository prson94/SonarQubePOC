 <changeSet author="Pappas" id="Function.dbo.ResponsibilityTypeIDByResourceID-v2.1">
  <sql dbms="mssql" endDelimiter="\nGO" splitStatements="true" stripComments="false">
<![CDATA[
create or alter function [dbo].[ResponsibilityTypeIDByResourceID] 
(	
	@ResourceID int
)
RETURNS TABLE
AS
RETURN 
(
	select		ResponsibilityTypeID
	from		dbo.ResponsibilitySummary
	where		ResourceID = @ResourceID
	group by	ResponsibilityTypeID
)
]]>
  </sql>
 </changeSet>

</databaseChangeLog>
