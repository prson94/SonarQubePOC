<databaseChangeLog
    
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet author="kmcnamee" id="GOV-8290">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="false">
      <![CDATA[
    if not exists (select 1 from sys.indexes where name = 'IX_ItemStep_CompletedOn')
    begin
	    CREATE NONCLUSTERED INDEX IX_ItemStep_CompletedOn ON [workflow].[ItemStep] ([CompletedOn])	
    end
		]]>
    </sql>
    <rollback>
      <![CDATA[
      DROP INDEX IX_ItemStep_CompletedOn ON [workflow].[ItemStep]
		]]>
    </rollback>
  </changeSet>
</databaseChangeLog>