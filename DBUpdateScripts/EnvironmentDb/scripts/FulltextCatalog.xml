<databaseChangeLog
    
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">


      <changeSet author="Andy Kelly" id="Environment Full Text Catalog">
        <preConditions onFail="MARK_RAN" onFailMessage="The Full Text Catalog has already been created. Skipping changeset and will mark as ran">
          <sqlCheck expectedResult="0">select count(*) from sys.fulltext_catalogs where [name] = 'FieldCatalog'</sqlCheck>
        </preConditions>
        <sqlFile dbms="mssql"
                encoding="utf8"
                endDelimiter="GO"
                path="FullTextCatalog.sql"
                relativeToChangelogFile="true"
                splitStatements="true"
                stripComments="true"/>

    </changeSet>

</databaseChangeLog>