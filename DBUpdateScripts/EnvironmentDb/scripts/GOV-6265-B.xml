  <changeSet author="VKyrychuk" id="gov-6265-B">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="true">
	update AssetType 
		SET CanOwnFusion = art.CanOwnFusion
	from  ArtifactType as art
		where art.ID= AssetType.ObjectID
		 
	</sql>
	<rollback>
	 
    </rollback>
  </changeSet>
