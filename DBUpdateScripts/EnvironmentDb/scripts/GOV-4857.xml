<databaseChangeLog
    
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet author="Sebastian Abraham" id="GOV-4857">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="true">
<![CDATA[
exec sp_rename 'Taxonomy','Taxonomy-retired'
exec sp_rename 'TaxonomyType','TaxonomyType-retired'
]]>
    </sql>
    <rollback>
<![CDATA[
exec sp_rename 'Taxonomy-retired','Taxonomy'
exec sp_rename 'TaxonomyType-retired','TaxonomyType'
]]>
    </rollback>
  </changeSet>
</databaseChangeLog>