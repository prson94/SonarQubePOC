    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet author="Core" id="Function.integration.GetObjectIDByAssetTypeId-v1">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="false">
		<![CDATA[
CREATE OR ALTER FUNCTION [integration].[GetObjectIDByAssetTypeId]
(
    @id int
)
RETURNS int
AS
BEGIN
    DECLARE @o int

    SELECT @o = [ObjectID] from AssetType where ID = @id

    RETURN @o
END
		]]>
    </sql>
	<rollback>
		<![CDATA[	

		]]>
	</rollback>
  </changeSet>

</databaseChangeLog>