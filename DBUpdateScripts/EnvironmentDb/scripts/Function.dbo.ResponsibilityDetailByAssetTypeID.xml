<![CDATA[
create or alter function [dbo].[ResponsibilityDetailByAssetTypeID]
(
	@AssetTypeID int
)
RETURNS TABLE
AS
RETURN 
(
	select	* 
	from	dbo.ResponsibilityDetail
	where	AssetTypeID = @AssetTypeID
)
]]>
