<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet author="Pappas" id="Table.dbo.ResourceTheme-v1">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="false">
		<![CDATA[
IF NOT EXISTS (SELECT * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'dbo' AND TABLE_NAME = 'ResourceTheme')
BEGIN
	CREATE TABLE [dbo].[ResourceTheme](
		ResourceID int not null,
		ThemeID int not null,
		CONSTRAINT [PK_ResourceTheme] PRIMARY KEY CLUSTERED ( ResourceID ASC )
	)
END
		]]>
    </sql>
	<rollback>
		<![CDATA[	
IF EXISTS (SELECT * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'dbo' AND TABLE_NAME = 'ResourceTheme')
BEGIN
	drop table dbo.ResourceTheme
END
		]]>
	</rollback>
  </changeSet>

  <changeSet author="Pappas" id="Table.dbo.ResourceTheme-Constraints-v1">
    <sql dbms="mssql"
            endDelimiter="\nGO"
            splitStatements="true"
            stripComments="false">
		<![CDATA[
IF NOT EXISTS (select * from [sys].[foreign_keys] WHERE name = 'FK_ResourceTheme_Theme')
BEGIN
	ALTER TABLE [dbo].[ResourceTheme] WITH CHECK ADD  CONSTRAINT [FK_ResourceTheme_Theme] FOREIGN KEY([ThemeID]) REFERENCES [dbo].[Theme] ([ID])
	ALTER TABLE [dbo].[ResourceTheme] CHECK CONSTRAINT [FK_ResourceTheme_Theme]
END
		]]>
    </sql>
	<rollback>
		<![CDATA[	
IF EXISTS (select * from [sys].[foreign_keys] WHERE name = 'FK_ResourceTheme_Theme')
BEGIN
	ALTER TABLE [dbo].[Theme] DROP CONSTRAINT [FK_ResourceTheme_Theme]
END
		]]>
	</rollback>
  </changeSet>

</databaseChangeLog>