\d360.web\Content\styles\typeahead.css
\d360.web\Content\styles\selectlistinfoitem.css
\d360.web\Content\styles\selectlistinfoitem.min.css

# Ignore retrieved packages except 2 required DLLs
\.vs
\.nuget
\packages\*
!\packages\repositories.config
!\packages\gudusoft.gsqlparser.dll
!\packages\ComponentSpace.SAML2.dll

# Ignore user settings
*.user

