# ignore versioning file that is built with every solution build in VS
\d360.core\versioning.cs

# ignore compiled js files
\d360.web\Scripts\app\app.js
\d360.web\Scripts\all.js
\d360.web\Scripts\all.min.js
\d360.web\Scripts\app\*.chunk.js
\d360.web\Scripts\app\*.bundle.js

# Ignore cache files
*.cache

# Ignore .cer files
*.cer

# Ignore .pubxml files
*.pubxml

# Ignore all files in the Temp sub-folder
\node_modules
\WebJob1

# Ignore application config
\.vs\config\*.config

# Ignore xml documentation files
/d360.web/App_Data/Documentation.XML

# Ignore compiled css files
\d360.web\Content\styles\*.min.css
\d360.web\Content\styles\ang.css
\d360.web\Content\styles\angular.css
