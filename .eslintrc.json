{
    "root": true,
    "overrides": [
        {
            "files": [
                "**/*.ts"
            ],
            "env": {
                "browser": true,
                "es2021": true
            },
            "parser": "@typescript-eslint/parser",
            "plugins": [
                "@typescript-eslint"
            ],
            "extends": [
                "eslint:recommended",
                "plugin:@typescript-eslint/recommended"
            ],
            "parserOptions": {
                "ecmaVersion": "latest",
                "sourceType": "module"
            },
            "rules": {
                "no-undef": 2,
                "eqeqeq": ["error", "always", {"null": "ignore"}],
                "@typescript-eslint/no-inferrable-types": "off"
            }
        }
    ],
    "globals": {
        "$localize": "readonly",
        "go": "readonly",
        "NodeListOf": "readonly"
    },
    "ignorePatterns": ["**/*.js"]
}