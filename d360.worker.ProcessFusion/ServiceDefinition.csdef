<?xml version="1.0" encoding="utf-8"?>
<ServiceDefinition name="d360.worker.ProcessFusion" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceDefinition" schemaVersion="2015-04.2.6">
  <WorkerRole name="d360.workers.FusionWorkerRole" vmsize="Small">
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" />
      <Setting name="QueueMessageVisibilityTime" />
      <Setting name="DBExecuteQueryTimeout" />
      <Setting name="DBReadQueryTimeout" />
      <Setting name="DBBulkCopyTimeout" />
      <Setting name="MaximumRetries" />
    </ConfigurationSettings>
  </WorkerRole>
</ServiceDefinition>