<?xml version="1.0" encoding="utf-8"?>
<ServiceConfiguration serviceName="d360.worker.ProcessFusion" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="4" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="d360.workers.FusionWorkerRole">
    <Instances count="1" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="" />
      <Setting name="QueueMessageVisibilityTime" value="3600" />
      <Setting name="QueueName" value="fusion-queue" />
      <Setting name="QueueCheckFrequency" value="60000" />
      <Setting name="DBExecuteQueryTimeout" value="5400" />
      <Setting name="DBReadQueryTimeout" value="600" />
      <Setting name="DBBulkCopyTimeout" value="600" />
      <Setting name="MaximumRetries" value="3" />
      <Setting name="APPINSIGHTS_INSTRUMENTATIONKEY" value="ce8d05fc-1a80-44d5-82e8-102232cffa0d" />
    </ConfigurationSettings>
  </Role>
</ServiceConfiguration>