  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\igx.functions.Core\igx.functions.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Configuration" />
  </ItemGroup>
  <ItemGroup>
