        #chtLine svg g {
            border: 1px solid #666;
            border-radius: 3px;
        }

        .area {
            fill: lightsteelblue;
            stroke-width: 0;
            opacity: 0.4;
        }

        .axis path,
        .axis line {
            fill: none;
            stroke: #000; 
            shape-rendering: crispEdges;
        }

        .x.axis path {
            display: none;
        }

        .line {
            stroke: steelblue;
            stroke-width: 1.5px;
        }
        .arc {
            stroke: #fff;
        }

        .grid .tick {
            stroke: lightgrey;
            opacity: 0.7;
        }

        .grid path {
            stroke-width: 0;
        }
    </style>
