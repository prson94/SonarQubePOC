        $(function () {

            // Line Chart
            d3.json("/Home/LineReport", function (error, data) {

                var margin = { top: 20, right: 80, bottom: 30, left: 50 },
                    width = 860 - margin.left - margin.right,
                    height = 500 - margin.top - margin.bottom;

                var parseDate = d3.time.format("%Y%m%d").parse;

                var x = d3.time.scale().range([0, width]);

                var y = d3.scale.linear().range([height, 0]);

                var color = d3.scale.category10();

                var xAxis = d3.svg.axis().scale(x).orient("bottom");

                var yAxis = d3.svg.axis().scale(y).orient("left");

                var make_x_axis = function () {
                    return d3.svg.axis()
                        .scale(x)
                        .orient("bottom")
                        .ticks(5)
                };

                var make_y_axis = function () {
                    return d3.svg.axis()
                        .scale(y)
                        .orient("left")
                        .ticks(5)
                };

                var area = d3.svg.area()
                    .x(function (d) { return x(d.x); })
                    .y0(height)
                    .y1(function (d) { return y(d.y); });

                var line = d3.svg.line()
                    .interpolate("basis")
                    .x(function (d) { return x(d.x); })
                    .y(function (d) { return y(d.y); });

                var svg = d3.select("#chtLine").append("svg")
                    .attr("width", '100%')//width + margin.left + margin.right)
                    //.attr("height", '100%')//height + margin.top + margin.bottom)
                    .append("g")
                    .attr("transform", "translate(" + margin.left + "," + margin.top + ")");

                var keys = [];

                data.forEach(function (d) {
                    if (keys.indexOf(d.label) == -1) {
                        keys.push(d.label);
                    }
                    d.x = parseDate(d.x);
                });

                color.domain(keys);

                var seriesItems = [];

                keys.forEach(function (key) {
                    var values = [];
                    data.forEach(function (d) {
                        if (d.label == key) {
                            values.push({ x: d.x, y: d.y});
                        }
                    });
                    var label = {
                        name: key,
                        values: values
                    };
                    seriesItems.push(label);
                });

                x.domain(d3.extent(data, function (d) { return d.x; }));

                y.domain([
                    d3.min(seriesItems, function (c) {
                        return d3.min(c.values, function (v) {
                            return v.y;
                        });
                    }),
                    d3.max(seriesItems, function (c) {
                        return d3.max(c.values, function (v) {
                            return v.y;
                        });
                    })
                ]);

                svg.append("g")
                    .attr("class", "x axis")
                    .attr("transform", "translate(0," + height + ")")
                    .call(xAxis);

                svg.append("g")
                    .attr("class", "y axis")
                    .call(yAxis)
                    .append("text")
                    .attr("transform", "rotate(-90)")
                    .attr("y", 6)
                    .attr("dy", ".71em")
                    .style("text-anchor", "end")
                    .text("# Events");

                svg.append("g")
                    .attr("class", "grid")
                    .attr("transform", "translate(0," + height + ")")
                    .call(make_x_axis()
                        .tickSize(-height, 0, 0)
                        .tickFormat("")
                    );

                svg.append("g")
                    .attr("class", "grid")
                    .call(make_y_axis()
                        .tickSize(-width, 0, 0)
                        .tickFormat("")
                    );

                var seriesItem = svg.selectAll(".label")
                    .data(seriesItems)
                    .enter()
                    .append("g");

                seriesItem.append("path")
                    .datum(function (d) { return d.values; })
                    .attr("class", "area")
                    .attr("d", area)
                    .style("fill", function (d) { return color(d.name); });

                seriesItem.append("path")
                    .attr("class", "line")
                    .attr("d", function (d) { return line(d.values); })
                    .style("stroke", function (d) { return color(d.name); });

                seriesItem.append("text")
                    .datum(function (d) { return { name: d.name, value: d.values[d.values.length - 1] }; })
                    .attr("transform", function (d) { return "translate(" + x(d.value.x) + "," + y(d.value.y) + ")"; })
                    .attr("x", 3)
                    .attr("dy", ".35em")
                    .text(function (d) { return d.name; });
            });

