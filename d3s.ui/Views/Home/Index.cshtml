@{
    ViewData["Title"] = "Home Page";
}
<div ng-app="app">
    <div id="main" ng-controller="AppCtrl as app">
        <ul>
            <li ng-repeat="item in app.getUsers()" ng-click="app.removeUser(item, $index)">
                {{ item.name }}
                <input type="text" ng-model="item.name" />
            </li>
        </ul>
    </div>
</div>
@*ng-class="{ warn: item.cat == 'child', ok: item.cat == 'adult' }"*@


