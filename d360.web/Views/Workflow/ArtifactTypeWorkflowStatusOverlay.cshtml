@model d360.core.entities.ObjectModel
@{
    var ArtifactTypeID = (int)ViewBag.ID;
}
<script id="workflowBreakdownByArtifactTypeTile" type="text/x-handlebars-template">
    <div class="pull-left" style="width: 30%">
        {{#each this }}
        <h4>{{Name}}</h4>
        <div class="description" style="margin: 5px 0px 10px 0px">{{Description}}</div>
        <div id="Steps{{ID}}" style="margin: 0px 0px 30px 0px"></div>
        {{/each}}
    </div>
    <div class="pull-right" style="width: 65%; position: relative">
        <h4>Selected Workflows</h4>
        <div id="StepWorkflowResultsProgress" style="position: absolute; top: 2px; right: 2px;"></div>
        <div id="StepWorkflowResults"></div>
        <div style="position: relative">
            <div id="WorkflowStatusDetailProgress" style="position: absolute; top: 2px; right: 2px;"></div>
            <div id="WorkflowStatusDetail"></div>
        </div>
    </div>
    <div class="clearfix"></div>
</script>
<script id="workflowDetailTemplate" type="text/x-handlebars-template">
    <div style="border: 1px solid #efefef; background-color: #fefefe; border-radius: 2px; margin-top: 25px; padding: 5px;">
        <h4>Selected Workflow Details</h4>
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6">
                <h5>Information About This Request</h5>
                <table class="table table-condensed table-hover">
                    <tbody>
                        {{#each Fields }}
                        <tr>
                            <td>{{Name}}</td>
                            <td>{{{Value}}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-6">
                <h5>Assignments</h5>
                <table class="table table-condensed table-hover">
                    <thead>
                        <tr>
                            <th>Activity</th>
                            <th>Resource</th>
                            <th>Complete?</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each Assignments }}
                        <tr>
                            <td>{{ActivityTypeName}}</td>
                            @*<td>{{ActivityTypeDescription}}</td>*@
                            <td>{{ResourceName}}</td>
                            <td>{{formatIsCompleteBool IsComplete}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
        @*<div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12">
                    <h5>Log</h5>
                    <table class="table table-condensed table-hover">
                        <thead>
                            <tr>
                                <th>Entry</th>
                                <th>Date</th>
                                <th>Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each Steps }}
                            <tr>
                                <td>{{Name}}</td>
                                <td>{{formatDate Date}}</td>
                                <td>{{TraceLevel}}</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>*@
    </div>

</script>

<div class="large-overlay">
    <div class="ui segment">
        <h4>Workflow Breakdown for @(ViewBag.Type)</h4>
        <div class="form-instructions"></div>
        <div id="WorkflowsTile"></div>
    </div>
</div>
<script type="text/javascript">
    var artifactTypeID = @(ArtifactTypeID);

    var addProgressToElement = function(controlID) {
        //$(controlID).hide();
        $(controlID).html("<i class='fa fa-spinner fa-spin fa-2x'></i>");
        //$(controlID).fadeIn(100);
    }
    var clearProgressOnElement = function(controlID) {
        // $(controlID).fadeOut(300);
        $(controlID).html("");
    }

    var clearDetailGrid = function(){
        try {
            var detail = $('#StepWorkflowResults');
            detail.jqxGrid({
                source: null,
                columns: []
            });
            detail.jqxGrid('updatebounddata');
        } catch (e) {
        }
    }

    var loadDetailGrid = function(workflowType, step) {

        addProgressToElement('#StepWorkflowResultsProgress');

        $.getJSON('/workflow/WorkflowsByArtifactTypeAndWorkflowTypeAndStep?id=' + artifactTypeID + '&type=' + workflowType + '&step=' + step, function(data) {
            var source = {
                datatype: "json",
                datafields: data.Fields,
                localdata: data.Data
            };
            var adapter = new $.jqx.dataAdapter(source);

            try {
                var detail = $('#StepWorkflowResults');
                detail.jqxGrid({
                    source: adapter,
                    columns: data.Columns
                });
                detail.jqxGrid('updatebounddata');
            } catch (e) {
            }

            clearProgressOnElement('#StepWorkflowResultsProgress');
        });
    }

    $(function () {

        $.getJSON('/workflow/WorkflowStepBreakdownByArtifactType?id=' + artifactTypeID, function (data) {

            var source = $("#workflowBreakdownByArtifactTypeTile").html();
            var template = Handlebars.compile(source);
            $('#WorkflowsTile').html(
                template(data)
            );

            $('#StepWorkflowResults').jqxGrid({
                altrows: true,
                width: grid_width,
                autoheight: true,
                sortable: true,
                filterable: true,
                showfilterrow: true,
                pageable: true,
                pagesizeoptions: ['5', '10', '20'],
                pagesize: 10,
                columnsresize: false,
                theme: theme,
                columns: []
            });

            $("#StepWorkflowResults").on("bindingcomplete", function (event) {
                $('#WorkflowStatusDetail').html('');
                var rowCount = $('#StepWorkflowResults').jqxGrid('getdisplayrows').length;
                if (rowCount > 0) {
                    $('#StepWorkflowResults').jqxGrid('selectrow', 0);
                }
            });

            $('#StepWorkflowResults').on('rowselect', function (event) {
                var row = event.args.row;
                addProgressToElement('#WorkflowStatusDetailProgress');
                $.getJSON(
                    '/services/workflow/' + row.ID + '/status',
                    function (data) {
                        var workflowDetailTemplateHtml = $("#workflowDetailTemplate").html();
                        var workflowDetailTemplateCompiled = Handlebars.compile(workflowDetailTemplateHtml);
                        $('#WorkflowStatusDetail').html(
                            workflowDetailTemplateCompiled(data)
                        );

                        clearProgressOnElement('#WorkflowStatusDetailProgress');
                    }
                );

            });

            $.each(data, function () {
                var wt = this;

                $("#Steps" + wt.ID).on('rowselect', function (event) {
                    var row = event.args.row;

                    $.each(data, function () {
                        if (row.WorkflowType != this.ID) {
                            $("#Steps" + this.ID).jqxGrid('clearselection');
                        }
                    });
                    //if (row.Count == 0) {
                    //    clearDetailGrid();
                    //}
                    //else {
                    loadDetailGrid(row.WorkflowType, row.ID);
                    //}
                });

                var source = {
                    datatype: "json",
                    datafields: [
                        { name: 'Name', type: 'string' },
                        { name: 'ID', type: 'number' },
                        { name: 'Count', type: 'number' },
                        { name: 'WorkflowType', type: 'number' }
                    ],
                    localdata: wt.Steps
                };
                var dataAdapter = new $.jqx.dataAdapter(source);

                $("#Steps" + wt.ID).jqxGrid({
                    altrows: true,
                    width: grid_width,
                    autoheight: true,
                    sortable: false,
                    filterable: false,
                    showfilterrow: false,
                    pageable: false,
                    pagermode: 'simple',
                    columnsresize: false,
                    source: dataAdapter,
                    theme: theme,
                    ready: function () {
                        var rowCount = $("#Steps" + wt.ID).jqxGrid('getdisplayrows').length;
                        if (rowCount > 0) {
                            if (wt.ID == 1) {
                                $("#Steps" + wt.ID).jqxGrid('selectrow', rowCount - 1);
                            }
                        }
                    },
                    columns: [
                        { text: '#', dataField: 'ID', width: '7%' },
                        { text: 'Step', dataField: 'Name' },
                        { text: '# Workflows', dataField: 'Count', width: '20%' }
                    ]
                });
            });
        });

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>