@{
    var id = ViewBag.WorkflowID;
}
<div class="medium-overlay">
    <div class="ui segment">
        <div class="left form-header-info">
            <h4 id="FormTitle"></h4>
        </div>
        <div class="right">
            <button type="button" id="RejectButton" class="btn waves-effect waves-light brown lighten-4" data-context="Workflow">Reject</button>
            <button type="button" id="ApproveButton" class="btn waves-effect waves-light brown lighten-1 saveButton" data-context="Workflow">Approve</button>
        </div>
        <div class="clear"></div>
        <div id="FormDescription" class="form-instructions"></div>
        <div id="progress"></div>
        <div class="row">
            <div class="col s6">
                <div id="RequestDetail"></div>
            </div>
            <div class="col s6">
                <div id="CertificationMessage" style="display:none">
                    By clicking the Certify button above, I certify that all data on this item is correct.
                </div>
                <div id="ApproverCommentArea">
                    <div class="FieldName">Comment</div>
                    <textarea id="ApproverComment"></textarea>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var workflowID = "@(id)";
    var task;
    $(function () {
        $("html, body").animate({ scrollTop: 0 }, "slow");

        $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');

        var postApprovalForm = function (approved) {
            $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');

            var getData = function () {
                switch (task.Activity) {
                    case 1:
                        return JSON.stringify({
                            Approved: approved,
                            Notes: $('#ApproverComment').val()
                        });
                        break;
                    case 2:
                        return JSON.stringify({});
                        break;
                    default:
                        return JSON.stringify({});
                        break;
                }
            }

            $.ajax('/services/workflow/tasks/' + workflowID, {
                dataType: 'json',
                contentType: "application/json; charset=utf-8",
                type: 'POST',
                data: getData()
            }).fail(function (xhr, status, error) {
                var response = {
                    type: 'error',
                    title: 'Error occured',
                    message: error,
                    context: 'Workflow'
                };
                OnFailed(response, status, xhr);
            })
              .done(function (data, status, xhr) {
                  var response = {
                      type: 'confirm',
                      title: 'Successfully completed',
                      message: xhr.responseText, //status,
                      context: 'Workflow'
                  };
                  OnSuccess(response, status, xhr);
              }).always(function () {
                  $('#progress').html('');
              });
        }

        $.getJSON('/services/workflow/tasks/' + workflowID, function (data) {

            $('#progress').html('');

            if (data) {
                var title = "";
                var description = "";
                var requestor = "";
                var detailHtml = "";

                title = data.WorkflowName + ' : ' + data.ActivityName;
                description = data.WorkflowDescription + '<br/>' + data.ActivityDescription;

                task = data;

                switch (data.Activity) {
                    case 1: // OwnerApproval
                        break;
                    case 2: // OwnerCertification
                        $('#RejectButton').hide();
                        $('#OrSeparator').hide();
                        $('#ApproverCommentArea').hide();
                        $('#ApproveButton').text('Certify');
                        $('#CertificationMessage').fadeIn(250);
                        break;
                }

                //switch (data.Workflow) {
                //    case 1: // SuggestNewArtifact
                //        break;
                //    case 2: // CertifyArtifact
                //        break;
                //}

                var detailHtml = "";
                for (var key in data.Properties) {
                    if (data.Properties.hasOwnProperty(key)) {
                        detailHtml += '<div class="form-group">';
                        detailHtml += '<label for="fld' + key + '">' + key + '</label>';
                        detailHtml += '<div id="fld' + key + '">' + data.Properties[key] + '</div>';
                        detailHtml += '</div>';
                    }
                }

                $('#FormTitle').text(title);
                $('#FormDescription').html(description);
                $('#RequestDetail').html(detailHtml); //requestor +

                $('#RejectButton').on('click', function () {
                    postApprovalForm(false);
                });

                $('#ApproveButton').on('click', function () {
                    postApprovalForm(true);
                });
            }
            else {
                $('#RejectButton').hide();
                $('#ApproveButton').hide();

                $('#FormTitle').text('No permissions to this workflow');
                $('#FormDescription').text('You have either completed your required task or you do not have access to this workflow.');
                $('#RequestDetail').html('');
            }
        });
    });
</script>
