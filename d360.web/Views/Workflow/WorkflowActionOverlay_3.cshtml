@{
    var id = ViewBag.WorkflowID;
}

        <div class="left form-header-info">
            <h4 id="FormTitle"></h4>
        </div>
        <div class="right">
            <button type="button" id="SaveButton" class="btn waves-effect waves-light brown lighten-1 saveButton" data-context="Workflow">Save</button>
        </div>
        <div class="clear"></div>
        <div id="FormDescription" class="form-instructions"></div>
        <div id="progress"></div>
        <div class="row">
            <div class="col s12 m6 l6">
                <div id="RequestDetail">
                    <div class="FieldName">Issue</div>
                    <div id="IssueValue"></div>
                    <div class="FieldName">Requestor</div>
                    <div id="RequestorValue"></div>
                    <div class="FieldName">Date</div>
                    <div id="DateValue"></div>
                </div>
            </div>
            <div class="col s12 m6 l6">
                <div id="PoolMessage">
                    By clicking Save above, you are assigning yourself to this issue.  Please provide a comment below.  As you are working on this issue,
                    you may also comment on the issue where it is listed on your Board.
                </div>
                <div id="ActionArea" class="row">
                    <div class="col s12 m4 l4" id="Action1Wrapper">
                        <input type="radio" id="Action1" name="Action" value="assign" checked="checked" />
                        <label for="Action1">Accept Assignment</label>
                    </div>
                    <div class="col s12 m4 l4" id="Action2Wrapper">
                        <input type="radio" id="Action2" name="Action" value="reassign" />
                        <label for="Action2">Re-assign</label>
                        <div class="FieldName">Re-assign To:</div>
                        <div id="ReassignTo"></div>
                    </div>
                    <div class="col s12 m4 l4" id="Action3Wrapper">
                        <input type="radio" id="Action3" name="Action" value="close" />
                        <label for="Action3">Close</label>
                    </div>
                </div>
                <div id="CommentArea">
                    <div class="FieldName">Comment</div>
                    <textarea id="Comment"></textarea>
                </div>
            </div>
        </div>


<script type="text/javascript">
    var workflowID = "@(id)";

    $(function () {
        $("html, body").animate({ scrollTop: 0 }, "slow");

        $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');

        $.getJSON('/services/workflow/tasks/' + workflowID, function (data) {

            $('#progress').html('');

            if (data) {
                var title = "";
                var description = "";

                title = data.WorkflowName + ' : ' + data.ActivityName;
                description = data.WorkflowDescription + '<br/>' + data.ActivityDescription;

                $('#FormTitle').text(title);
                $('#FormDescription').html(description);

                $('#IssueValue').html(data.Issue);
                $('#RequestorValue').html('<a data-context="Preview" data-type="Resource" data-id="' + data.ResourceID + '" href="' + data.ResourceUrl + '">' + data.ResourceName + '</a>');
                $('#DateValue').html(moment.utc(data.DateStarted).local().format('dddd, MMMM Do YYYY, h:mm:ss a'));

                if (data.Activity == 3) {
                    $('#Action2Wrapper').hide();
                    $('#Action3Wrapper').hide();
                    //$('#Action1').attr('checked', 'checked');
                }
                else {
                    $('#Action1Wrapper').hide();
                    $('#Action3').attr('checked', 'checked');

                    var reassignSource = {
                        datatype: "json",
                        datafields: [
                            { name: 'FullName' },
                            { name: 'ResourceID' }
                        ],
                        url: '/api/resources/1'
                    };
                    var reassignAdapter = new $.jqx.dataAdapter(reassignSource);
                    $('#ReassignTo').jqxDropDownList({
                        enableBrowserBoundsDetection: true,
                        filterable: true,
                        searchMode: 'containsignorecase',
                        displayMember: 'FullName',
                        valueMember: 'ResourceID',
                        width: '100%',
                        source: reassignAdapter,
                        theme: theme
                    });
                }

                $('#SaveButton').on('click', function () {
                    $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');

                    $.ajax('/services/workflow/tasks/' + workflowID, {
                        dataType: 'json',
                        contentType: "application/json; charset=utf-8",
                        type: 'POST',
                        data: JSON.stringify({
                            WorkflowAction: $('input[name=Action]:checked', '#ActionArea').val(),
                            AssignTo: $('#ReassignTo').jqxDropDownList('val'),
                            Comment: $('#Comment').val()
                        })
                    }).fail(function (xhr, status, error) {
                        var response = {
                            type: 'error',
                            title: 'Error occured',
                            message: error,
                            context: 'Workflow'
                        };
                        OnFailed(response, status, xhr);
                    })
                      .done(function (data, status, xhr) {
                          OnSuccess(data, status, xhr);
                      }).always(function () {
                          $('#progress').html('');
                      });
                });
            }
            else {
                $('#SaveButton').hide();

                $('#FormTitle').text('No permissions to this workflow');
                $('#FormDescription').text('You have either completed your required task or you do not have access to this workflow.');
                $('#RequestDetail').html('');
            }
        });
    });
</script>
