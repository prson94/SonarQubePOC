
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title>Lineage Go JS Prototype</title>
    <meta charset="utf-8" />
    <link href="~/Content/font-awesome.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-2.1.4.js"></script>
    <script src="~/Scripts/go-1.5.12-debug.js"></script>
    <script src="~/Scripts/jqx/3.8.2/jqx-all.js"></script>
    <script src="~/Scripts/knockout-3.3.0.js"></script>
    <link href="~/Content/styles/all.min.css" rel="stylesheet" />

</head>
<body>
    <table>
        <tbody>
            <tr id="diagramRow" style="height:520px">
                <td style="vertical-align:top;">
                    <div style="position:relative;top: 0;left: 0;">
                        <div id="overlay" style="display:none; background-color:rgba(0, 0, 0, 0.1); width:100%;height:100%;position:absolute;z-index:100000;top:0;left:0;">
                            <div id="overlayModal" style="background-color:white;border-radius:5px;width:33%;min-width:500px;vertical-align:middle;margin:15px auto;padding:25px;box-shadow:10px 10px 5px rgba(0,0,0,.3);border:1px solid lightgray">
                                <div style="width:100%;text-align:center;">
                                    <div id="newRelDisplay"></div><br />
                                </div>
                                <table>
                                    <tbody>
                                        <tr>
                                            <td colspan="2" style="font-weight:bold">
                                                Choose a Predicate
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                Predicate: 
                                            </td>
                                            <td>
                                                <select id="ddlPredicate" style="display:block !important; padding:0 !important; height: 1.5rem !important; width:80% !important"></select>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <table>
                                    <tbody>
                                        <tr>
                                            <td colspan="2" style="font-weight:bold">
                                                Create a new Predicate
                                            </td>
                                        </tr>
                                        <tr style="padding-bottom:2px">
                                            <td>
                                                Predicate Name:
                                            </td>
                                            <td>
                                                <input type="text" id="newPredicateName" />
                                            </td>
                                        </tr>
                                        <tr style="padding-bottom:2px">
                                            <td>
                                                Phrase:
                                            </td>
                                            <td>
                                                <input type="text" id="newPredicatePhrase" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <button id="AddNewRel" style="display:none;" class="btn white-text" onclick="addRelationship($('#ddlPredicate').val());">OK</button>
                                            </td>
                                            <td>
                                                <button id="CancelNewRel" class="btn red darken-3 white-text" onclick="cancelAddLink();">Cancel</button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div id ="resizeContainer" style="height:520px;resize:both;overflow:auto">
                            <div id="lineageDiagram" style="background:white;height:500px;">
                                <!-- GO JS DIAGRAM GENERATED HERE-->
                            </div>
                        </div>

                    </div>
                </td>
                <td id="sidebarCell" style="width:350px;vertical-align:top;height:100%">
                    <div id="sidebarContainer" style="height:100%;overflow-y: scroll;">
                        <div id="jqxExpander1">
                            <div><i class="fa fa-plus"></i> Add a new node</div>
                            <div>
                                Type: <select data-bind="value: NodeType" class="select-dropdown" id="ddlType" style="display:block !important; padding:0 !important; height: 1.2rem !important; width:80% !important"></select><br />
                                Search: <input id="txtSearch" type="text" />
                                <button onclick="getArtifact();">Search</button>
                                <div id="lineagePalette" style="height:300px"></div>
                            </div>
                        </div>
                        <div id="jqxExpander0">
                            <div><i class="fa fa-info-circle"></i> Info</div>
                            <div>
                                <div id="noneSel" class="grey-text">Nothing selected</div>
                                <div id="isSel" style="display:none">
                                    <div id="preview"></div>
                                </div>
                                <br />
                            </div>
                        </div>
                    </div>

                </td>
            </tr>
            <tr>
                <td>
                         zoom: <div id="jqxZoom" style="display:inline-block;background-color:#e20000"></div><span id="zoomDisplay" style="margin-left:10px">100% </span>
                        | <a href="#" onclick="$('#jqxZoom').val(1500);"> zoom to 100%</a>
                        | <a href="#" onclick="myDiagram.zoomToFit();"> zoom to fit</a>
                        | <a href="#" onclick="reOrderLayout();">reorganize </a>
                        | <a href="#" onclick="toggleFullscreen(isFullscreen);">toggle fullscreen</a>
                        | spacing: <input id="txtSpacing" type="text" value="25" maxlength="3" style="width:40px" onkeyup="changeSpacing($(this).val())" />
                        | <a href="#" onclick="rotateDiagram();">rotate</a>
                        <button id="saveBtn" class="btn red" onclick="saveChanges();" style="float:right"><i class="fa fa-save"></i> Save Changes</button>
                </td>
                <td></td>
            </tr>
            <tr>
                <td>
                     Object Type: <input type="text" id="objecttype" value="Artifact" />
                    Object Id: <input type="text" id="objectid" value="972864" /> @*972864*@
                    <button onclick="populateDiagram();" class="btn">Populate</button>
                </td>
                <td></td>
            </tr>
        </tbody>
    </table>



    <script type="text/javascript">

        var oldHeight = $('#resizeContainer').height();
        var oldWidth = $('#resizeContainer').width();
        var newId = -1;
        var temp = null; //store search result node here
        var pendingExclusionObjects = [];
        var pendingExclusionNodes = [];
        var newRelationships = [];
        var newNodes = [];
        var predicates = [];
        var newLink = null;
        var g = go.GraphObject.make;
        var showDirectionHighlights = false;
        var isFullscreen = false;
        var initialNodes = [];
        var initialLinks = [];
        var mapId = 0;
        var digraphDirection = 0;
        var fromPortAlignment = go.Spot.LeftCenter;
        var toPortAlignment = go.Spot.RightCenter;

        function createArtifactModel() {
            return {
                key: null,
                id: null,
                parentId: null,
                name: null,
                type: null,
                typeName: null,
                backColor: null,
                foreColor: null,
                isDeletable: true,
                exclude: 'false',
                highlightColor: null,
                diagramObjectType: "Node",
                template: "Artifact",
                intersectMapId: null
            };
        };

        function createLinkModel() {
            return {
                from: null,
                frompid: "OUT",
                to: null,
                text: null,
                phrase: null,
                predicateName: null,
                isDeletable: true,
                exclude: 'false',
                diagramObjectType: "Link"
            };
        };

        //diagram initialization and settings
        var myDiagram = g(go.Diagram, 'lineageDiagram', {
                initialContentAlignment: go.Spot.TopLeft,
                contentAlignment: go.Spot.Default,
                allowDrop: true,
                hoverDelay: 100,
                initialAutoScale: go.Diagram.UniformToFill,
                layout: g(go.LayeredDigraphLayout, {
                    direction: digraphDirection
                   //,isInitial: true,
                    //,isOngoing: false
                }),
                "undoManager.isEnabled": true
            })
        { 
            myDiagram.addDiagramListener('ViewportBoundsChanged', onViewportBoundsChanged);
            myDiagram.addDiagramListener('ChangedSelection', onSelectionChange);
            myDiagram.addDiagramListener('LinkDrawn', onLinkDrawn);
            myDiagram.addDiagramListener('SelectionDeleting', onDelete);
            myDiagram.addDiagramListener('ObjectDoubleClicked', onDoubleClick);
            myDiagram.addDiagramListener('InitialLayoutCompleted', onInitialLayoutComplete);

            myDiagram.linkTemplate = g(go.Link,
            {
                routing: go.Link.Orthogonal,
                curve: go.Link.JumpOver,
                corner: 10,
                relinkableFrom: false,
                relinkableTo: false
            }, // the whole link panel
            g(go.Shape,  // the link shape
              {
                  stroke: "gray",
                  strokeWidth: 2
              }),
            g(go.Shape,  // the arrowhead
              { toArrow: "standard", fill: "gray", stroke: "gray" }),
            g(go.Panel, "Auto",
              g(go.Shape,  // the link shape
                {
                    visible: false,
                    fill: g(go.Brush, "Radial", { 0: "rgb(255, 255, 255)", 0.3: "rgb(255, 255, 255)", 1: "rgba(255, 255, 255, 0)" }),
                    stroke: null
                    //stroke: 'gray',
                    //strokeWidth: 2
                },
                //only visible if there's a label
                new go.Binding("visible", "text", function (a) { return (a ? true : false) })
                ),
              g(go.TextBlock,  // the label
                {
                    textAlign: "center",
                    font: "9pt helvetica, arial, sans-serif",
                    stroke: "#000",
                    margin: 4
                },
                new go.Binding("text", "text").makeTwoWay())
            ),
            new go.Binding("visible", "exclude", function (x) { return x === 'false'; }).makeTwoWay()
          );

            myDiagram.model.class = go.GraphLinksModel;
            myDiagram.model.nodeCategoryProperty = "template";
            myDiagram.model.linkFromPortIdProperty = "frompid";
            myDiagram.model.linkToPortIdProperty = "topid";
            myDiagram.model.nodeDataArray = [];
            myDiagram.model.linkDataArray = [];

            makeTemplate([makePort("", true)], [makePort("OUT", false)]);
        }

        //palette initialization and settings
        var myPalette = g(go.Palette, 'lineagePalette', {
             contentAlignment: go.Spot.BottomCenter
            ,allowDrop: true
            ,initialAutoScale: go.Diagram.Uniform
            ,model: new go.GraphLinksModel([{template:"Artifact", backColor:'black', foreColor:'white', name:'', id:-1, key:-1,typeName:'',type:'', isDeletable: true}])
        })
        {
            myPalette.model.nodeCategoryProperty = 'template';
            myPalette.model.nodeDataArray = [];
            myPalette.model.class = 'go.GraphLinksModel';
        }

        //DIAGRAM TEMPLATES
        function makePort(name, leftside) {
            var port = g(go.Shape, "Circle", {
                fill: "white",
                stroke: "gray",
                strokeWidth: 3,
                desiredSize: new go.Size(9, 9),
                portId: name,
                toMaxLinks: 1,
                cursor: "pointer"
            });


            var panel = g(go.Panel, "Horizontal", {
                margin: new go.Margin(2, 0)
            });

            if (leftside) {
                port.toSpot = go.Spot.Left;
                port.toLinkable = true;
                panel.alignment = go.Spot.TopLeft;
                panel.add(port);
            } else {
                port.fromSpot = go.Spot.Right;
                port.fromLinkable = true;
                panel.alignment = go.Spot.TopRight;
                panel.add(port);
            }
            return panel;
        }

        function makeTemplate(inports, outports) {
            var node = g(go.Node, "Spot",
                {
                    mouseEnter: mouseEnter,
                    mouseLeave: mouseLeave
                },
            g(go.Panel, "Auto", {
                width: 207,
                height: 105,
                name: "NodePanel"
            },

            g(go.Shape, "RoundedRectangle", {
                stroke: 'transparent',
                strokeWidth: 2,
                spot1: go.Spot.TopLeft,
                spot2: go.Spot.BottomRight,
                name: "NodeShape"
            },
                new go.Binding("fill", "backColor").makeTwoWay()
           ),
            g(go.Panel, "Table",
                g(go.TextBlock, {
                    row: 0,
                    margin: 3,
                    alignment: go.Spot.Top,
                    editable: false,
                    maxSize: new go.Size(180, 40),
                    font: "bold 12pt sans-serif"
                },
                    new go.Binding("text", "name").makeTwoWay(),
                    new go.Binding("stroke", "foreColor").makeTwoWay()
                ),
                g(go.TextBlock, {
                    row: 1,
                    margin: 3,
                    maxSize: new go.Size(180, NaN),
                    font: "10pt sans-serif"
                },
                    new go.Binding("stroke", "foreColor").makeTwoWay(),
                    new go.Binding("text", "typeName").makeTwoWay()
                ),
                g(go.TextBlock, {
                    row: 2,
                    margin: 3,
                    maxSize: new go.Size(180, NaN),
                    font: "bold 10pt sans-serif"
                },
                    new go.Binding("text", "id").makeTwoWay(),
                    new go.Binding("stroke", "foreColor").makeTwoWay()
                )
            )),
            g(go.Shape, "RoundedRectangle", {
                stroke: null,
                fill: null,
                strokeWidth: 5,
                width: 207,
                height: 105,
                spot1: go.Spot.TopLeft,
                spot2: go.Spot.LeftCenter,
                name: "DirectionHighlight"
            },
                new go.Binding("stroke", "highlightColor", function (h) { return showDirectionHighlights ? h : null; }).makeTwoWay()
           ),
            g(go.Panel, "Vertical", {
                alignment: fromPortAlignment,
                alignmentFocus: new go.Spot(0, 0.5, -8, 0)
            },
            inports),
            g(go.Panel, "Vertical", {
                alignment: toPortAlignment,
                alignmentFocus: new go.Spot(1, 0.5, 8, 0)
            },
            outports),
            new go.Binding("visible", "exclude", function (x) { return (x === 'false'); })//.makeTwoWay()
       );

            myDiagram.nodeTemplateMap.add("Artifact", node);
        }

        function makeSearchTemplate() {
            var node = g(go.Node, "Spot",
                   {
                       mouseEnter: mouseEnter,
                       mouseLeave: mouseLeave
                   },
               g(go.Panel, "Auto", {
                   width: 125,
                   height: 50,
                   name: "NodePanel"
               },
               g(go.Shape, "RoundedRectangle", {
                   stroke: 'transparent',
                   strokeWidth: 2,
                   spot1: go.Spot.TopLeft,
                   spot2: go.Spot.BottomRight,
                   name: "NodeShape"
               },
                   new go.Binding("fill", "backColor").makeTwoWay()
              ),
               g(go.Panel, "Table",
                   g(go.TextBlock, {
                       row: 0,
                       margin: 3,
                       alignment: go.Spot.Top,
                       editable: false,
                       maxSize: new go.Size(180, 50),
                       font: "8pt sans-serif"
                   },
                       new go.Binding("text", "name").makeTwoWay()
                       , new go.Binding("stroke", "foreColor").makeTwoWay()
                   ))
               ));

            myPalette.nodeTemplateMap.add("Artifact", node);
        }
        makeSearchTemplate();



        //DIAGRAM FUNCTIONS
        function rotateDiagram() {
            myDiagram.startTransaction("rotate");
            digraphDirection = (digraphDirection + 90) % 360;
            myDiagram.layout.direction = digraphDirection;
            myDiagram.layout.setsPortSpots = true;
            myDiagram.commitTransaction("rotate");
        }
        function markPendingExclusions(node) {
            var data = {
                type: node.type,
                id: node.id,
                mapId: mapId
            };
            pendingExclusionObjects.push({
                ObjectType: node.type,
                ObjectID: node.id
            });

            $.ajax({
                url: '/diagrams/GetExclusionsByMapObject',
                data: data,
                async: false,
                success: function (data) {
                    for (var i = 0; i < data.length; i++) {
                        for (var j = 0; j < myDiagram.model.nodeDataArray.length; j++) {
                            var n = myDiagram.model.nodeDataArray[j];

                            if (n.intersectMapId == data[i]) {
                                //console.log('marking intersectmapid ' + n.intersectMapId + ' as excluded');
                                myDiagram.model.nodeDataArray[j].exclude = 'true';
                                pendingExclusionNodes.push(n);
                            }
                        }
                    }
                }
            });

           //console.log(myDiagram.model.nodeDataArray);
        }

        function reOrderLayout() {
            //myDiagram.layout.isValidLayout = false;
           // myDiagram.layout.isOngoing = true;
            myDiagram.layout.invalidateLayout(); //isValidLayout = false;
            myDiagram.requestUpdate();
           // myDiagram.layout.isOngoing = false;
        }

        function toggleFullscreen(on) {
            //console.log(on);
            if (on === false) {
                $('#sidebarCell').width(1).hide();
                $('#sidebarContainer').hide();
                $('#resizeContainer').height($(window).height() - 60);
                $('#lineageDiagram').height($('#resizeContainer').height());
                //myDiagram.requestUpdate();
                isFullscreen = true;
            } else {
                $('#sidebarCell').width(350).show();
                $('#sidebarContainer').show();
                $('#resizeContainer').height(520);
                $('#lineageDiagram').height(500);
                //myDiagram.requestUpdate();
                isFullscreen = false;
            }
            

        }

        function parseData(data) {

            myDiagram.startTransaction("load_all_data");
            myDiagram.model.nodeDataArray = [];
            myDiagram.model.linkDataArray = [];
            var anchor = null;
            var modelList = [];
            var linkList = [];
            var exclusions = [];
            for (var i = 0; i < data.nodes.length; i++) {
                var d = data.nodes[i];
                var model = createArtifactModel();
                model.key = d.key;
                model.id = d.objid;
                model.type = d.obj;
                model.name = d.name;
                model.typeName = d.type;
                model.foreColor = d.fore;
                model.backColor = d.back;
                model.diagramObjectType = "Node";
                //model.isDeletable = false;
                model.exclude = d.exclude.toString();
                model.intersectMapId = d.intersectMapId;

                for (var j = 0; j < pendingExclusionNodes.length; j++) {
                    if (pendingExclusionNodes[j].intersectMapId == model.intersectMapId) {
                        model.exclude = 'true';
                    }
                }

                //console.log(model);
                modelList.push(model);
            }
            //console.log(modelList);

            for (var i = 0; i < data.links.length; i++) {
                var d = data.links[i];
                var link = createLinkModel();
                    link.from = d.from;
                    link.to = d.to;
                    link.text = d.text;
                    //link.isDeletable = false;
                    link.diagramObjectType = "Link";
                    linkList.push(link);
            }


                
            findExclusions(modelList, linkList);
            //markPendingExclusions();
            //console.log(linkList);

            myDiagram.model.nodeDataArray = modelList;
            myDiagram.model.linkDataArray = linkList;

            initialNodes = modelList.slice(); //copy by val, not ref
            initialLinks = linkList.slice();

            myDiagram.commitTransaction("load_all_data");
            reOrderLayout();

        }

        function findExclusions(nodes, links) {
            for (var i = 0; i < nodes.length; i++) {

                if (nodes[i].exclude == 'true') {
                   // console.log('reached');
                    for (var j = 0; j < links.length; j++) {
                        //var link = myDiagram.model.linkDataArray[j];

                        if (links[j].to == nodes[i].key || links[j].from == nodes[i].key) {
                            //console.log(links[j].to + ', ' + nodes[i].key + ", " + links[j].from + ', ' + nodes[i].key + ', ' + nodes[i].exclude)
                            links[j].exclude = 'true';
                            links[j].text = 'EXCLUDE';
                        }
                    }
                }
            }

        }

        function changeSpacing(val) {

            var num = parseInt(val);

            if (num == null || num == NaN) {
                $('#txtSpacing').val(myDiagram.layout.columnSpacing);
                return;
            }

            if (num < 1) num = 1;
            if (num > 100) num = 100;

            myDiagram.layout.columnSpacing = num;
            myDiagram.layout.layerSpacing = num;
            myDiagram.requestUpdate();
        }

        function cancelAddLink() {
            if (newLink != null) {
                myDiagram.startTransaction("remLink");
                myDiagram.model.removeLinkData(newLink);
                myDiagram.commitTransaction("remLink");
                newLink = null;
            }
            $('#overlay').hide();
            //$("#jqxExpander2").jqxExpander('collapse');

        };

        function addRelationship(id) {
            var id = (id || '');
            var rel = null;
            if (id != '' && id != 0) {
                for (var i = 0; i < predicates.length; i++) {
                    if (predicates[i].value == id) {

                        rel = {
                            name: predicates[i].name,
                            phrase: predicates[i].phrase
                        };
                    }
                }

            }
            else {
                rel = {
                    name: $('#newPredicateName').val(),
                    phrase: $('#newPredicatePhrase').val()
                };
            }
            newLink.predicateName = rel.name;
            newLink.phrase = rel.phrase;
            newLink.text = rel.phrase;
            newLink.diagramObjectType = "Link";

            myDiagram.startTransaction("nameRel")
            var index = -1;

            for (var i = 0; i < myDiagram.model.linkDataArray.length; i++) {
                if (myDiagram.model.linkDataArray[i].from == newLink.from &&
                    myDiagram.model.linkDataArray[i].to == newLink.to) {
                    myDiagram.model.removeLinkData(myDiagram.model.linkDataArray[i]);
                    break;
                }
            }
            newLink.isDeletable = true;
            myDiagram.model.addLinkData(newLink);
            myDiagram.commitTransaction("nameRel");
            $('#overlay').hide();
            //myDiagram.isEnabled = true;
            //newRelationships.push(newLink);
            newLink = null;


            $('#newPredicateName').text('');
            $('#newPredicatePhrase').text('');
            $('#newRelDisplay').text('');
            $('#AddNewRel').hide();
            //$("#jqxExpander2").jqxExpander('collapse');

        };

        function markDownstream(node) {
            //console.log(node.parentId);
            while (node.parentId != null) {
                node.highlightColor = "red";
                var parent = null;
                for (var i = 0; i < myDiagram.model.nodeDataArray.length; i++) {
                    if (myDiagram.model.nodeDataArray[i].id == node.parentId) {
                        parent = myDiagram.model.nodeDataArray[i];
                    }
                }
                for (var j = 0; j < myDiagram.model.linkDataArray.length; j++) {
                    var l = myDiagram.model.linkDataArray[j];
                    if (l.to == node.id && l.from == parent.id) {
                        //mark upstream
                    }
                };

                markDownstream(parent);
            }
        };

        function markUpstream(node) {
            var model = myDiagram.model.nodeDataArray;
            //console.log(node.key);
            for (var i = 0; i < model.length; i++) {
                //console.log('model: '+model.parentId + ', node: ' + node.id);
                if (model[i].parentId == node.key) {
                    model[i].highlightColor = "green";
                    //console.log('marked upstream');
                    markUpstream(model[i]);
                }
            }
        };

        function getArtifact() {
            var data = {
                id: $('#ddlType').val(),
                search: $('#txtSearch').val()
            };

            $.ajax({
                url: '/Diagrams/getArtifact',
                data: data,
                success: function (data) {
                    
                    myPalette.model.nodeDataArray = [];
                    temp = data[0];
                    for (var i = 0; i < data.length; i++) {
                        data[i].template = "Artifact";
                        data[i].key = data[i].type + data[i].id.toString();
                        data[i].isDeletable = true;
                        myPalette.model.addNodeData(data[i]);
                    }
                },
                async: false
            });

            if (temp == null) {
                return;
            }
            var data = {
                type1: $("#ddlType option:selected").text(),
                type2: ''
            };

            for (var i = 0; i < myDiagram.model.nodeDataArray.length; i++) {
                if (myDiagram.model.nodeDataArray[i].key == $('#ddlRel').val()) {
                    data.type2 = myDiagram.model.nodeDataArray[i].type;
                    break;
                }
            }
            populatePredicateList();
        }

        function addExisting() {
            myDiagram.startTransaction("add_existing");
            var newNode = createArtifactModel();
            newNode.key = temp.type + temp.id;
            newNode.id = temp.id;
            newNode.type = temp.type;
            newNode.typeName = temp.typeName;
            newNode.name = temp.name + " *";
            newNode.backColor = temp.backColor;
            newNode.foreColor = temp.foreColor;
            newNode.id = temp.id;

            myDiagram.model.addNodeData(newNode);


            myDiagram.commitTransaction("add_existing");

            temp = null;
            $('#txtResult').text('').css('background-color', 'transparent');
            populateNodeSelectList();
        }

        function populateDiagram() {
            var data = {
                type: $('#objecttype').val(),
                id: $('#objectid').val()
            };

            var results = $.ajax({
                url: '/diagrams/maps/Artifact/' + data.id + '.json',
                data: null,
                success: function (data) {
                    mapId = data.mapId;
                    //console.log(data);
                    parseData(data);
                    populateNodeSelectList();
                    myDiagram.zoomToFit();
                }
            });
        }
        populateDiagram();

        function saveChanges() {
            //$('#saveBtn').prop('disabled',true);
            var nodeChanges = getNodeChanges();
            var linkChanges = getLinkChanges();

            var data = {
                AddedNodes: nodeChanges.added,
                AddedLinks: linkChanges.added,
                ExclusionObjects: pendingExclusionObjects,
                AllNodes: myDiagram.model.nodeDataArray,
                AllLinks: myDiagram.model.linkDataArray,
                MapID: mapId
            }

            $.ajax({
                url: '/Diagrams/SaveChanges',
                data: JSON.stringify(data),
                processData: false,
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    $('#saveBtn').prop('disabled', false);
                },
                failure: function (data) {
                    $('#saveBtn').prop('disabled', false);
                }
            });

        }
       
        function getLinkChanges() {
            var changes = {
                added: [],
                modified: [],
                deleted: []
            };
            var links = myDiagram.model.linkDataArray;

            for (var i = 0; i < links.length; i++) {
                var found = false;
                for (var j = 0; j < initialLinks.length; j++) {
                    if (initialLinks[j].to == links[i].to && initialLinks[j].from == links[i].from) {
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    changes.added.push(links[i]);
                }
            }

            for (var i = 0; i < initialLinks.length; i++) {
                var found = false;
                for (var j = 0; j < links.length; j++) {
                    if (initialLinks[i].to == links[j].to && initialLinks[i].from == links[j].from) {
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    changes.deleted.push(initialLinks[i]);
                }
            }

            for (var i = 0; i < links.length; i++) {
                for (var j = 0; j < initialLinks.length; j++) {
                    //modified logic
                }
            }
            
            //console.log(changes);
            return changes;
        }
        
        function getNodeChanges() {
            var changes = {
                added: [],
                modified: [],
                deleted: []
            };

            var nodes = myDiagram.model.nodeDataArray;

            //added
            for (var i = 0; i < nodes.length; i++ ) {
                var found = false;
                for (var j = 0; j < initialNodes.length; j++) {
                    if (initialNodes[j].key == nodes[i].key) {
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    changes.added.push(nodes[i]);
                }
            }

            //deleted
            for (var i = 0; i < initialNodes.length; i++) {
                var found = false;
                for (var j = 0; j < nodes.length; j++) {
                    if (initialNodes[i].key == nodes[j].key) {
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    changes.deleted.push(initialNodes[i]);
                }
            }

            //modified
            for (var i = 0; i < nodes.length; i++) {
                for (var j = 0; j < initialNodes.length; j++) {
                    if (initialNodes[j].id == nodes[i].id) {

                        if (initialNodes[j].key === nodes[i].key) {
                            changes.modified.push(nodes[i]);
                            break;
                        }
                    }
                }
            }

            //console.log(changes);
            return changes;

        }


        //OTHER PAGE FUNCTIONS
        function populateNodeSelectList() {

            $('#ddlRel').html('');
            var output = [];
            output.push('<option value="-10000">(None)</option>');
            for (var i = 0; i < myDiagram.model.nodeDataArray.length; i++) {
                var node = myDiagram.model.nodeDataArray[i];
                output.push('<option style = "background-color:' + node.backColor + ';color:' + node.foreColor + ';" value="' + node.key + '">' + node.name + ' (' + node.typeName + ')</option>');
            }
            $('#ddlRel').html(output.join(''));

        }

        function populateTypeSelectList() {

            $.ajax({
                url: '/Diagrams/GetArtifactTypes',
                data: null,
                success: function (data) {
                    $('#ddlType').html('');
                    var output = [];
                    for (var i = 0; i < data.length; i++) {
                        output.push('<option value="' + data[i].id + '">' + data[i].name + '</option>');
                    }
                    $('#ddlType').html(output.join(''));
                }
            });
        }
        populateTypeSelectList();

        function populatePredicateList() {
            $.ajax({
                url: '/diagrams/getpredicateinfo',
                success: function (data) {
                    //console.log(data);
                    var output = [];
                    predicates = [];
                    output.push('<option value="0">(No Choice)</option>');
                    for (var i = 0; i < data.length; i++) {
                        data[i].id = data[i].intersecttypeid + '_' + data[i].intersecttyperoleid
                        output.push('<option value="' + data[i].value + '">' + data[i].displayName + '</option>');
                        predicates.push(data[i]);
                    }
                    $('#ddlPredicate').html(output.join(''));
                }
            });
        }

        //EVENT HANDLERS
        function onDelete(e) {
            e.subject.each(function (d) {
                console.log('d: ' + d.data);
                markPendingExclusions(d.data);
                
            });
            console.log('pending exclusion nodes: ' + pendingExclusionNodes);
            populateDiagram();
        };

        function onDoubleClick(e) {
            var obj = e.diagram.selection.first().data;
            //console.log(obj);
            if (obj != null) {

                $('#objecttype').val(obj.type);
                $('#objectid').val(obj.id);

                populateDiagram();
                //deleting = d.data;
            }
        }

        function onLinkDrawn(e) {
            $('#overlay').show();

            newLink = e.subject.data;
            newLink.diagramObjectType = "Link";
            var from = e.subject.data.from;
            var to = e.subject.data.to;
            var toNode = null;
            var fromNode = null;
            //console.log(e.subject.data);
            toNode = myDiagram.model.findNodeDataForKey(to);
            fromNode = myDiagram.model.findNodeDataForKey(from);


            $('#newRelDisplay').html('<span style="padding:3px; border: 0 solid transparent; border-radius:3px;color: ' + (fromNode.foreColor || 'black') + ';background-color: ' + (fromNode.backColor || 'white') + ';" >' + fromNode.typeName + '</span><span style="font-size:1.5rem;font-weight:800;color:grey">&#8594;</span><span style="padding:3px; border: 0 solid transparent; border-radius:3px;color: ' +
         (toNode.foreColor || 'black') + ';background-color: ' + (toNode.backColor || 'white') + ';">' + toNode.typeName + '</span>');
            $('#AddNewRel').show();

            var data = {
                type1: fromNode.typeName,
                type2: toNode.typeName
            };
            populatePredicateList();
        };

        function onSelectionChange(e) {
            var node = e.diagram.selection.first();

            if (node == null) {
                $('#noneSel').show();
                $('#isSel').hide();
                $('#preview').html('');
                $("#jqxExpander0").jqxExpander('collapse');
                return;
            }
            //console.log(node.data);
            var data = node.data;

            $('#noneSel').hide();
            $('#isSel').show();
            $('#ddlRel').val(data.key);

            if (data.diagramObjectType == "Node") { //node selected
                $.ajax({
                    url: '/resources/Artifact/' + data.id + '/templates/tooltip/Preview',
                    data: null,
                    success: function (data) {
                        $('#preview').html(data);
                        $("#jqxExpander0").jqxExpander('expand');
                    },
                    async: true
                });
            } else if (data.diagramObjectType == "Link") { //link selected
                //console.log(data.from);
                $("#jqxExpander0").jqxExpander('collapse');
            }


        };

        function onInitialLayoutComplete() {
            //myDiagram.zoomToFit();
            //myDiagram.layout.isOngoing = false;
        }

        function onViewportBoundsChanged() {
            var s = myDiagram.scale;
            var h = 500;
            if (s > 1) {
                h = h * s;
            }
            $('#jqxZoom').val(Math.round(myDiagram.scale * 1500));
        };

        function mouseEnter(e, node) {
            node.isShadowed = true;
        };

        function mouseLeave(e, node) {
            node.isShadowed = false;
        };

        $('#resizeContainer').on('mouseup', function () {
            var height = $('#resizeContainer').height();
            var width = $('#resizeContainer').width();

            if (height != oldHeight || width != oldWidth) {
                $('#lineageDiagram').height(height - 20).width(width);
                oldHeight = height;
                oldWidth = width;
                myDiagram.requestUpdate();
            }
        });

        $(document).ready(function () {
            // Create jqxExpander
            $("#jqxExpander0").jqxExpander({ width: '100%', height: 'auto' }).jqxExpander('collapse');
            $("#jqxExpander1").jqxExpander({ width: '100%', height: 'auto' }).jqxExpander('collapse');
            //$("#jqxExpander2").jqxExpander({ width: '100%', height: 'auto' }).jqxExpander('collapse');


            $("#jqxZoom").jqxScrollBar({ width: 280, height: 18, min: 750, max: 2250, value: 1500 });
            $("#jqxZoom").on('valueChanged', function (event) {
                var val = parseInt(event.currentValue);
                $('#zoomDisplay').text(Math.round( (val / 1500) * 100) + '%');
                myDiagram.scale = (val / 1500);
            });

        });

    </script>
