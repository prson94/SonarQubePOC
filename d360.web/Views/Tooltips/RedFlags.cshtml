@model d360.core.entities.ObjectModel
<div id="RedFlagsOverlayGrid"></div>
<script type="text/javascript">
    var OverlayDataUrl = '/api/@(Model.ObjectType)/@(Model.ObjectID)/RedFlags';
    $(function () {

        var OverlayGridSource = {
            datatype: 'json',
            type: 'get',
            datafields: [
                { name: 'ID' },
                { name: 'Name' },
                { name: 'Description' },
                { name: 'Status' },
                { name: 'Url' },
                { name: 'CriticalRelationshipCount' },
            ],
            url: OverlayDataUrl
        };

        OverlayGridAdapter = new $.jqx.dataAdapter(OverlayGridSource);

        $('#RedFlagsOverlayGrid').jqxGrid({
            source: OverlayGridAdapter,
            width: grid_width,
            pagesizeoptions: ['5', '10', '20'],
            pagesize: 20,
            autoheight: true,
            sortable: true,
            altrows: true,
            showfilterrow: true,
            filterable: true,
            pageable: true,
            theme: list_theme,
            columns: [
                { datafield: "Name", text: "Name", width: 200 },
                { datafield: "Description", text: "Description" },
                { datafield: "CriticalRelationshipCount", text: "# Critical Relationships", width: 75 }
            ]
        });

        $('#RedFlagsOverlayGrid').on('rowdoubleclick', function (event) {
            try {
                var args = event.args;
                var row = args.rowindex;
                var data = $('#RedFlagsOverlayGrid').jqxGrid('getrowdata', row);
                location.assign(data.Url);
            } catch (e) {
                logError("RedFlags : RedFlagsOverlayGrid.rowdoubleclick", e);
            }
        });
    });
</script>