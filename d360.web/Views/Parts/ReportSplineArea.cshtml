@model d360.web.Models.ReportResultModel
<style>
    #ReportChart {
        border: 1px solid #666;
        border-radius: 3px;
        width: 100%;
        height: 500px;
        margin: 0 auto;
    }
</style>
<input id="btnAdd" type="button" value="Add widget!" />
<div id="Gridster" class="gridster"><ul></ul></div>
<div id="ReportChart"></div>
<script type="text/javascript">
    var reportSplineUri = '/parts/@(Model.Type.ToString())/@(Model.ID)/reports/@(Model.ReportDefinitionID).json';
    $(function () {

        var gridster = $("#Gridster > ul")
            .gridster({
                max_cols: 3,
                min_cols: 1,
                min_rows: 1,
                resize: {enabled: true, axes: 'both'}
            })
            .data('gridster');

        $('#btnAdd').click(function(){
            gridster.add_widget('<li class="gs-w">Hi there</li>', 3, 1, 1, 1);
        });

        var reportSplineSource =
        {
            datatype: "json",
            datafields: @(Html.Raw(Model.Fields)),
            url: reportSplineUri
        };

        var reportSplineAdapter = new $.jqx.dataAdapter(reportSplineSource, { async: false, autoBind: true, loadError: function (xhr, status, error) { alert('Error loading "' + reportSplineSource.url + '" : ' + error); } });

        $('#ReportChart').jqxChart({
            title: "@(Model.Name)",
            enableAnimations: true,
            showLegend: true,
            backgroundColor: 'transparent',
            showBorderLine: false,
            padding: { left: 5, top: 5, right: 5, bottom: 5 },
            titlePadding: { left: 90, top: 0, right: 0, bottom: 10 },
            source: reportSplineAdapter,
            categoryAxis:
            {
                dataField: 'x',
                datatype: 'date',
                showGridLines: true,
                gridLinesColor: '#ccc',
                gridLinesDashStyle: '2,2'
            },
            colorScheme: 'scheme02',
            seriesGroups:
            [
                {
                    type: 'splinearea',
                    alignEndPointsWithIntervals: false,
                    valueAxis:
                    {
                        unitInterval: 25,
                        gridLinesInterval: 25,
                        gridLinesDashStyle: '2,2',
                        tickMarksColor: '#ccc',
                        displayValueAxis: true,
                        description: 'Index Value'
                    },
                    series: [
                        { dataField: 'y', displayText: 'Event Count', opacity: 0.7 }
                    ]
                }
            ]
        });
    });
</script>