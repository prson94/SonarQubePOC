@model d360.core.entities.ObjectModel
<div id="AssignmentsPart"></div>
<script type="text/javascript">
    $(function () {

        var assignmentUrl = '/api/resources/@(Model.ObjectID)/assignments';

        //#region Grid

        var assignmentToolsRenderer = function (index, datafield, value, defaultvalue, column, data) {

            var tools = [
                { isitemlink: true, urlprefix: '#/monitor/' + data.EventTypeID + '/' + data.EventGroupID, type: 'EventGroup', context: 'Preview' }
            ];

            return renderToolsHtml(value, tools, contextList.Event, data);
        };

        var srcAssignmentsPart =
        {
            datatype: 'json',
            url: assignmentUrl,
            datafields:
            [
                { name: 'ID', type: 'number' },
                { name: 'DateCreated' },
                { name: 'Name', type: 'string' },
                { name: 'EventTypeID', type: 'number' },
                { name: 'EventGroupID', type: 'number' },
                { name: 'EventCount', type: 'number' }
            ]
        };
        var adapterAssignmentsPart = new $.jqx.dataAdapter(srcAssignmentsPart);

        $("#AssignmentsPart").jqxGrid({
            altrows: true,
            width: grid_width,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            autoheight: true,
            source: adapterAssignmentsPart,
            theme: list_theme,
            columns: [
                { datafield: "Name", text: "Name" },
                { datafield: "EventCount", text: "# Events", width: '75px' },
                { datafield: "DateCreated", text: "Created on", width: '150px', cellsformat: 'f' },
                { datafield: "ID", text: "", width: 40, cellsrenderer: assignmentToolsRenderer }
            ]
        });

        //#endregion
    });
</script>