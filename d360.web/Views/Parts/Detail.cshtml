@{
    var divID = "DetailPart" + ViewData["type"] + ViewData["id"];
}
<div class="tile tile-detail">
    <article id="@(divID)"></article>
</div>
<script type="text/javascript">
    var detailDivID = '#@(divID)';
    var dpContext = '@(ViewData["context"])';
    var dpType = '@(ViewData["type"])';
    var dpID = '@(ViewData["id"])';

    $(document).ready(function () {

        ObjectDetail('@(divID)', dpType, dpID);

        //#region Event Subscriptions

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case dpContext:
                        ObjectDetail('@(divID)', dpType, dpID);
                        break;
                }

            } catch (e) {
                logError("Detail", e);
            }
        });

        //#endregion

    });
</script>