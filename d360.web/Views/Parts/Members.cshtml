<div class="tile tile-detail">
    <header>Members</header>
    <div id="MembersPart"></div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var id = '@(ViewData["id"])';
        var memberContext = '@(ContextList.ResourceGroup)';

        var membersToolsRenderer = function (index, datafield, value, defaultvalue, column, data) {
            var tools = [
                { isitemlink: true, urlprefix: '#/resources/{0}', type: 'Group', context: 'Preview' },
                { icon: 'trash-o', urlprefix: '/form/DeleteGroupUser?groupID=' + id + '&resourceID={0}' }
            ];

            return renderToolsHtml(value, tools, memberContext, data);
        };

        var srcMembersGrid = {
            datatype: 'json',
            type: 'get',
            url: '/api/groups/' + id + '/resources',
            datafields:
            [
                { name: 'ResourceID', type: 'number' },
                { name: 'FirstName', type: 'string' },
                { name: 'LastName', type: 'string' },
                { name: 'IsOwner', type: 'boolean' }
            ]
        };

        var adapterMembersGrid = new $.jqx.dataAdapter(srcMembersGrid);

        $("#MembersPart").jqxGrid({
            altrows: true,
            width: grid_width,
            autoheight: true,
            sortable: true,
            virtualmode: false,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            pageable: true,
            //columnresize: true,
            source: adapterMembersGrid,
            theme: list_theme,
            columns: [
                { datafield: "FirstName", text: "First Name" },
                { datafield: "LastName", text: "Last Name" },
                { datafield: "IsOwner", text: "Owner?", width: 100, cellsrenderer: booleanrenderer },
                { datafield: "ResourceID", text: "", width: 80, cellsrenderer: membersToolsRenderer }
            ]
        });

        //#region Event Subscriptions

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case memberContext:
                        $("#MembersPart").jqxGrid('updatebounddata');
                        break;
                }
            } catch (e) {
                logError("MembersGrid", e);
            }
        });

        //#endregion
    });
</script>
