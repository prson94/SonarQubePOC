@model d360.web.Models.ReportResultModel
<h1>@Model.Name</h1>

<div class='description' style="margin-bottom: 20px;">@Model.Description</div>

<div id="ReportGrid"></div>
<script type="text/javascript">
    var uri = '/parts/@(Model.Type.ToString())/@(Model.ID)/reports/@(Model.ReportDefinitionID)/json';
    var fields = @Html.Raw(Model.Fields);
    var columns = @Html.Raw(Model.Columns);
    $(function () {
        var srcReportGrid = {
            datatype: 'json',
            url: uri,
            datafields: fields
        };

        var adapterReportGrid = new $.jqx.dataAdapter(srcReportGrid);

        $("#ReportGrid").jqxGrid({
            width: '100%',
            height: 500,
            //autoheight: true,
            filterable: true,
            groupable: true,
            sortable: true,
            filterable: true,
            scrollmode: 'deferred',
            columnsresize: true,
            enabletooltips: true,
            showfilterrow: true,
            virtualmode: false,
            //pageable: true,
            columnsresize: true,
            enabletooltips: true,
            source: adapterReportGrid,
            theme: theme,
            columns: columns
        });
    });
</script>

