@model d360.core.entities.ObjectModel
@{
    var title = (string)ViewData["Title"];
    var resourceID = (int)ViewData["ResourceID"];
}
<div class="container medium-overlay">
    <div class="ui segment">
        <div class="ui form message">
            <div class="ui large header">@(title)</div>
        </div>
        <div id="FollowingPart"></div>
    </div>
</div>
<script type="text/javascript">
    var followingUrl = '/queries/FollowingByResourceByType?resourceID=@(resourceID)&type=@(Model.ObjectType)&id=@(Model.ObjectID)';

    var UnFollow = function (row) {
        var data = $('#FollowingPart').jqxGrid('getrowdata', row);
        amplify.publish("CommandAction", { uri: "/resources/UpdateFollowStatus?type=" + data.ObjectType + "&id=" + data.ObjectID, customdata: { commandname: 'follow' } });
    }

    $(document).ready(function () {

        var followingTypeRenderer = function (index, datafield, value, defaultvalue, column, data) {
            try {
                if (data) {
                    var tools = [];

                    tools.push({
                        isitemlink: true,
                        iconBackColor: data.IconBackColor, iconForeColor: data.IconForeColor, iconText: data.IconText,
                        context: 'Preview', type: data.ObjectType, id: data.ObjectID,
                        urlprefix: data.Url
                    });

                    return renderToolsHtml(value, tools, contextList.Responsibility, data);
                }
            } catch (e) {
                console.log(e);
            }
            return "";
        };

        var source = {
            datafields: [
                { name: 'Url' },
                { name: 'Name' },
                { name: 'ObjectType' },
                { name: 'ObjectID' },
                { name: 'OpenEventCount' },
                { name: 'CurrentScore' },
                { name: 'RedFlagged' }
            ],
            datatype: "json",
            async: false,
            url: followingUrl
        };

        var adapter = new $.jqx.dataAdapter(source);

        $('#FollowingPart').jqxGrid({
            altrows: true,
            theme: list_theme,
            source: adapter,
            selectionmode: 'multiplerows',
            columnsmenu: true,
            sortable: true,
            pageable: false,
            height: '250px',
            scrollmode: 'logical',
            filterable: true,
            filtermode: 'excel',
            scrollbarsize: 10,
            //showfilterrow: true,
            width: grid_width,
            columns: [
                 //{
                 //    datafield: "TypeName",
                 //    text: "Type",
                 //    width: '125px'
                 //    //cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                 //        //return previewLinkRenderer(data.ObjectType, data.ObjectID, data.Url, data.Name);
                 //    //}
                 //},
                 {
                     datafield: "Name",
                     text: "Name",
                     cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                         return previewLinkRenderer(data.ObjectType, data.ObjectID, data.Url, data.Name);
                     }
                 },
                 {
                     datafield: "CurrentScore",
                     text: "Score",
                     width: '60px',
                     cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                         return currentScoreRenderer(value, data);
                     }
                 },
                 {
                     datafield: "ObjectID",
                     text: "",
                     width: '40px',
                     filterable: false,
                     cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                         return "<div class='RowTools'><a onclick='UnFollow(" + index + ")'><i title='Stop Following' class='fa fa-bookmark-o'></i></a></div>";
                     }
                 },
                 {
                     datafield: "RedFlagged",
                     text: "",
                     width: '30px',
                     filterable: false,
                     cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                         return redFlaggedRenderer(data, false);
                     }
                 }
            ]
        });

        //$('#FollowingPart').on('rowunselect', function (event) {
        //    amplify.publish("ClearFilteredBoard");
        //});

        //$('#FollowingPart').on('rowselect', function (event) {
        //    var args = event.args;
        //    var row = args.rowindex;

        //    var currentSelectedIndexes = $('#FollowingPart').jqxGrid('getselectedrowindexes');
        //    $.each(currentSelectedIndexes, function (p, ix) {
        //        if (ix != row) $('#FollowingPart').jqxGrid('unselectrow', ix);
        //    })
        //    amplify.publish("ClearOtherBoardFilters", { Origin: 'Following' });

        //    var data = $('#FollowingPart').jqxGrid('getrowdata', row);
        //    amplify.publish("ShowFilteredBoard", { ObjectType: data.ObjectType, ObjectID: data.ObjectID });
        //});

        //amplify.subscribe("ClearOtherBoardFilters", function (data) {
        //    if (data.Origin != 'Following') {
        //        var currentSelectedIndexes = $('#FollowingPart').jqxGrid('getselectedrowindexes');
        //        $.each(currentSelectedIndexes, function (p, ix) {
        //            $('#FollowingPart').jqxGrid('unselectrow', ix);
        //        })
        //    }
        //});

        amplify.subscribe("CommandExecuted", function (data) {
            $('#FollowingPart').jqxGrid('updatebounddata');
        });

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case "AlertFlag":
                        $('#FollowingPart').jqxGrid('updatebounddata');
                        break;
                }

            } catch (e) {
                logError("Detail", e);
            }
        });
    });
</script>