@model d360.core.entities.ObjectModel
@{
    var title = (string)ViewData["Title"];
    var resourceID = (int)ViewData["ResourceID"];
    var exportUrl = string.Format("/resources/{0}/following/{1}/{2}.xlsx", resourceID, Model.ObjectType, Model.ObjectID);
    var isCurrentUser = (bool)ViewData["IsCurrentUser"];
}
<div class="container medium-overlay">
    <div class="tile tile-detail">
        <header>
            @(title)
            <div class="TileTools" style="right: 5px; top: 5px; z-index: 1003">
                <div id="OverlayTools" style="border: none !important; background-color: transparent !important">
                    <ul>
                        <li data-action="export">
                            <i class="fa fa-2x fa-cloud-download" title="Export"></i>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
        <div style="margin-top: 30px" id="FollowingPart"></div>
    </div>
</div>
<script type="text/javascript">
    var followingUrl = '/queries/FollowingByResourceByType?resourceID=@(resourceID)&type=@(Model.ObjectType)&id=@(Model.ObjectID)';
    var exportUri = "@exportUrl";

    $('#OverlayTools').jqxMenu({ theme: 'flat', mode: 'horizontal', height: 50 });
    $('#OverlayTools').on('itemclick', function (event) {
        var li = event.args;
        var offset = $(li).offset();
        switch ($(li).data('action')) {
            case 'export':
                //#region
                $.fileDownload(exportUri, {
                    httpMethod: "GET"
                });
                break;
                //#endregion
        }
    });

    var UnFollow = function (row) {
        var data = $('#FollowingPart').jqxGrid('getrowdata', row);
        amplify.publish("CommandAction", { uri: "/resources/UpdateFollowStatus?type=" + data.ObjectType + "&id=" + data.ObjectID, customdata: { commandname: 'follow' } });
    }

    $(document).ready(function () {

        var followingTypeRenderer = function (index, datafield, value, defaultvalue, column, data) {
            try {
                if (data) {
                    var tools = [];

                    tools.push({
                        isitemlink: true,
                        iconBackColor: data.IconBackColor, iconForeColor: data.IconForeColor, iconText: data.IconText,
                        context: 'Preview', type: data.ObjectType, id: data.ObjectID,
                        urlprefix: data.Url
                    });

                    return renderToolsHtml(value, tools, contextList.Responsibility, data);
                }
            } catch (e) {
                console.log(e);
            }
            return "";
        };

        var source = {
            datafields: [
                { name: 'Url' },
                { name: 'Name' },
                { name: 'ObjectType' },
                { name: 'ObjectID' },
                { name: 'OpenEventCount' },
                { name: 'CurrentScore' }
            ],
            datatype: "json",
            async: false,
            url: followingUrl
        };

        var adapter = new $.jqx.dataAdapter(source);

        $('#FollowingPart').jqxGrid({
            altrows: true,
            theme: list_theme,
            source: adapter,
            selectionmode: 'multiplerows',
            columnsmenu: true,
            sortable: true,
            pageable: false,
            height: '250px',
            scrollmode: 'logical',
            filterable: true,
            filtermode: 'excel',
            scrollbarsize: 10,
            width: grid_width,
            columns: [
                 {
                     datafield: "Name",
                     text: "Name",
                     cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                         return previewLinkRenderer(data.ObjectType, data.ObjectID, data.Url, data.Name);
                     }
                 }
                 , {
                     datafield: "CurrentScore",
                     text: "Score",
                     width: '60px',
                     cellsrenderer: currentScoreRenderer
                 }
                 @if (isCurrentUser)
                 {
                  @:, { datafield: "ObjectID", text: "", width: '40px', filterable: false, cellsrenderer: function (index, datafield, value, defaultvalue, column, data) { return "<div class='RowTools'><a onclick='UnFollow(" + index + ")'><i title='Stop Following' class='fa fa-bookmark-o'></i></a></div>"; } }
                 }
            ]
        });

        amplify.subscribe("CommandExecuted", function (data) {
            $('#FollowingPart').jqxGrid('updatebounddata');
        });
    });
</script>