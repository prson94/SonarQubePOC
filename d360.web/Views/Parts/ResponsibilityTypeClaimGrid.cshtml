@{
    var id = (int)ViewData["ID"];
}
<div class="tile tile-detail">
    <header>Claims</header>
    <div id="ResponsibilityTypeClaimGrid"></div>
</div>

<script type="text/javascript">
    var ResponsibilityTypeClaimGridUri = '/api/ownership/types/@(id)/claims';

    $(function () {

        //#region Grid

        var ResponsibilityTypeClaimGridToolsRenderer = function (index, datafield, value, defaultvalue, column, data) {

            var tools = [
                { icon: 'pencil', urlprefix: '/form/EditResponsibilityTypeClaim?id=' + value },
                { icon: 'trash-o', urlprefix: '/form/DeleteResponsibilityTypeClaim?id=' + value }
            ];

            return renderToolsHtml(value, tools, contextList.ResponsibilityTypeClaim);
        }

        var ResponsibilityTypeClaimGridSource = {
            datatype: 'json',
            url: ResponsibilityTypeClaimGridUri,
            datafields:
            [
                { name: 'ID' },
                { name: 'Claim' },
                { name: 'ClaimDescription' },
                { name: 'ClaimObject' },
                { name: 'ClaimObjectDescription' },
                { name: 'ResponsibilityType' },
                { name: 'ResponsibilityTypeID' }
            ]
        };

        var ResponsibilityTypeClaimGridAdapter = new $.jqx.dataAdapter(ResponsibilityTypeClaimGridSource);

        $("#ResponsibilityTypeClaimGrid").jqxGrid({
            altrows: true,
            width: grid_width,
            autoheight: true,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            pageable: true,
            source: ResponsibilityTypeClaimGridAdapter,
            theme: list_theme,
            columns: [
                { datafield: "ClaimDescription", text: "Claim" },
                { datafield: "ClaimObjectDescription", text: "Dependent Object", width: 125 },
                { text: '', dataField: 'ID', width: 80, filterable: false, cellsrenderer: ResponsibilityTypeClaimGridToolsRenderer }
            ]
        });

        //#endregion

        //#region Event Subscriptions

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case contextList.ResponsibilityTypeClaim:
                        $('#ResponsibilityTypeClaimGrid').jqxGrid('updatebounddata');
                        break;
                }
            } catch (e) {
                logError("UserList : SaveAction", e);
            }
        });

        //#endregion

    });
</script>