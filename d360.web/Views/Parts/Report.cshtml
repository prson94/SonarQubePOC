@model d360.core.entities.Report
@{
    var chartJson = "[";
    var charts = Model.ReportCharts.ToList();
    chartJson += "]";

    var gridJson = "[";
    var grids = Model.ReportGrids.ToList();

    gridJson += "]";
}
<style>
    .jqx-tooltip {
        z-index: 100000;
    }

    .jqx-tooltip-main {
        z-index: 100001;
    }
</style>
<h1>@(Model.Name)</h1>
<div class="description" style="margin-bottom: 30px;">@(Model.Description)</div>

@switch (Model.Layout)
{
    case "1x1":
        <text>
            <div class="row">
                <div class="col-lg-12"><div id="region1" class="report-region"></div></div>
            </div>
        </text>
        break;
    case "2x1":
    <text>
        <div class="row">
            <div class="col-lg-12"><div id="region1" class="report-region"></div></div>
        </div>
        <div class="row">
            <div class="col-lg-12"><div id="region2" class="report-region"></div></div>
        </div>
    </text>
        break;
    case "1x2":
    <text>
        <div class="row">
            <div class="col-lg-6"><div id="region1" class="report-region"></div></div>
            <div class="col-lg-6"><div id="region2" class="report-region"></div></div>
        </div>
    </text>
        break;
    case "2x3":
    <text>
        <div class="row">
            <div class="col-lg-12"><div id="region1" class="report-region"></div></div>
        </div>
        <div class="row">
            <div class="col-lg-8"><div id="region2" class="report-region"></div></div>
            <div class="col-lg-4"><div id="region3" class="report-region"></div></div>
        </div>
    </text>
        break;
}
<script type="text/javascript">
    $(function () {
        @foreach (var grd in Model.ReportGrids)
        {
            var gridID = string.Format("#region{0}", grd.Location);
        <text>
        var srcReportGrid@(grd.ID) = {
            datatype: 'json',
            url: '/parts/@(Model.ObjectType.ToString())/@(Model.ObjectID)/reports/@(grd.ID)/G.json',
            datafields: @(Html.Raw(grd.Fields))
        };

        var adapterReportGrid@(grd.ID) = new $.jqx.dataAdapter(srcReportGrid@(grd.ID));
        $('@(gridID)').append('<h2>@(grd.Name)</h2>');
        $('@(gridID)').append('<div id="ReportGrid@(grd.ID)"></div>');
        $("#ReportGrid@(grd.ID)").jqxGrid({
            width: '100%',
            height: 300,
            //autoheight: true,
            filterable: true,
            groupable: true,
            sortable: true,
            filterable: true,
            scrollmode: 'deferred',
            columnsresize: true,
            enabletooltips: true,
            showfilterrow: true,
            virtualmode: false,
            //pageable: true,
            columnsresize: true,
            enabletooltips: true,
            source: adapterReportGrid@(grd.ID),
            theme: theme,
            columns: @(Html.Raw(grd.Columns))
        });
        </text>
        }

        @foreach (var cht in Model.ReportCharts)
        {
            var chartID = string.Format("#region{0}", cht.Location);
        <text>
        var reportSplineSource@(cht.ID) =
        {
            datatype: "json",
            datafields: @(Html.Raw(cht.Fields)),
            url: '/parts/@(Model.ObjectType.ToString())/@(Model.ObjectID)/reports/@(cht.ID)/C.json'
        };

        var reportSplineAdapter@(cht.ID) = new $.jqx.dataAdapter(reportSplineSource@(cht.ID), { async: false, autoBind: true, loadError: function (xhr, status, error) { alert('Error loading "' + reportSplineSource@(cht.ID).url + '" : ' + error); } });

        $('@(chartID)').append('<h2>@(cht.Name)</h2>');
        $('@(chartID)').append('<div id="ReportChart@(cht.ID)" style="width: 100%; height: 500px"></div>');

        $('#ReportChart@(cht.ID)').jqxChart({
            title: '',
            description: '',
            enableAnimations: true,
            showLegend: true,
            backgroundColor: 'transparent',
            enableCrosshairs: true,
            showBorderLine: false,
            padding: { left: 5, top: 5, right: 5, bottom: 5 },
            titlePadding: { left: 90, top: 0, right: 0, bottom: 10 },
            source: reportSplineAdapter@(cht.ID),
            categoryAxis:
            {
                dataField: '@(Html.Raw(cht.CategoryDataField))',
                datatype: 'date',
                showGridLines: true,
                gridLinesColor: '#ccc',
                gridLinesDashStyle: '2,2',
                textRotationAngle: 45
            },
            colorScheme: 'scheme02',
            seriesGroups: @(Html.Raw(cht.Series))
            });
        </text>
        }
    });
</script>