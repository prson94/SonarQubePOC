<div class="tile tile-detail">
    <header>Fields</header>
    <article id="FieldTypeRelationPart"></article>
</div>
<script type="text/javascript">
    $(document).ready(function () {

        var ftpType = '@(ViewData["type"])';
        var ftpID = '@(ViewData["id"])';
        var relationGridContext = '@(ContextList.FieldTypeRelation)';

        //#region Grid

        var fieldstoolsrenderer = function (index, datafield, value, defaultvalue, column, data) {
            var tools = [
                { icon: 'caret-up', urlprefix: '/fields/' + data.ObjectType + '/' + data.ObjectID + '/' + data.ID + '/move/up', context: 'action' },
                { icon: 'caret-down', urlprefix: '/fields/' + data.ObjectType + '/' + data.ObjectID + '/' + data.ID + '/move/down', context: 'action' },
                { icon: 'pencil', urlprefix: '/form/fields/' + data.ObjectType + '/' + data.ObjectID + '/' + data.ID + '/edit' },
                { icon: 'trash-o', urlprefix: '/form/fields/' + data.ObjectType + '/' + data.ObjectID + '/' + data.ID + '/delete' }
            ];
            return renderToolsHtml(value, tools, relationGridContext);
        };

        var srcFieldTypesGrid = {
            datatype: 'json',
            url: '/fields/' + ftpType + '/' + ftpID + '.json',
            datafields:
            [
                { name: 'ObjectType' },
                { name: 'ObjectID' },
                { name: 'ID' },
                { name: 'FriendlyName' },
                { name: 'SortOrder' },
                { name: 'IsRequired' },
                { name: 'IsListable' },
                { name: 'DisplayDescription' },
                { name: 'FormDescription' }
            ]
        };

        var adapterFieldTypesGrid = new $.jqx.dataAdapter(srcFieldTypesGrid);

        $("#FieldTypeRelationPart").jqxGrid({
            width: grid_width,
            autoheight: true,
            sortable: true,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            filterable: true,
            showfilterrow: true,
            pageable: true,
            altrows: true,
            //columnresize: true,
            source: adapterFieldTypesGrid,
            theme: list_theme,
            columns: [
                { datafield: "FriendlyName", text: "Field" },
                //{ text: 'Display Description', dataField: 'DisplayDescription', width: 150 },
                //{ text: 'Form Description', dataField: 'FormDescription', width: 150 },
                { datafield: "SortOrder", text: "Order", width: 70 },
                { datafield: "IsRequired", text: "Required?", cellsrenderer: booleanrenderer, width: 70 },
                { datafield: "IsListable", text: "Listable?", cellsrenderer: booleanrenderer, width: 70 },
                { text: '', dataField: 'ID', width: 150, filterable: false, cellsrenderer: fieldstoolsrenderer }
            ]
        });

        //#endregion

        //#region Event Subscriptions

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case relationGridContext:
                        $('#FieldTypeRelationPart').jqxGrid('updatebounddata');
                        break;
                }
            } catch (e) {
                logError("FieldTypeRelationGrid", e);
            }
        });

        amplify.subscribe("ToolAction", function (data) {
            try {
                if (data.context == "action") {
                    $.post(data.uri, function (data) {
                        amplify.publish("ShowMessage", { title: "Success!", message: data.message, type: 'confirm' });
                        $('#FieldTypeRelationPart').jqxGrid('updatebounddata');
                    });
                }
            } catch (e) {
                logError("FieldTypeRelationGrid", e);
            }
        });

        //#endregion

    });
</script>