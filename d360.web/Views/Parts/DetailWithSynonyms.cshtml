@model List<d360.core.entities.Synonym>
@{
    var divWrapperID = "DetailPartWrapper" + ViewData["type"] + ViewData["id"];
    var divID = "DetailPart" + ViewData["type"] + ViewData["id"];
}
<style type="text/css">
    .jqx-scrollview {
        background-color: transparent !important;
    }

    .jqx-fill-state-normal-metrodark {
        font-size: 12px;
        line-height: 17px;
        font-family: 'segoe ui', arial, sans-serif;
        border-color: #35353A;
        color: #ffffff;
        background: #3E3E42;
    }

    .jqx-fill-state-hover-metrodark {
        font-size: 12px;
        line-height: 17px;
        font-family: 'segoe ui', arial, sans-serif;
        border-color: #1C97EA;
        color: #fff;
        background-color: #1C97EA;
    }

    .jqx-fill-state-focus-metrodark {
        border-color: #000;
    }

    .jqx-fill-state-pressed-metrodark {
        border-color: #007ACC;
        color: #fff;
        background-color: #007ACC;
    }

    .jqx-fill-state-disabled-metrodark {
        color: #898989;
    }
</style>
<div class="tile tile-detail">
    <div role="tabpanel" style="margin:5px">

        <!-- Nav tabs -->
        <ul class="nav nav-pills" role="tablist">
            <li role="presentation" class="active"><a href="#default" aria-controls="home" role="tab" data-toggle="tab">Governance</a></li>
            @foreach (var s in Model)
            {
                <li role="presentation"><a href="#Synonym@(s.ID)" aria-controls="profile" role="tab" data-toggle="tab">@(s.SynonymType.Name)</a></li>
            }
        </ul>

        <!-- Tab panes -->
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane active" id="default">
                <div id="@(divID)" class="ui tab active" data-tab="default"></div>
            </div>
            @foreach (var s in Model)
            {
                <div role="tabpanel" class="tab-pane" id="Synonym@(s.ID)">
                    <div id="SynonymMenu@(s.ID)" style='border: none !important; margin: 15px;'>
                        <ul>
                            <li data-context='@(ContextList.Synonym)' data-uri='/form/EditSynonym?id=@(s.ID)'>
                                <i class='fa fa-pencil' title='Edit this synonym'></i>
                            </li>
                            <li data-context='@(ContextList.Synonym)' data-uri='/form/DeleteSynonym?id=@(s.ID)'>
                                <i class='fa fa-trash-o' title='Remove this synonym'></i>
                            </li>
                        </ul>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            @*<h2>@s.SynonymType.Name Synonym</h2>*@
                            <div class="FieldName">Name</div>
                            <div>@s.Name</div>
                            <div class="FieldName">Description</div>
                            <div>@Html.Raw(s.Description)</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<script type="text/javascript">
    var dpContext = '@(ViewData["context"])';
    var dpType = '@(ViewData["type"])';
    var dpID = '@(ViewData["id"])';

    $(document).ready(function () {

        ObjectDetail('@(divID)', dpType, dpID);

        //#region Event Subscriptions

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case dpContext:
                        ObjectDetail('@(divID)', dpType, dpID);
                        break;
                }

            } catch (e) {
                logError("Detail", e);
            }
        });
        @{foreach (var s in Model)
        {
        <text>
        $('#SynonymMenu@(s.ID)').jqxMenu({ showTopLevelArrows: false, enableRoundedCorners: false, theme: theme, autoOpenPopup: true, mode: 'horizontal' });
        $('#SynonymMenu@(s.ID)').on('itemclick', function (event) {
            var li = event.args;
            amplify.publish('ToolAction', { uri: $(li).data("uri"), context: $(li).data("context") });
        });
        </text>
        }
        }
        //#endregion

    });
</script>