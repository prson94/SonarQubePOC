@model d360.web.Models.ReportViewModel
@{
    var qs = "ReportPath=" + Model.Report.ReportPath;
    if (Model.Report.ReportParameters != null)
    {
        if (Model.Report.ReportParameters.Count > 0) { qs += "&"; }
        var i = 1;
        foreach (var p in Model.Report.ReportParameters)
        {
            qs += p.ParameterName + "=";
            switch (p.Token)
            { 
                //case "{CurrentCompanyID}":
                //    qs += Model.Report.CompanyID;
                //    break;
                case "{ObjectType}":
                    qs += Model.Type.ToString();
                    break;
                case "{ObjectID}":
                    qs += Model.ID;
                    break;
            }

            if (i < Model.Report.ReportParameters.Count) { qs += "&"; }
            
            i++;
        }
    }
}
<iframe src="~/Report.aspx?@Html.Raw(qs)" style="width: 100%; height: 600px; border: none; overflow: hidden" frameborder="0" seamless="seamless"></iframe>