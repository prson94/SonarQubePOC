<div class="tile tile-detail">
    <header>Resolutions</header>
    <div id="ResolutionsPart"></div>
</div>
<script type="text/javascript">
    var resolutionUri = '/api/EventType/@(ViewData["id"])/resolutions';
    $(function () {
        //#region Grid Logic

        var srcResolutionsGrid = {
            datatype: 'json',
            type: 'get',
            url: resolutionUri,
            datafields:
            [
                { name: 'ID' },
                { name: 'DateCreated' },
                { name: 'DateUpdated' },
                { name: 'Name' }
            ],
            filter: function () {
                $("#ResolutionsPart").jqxGrid('updatebounddata');
            },
            sort: function () {
                $("#ResolutionsPart").jqxGrid('updatebounddata');
            }
        };

        var adapterResolutionsGrid = new $.jqx.dataAdapter(srcResolutionsGrid);

        $("#ResolutionsPart").jqxGrid({
            altrows: true,
            width: grid_width,
            autoheight: true,
            sortable: true,
            virtualmode: false,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            pageable: true,
            source: adapterResolutionsGrid,
            theme: list_theme,
            columns: [
                { datafield: "Name", text: "Name" },
                { datafield: "DateCreated", text: "Created on", width: '150px', cellsformat: 'f' },
                { datafield: "DateUpdated", text: "Updated on", width: '150px', cellsformat: 'f' }
            ]
        });

        //#endregion

        //#region Event Subscriptions

        $('#ResolutionsPart').on('rowdoubleclick', function (event) {
            try {
                var args = event.args;
                var row = args.rowindex;
                var data = $("#ResolutionsPart").jqxGrid('getrowdata', row);
                location.assign('#/monitor/resolutions/' + data.ID);
            } catch (e) {
                logError("FieldTypeRelationGrid", e);
            }
        });

        //#endregion
    });
</script>