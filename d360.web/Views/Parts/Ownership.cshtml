@model d360.core.entities.ObjectModel
@{
    var title = (string)ViewData["Title"];
    var objectType = (string)ViewData["ObjectType"];
    var objectTypeID = (int?)ViewData["ObjectTypeID"];
    var IsAdmin = (bool)ViewData["IsAdmin"];
    var url = string.Format("/api/resources/{0}/ownership", Model.ObjectID);
    if (!string.IsNullOrEmpty(objectType) && objectTypeID.HasValue)
    {
        url += string.Format("/{0}/{1}", objectType, objectTypeID.Value);
    }
    url += "?$orderby=ObjectName";
}
<div class="container medium-overlay">
    <div class="ui segment">
        <div class="ui form message">
            <div class="ui large header">@(title)</div>
        </div>
        <div id="OwnershipPart"></div>
    </div>
</div>
<script type="text/javascript">
    var IsAdmin = @(IsAdmin ? "true" : "false");

    $(function () {

        var ownershipUrl = '@(url)';

        //#region Grid

        var source = {
            datafields: [
                { name: 'ObjectType' },
                { name: 'ObjectUrl' },
                { name: 'ObjectTypeName' },
                { name: 'ObjectID' },
                { name: 'ObjectName' },
                { name: 'FromGroup' },
                { name: 'Role' },
                { name: 'CurrentScore' }//,
                //{ name: 'RedFlagged' }
            ],
            datatype: "json",
            async: false,
            url: ownershipUrl
        };

        var adapter = new $.jqx.dataAdapter(source);

        $('#OwnershipPart').jqxGrid({
            altrows: true,
            theme: list_theme,
            source: adapter,
            sortable: true,
            filterable: true,
            selectionmode: 'multiplerows',
            filtermode: 'excel',
            //showfilterrow: true,
            pageable: false,
            height: '250px',
            scrollmode: 'logical',
            scrollbarsize: 10,
            width: grid_width,
            columns: [
                //{ datafield: "ObjectTypeName", text: "Type", width: '125px' },
                { 
                    datafield: "ObjectName", 
                    text: "Name", 
                    cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                        var html = previewLinkRenderer(data.ObjectType, data.ObjectID, data.ObjectUrl, data.ObjectName);
                        data = null;
                        return html;
                    } 
                },
                { datafield: "Role", text: "Role" },
                { 
                    datafield: "CurrentScore", 
                    text: "Score", 
                    width: '60px', 
                    cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                        return currentScoreRenderer(value, data);
                    } 
                }//,
                //{ 
                //    datafield: "RedFlagged", 
                //    text: "", 
                //    width: '30px', 
                //    filterable: false, 
                //    cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                //        return redFlaggedRenderer(data, true);
                //    }, 
                //    hidden: !IsAdmin 
                //}
            ]
        });

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case "AlertFlag":
                        $('#OwnershipPart').jqxGrid('updatebounddata');
                        break;
                }

            } catch (e) {
                logError("Detail", e);
            }
        });

        //#endregion
    });
</script>
