<script type="text/javascript">
    var vm;

    function Comment(item) {
        var self = this;

        self.ID = item.ID;
        self.Body = item.Body;
        self.CommentTypeID = item.CommentTypeID || 0;
        self.DateCreated = item.DateCreated || null;
        self.ObjectID = item.ObjectID || 0;
        self.ObjectType = item.ObjectType || "";
        self.ParentID = item.ParentID || null;
        self.ResourceName = item.ResourceName || ""
        self.ResourceEmail = item.ResourceEmail || "";
        self.ObjectName = item.ObjectName || "";
        self.ObjectUrl = item.ObjectUrl || "";
        self.CommentType = item.CommentType || "";

        self.comments = ko.observableArray();

        self.addComment = function (newcomment) {
            self.comments.push(newcomment);
        };
    };

    //ko.bindingHandlers.listview = {
    //    update: function (element, valueAccessor, allBindingsAccessor, viewModel) {
    //        setTimeout(function () {
    //            $(element).attr('data-role', 'listview');
    //            $(element).listview();
    //        }, 0);
    //    }
    //};

    CommentViewModel = function () {
        var self = this;

        self.comments = ko.observableArray();

        self.addComment = function (newcomment) {
            self.comments.push(newcomment);
        };

        self.init = function (hub) {

            self.hub = hub;

            self.hub.client.notifyOfNewFollowedComments = function (message) {
                $.gritter.add({
                    title: 'Success', text: message, type: 'confirm', class_name: 'status'
                });
            }

            //functions called by the Hub
            self.hub.client.loadFollowedComments = function (data) {
                var mappedComments = $.map(data, function (item) { return new Comment(item); });
                self.comments(mappedComments);
            }

            self.hub.server.getFollowedComments().fail(function (err) {
                alert(err);
            });
        }
    };

@*    $(document).ready(function () {
        //var bpType = '@(ViewData["Type"])';
        //var bpID = '@(ViewData["ID"])';
        //$('#BoardPart').Social({ enableborder: false, enablecategories: true, followed: true, type: bpType, id: bpID });
    });*@

    amplify.subscribe("SocialHubConnected", function (data) {
        var vm = new CommentViewModel();
        ko.applyBindings(vm, document.getElementById('BoardPart'));
        vm.init(data.hub);
    });
</script>

