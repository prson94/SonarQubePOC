@model d360.core.entities.ObjectModel
@{
    var IsAdmin = (bool)ViewData["IsAdmin"];
}
<div id="OwnershipPart"></div>
<script type="text/javascript">
    var ownershipUrl = '/api/groups/@(Model.ObjectID)/ownership';
    var IsAdmin = @(IsAdmin ? "true" : "false");

    $(function () {

        //#region Grid
       
        var source = {
            datafields: [
                { name: 'ObjectType' },
                { name: 'ObjectTypeName' },
                { name: 'ObjectID', type: 'number' },
                { name: 'ObjectName' },
                { name: 'ObjectUrl' },
                { name: 'ResponsibleObjectName' },
                { name: 'ResponsibleObjectUrl' },
                { name: 'Role' },
                { name: 'CurrentScore', type: 'number' }
            ],
            datatype: "json",
            async: false,
            url: ownershipUrl
        };

        var adapter = new $.jqx.dataAdapter(source);

        $('#OwnershipPart').jqxGrid({
            altrows: true,
            theme: list_theme,
            source: adapter,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            pageable: false,
            height: '250px',
            scrollmode: 'logical',
            scrollbarsize: 10,
            width: grid_width,
            columns: [
                { datafield: "ObjectTypeName", text: "Type", width: '125px', columntype: 'dropdownlist', filtertype: 'checkedlist' },
                { 
                    datafield: "ObjectName", 
                    text: "Name", 
                    cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                        var html = previewLinkRenderer(data.ObjectType, data.ObjectID, data.ObjectUrl, data.ObjectName);
                        data = null;
                        return html;
                    }
                },
                { datafield: "Role", text: "Role", columntype: 'dropdownlist', filtertype: 'checkedlist' },
                { 
                    datafield: "CurrentScore", 
                    text: "Score", 
                    filterable: false, 
                    width: '60px', 
                    cellsrenderer: currentScoreRenderer, 
                    columntype: 'numberinput', 
                    filtertype: 'number' 
                }
            ]
        });

        $('#OwnershipPart').on('rowselect', function (event) {
            var args = event.args;
            var row = args.rowindex;

            var currentSelectedIndexes = $('#OwnershipPart').jqxGrid('getselectedrowindexes');
            $.each(currentSelectedIndexes, function (p, ix) {
                if (ix != row) $('#OwnershipPart').jqxGrid('unselectrow', ix);
            })
            amplify.publish("ClearOtherBoardFilters", { Origin: 'Ownership' });

            var data = $('#OwnershipPart').jqxGrid('getrowdata', row);
            amplify.publish("ShowFilteredBoard", { ObjectType: data.ObjectType, ObjectID: data.ObjectID });
        });

        amplify.subscribe("ClearOtherBoardFilters", function (data) {
            if (data.Origin != 'Ownership') {
                var currentSelectedIndexes = $('#OwnershipPart').jqxGrid('getselectedrowindexes');
                $.each(currentSelectedIndexes, function (p, ix) {
                    $('#OwnershipPart').jqxGrid('unselectrow', ix);
                })
            }
        });

        //#endregion

    });
</script>
