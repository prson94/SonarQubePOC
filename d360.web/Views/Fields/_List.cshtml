@model d360.web.Models.FieldsViewModel
@{
    var prefix = ViewData["UriPrefix"].ToString();    
}

<div id="FieldsGridPart"></div>
<script type="text/javascript">
    var idx = '@(Model.TabIndex)';
    $(document).ready(function () {

        var prefix = '@(prefix)';

        //#region Grid

        var fieldstoolsrenderer = function (index, datafield, value, defaultvalue, column, data) {
            var tools = [
                { icon: 'caret-up', context: 'action', urlprefix: '/fields/' + data.ObjectType + '/' + data.ObjectTypeID + prefix + '/' + data.Name + '/move/up' },
                { icon: 'caret-down', context: 'action', urlprefix: '/fields/' + data.ObjectType + '/' + data.ObjectTypeID + prefix + '/' + data.Name + '/move/down' },
                { icon: 'pencil', urlprefix: '/form/fields/' + data.ObjectType + '/' + data.ObjectTypeID + prefix + '/' + data.Name + '/edit' },
                { icon: 'trash-o', urlprefix: '/form/fields/' + data.ObjectType + '/' + data.ObjectTypeID + prefix + '/' + data.Name + '/delete' }
            ];
            return renderToolsHtml(value, tools, '@ContextList.FieldTypeRelation');
        };

        var srcFieldTypesGrid =
                    {
                        datatype: 'json',
                        url: '/Fields/' + '@(Model.ObjectType)/@(Model.ObjectTypeID)' + prefix + '.json',
                        datafields:
                        [
                        { name: 'DisplayDescription' },
                        { name: 'FormDescription' },
                        { name: 'FriendlyName' },
                        { name: 'IsHtml' },
                        { name: 'Lookup' },
                        { name: 'MaxOccurs' },
                        { name: 'MinOccurs' },
                        { name: 'Name' },
                        { name: 'ObjectType' },
                        { name: 'ObjectTypeID' },
                        { name: 'Type' },
                        { name: 'Validator' }
                        ]
                    };

        var adapterFieldTypesGrid = new $.jqx.dataAdapter(srcFieldTypesGrid);

        $("#FieldsGridPart").jqxGrid(
        {
            width: grid_width,
            autoheight: true,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            pageable: true,
            //columnresize: true,
            source: adapterFieldTypesGrid,
            theme: list_theme,
            columns: [
                { text: 'Name', dataField: 'Name' },
                { text: 'Friendly Name', dataField: 'FriendlyName' },
                { text: 'Display Description', dataField: 'DisplayDescription', width: 150 },
                { text: 'Form Description', dataField: 'FormDescription', width: 150 },
                { text: 'Type', dataField: 'Type', width: 70 },
                { text: 'Lookup?', dataField: 'Lookup', width: 90, cellsrenderer: booleanrenderer },
                { text: 'Validation?', dataField: 'Validator', width: 100, cellsrenderer: booleanrenderer },
                { text: '', dataField: 'Name', width: 150, cellsrenderer: fieldstoolsrenderer }
            ]
        });

        //#endregion

        //#region Event Subscriptions

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case "@ContextList.FieldTypeRelation":
                        $('#FieldsGridPart').jqxGrid('updatebounddata');
                        break;
                }
            } catch (e) {
                logError("Fields._List : SaveAction", e);
            }
        });

        amplify.subscribe("CommandExecuted", function (command) {
            if (command == "FieldMove") {
                $('#FieldsGridPart').jqxGrid('updatebounddata');
            }
        });

        //#endregion
    });
</script>