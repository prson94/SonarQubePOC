@{
    var id = (int)ViewBag.ID;
    var surveyTypeID = (int)ViewBag.SurveyTypeID;
    var title = (id == 0) ? "Add Survey Question" : "Edit Survey Question";
    var description = (id == 0) ? Resources.FormInfo.Add_QuestionType_Directions : Resources.FormInfo.Edit_QuestionType_Directions;
}
<script id="questionTypeTmpl" type="text/html">
    <div class="left form-header-info">
        <h4>@(title)</h4>
    </div>
    <div class="right">
        <button type="button" id="EditableFormCancelButton" data-bind="click: cancel" class="btn waves-effect waves-light brown lighten-4">Cancel</button>
        <button type="button" id="EditableFormSaveButton" data-bind="click: save" class="btn waves-effect waves-light brown lighten-1 saveButton">Save</button>
    </div>
    <div class="clear"></div>
    <div class="form-instructions">@Html.Raw(description)</div>
    <div id="progress" data-bind="visible: InProgress"><i class="fa fa-spinner fa-spin fa-4x"></i></div>

    <div class="row">
        <div class="col s6">
            <div class="FieldNameRequired">@(Resources.FieldInfo.Name_Name)</div><br/>
            <input type="text" data-bind="jqxInput: { theme: theme, width: '100%', height: 25, value: Name, disabled: LimitedChangesOnly }" />
        </div>
        <div class="col s6">
            <div class="FieldNameRequired">@(Resources.FieldInfo.DisplayStyle_Name)</div><br />
            <div data-bind="displayStyleFilteredDropdown, jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: true,
                 selectedIndex: DisplayStyleIndex,
                 source: DisplayStyleOptions,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase' }"></div>
        </div>
    </div>

    <div class="row">
        <div class="col s12">
            <div class="FieldNameRequired">Description</div><br />
            <textarea data-bind="htmlareasimple: Description"></textarea>
        </div>
    </div>

    <div class="row">
        <div class="col s12" style="margin: 10px 0 10px 0">
            <table cellpadding="1">
                <thead>
                    <tr>
                        <th style="width: 60%">Name</th>
                        <th>Value</th>
                        <th style="width: 20px; text-align: right">
                            <a class='btn-flat waves-effect blue-text' data-bind="click: addItem"><i class='fa fa-plus' title='Add question option'></i></a>
                        </th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: Items">
                    <tr>
                        <td style="vertical-align: top; width: 60%">
                            <input type="text" data-bind="jqxInput: { theme: theme, width: '98%', height: 25, value: Name, disabled: LimitedChangesOnly }" />
                        </td>
                        <td style="vertical-align: top">
                            <div data-bind="jqxNumberInput: { theme: theme, width: '98%', height: 25, value: Value, inputMode: 'simple', spinButtons: false, decimalDigits: 0, digits: 2, disabled: LimitedChangesOnly }"></div>
                        </td>
                        <td style="width: 20px; text-align: right">
                            <a class='btn-flat waves-effect red-text' data-bind="click: $parent.deleteItem">
                                <i class='fa fa-trash' title='Remove'></i>
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</script>

<div class="medium-overlay">
    <div class="ui segment">
        <div id="QuestionTypeFormWrapper" data-bind="template: {name: 'questionTypeTmpl' }"></div>
    </div>
</div>


<script type="text/javascript">
    //#region Bindings

    ko.bindingHandlers.displayStyleFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.DisplayStyle(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };

    //#endregion

    function QuestionTypeItemViewModel(data, parent) {
        var self = this;
        data = data || {};

        //#region Simple Properties

        self.ID = ko.observable(data.ID);
        self.Name = ko.observable(data.Name || '');
        self.Value = ko.observable(data.Value || '');
        self.LimitedChangesOnly = ko.observable(data.LimitedChangesOnly || false);

        //#endregion

        //#region Internal Methods

        //self.isValid = function () {
        //    if (self.SourceFusionAttributeTypeIndex() == -1)
        //        return false;
        //    if (self.ReferenceTypeIndex() == -1)
        //        return false;

        //    var oneOrMoreFieldsSelected = false;
        //    $.each(self.DisplayFieldOptions(), function(fix, fid){
        //        if (!oneOrMoreFieldsSelected) {
        //            oneOrMoreFieldsSelected = (fid.Show() || fid.SortOrder() || fid.FilterValue() != '');
        //        }
        //    });

        //    return (oneOrMoreFieldsSelected);
        //};

        //#endregion
    }

    function QuestionTypeViewModel(data) {
        var self = this;
        data = data || {};

        self.Context = ko.observable("@(ContextList.QuestionType)");

        //#region Simple Properties

        self.ID = ko.observable(data.ID || 0);
        self.SurveyTypeID = ko.observable(data.SurveyTypeID);

        self.Name = ko.observable(data.Name);
        self.Description = ko.observable(data.Description || '');

        self.DisplayStyleIndex = ko.observable(data.DisplayStyleIndex || -1);
        self.DisplayStyle = ko.observable(data.DisplayStyle);

        self.LimitedChangesOnly = ko.observable(data.LimitedChangesOnly || false);
        self.InProgress = ko.observable(false);

        //#endregion

        //#region List Properties

        self.Items = ko.observableArray();
        self.DisplayStyleOptions = ko.observableArray();

        //#endregion

        //#region Methods

        self.addItem = function() {
            self.Items.push(new QuestionTypeItemViewModel({}, self));
        };

        self.cancel = function () {
            amplify.publish("CancelAction", { context: self.Context() });
        };

        self.deleteItem = function () {
            self.Items.remove(this);
        };

        self.loadCurrent = function () {
            $.getJSON(
                '/form/QuestionType_FormData',
                { id: self.ID(), surveyTypeID: @(surveyTypeID) },
                function (relData) {

                    self.DisplayStyleOptions(relData.DisplayStyleOptions);

                    self.Name(relData.Name);
                    self.Description(relData.Description);
                    self.SurveyTypeID(relData.SurveyTypeID);
                    self.DisplayStyle(relData.DisplayStyle);
                    self.LimitedChangesOnly(relData.LimitedChangesOnly);

                    var indexToSelect = -1;
                    $.each(self.DisplayStyleOptions(), function (ix, item) {
                        if (item.value == relData.DisplayStyle) {
                            indexToSelect = ix;
                        }
                    });
                    self.DisplayStyleIndex(indexToSelect);

                    if (!relData.Items) relData.Items = [];
                    if (relData.Items.length == 0) relData.Items.push({});

                    self.Items(
                        $.map(relData.Items, function (item) { return new QuestionTypeItemViewModel(item, self); })
                    );
                }
            );
        };

        self.save = function () {
            self.InProgress(true);

            var postModel = {
                ID: self.ID(),
                Name: self.Name(),
                Description: self.Description(),
                SurveyTypeID: self.SurveyTypeID(),
                DisplayStyle: self.DisplayStyle(),
                Items: []
            };

            $.each(self.Items(), function(itemIx, item){
                try {
                    var itm = {
                        ID: item.ID(),
                        Name: item.Name(),
                        Value: item.Value()
                    };
                    postModel.Items.push(itm);
                } catch (e) {
                    console.log(e);
                }
            });

            var uri = '';
            var method = '';
            if (postModel.ID == 0) {
                uri = '/form/AddQuestionType';
                method = 'POST';
            }
            else {
                uri = '/form/EditQuestionType';
                method = 'PUT';
            }

            $.ajax(uri, {
                data: postModel,
                dataType: 'json',
                method: method
            }).done(function (data, status, xhr) {
                amplify.publish("SaveAction", { context: self.Context(), action: 'add', id: 0, custom: {} });
                amplify.publish("ShowMessage", { type: "confirm", title: "Success!", message: 'Response type successfully created.' });
            }).fail(function (xhr, status, error) {
                amplify.publish("ShowMessage", { type: "error", title: "Error!", message: error });
            }).always(function (data, status, error) {
                self.InProgress(false);
            });
        };

        //#endregion

        return self;
    }

    $(function () {
        var model = new QuestionTypeViewModel({
            ID: @(ViewBag.ID)
        });
        ko.applyBindings(model, document.getElementById('QuestionTypeFormWrapper'));
        model.loadCurrent();

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
