@using d360.web.Models;
@using d360.core.resources;
@model ArtifactTypeEditorModel
<div class="small-overlay">
    <div class="ui segment">
        @Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = ContextList.ArtifactType, Description = Model.FormDescription, Name = Model.FormName })
        @using (Ajax.BeginForm(new AjaxOptions { HttpMethod = Model.FormMethod, Url = Model.FormUri, OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
        {
            <input type="hidden" id="_context" name="_context" value="@(ContextList.ArtifactType)" />
            <input type="hidden" id="ID" name="ID" value="@(Model.ArtifactType.ID)" />
            <input type="hidden" id="ParentID" name="ParentID" value="@(Model.ArtifactType.ParentID)" />

            <div class="row">
                <div class="col s8">
                    <div class="row">
                        <div class="col s12">
                            <div id='NameTip' class="FieldName">@Model.ArtifactType.GetName(i => i.Name)</div>
                            <input id="Name" name="Name" type="text" value="@(Model.ArtifactType.Name)" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col s12">
                            <div id='DescriptionTip' class="FieldName">@Model.ArtifactType.GetName(i => i.Description)</div>
                            <textarea id="Description" name="Description" class="htmlArea">@(Model.ArtifactType.Description)</textarea>
                        </div>
                    </div>
                </div>
                <div class="col s4">
                    <div class="row">
                        <div class="col s12 input-field">
                            <input type="checkbox" id="CanOwnFusion" name="CanOwnFusion" @(Model.ArtifactType.CanOwnFusion ? "checked='checked'" : "") />
                            <label id='CanOwnFusionTip' for="CanOwnFusion">@Model.ArtifactType.GetName(i => i.CanOwnFusion)</label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col s12 input-field">
                            <input type="checkbox" id="AllowRelatedArtifacts" name="AllowRelatedArtifacts" @(Model.ArtifactType.AllowRelatedArtifacts ? "checked='checked'" : "") />
                            <label id='AllowRelatedArtifactsTip' for="AllowRelatedArtifacts">@Model.ArtifactType.GetName(i => i.AllowRelatedArtifacts)</label>
                        </div>
                    </div>
                    @*<div class="row">
                        <div class="col s12 input-field">
                            <input type="checkbox" id="AllowHierarchy" name="AllowHierarchy" @(Model.ArtifactType.AllowHierarchy ? "checked='checked'" : "") />
                            <label id='AllowHierarchyTip' for="AllowHierarchy">@Model.ArtifactType.GetName(i => i.AllowHierarchy)</label>
                        </div>
                    </div>*@
                </div>
            </div>

            <div class="row">
                <div class="col s6">
                    <input type="hidden" id="IconBackColor" name="IconBackColor" value="@(Model.IconBackColor)" />
                    <div id='IconBackColorTip' class="FieldName">Background Color</div>
                    <div id="IconBackColorPicker"></div>
                </div>
                <div class="col s6">
                    <input type="hidden" id="IconForeColor" name="IconForeColor" value="@(Model.IconForeColor)" />
                    <div id='IconForeColorTip' class="FieldName">Text Color</div>
                    <div id="IconForeColorPicker"></div>
                </div>
            </div>
        }

    </div>

    <script type="text/javascript">
        $(function () {
            var nameTip = "@Model.ArtifactType.GetDescription(i => i.Name)";
            var descriptionTip = "@Model.ArtifactType.GetDescription(i => i.Description)";
            var canOwnFusionTip = "@Model.ArtifactType.GetDescription(i => i.CanOwnFusion)";
            var allowRelatedArtifactsTip = "@Model.ArtifactType.GetDescription(i => i.AllowRelatedArtifacts)";
            @*var allowHierarchyTip = "@Model.ArtifactType.GetDescription(i => i.AllowHierarchy)";*@

            var backColor = "@(Model.IconBackColor.Replace("#", ""))";
            var foreColor = "@(Model.IconForeColor.Replace("#", ""))";

            //#region Control Instantiation

            $("#Name").jqxInput({ width: field_width, theme: theme, height: 25 });
            $('#IconBackColorPicker').jqxColorPicker({ color: backColor, colorMode: 'hue', width: field_width, height: 225 });
            $('#IconForeColorPicker').jqxColorPicker({ color: foreColor, colorMode: 'hue', width: field_width, height: 225 });

            $('#form0').jqxValidator({
                hintType: 'label',
                rules: [
                    {
                        input: "#Name",
                        rule: 'required',
                        action: 'blur',
                        message: 'Name is required.'
                    }
                ]
            });

            //#endregion

            //#region Help Tooltips

            tipCss = 'qtip-blue qtip-shadow';
            $('#NameTip').qtip({
                content: { text: nameTip },
                style: { classes: tipCss }
            });

            $('#DescriptionTip').qtip({
                content: { text: descriptionTip },
                style: { classes: tipCss }
            });

            $('#CanOwnFusionTip').qtip({
                content: { text: canOwnFusionTip },
                style: { classes: tipCss }
            });

            $('#AllowRelatedArtifactsTip').qtip({
                content: { text: allowRelatedArtifactsTip },
                style: { classes: tipCss }
            });

            //$('#AllowHierarchyTip').qtip({
            //    content: { text: allowHierarchyTip },
            //    style: { classes: tipCss }
            //});

            //#endregion

            //#region Events

            $('#IconBackColorPicker').bind('colorchange', function (event) {
                var color = '#' + $('#IconBackColorPicker').jqxColorPicker('getColor').hex;//event.args;
                $('#IconBackColor').val(color);
            });

            $('#IconForeColorPicker').bind('colorchange', function (event) {
                var color = '#' + $('#IconForeColorPicker').jqxColorPicker('getColor').hex;//event.args;
                $('#IconForeColor').val(color);
            });

            $('#form0').on('validationSuccess', function (event) {
                // You can submit the form.
                $('#form0').submit();
            });
            $('#EditableFormSaveButton').on('click', function () {
                $('#form0').jqxValidator('validate');
            });

            $('#EditableFormCancelButton').on('click', function () {
                amplify.publish("CancelAction", { context: $('#EditableFormCancelButton').data('context') });
            });
            amplify.subscribe("ErrorOccurredAction", function (data) {
                $('#EditableFormSaveButton').hide();
            });
            amplify.subscribe("StartingAjax", function () {
                $('#EditableFormSaveButton').attr('disabled', 'disabled');
                $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');
            });
            amplify.subscribe("EndingAjax", function () {
                $('#EditableFormSaveButton').removeAttr('disabled');
                $('#progress').html('');
            });

            //#endregion

            $("html, body").animate({ scrollTop: 0 }, "slow");
        });
    </script>
