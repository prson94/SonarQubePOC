@model d360.web.Models.EditableForm
<div class="@(Model.FormSize)-overlay">
    <div class="ui segment">
        @Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = Model.Context, Description = Model.FormDescription, Name = Server.HtmlDecode(Model.FormTitle) })
        @using (Ajax.BeginForm(new AjaxOptions { HttpMethod = Model.FormMethod, Url = Html.Raw(Model.FormUri).ToHtmlString(), OnSuccess = "RelationshipActionSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
        { }
    </div>
</div>

<script type="text/javascript">
    function RelationshipActionSuccess(data, status, xhr) {
        amplify.publish("RelationshipFormStatus", { title: 'Successfully Added Relationships', message: data.message, success: true });
        amplify.publish("RelationshipSave", { action: 'Add' });
    }

    $(function () {
        $('#form0').Editor({ context: '@(Model.Context)', uri: '@(Html.Raw(Model.FieldUri))' });

        $("html, body").animate({ scrollTop: 0 }, "slow");

        $('#EditableFormCancelButton').on('click', function () {
            amplify.publish("RelationshipCancel");
        });

        amplify.subscribe("ErrorOccurredAction", function (data) {
            $('#EditableFormSaveButton').hide();
        });
        amplify.subscribe("StartingAjax", function () {
            $('#EditableFormSaveButton').attr('disabled', 'disabled');
            $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');
        });
        amplify.subscribe("EndingAjax", function () {
            $('#EditableFormSaveButton').removeAttr('disabled');
            $('#progress').html('');
        });
    });
</script>