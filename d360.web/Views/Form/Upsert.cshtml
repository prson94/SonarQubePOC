@model d360.web.Models.EditorModel
<div class="medium-overlay">
    <div class="ui segment">
        @Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = Model.Context, Description = Model.Description, Name = Model.Title })
        @using (Ajax.BeginForm(new AjaxOptions { HttpMethod = Model.Method, Url = Model.Uri, OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
        {
            <input type="hidden" id="_context" name="_context" value="@(Model.Context)" />
            @Html.EditorForModel()
        }
    </div>
</div>

<script type="text/javascript">
    $(function () {
        amplify.subscribe("ErrorOccurredAction", function (data) {
            $('#EditableFormSaveButton').hide();
        });

        amplify.subscribe("StartingAjax", function () {
            $('#EditableFormSaveButton').attr('disabled', 'disabled');
            $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');
        });

        amplify.subscribe("EndingAjax", function () {
            $('#EditableFormSaveButton').removeAttr('disabled');
            $('#progress').html('');
        });

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
