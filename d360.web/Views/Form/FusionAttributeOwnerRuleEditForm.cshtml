@model d360.web.Models.FusionOwnerRuleEditorModel

@Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = ContextList.FusionOwnerRule, Description = "By assigning an owner rule you are stating that the following artifact claims ownership over any selected fusion object.  This ownership applies when setting relationships on the fusion objects for this particular configuration.", Name = Model.FormName })
@using (Ajax.BeginForm(new AjaxOptions { HttpMethod = Model.FormMethod, Url = Model.FormUri, OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
{
    <input type="hidden" id="FusionID" name="FusionID" value="@(Model.FusionID)" />
    <input type="hidden" id="ID" name="ID" value="@(Model.Rule.ID)" />
    <div>
        @Html.Partial("FusionAttributeTypeFormTreeControl", new d360.web.Models.FusionAttributeTypeEditorControl { Title = "Owned Type", Types = Model.AttributeTypes, SelectedID = Model.Rule.ObjectID })
    </div>
    <div class="row">
        <div class="col s12">
            <div id='OwnerTip' class="FieldNameRequired">Owner</div>
            <div id="FusionOwnerOptionsDropdown" name="FusionOwnerOptionsDropdown"></div>
        </div>
    </div>
}
<script type="text/javascript">
    var fusionTypeID = '@(Model.FusionTypeID)';
    var fusionID = '@(Model.FusionID)';
    $(function () {

        //#region Options

        var FusionOwnerOptionsSource = {
            datatype: 'json',
            url: '/api/fusion/' + fusionTypeID + '/configurations/' + fusionID + '/ownership/options',
            datafields: [
                { name: "Type", type: "string" },
                { name: "ID", type: "number" },
                { name: "Name", type: "string" }
            ]
        };
        var FusionOwnerOptionsAdapter = new $.jqx.dataAdapter(FusionOwnerOptionsSource);
        $("#FusionOwnerOptionsDropdown").jqxDropDownList({ theme: theme, source: FusionOwnerOptionsAdapter, displayMember: 'Name', valueMember: 'ID', width: field_width, dropDownWidth: 500, height: 25 });

        //#endregion

        $('#EditableFormSaveButton').on('click', function () {
            $('#progress').html(progressIndicatorHtml);
            $('#form0').submit();
        });

        $('#EditableFormCancelButton').on('click', function () {
            amplify.publish("CancelAction", { context: $('#EditableFormCancelButton').data('context') });
        });

        amplify.subscribe("ErrorOccurredAction", function (data) {
            $('#EditableFormSaveButton').hide();
        });

        $("#FusionOwnerOptionsDropdown").on('bindingComplete', function (event) {
            var items = $("#FusionOwnerOptionsDropdown").jqxDropDownList('getItems');
            if (items) {
                $.each(items, function () {
                    console.log(this.value);
                    if (this.value == "@(Model.Rule.RelationshipOwnerObjectID)") {
                        $("#FusionOwnerOptionsDropdown").jqxDropDownList('selectItem', this);
                    }
                });
            }
        });

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
