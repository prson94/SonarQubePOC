@using d360.web.Models;
@using d360.core.enums;
@model HierarchyEditorModel

<div class="small-overlay">
    <div class="ui segment">
        @Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = ContextList.Hierarchy, Description = Model.FormDescription, Name = Model.FormName })
        <div class="row">
            <div class="col s6">
                <p class="FieldNameRequired col1">Artifact</p>
                <div id="hierarchyArtifactList"></div>
            </div>
            <div class="col s6">
                <p class="FieldNameRequired">Predicate</p>
                <div id="hierarchyPredicateList"></div>
                <span id="hierarchyError" style="color:#710000; display:none;">An error occurred. Please select an artifact and a predicate to save.</span>
            </div>
            <div class="s6" style="display:none">
                @(Model.SubjectType) , @(Model.SubjectID)
            </div>
        </div>
    </div>
</div>

<script>

    var hierarchySubjectSource = {
        datafields: [
            { name: 'Object' },
            { name: 'ObjectID' },
            { name: 'Name' }
        ],
        datatype: "json",
        url: '/relations/hierarchy/artifacts/@((int)Model.IntersectMapId)/@(Model.HierarchyMapType)/@(Model.SubjectType)/@(Model.SubjectID)'
    };

    var hierarchySubjectAdapter = new $.jqx.dataAdapter(
        hierarchySubjectSource,
        {
            beforeLoadComplete: function (records) {
                for (var i = 0; i < records.length; i++) {
                    var record = records[i];
                    record.Value = record.Object + '|' + record.ObjectID;
                }
                return records;
            }
        }
    );

    $("#hierarchyArtifactList").jqxDropDownList({
        theme: theme,
        source: hierarchySubjectAdapter,
        width: field_width,
        height: field_height,
        valueMember: 'Value',
        displayMember: 'Name',
        filterable: true,
        dropDownWidth: 400,
        searchMode: 'containsignorecase'
    });

    var hierarchyPredicateSource = {
        datafields: [
            { name: 'id' },
            { name: 'name' }
        ],
        datatype: "json",
        @if(Model.IntersectMapId != 0)
        {
           <text> url: '/diagrams/GetPredicateInfoByAllocation?id=@(Model.IntersectMapId)'</text>
        } else
        {
                    //public JsonNetResult GetPredicateInfoByTypes(string type1, string type2, int id1, int id2, MapType mapType)

            <text>url: '/diagrams/GetPredicateInfoByTypes?type1=@(Model.Subject.Type)&type2=@(Model.Subject.Type)&id1=@(Model.Subject.TypeID)&id2=@(Model.Subject.TypeID)&mapType=@(Model.HierarchyMapType)'
    </text>
        }
        
    };

    var hierarchyPredicateAdapter = new $.jqx.dataAdapter(hierarchyPredicateSource);

    $("#hierarchyPredicateList").jqxDropDownList({
        theme: theme,
        source: hierarchyPredicateAdapter,
        width: field_width,
        height: field_height,
        valueMember: 'id',
        displayMember: 'name',
        filterable: true,
        dropDownWidth: 400,
        searchMode: 'containsignorecase'
    });

    $('#EditableFormSaveButton').on('click', function () {
        $('#hierarchyError').hide();
        var SourcePostModel = {
            TargetType: '@(Model.TargetType)',
            TargetID: '@(Model.TargetID)',
            SubjectType: '@(Model.SubjectType)',
            SubjectID: '@(Model.SubjectID)',
            ObjectType: '@(Model.ObjectType)',
            ObjectID: $('#hierarchyArtifactList').val().split('|')[1],
            PredicateID: $('#hierarchyPredicateList').val()
        };

        if (SourcePostModel.ObjectID == null || SourcePostModel.PredicateID == "") {
            $('#hierarchyError').show();
        }
        //console.log(SourcePostModel);

        $.ajax({
            url: '/form/SaveHierarchy',
            data: SourcePostModel,
            method: 'POST',
            async: false
        });

        amplify.publish("SaveAction", { context: $('#EditableFormCancelButton').data('context') });
    });

    $('#EditableFormCancelButton').on('click', function () {
        amplify.publish("CancelAction", { context: $('#EditableFormCancelButton').data('context') });
    });
    amplify.subscribe("ErrorOccurredAction", function (data) {
        $('#EditableFormSaveButton').hide();
    });
    amplify.subscribe("StartingAjax", function () {
        $('#EditableFormSaveButton').attr('disabled', 'disabled');
        $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');
    });
    amplify.subscribe("EndingAjax", function () {
        $('#EditableFormSaveButton').removeAttr('disabled');
        $('#progress').html('');
    });

</script>