@model d360.web.Models.FusionPromotionRuleEditorModel
@Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = ContextList.FusionPromotionRule, Description = "By assigning a promotion rule you are promoting any selected fusion objects to become a business-level item, allowing you to then associated attributes and establish other relationships to the promoted item.", Name = Model.FormName })
<div class="small-overlay">
    @using (Ajax.BeginForm(new AjaxOptions { HttpMethod = Model.FormMethod, Url = Model.FormUri, OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
    {
        <input type="hidden" id="FusionID" name="FusionID" value="@(Model.FusionID)" />
        <input type="hidden" id="ID" name="ID" value="@(Model.Rule.ID)" />
        <div>
            @Html.Partial("FusionAttributeTypeFormTreeControl", new d360.web.Models.FusionAttributeTypeEditorControl { Title = "Promoted From", Types = Model.AttributeTypes, SelectedID = Model.Rule.ObjectID })
        </div>
        <div>
            <div id='PromotionTip' class="FieldNameRequired">Promote To</div>
            <div id="PrOptionsDropdown" name="PrOptionsDropdown"></div>
        </div>
        <div id="PromotionParent" style="display:none">
            <div id='PromotionParentTip' class="FieldName">Promote Under</div>
            <div id="PrOptionsParentDropdown" name="PrOptionsParentDropdown"></div>
        </div>
        <div class="input-field">
            <input type="checkbox" id="Enabled" name="Enabled" value="@(Model.Rule.Enabled)" />
            <label id='ItemsTip' for="Enabled">Enabled?</label>
        </div>
    }
</div>


<script type="text/javascript">
    var prErrorLogCategory = "Promotion";
    var prFusionTypeID = '@(Model.FusionTypeID)';
    var prFusionID = '@(Model.FusionID)';
    var prUri = "@(Model.FormUri)";
    var prMethod = "@(Model.FormMethod)";

    $(function () {

        //#region Options

        var PrOptionsSource = {
            datatype: 'json',
            url: '/api/fusion/' + prFusionTypeID + '/configurations/' + prFusionID + '/promotion/options',
            datafields: [
                { name: "PromotionObjectType", type: "string" },
                { name: "PromotionObjectID", type: "number" },
                { name: "Name", type: "string" },
                { name: "ParentObjectTypeID", type: "number" }
            ]
        };
        var PrOptionsAdapter = new $.jqx.dataAdapter(PrOptionsSource, {
            beforeLoadComplete: function (records) {
                var data = new Array();
                for (var i = 0; i < records.length; i++) {
                    var r = records[i];
                    r.FormattedID = r.PromotionObjectType + '|' + r.PromotionObjectID + '|' + r.ParentObjectTypeID;
                    data.push(r);
                }
                return data;
            }
        });
        $("#PrOptionsDropdown").jqxDropDownList({ theme: theme, source: PrOptionsAdapter, displayMember: 'Name', valueMember: 'FormattedID', width: field_width, height: field_height });

        $("#PrOptionsDropdown").on('change', function (event) {
            var args = event.args;
            if (args) {
                var index = args.index;
                var item = args.item;
                var value = item.value;
                var values = value.split('|');
                if (values[2] > 0) {
                    $('#PromotionParent').show();
                    var ot = values[0];
                    if (ot == 'ArtifactType') ot = 'Artifact';
                    PrOptionsParentSource.url = '/api/' + ot + '/' + values[2] + '/fieldlookup';
                    PrOptionsParentAdapter.dataBind();
                }
                else {
                    $('#PromotionParent').hide();
                    PrOptionsParentSource.url = null;
                    PrOptionsParentAdapter.dataBind();
                }
            }
        });

        //#endregion

        //#region Options Parent

        var PrOptionsParentSource = {
            datatype: 'json',
            url: null,
            datafields: [
                { name: "ID", type: "number" },
                { name: "Name", type: "string" }
            ]
        };
        var PrOptionsParentAdapter = new $.jqx.dataAdapter(PrOptionsParentSource);
        $("#PrOptionsParentDropdown").jqxDropDownList({ theme: theme, source: PrOptionsParentAdapter, displayMember: 'Name', valueMember: 'ID', width: field_width, height: field_height });

        //#endregion

        //#region Tooltips

        tipCss = 'qtip-blue qtip-shadow';
        $('#PromotionTip').qtip({
            content: {
                text: "@Resources.FieldInfo.FusionPromotionTo_ToolTip"
            },
            style: {
                classes: tipCss
            }
        });

        $('#PromotionParentTip').qtip({
            content: {
                text: "@Resources.FieldInfo.FusionPromotionUnder_ToolTip"
            },
            style: {
                classes: tipCss
            }
        });

        $('#ItemsTip').qtip({
            content: {
                text: "@Resources.FieldInfo.FusionPromotionEnable_ToolTip"
            },
            style: {
                classes: tipCss
            }
        });

        //#endregion

        $('#EditableFormSaveButton').on('click', function () {
            $('#progress').html(progressIndicatorHtml);
            $('#form0').submit();
        });

        $('#EditableFormCancelButton').on('click', function () {
            amplify.publish("CancelAction", { context: $('#EditableFormCancelButton').data('context') });
        });

        amplify.subscribe("ErrorOccurredAction", function (data) {
            $('#EditableFormSaveButton').hide();
        });

        $("#PrOptionsDropdown").on('bindingComplete', function (event) {
            var items = $("#PrOptionsDropdown").jqxDropDownList('getItems');
            if (items) {
                $.each(items, function () {
                    console.log(this.value);
                    if (this.value == "@(string.Format("{0}|{1}|{2}", Model.Rule.PromotionObjectType, Model.Rule.PromotionObjectID, ((Model.Rule.PromotionParentObjectID.HasValue) ? Model.Rule.PromotionObjectID.ToString() : "null")))") {
                        $("#PrOptionsDropdown").jqxDropDownList('selectItem', this);
                    }
                });
            }
        });

        $("#PrOptionsParentDropdown").on('bindingComplete', function (event) {
            var items = $("#PrOptionsParentDropdown").jqxDropDownList('getItems');
            if (items) {
                $.each(items, function () {
                    console.log(this.value);
                    if (this.value == "@(Model.Rule.PromotionParentObjectID)") {
                        $("#PrOptionsParentDropdown").jqxDropDownList('selectItem', this);
                    }
                });
            }
        });

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
