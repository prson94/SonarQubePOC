@using d360.web.Models;
@using d360.core.resources;
@model SourcingResponsibilityEditorModel
@{
    var context = (Model.Responsibility.ObjectType == "Intersect") ? ContextList.IntersectSourcingResponsibility : ContextList.SourcingResponsibility;
}
<div class="small-overlay">
    <div class="ui segment">
        @Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = context, Description = Model.FormDescription, Name = Model.FormName })
        @using (Ajax.BeginForm(new AjaxOptions { HttpMethod = Model.FormMethod, Url = Model.FormUri, OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
        {
            <input type="hidden" id="_context" name="_context" value="@(context)" />
            <input type="hidden" id="ID" name="ID" value="@(Model.Responsibility.ID)" />
            <input type="hidden" id="ObjectType" name="ObjectType" value="@(Model.Responsibility.ObjectType)" />
            <input type="hidden" id="ObjectID" name="ObjectID" value="@(Model.Responsibility.ObjectID)" />
            if (Model.Responsibility.ObjectType == "Intersect")
            {
                <input type="hidden" id="ResponsibilityType" name="ResponsibilityType" value="0" />
                <div class="row">
                    <div class="col s12">
                        <div id='ResponsibleObjectTip' class="FieldNameRequired">Source</div>
                        <div id="ResponsibleObject" name="ResponsibleObject"></div>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col s6">
                        <div id='ResponsibilityTypeTip' class="FieldNameRequired">Responsibility</div>
                        <div id="ResponsibilityType" name="ResponsibilityType"></div>
                    </div>
                    <div class="col s6">
                        <div id='ResponsibleObjectTip' class="FieldNameRequired">Source</div>
                        <div id="ResponsibleObject" name="ResponsibleObject"></div>
                    </div>
                </div>
                <div class="row">
                    <div class="col s12">
                        <div id='SourceResponsibilityTip' class="FieldNameRequired">Consumer</div>
                        <div id="TargetResponsibility" name="TargetResponsibility"></div>
                    </div>
                </div>
            }
            <div class="row">
                <div class="col s12">
                    <div id='ContextTip' class="FieldName">Contexts</div>
                    <div id="Context" name="Context"></div>
                </div>
            </div>
            <div class="row" @((Model.Responsibility.ObjectType == "Intersect") ? "style=display:none" : "")>
                <div class="col l6 m6 s12">
                    <div id='BusinessTransformationTip' class="FieldName">Business Transformation</div>
                    <textarea id="BusinessTransformation" name="BusinessTransformation" class="simpleHtmlArea">@Html.Raw(Model.BusinessTransformation)</textarea>
                </div>
                <div class="col l6 m6 s12">
                    <div id='TechnicalTransformationTip' class="FieldName">Technical Transformation</div>
                    <textarea id="TechnicalTransformation" name="TechnicalTransformation" class="simpleHtmlArea">@Html.Raw(Model.TechnicalTransformation)</textarea>
                </div>
            </div>
        }
    </div>
</div>
<script type="text/javascript">
    var allowResponsiblityTypeDropdown = @((Model.Responsibility.ObjectType == "Intersect") ? "false" : "true");
    var amplifyCancelAction = "CancelAction";
    var amplifySaveAction = "";
    @if (Model.Responsibility.ObjectType == "Intersect")
    {
    <text>
    amplifyCancelAction = "ResponsibilityCancel";
    amplifySaveAction = "ResponsibilitySave";
    </text>
    }

    //function OnSourcingResponsibilitySuccess(data, status, xhr) {
    //    amplify.publish("EndingAjax");
    //    try {
    //        var a = 'form';
    //        var action = 'add';
    //        var id = 0;
    //        if (data.context) { a = data.context; }
    //        if (data.action) { action = data.action; }
    //        if (data.id) { id = data.id; }
    //        amplify.publish(amplifySaveAction, { context: a, action: action, id: id, custom : data.custom });
    //        amplify.publish("ShowMessage", data);
    //    } catch (e) {
    //        logError("SourcingResponsibilityEditForm : OnSuccess", e);
    //    }
    //}

    $(function () {
        @*var _ResponsibilityTypeTip = "@Model.Responsibility.GetDescription(i => i.Name)";
            var _ResponsibleObjectTip = "@Model.Responsibility.GetDescription(i => i.Description)";
            var _ContextTip = "";
            var _VisibleTip = "@Model.Responsibility.GetDescription(i => i.AllowRelatedArtifacts)";*@

        var ContextSource = [];
        @{foreach (var c in Model.Contexts) {
            <text>ContextSource.push({ label: '@(c.Text)', value: '@(c.Value)', checked: @(c.Selected ? "true": "false") });</text>  @*, group: '@(c.Group.Name)'*@
        }}

        var ResponsibilityTypeSource = [];
        @{foreach (var c in Model.ResponsibilityTypes) {
            <text>ResponsibilityTypeSource.push({ label: '@(c.Text)', value: '@(c.Value)', checked: @(c.Selected ? "true": "false") });</text>
        }}

        var SourceResponsibilitySource = [];
        @{foreach (var c in Model.SourceResponsibilities) {
            <text>SourceResponsibilitySource.push({ label: '@(c.Text)', value: '@(c.Value)', checked: @(c.Selected ? "true": "false") });</text>
        }}

        var ArtifactsSource = [];
        @{foreach (var c in Model.Artifacts) {
            <text>ArtifactsSource.push({ label: '@(c.Text)', value: '@(c.Value)', checked: @(c.Selected ? "true": "false"), group: '@(c.Group.Name)' });</text>
        }}

        //#region Control Instantiation

        if (allowResponsiblityTypeDropdown) {
            $('#ResponsibilityType').jqxDropDownList({
                enableBrowserBoundsDetection: true,
                width: '100%',
                //dropDownWidth: 400,
                source: ResponsibilityTypeSource,
                theme: theme
            });
            $("#ResponsibilityType").jqxDropDownList('val', '@(Model.Responsibility.ResponsibilityTypeID)');


            $('#TargetResponsibility').jqxDropDownList({
                disabled: @((Model.SourceResponsibilities.Count == 0) ? "true" : "false"),
                enableBrowserBoundsDetection: true,
                width: '100%',
                //dropDownWidth: 400,
                source: SourceResponsibilitySource,
                theme: theme
            });
            $("#TargetResponsibility").jqxDropDownList('val', '@(Model.Responsibility.TargetResponsibilityID)');
        }


        $('#ResponsibleObject').jqxDropDownList({
            enableBrowserBoundsDetection: true,
            filterable: true,
            width: '100%',
            //dropDownWidth: 400,
            source: ArtifactsSource,
            theme: theme
        });
        $("#ResponsibleObject").jqxDropDownList('val', '@(Model.Responsibility.ResponsibleObjectID)');

        $('#Context').jqxDropDownList({
            checkboxes: true,
            filterable: true,
            searchMode: 'containsignorecase',
            enableBrowserBoundsDetection: true,
            width: '100%',
            //dropDownWidth: 400,
            source: ContextSource,
            theme: theme
        });

        $('#form0').jqxValidator({
            hintType: 'label',
            rules: [
                //{
                //    input: "#Name",
                //    rule: 'required',
                //    action: 'blur',
                //    message: 'Name is required.'
                //}
            ]
        });

        //#endregion

        //#region Help Tooltips

        tipCss = 'qtip-blue qtip-shadow';

        //$('#NameTip').qtip({
        //    content: { text: nameTip },
        //    style: { classes: tipCss }
        //});

        //#endregion

        //#region Events

        if (allowResponsiblityTypeDropdown) {
            //$(document.body).on('change', '#ResponsibilityType', function (value) {
            $('#ResponsibilityType').on('change', function (event) {
                //var optionSelected = $("option:selected", this);
                var valueSelected = event.args.item.value; //this.value;
                var url = "/form/SourcesByResponsibilityType?id=" + valueSelected;
                $.getJSON(url, function(roData) {
                    var ddl = $('#ResponsibleObject');
                    //ddl.html('');
                    //ddl.append('<option value="" disabled selected>Select source</option>');
                    var existingItems = ddl.jqxDropDownList('getItems');
                    if (existingItems) {
                        if (existingItems.length > 0) {
                            ddl.jqxDropDownList('clearSelection');
                            ddl.jqxDropDownList('clearFilter');
                            try {
                                ddl.jqxDropDownList('clear');
                            } catch (e) {}
                            existingItems = null;
                        }
                    }
                    $.each(roData, function(){
                        ddl.jqxDropDownList('addItem', { label: this.Text, value: this.Value });
                        //ddl.append('<option value="' + this.Value + '">' + this.Text + '</option>');
                    });
                })
            });
        }

        $('#form0').on('validationSuccess', function (event) {
            // You can submit the form.
            $('#form0').submit();
        });
        $('#EditableFormSaveButton').on('click', function () {
            $('#form0').jqxValidator('validate');
        });

        $('#EditableFormCancelButton').on('click', function () {
            amplify.publish(amplifyCancelAction, { context: $('#EditableFormCancelButton').data('context') });
        });
        amplify.subscribe("ErrorOccurredAction", function (data) {
            $('#EditableFormSaveButton').hide();
        });
        amplify.subscribe("StartingAjax", function () {
            $('#EditableFormSaveButton').attr('disabled', 'disabled');
            $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');
        });
        amplify.subscribe("EndingAjax", function () {
            $('#EditableFormSaveButton').removeAttr('disabled');
            $('#progress').html('');
        });

        //#endregion

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
