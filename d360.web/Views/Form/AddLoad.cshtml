<script id="loadTmpl" type="text/html">
    <div class="left form-header-info">
        <h4>Upload a Spreadsheet Job</h4>
    </div>
    <div class="right">
        <button type="button" id="EditableFormCancelButton" data-bind="click: cancel" class="btn waves-effect waves-light brown lighten-4">Cancel</button>
        <button type="button" id="EditableFormSaveButton" data-bind="click: save" class="btn waves-effect waves-light brown lighten-1 saveButton">Save</button>
    </div>
    <div class="clear"></div>
    <div class="form-instructions">Please ensure that you have column headers in your spreadsheet.</div>
    <div id="progress" data-bind="visible: InProgress"><i class="fa fa-spinner fa-spin fa-4x"></i></div>

    <div class="row">
        <div class="col s12">
            <div class="FieldNameRequired">Action</div>
            <div data-bind="actionFilteredDropdown, jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: true,
                 selectedIndex: ActionIndex,
                 source: ActionOptions,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase' }"></div>
        </div>
        <div class="col s12" data-bind="visible: ActionSelected">
            <div class="FieldNameRequired">Type To Load</div>
            <div data-bind="typeFilteredDropdown, jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: true,
                 selectedIndex: TypeIndex,
                 source: TypeOptions,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase' }"></div>
            <span data-bind="visible: TypeOptionsLoading">Loading, please wait...</span>
        </div>
        <div class="col s12" data-bind="visible: ActionAndTypeSelected">
            <div class="FieldName">Notes</div>
            <textarea data-bind="value: Notes"></textarea>
        </div>
        <div class="col s12" data-bind="visible: ActionAndTypeSelected">
            <div class="FieldName">Expected columns based on the type you selected (Bold columns are required)</div>
            <table>
                <tr data-bind="foreach: Columns">
                    <td data-bind="text: $data,css :$root.isRequiredField($data)"></td>
                </tr>
            </table>
            <br /><br />
            <a data-bind="attr: { href: TemplateDownloadUrl }">Download spreadsheet</a>. (Bold columns are required.  If you do not want to populate an optional column remove the column from the spreadsheet.)
        </div>
        <div class="col s12" data-bind="visible: ActionAndTypeSelected">
            <div class="row">&nbsp;</div>
            <div class="FieldName">File</div>            
            @*<div id="BulkLoadFile"></div>*@
            @*<div data-bind="fileDrag: File">*@
            <div>
                <input type="file" data-bind="fileInput: File" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel" style="width: 99%" />
                @*<input type="file" data-bind="fileInput: File, customFileInput: {}" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel" />*@
            </div>
        </div>
    </div>

</script>
<style type="text/css">
    #BulkLoadFileUploadButton, #BulkLoadFileCancelButton, .jqx-file-upload-file-upload-d3s {
        display: none;
    }
</style>
<div class="small-overlay">
    <div class="ui segment">
        <div id="LoadWrapper" data-bind="template: {name: 'loadTmpl' }"></div>
    </div>
</div>
<script type="text/javascript">
    function LoadViewModel(data) {
        var self = this;
        data = data || {};

        //#region Simple Properties

        self.Context = ko.observable(data.Context);

        self.ActionIndex = ko.observable(data.ActionIndex || -1);
        self.Action = ko.observable(data.Action1);
        self.TypeIndex = ko.observable(data.TypeIndex || -1);
        self.Type = ko.observable(data.Type);
        self.Notes = ko.observable(data.Notes || "");

        self.File = ko.observable({
            file: ko.observable(), // will be filled with a File object
            // Read the files (all are optional, e.g: if you're certain that it is a text file, use only text:
            binaryString: ko.observable(),  // The result property will contain the file/blob's data as a binary string. Every byte is represented by an integer in the range [0..255].
            text: ko.observable(),          // The result property will contain the file/blob's data as a text string. By default the string is decoded as 'UTF-8'. Use the optional encoding parameter can specify a different format.
            dataURL: ko.observable(),       // The result property will contain the file/blob's data encoded as a data URL.
            arrayBuffer: ko.observable(),   // The result property will contain the file/blob's data as an ArrayBuffer object.
            base64String: ko.observable(),  // Just the base64 string, without mime type or anything else.
        });

        
        self.InProgress = ko.observable(false);

        //#endregion

        //#region Computed Properties

        self.ActionSelected = ko.pureComputed(function () {
            return (self.Action());
        }, self);

        self.ActionAndTypeSelected = ko.pureComputed(function () {
            return (self.Action() && self.Type());
        }, self);

        self.TypeOptionsLoading = ko.pureComputed(function () {
            return (self.TypeOptions().length == 0);
        }, self);

        self.TemplateDownloadUrl = ko.observable("#");

        //#endregion

        //#region List Properties

        self.ActionOptions = ko.observableArray([
            { title: 'Promotion', value: 'P' },
            { title: 'Relation', value: 'R' },
            { title: 'Unrelation', value: 'U' },
            { title: 'Lineage', value: 'L'}
        ]);
        self.TypeOptions = ko.observableArray();
        self.Columns = ko.observableArray();

        //#endregion

        self.File().dataURL.subscribe(function (dataURL) {
            console.log(dataURL);
        });

        self.Action.subscribe(function (value) {
            self.TypeOptions.removeAll();
            if (value) {
                $.getJSON(
                    '/form/Load_TypeOptions',
                    { act: value },
                    function (relData) {
                        self.TypeOptions(relData);

                        var indexToSelect = -1;

                        $.each(self.TypeOptions(), function (ix, item) {
                            if (item.value == self.Type()) {
                                indexToSelect = ix;
                            }
                        });
                        self.TypeIndex(indexToSelect);
                    }
                );
                //self.ActionSelected(true);
            }
        });

        self.Type.subscribe(function (value) {
            if (value) {
                var typeInfo = value.split('|');
                self.TemplateDownloadUrl('/form/Load_ExpectedColumns_ToExcel?type=' + typeInfo[0] + '&id=' + typeInfo[1]);
                $.getJSON(
                    '/form/Load_ExpectedColumns',
                    { type: typeInfo[0], id: typeInfo[1] },
                    function (colData) {
                        self.Columns(colData);
                    }
                );
            }
        });

        //#region Methods

        self.cancel = function () {
            amplify.publish("CancelAction", { context: self.Context() });
        };

        self.save = function () {
            self.InProgress(true);

            var postModel = {
                LoadAction: self.Action(),
                Type: self.Type(),
                Notes: self.Notes(),
                File: self.File().dataURL()
            }

            $.ajax('/form/AddLoad', {
                data: JSON.stringify(postModel),
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                method: 'post'
            }).done(function (data, status, xhr) {
                
                amplify.publish("SaveAction", { context: data.context, action: 'add', id: data.id, custom: data.custom });
                amplify.publish("ShowMessage", data);
                self.InProgress(false);
                
            }).fail(function (xhr, status, error) {
                amplify.publish("ShowMessage", { type: "error", title: "Error!", message: error });
                self.InProgress(false);
            });
        };

        
        self.isRequiredField = function (column,type) {
            var objectType = self.Type().split('|');            
            if (objectType == null) return 'required';
            objectType = objectType[0];
            console.log(objectType)
            var col = column != null ? column.toLowerCase() : '';
            if (self.Action() == 'P' && objectType.toLowerCase() == 'artifacttype') {
                if (col == 'name' || col == 'subject area' || col.startsWith('parent ')) return 'required';
                return ''
            }
            if (self.Action() == 'P' && objectType.toLowerCase() == 'domain') {
                if (col == 'name' || col == 'code') return 'required';
                return ''
            }
            if (self.Action() == 'P' && objectType.toLowerCase() == 'domaintype') {
                if (col == 'name' || col == 'domain group') return 'required';
                return ''
            }
            return 'required';
        }

        //#endregion

        return self;
    }

    $(function () {
        var model = new LoadViewModel({});
        ko.applyBindings(model, document.getElementById('LoadWrapper'));
        //$('#BulkLoadFile').jqxFileUpload({ theme: theme, uploadUrl: '', fileInputName: 'BulkUpload', accept: '.xls, .xlsx', multipleFilesUpload: false, uploadTemplate: 'info' });
        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
