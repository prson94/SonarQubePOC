@model d360.web.Models.LoadTypeRuleEditorModel
<div class="container">
    <div class="ui segment">
        @Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = ContextList.LoadTypeRule, Description = Resources.FormInfo.Edit_LoadTypeRule_Directions, Name = Resources.FormInfo.Edit_LoadTypeRule_Title })
        @using (Ajax.BeginForm(new AjaxOptions { HttpMethod = "PUT", Url = "/Form/EditLoadTypeRule", OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
        {
            @Html.HiddenFor(i => i.ID)
            @Html.EditorForModel()
        }
    </div>
</div>

<script type="text/javascript">
    $(function () {
        //$('#form0').jqxValidator({
        //    hintType: 'label',
        //    rules: [
        //        {
        //            input: "#Name",
        //            rule: 'required',
        //            action: 'blur',
        //            message: 'Name is required.'
        //        }
        //    ]
        //});

        //$('#form0').on('validationSuccess', function (event) {
        //    // You can submit the form.
        //    $('#form0').submit();
        //});
        $('#EditableFormSaveButton').on('click', function () {
            $('#form0').submit();
            //$('#form0').jqxValidator('validate');
        });

        $('#EditableFormCancelButton').on('click', function () {
            amplify.publish("CancelAction", { context: $('#EditableFormCancelButton').data('context') });
        });
        amplify.subscribe("ErrorOccurredAction", function (data) {
            $('#EditableFormSaveButton').hide();
        });
        amplify.subscribe("StartingAjax", function () {
            $('#EditableFormSaveButton').attr('disabled', 'disabled');
            $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');
        });
        amplify.subscribe("EndingAjax", function () {
            $('#EditableFormSaveButton').removeAttr('disabled');
            $('#progress').html('');
        });

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
