@using d360.core.resources
@model d360.web.Models.SourcingResponsibilityEditorModel

<div class="container">
    <div class="ui segment">

        <div class="ui form message">
            <div class="pull-left">
                <div class="ui large header">Add Responsiblity</div>
                <p>Add a sourcing responsbility for this item.  This is the ideal source defined for this item and could be overriden by an actual source on a relationship.</p>
            </div>
            <div class="pull-right">
                <div class="ui buttons">
                    <button type="button" id="EditableFormCancelButton" class="tiny ui button" data-context="@(ContextList.ActionResponsibility)">Cancel</button>
                    <div class="or"></div>
                    <button type="button" id="EditableFormSaveButton" class="tiny ui positive button saveButton" data-context="@(ContextList.ActionResponsibility)">Save</button>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>

        <div id="progress"></div>

        @using (Ajax.BeginForm(new AjaxOptions { HttpMethod = "POST", Url = "/Form/AddResponsibility_Sourcing", OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
        {
            @Html.EditorForModel()
        }
    </div>
</div>