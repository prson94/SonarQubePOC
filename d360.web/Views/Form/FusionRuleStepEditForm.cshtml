@model d360.web.Models.FusionRuleStepEditorModel
@{    
    var objectType = Model.RuleStep.GetSettingValueByName("Object");
    var subjectType = Model.RuleStep.GetSettingValueByName("Subject");
    var focalType = Model.RuleStep.GetSettingValueByName("Focal");
    var objectID = Model.RuleStep.GetSettingValueByName("ObjectID");
    var subjectID = Model.RuleStep.GetSettingValueByName("SubjectID");
    var focalID = Model.RuleStep.GetSettingValueByName("FocalID");

    var promoteParentTypeID = Model.RuleStep.GetSettingValueByName("ParentObjectTypeID");
    var promoteParentSearch = Model.RuleStep.GetSettingValueByName("ParentObjectSearch");
    var promoteParentObjectID = Model.RuleStep.GetSettingValueByName("ParentObjectID");

    var objectSearch = Model.RuleStep.GetSettingValueByName("ObjectSearch");
    var subjectSearch = Model.RuleStep.GetSettingValueByName("SubjectSearch");
    var focalSearch = Model.RuleStep.GetSettingValueByName("FocalSearch");

    var filterField = Model.RuleStep.GetSettingValueByName("FilterField");
    var targetField = Model.RuleStep.GetSettingValueByName("TargetField");
    var intersectTypeID = Model.RuleStep.GetSettingValueByName("IntersectType");
    var RuleObjectID = Model.RuleStep.FusionRule.ObjectID;
    var RuleObjectType = Model.RuleStep.FusionRule.ObjectType;
    var predicate = Model.RuleStep.GetSettingValueByName("Predicate");

}
@Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = ContextList.FusionRuleStep, Description = "Configure the actions for this step of your fusion rule.", Name = Model.FormName })
<div class="large-overlay">
    @using (Ajax.BeginForm(new AjaxOptions { HttpMethod = Model.FormMethod, Url = Model.FormUri, OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
    {
        <input type="hidden" id="RuleID" name="RuleID" value="@(Model.RuleStep.RuleID)" />
        <input type="hidden" id="RuleStepID" name="RuleStepID" value="@(Model.RuleStep.ID)" />
        <input type="hidden" id="Step" name="Step" value="@(Model.RuleStep.Step)" />

        <div class="row">
            <div class="col s6 offset-s3">              
                <div class="row" id="stepAction" data-bind="template: {name: 'promotionStepActionTmpl' }"></div>                
            </div>            
        </div>        
    }
</div>

<script type="text/javascript">
    var prErrorLogCategory = "Promotion";
    var prUri = "@(Model.FormUri)";
    var prMethod = "@(Model.FormMethod)";

    var ruleStepViewModel;

    function unsubscribe() {
        ruleStepViewModel = null;

        amplify.unsubscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.unsubscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
    }

    $(function () {

        ruleStepViewModel = new promotionStepActionViewModel(@(Model.FusionID), @(Model.FusionTypeID), @(Model.RuleStep.RuleID), @(Model.RuleStep.ID), @(RuleObjectID), '@(RuleObjectType)');
        ruleStepViewModel.description = "@(Model.RuleStep.Description)";
        ruleStepViewModel.SetSelectedAction("@(Model.RuleStep.Action)");

        if("@((Model.RuleStep.Action ?? "").ToUpper())" == "PROMOTE")
        {
            ruleStepViewModel.SetPromotionValues('@(string.Format("{0}|{1}|{2}", objectType, objectID, ((!string.IsNullOrEmpty(promoteParentTypeID)) ? promoteParentTypeID : "null")))', '@(promoteParentSearch)', "@(promoteParentObjectID)");
        }
        else if("@((Model.RuleStep.Action ?? "").ToUpper())" == "FIND")
        {
            ruleStepViewModel.SetFindValues('@(objectSearch)', '@(objectType)', '@(objectID)', '@(filterField)','@(targetField)');
        }
        else if("@((Model.RuleStep.Action ?? "").ToUpper())" == "RELATE")
        {
            ruleStepViewModel.SetRelateValues('@(subjectSearch)', '@(subjectType)', '@(subjectID)', '@(objectSearch)', '@(objectType)', '@(objectID)', '@(intersectTypeID)');
        }
        else if("@((Model.RuleStep.Action ?? "").ToUpper())" == "LINEAGE")
        {
            ruleStepViewModel.SetLineageValues('@(focalSearch)', '@(focalType)', '@(focalID)', '@(subjectSearch)', '@(subjectType)', '@(subjectID)', '@(objectSearch)', '@(objectType)', '@(objectID)', '@(intersectTypeID)', '@(predicate)');
        }

        ko.applyBindings(ruleStepViewModel, document.getElementById('stepAction'));

        //#region tooltips
        tipCss = 'qtip-blue qtip-shadow';
        $('#PromotionTip').qtip({
            content: {
                text: "@Resources.FieldInfo.FusionPromotionTo_ToolTip"
            },
            style: {
                classes: tipCss
            }
        });

        $('#PromotionParentTip').qtip({
            content: {
                text: "@Resources.FieldInfo.FusionPromotionUnder_ToolTip"
            },
            style: {
                classes: tipCss
            }
        });
        $('#PromotionResultStepTip').qtip({
            content: {
                text: "Choose a step to use the results from to base the parent of this step from."
            },
            style: {
                classes: tipCss
            }
        });


        $('#PromotionParentSearchTip').qtip({
            content: {
                text: "Choose a method to determine the parent value of the promoted item. Direct you specify the parent directly, or Result From Step where the parent value is based off the result of another step."
            },
            style: {
                classes: tipCss
            }
        });

        //#endregion

        //#region validation

        $('#form0').jqxValidator({
            hintType: 'label',
            rules: [
                //{
                //    input: "#Name",
                //    rule: 'required',
                //    action: 'blur',
                //    message: 'Name is required.'
                //},
           /*     {
                    input: '#Description', message: 'A description for this step is required.', action: 'blur',
                    rule: function () {
                        return $('#Description').val() != '';
                    }
                },
                {
                    input: '#Action', message: 'A step action is required.', action: 'blur',
                    rule: function () {
                        return $('#Action').val() != '';
                    }
                },*/
            /*    {
                    input: '#PrOptionsDropdown', message: 'Promote to location is required.', action: 'blur',
                    rule: function () {
                        return $('#PrOptionsDropdown').val() != '';
                    }
                }*/
            ]
        });


        //#endregion

        $('#form0').on('validationSuccess', function (event) {
            $('#form0').submit();
        });
        $('#EditableFormSaveButton').on('click', function () {
            $('#form0').jqxValidator('validate');
        });

        $('#EditableFormCancelButton').on('click', function () {
            amplify.publish("CancelAction", { context: $('#EditableFormCancelButton').data('context') });
        });

        amplify.subscribe("ErrorOccurredAction", function (data) {
            $('#EditableFormSaveButton').hide();
        });

        $("html, body").animate({ scrollTop: 0 }, "slow");


        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);


    });
</script>