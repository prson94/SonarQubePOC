@{
    var id = (int)ViewBag.ID;
    var title = (id == 0) ? "Add Relationship Type" : "Edit Relationship Type";
    var description = (id == 0) ? Resources.FormInfo.Add_RelationshipType_Directions : Resources.FormInfo.Edit_RelationshipType_Directions;
}
<script id="intersectTypeTmpl" type="text/html">
    <div class="left form-header-info">
        <h4>@(title)</h4>
    </div>
    <div class="right">
        <button type="button" id="EditableFormCancelButton" data-bind="click: cancel" class="btn waves-effect waves-light brown lighten-4">Cancel</button>
        <button type="button" id="EditableFormSaveButton" data-bind="click: save, css: { disabled: TypesNotPresent }" class="btn waves-effect waves-light brown lighten-1 saveButton">Save</button>
    </div>
    <div class="clear"></div>
    <div class="form-instructions">@Html.Raw(description)</div>
    <div id="progress" data-bind="visible: InProgress"><i class="fa fa-spinner fa-spin fa-4x"></i></div>

    <div class="row">
        <div class="col s4">
            <div class="FieldNameRequired">@(Resources.FieldInfo.RelationshipSide1_Name)</div>
            <div data-bind="intersectTypeSide1FilteredDropdown, jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: true,
                 selectedIndex: Side1Index,
                 source: Side1Options,
                 disabled: LimitedChangesOnly,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase' }"></div>
            <span data-bind="visible: Side1OptionsLoading">Loading, please wait...</span>
        </div>
        <div class="col s4">
            <div class="FieldNameRequired">@(Resources.FieldInfo.RelationshipPredicate_Name)</div>
            <div data-bind="intersectTypePredicateFilteredDropdown, jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: true,
                 selectedIndex: PredicateIndex,
                 source: PredicateOptions,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase' }"></div>
            @*disabled: LimitedChangesOnly,*@

            <span data-bind="visible: PredicateOptionsLoading">Loading, please wait...</span>
        </div>
        <div class="col s4">
            <div class="FieldNameRequired">@(Resources.FieldInfo.RelationshipSide2_Name)</div>
            <div data-bind="intersectTypeSide2FilteredDropdown, jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: true,
                 selectedIndex: Side2Index,
                 source: Side2Options,
                 disabled: LimitedChangesOnly,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase' }"></div>
            <span data-bind="visible: Side2OptionsLoading">Loading, please wait...</span>
        </div>
    </div>

    @*<div class="row">
            <div class="col s6">
                <div class="FieldNameRequired">@(Resources.FieldInfo.FriendlyName_Name)</div>
                <input type="text" data-bind="jqxInput: { width: field_width, height: field_height, theme: theme, value: Side1DisplayText}" />
            </div>
            <div class="col s6">
                <div class="FieldNameRequired">@(Resources.FieldInfo.FriendlyName_Name)</div>
                <input type="text" data-bind="jqxInput: { width: field_width, height: field_height, theme: theme, value: Side2DisplayText}" />
            </div>
        </div>*@

    @*<div class="row">
            <div class="col s6">
                <div class="FieldNameRequired">Assigned Predicates</div>
                <div data-bind="predicatesFilteredDropdown, jqxDropDownList: {
                    width: field_width,
                    theme: theme,
                    filterable: true,
                    checkboxes:true,
                    source: PredicateOptions,
                    displayMember: 'title',
                    valueMember: 'value',
                    searchMode: 'containsignorecase' }"></div>
            </div>
            <div class="col s6"></div>
        </div>*@

</script>

<div class="small-overlay">
    <div class="ui segment">
        <div id="IntersectTypeFormWrapper" data-bind="template: {name: 'intersectTypeTmpl' }"></div>
    </div>
</div>

<script type="text/javascript">
    //#region Bindings

    ko.bindingHandlers.intersectTypeSide1FilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.Side1(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    ko.bindingHandlers.intersectTypePredicateFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.Predicate(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    ko.bindingHandlers.intersectTypeSide2FilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.Side2(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    //ko.bindingHandlers.intersectTypeRoleFilteredDropdown = {
    //    init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
    //        $(element).on('change', function (event) {
    //            viewModel.RoleID(event.args.item.value);
    //        });
    //    },
    //    update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    //};
    //ko.bindingHandlers.predicatesFilteredDropdown = {
    //    init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
    //        $(element).on('checkChange', function (event) {
    //            var checkedItems = $(element).jqxDropDownList('getCheckedItems');
    //            if (checkedItems) {
    //                viewModel.Predicates.removeAll();

    //                if (checkedItems.length > 0) {
    //                    $.each(checkedItems, function(cix, ci) {
    //                        viewModel.Predicates.push(ci.value);
    //                    });
    //                }
    //            }
    //        });
    //    },
    //    update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    //};

    //#endregion

    function IntersectTypeViewModel(data) {
        var self = this;
        data = data || {};

        //#region Simple Properties

        self.ID = ko.observable(data.ID);
        self.Context = ko.observable(data.Context);

        self.Side1Index = ko.observable(data.Side1Index || -1);
        self.Side1 = ko.observable(data.Side1);
        //self.Side1DisplayText = ko.observable(((data.Side1DisplayText) ? data.Side1DisplayText : ""));

        self.PredicateIndex = ko.observable(data.PredicateIndex || -1);
        self.Predicate = ko.observable(data.Predicate);

        self.Side2Index = ko.observable(data.Side2Index || -1);
        self.Side2 = ko.observable(data.Side2);
        //self.Side2DisplayText = ko.observable(((data.Side2DisplayText) ? data.Side2DisplayText : ""));

        self.LimitedChangesOnly = ko.observable(data.LimitedChangesOnly || false);
        self.InProgress = ko.observable(false);

        //#endregion

        //#region Computed Properties

        self.TypesNotPresent = ko.pureComputed(function () {
            return (self.Side1OptionsLoading().length <= 0 ||
                    self.Side2OptionsLoading().length <= 0);
        }, self);

        self.Side1OptionsLoading = ko.pureComputed(function () {
            return self.Side1Options().length == 0;
        }, self);

        self.PredicateOptionsLoading = ko.pureComputed(function () {
            return self.PredicateOptions().length == 0;
        }, self);

        self.Side2OptionsLoading = ko.pureComputed(function () {
            return self.Side2Options().length == 0;
        }, self);

        //#endregion

        //#region List Properties

        self.IntersectRoles = ko.observableArray();
        self.IntersectRoleOptions = ko.observableArray();

        self.PredicateOptions = ko.observableArray();
        self.Side1Options = ko.observableArray();
        self.Side2Options = ko.observableArray();

        //#endregion

        self.Side1.subscribe(function (value) {
            self.Side2Options.removeAll();
            if (value) {
                var values = value.split('|');
                var dataToServer;
                var side2Values;

                if (self.Side2()) {
                    side2Values = self.Side2().split('|');
                }
                if (side2Values) {
                    dataToServer = { type: values[0], id: values[1], side2Type: side2Values[0], side2ID: side2Values[1] };
                }
                else {
                    dataToServer = { type: values[0], id: values[1] };
                }

                $.getJSON(
                    '/form/IntersectType_Side2Options',
                    dataToServer,
                    function (relData) {
                        self.Side2Options(relData);

                        var indexToSelect = -1;

                        $.each(self.Side2Options(), function (ix, item) {
                            if (item.value == self.Side2()) {
                                indexToSelect = ix;
                            }
                        });
                        self.Side2Index(indexToSelect);
                    }
                );
            }
        });

        //#region Methods

        self.cancel = function () {
            amplify.publish("CancelAction", { context: self.Context() });
        };

        self.loadCurrentIntersectType = function () {
            // Step 1
            $.getJSON('/form/IntersectType_Side1Options', function (relData) {
                self.Side1Options(relData);
            }).then(function () {
                if (self.ID() > 0) {
                    // Step 2
                    $.getJSON(
                        '/form/IntersectType_FormData',
                        { id: self.ID() },
                        function (relData) {

                            //Side2 needs to be first, here.
                            self.Side2(relData.Side2);
                            self.Side1(relData.Side1);
                            self.Predicate(relData.Predicate);
                            self.LimitedChangesOnly(relData.LimitedChangesOnly);

                            var indexToSelect = -1;
                            $.each(self.Side1Options(), function (ix, item) {
                                if (item.value == relData.Side1) {
                                    indexToSelect = ix;
                                }
                            });
                            self.Side1Index(indexToSelect);
                        }
                    ).then(function(){
                        self.loadPredicates();
                    });
                }
                else {
                    self.loadPredicates();
                }
            });
        };

        self.loadPredicates = function() {
            self.PredicateOptions.removeAll();

            $.getJSON(
                '/form/IntersectType_PredicateOptions',
                { },
                function (relData) {

                    self.PredicateOptions(relData);

                    var indexToSelect = -1;
                    $.each(relData, function (ix, item) {
                        if (item.value == self.Predicate()) {
                            indexToSelect = ix;
                        }
                    });
                    self.PredicateIndex(indexToSelect);
                });
        }

        self.save = function () {
            self.InProgress(true);

            var postModel = {
                ID: self.ID(),
                Side1: self.Side1(),
                //Side1DisplayText: self.Side1DisplayText(),
                Side2: self.Side2(),
                //Side2DisplayText: self.Side2DisplayText(),
                Predicate: self.Predicate()//Predicates: self.Predicates(),
            }

            var uri = '';
            var method = '';
            if (postModel.ID == 0) {
                uri = '/form/AddIntersectType';
                method = 'POST';
            }
            else {
                uri = '/form/EditIntersectType';
                method = 'PUT';
            }

            $.ajax(uri, {
                data: postModel,
                dataType: 'json',
                method: method
            }).done(function (data, status, xhr) {
                if (data.type == "error") {
                    amplify.publish("ShowMessage", { type: data.type, title: data.title, message: data.message });
                }
                else {
                    amplify.publish("SaveAction", { context: self.Context(), action: 'add', id: 0, custom: {} });
                    amplify.publish("ShowMessage", { type: "confirm", title: data.title, message: data.message });                
                }
            }).fail(function (xhr, status, error) {
                amplify.publish("ShowMessage", { type: "error", title: "Error!", message: error });
            }).always(function (data, status, error) {
                self.InProgress(false);
            });
        };

        //#endregion

        return self;
    }

    $(function () {
        var model = new IntersectTypeViewModel({
            ID: @(ViewBag.ID),
            Context: "@(ContextList.IntersectType)"
        });
        ko.applyBindings(model, document.getElementById('IntersectTypeFormWrapper'));
        model.loadCurrentIntersectType();

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
