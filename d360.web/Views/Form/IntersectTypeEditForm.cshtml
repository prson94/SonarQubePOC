@{ 
    var id = (int)ViewBag.ID;
    var title = (id == 0) ? "Add Relationships Type" : "Edit Relationship Type";
    var description = (id == 0) ?  Resources.FormInfo.Add_RelationshipType_Directions : Resources.FormInfo.Edit_RelationshipType_Directions;
}
<script id="intersectTypeRoleTmpl" type="text/html">
    <tr style="margin-bottom: 10px">
        <td style="vertical-align: top">
            <div>
                <div data-bind="intersectTypeRoleFilteredDropdown, jqxDropDownList: {
                 width: field_width98,
                 dropDownWidth: 600,
                 theme: theme,
                 filterable: true,
                 source: $parent.RoleOptions,
                 selectedIndex: RoleIndex,
                 displayMember: 'Name',
                 valueMember: 'ID',
                 searchMode: 'containsignorecase'
                 }"></div>
            </div>
            <div>
                <input type="text" data-bind="jqxInput: { width: field_width98, height: field_height, theme: theme, placeHolder: 'Or add new role', value: NewRoleName}" />
            </div>
        </td>
        <td style="vertical-align: top">
            <input type="text" data-bind="jqxInput: { width: field_width98, height: field_height, theme: theme, value: Side1Label}" />
        </td>
        <td style="vertical-align: top">
            <input type="text" data-bind="jqxInput: { width: field_width98, height: field_height, theme: theme, value: Side2Label}" />
        </td>
        <td style="width: 20px; text-align: right; vertical-align: top">
            <a style="padding: 0 .5rem;" class="waves-effect waves-teal btn-flat" title="Remove this role" data-bind="click:$parent.deleteRole"><i class="fa fa-trash"></i></a>
        </td>
    </tr>
</script>

<script id="intersectTypeTmpl" type="text/html">
    <div class="left form-header-info">
        <h4>@(title)</h4>
    </div>
    <div class="right">
        <button type="button" id="EditableFormCancelButton" data-bind="click: cancel" class="btn waves-effect waves-light brown lighten-4">Cancel</button>
        <button type="button" id="EditableFormSaveButton" data-bind="click: save, css: { disabled: TypesNotPresent }" class="btn waves-effect waves-light brown lighten-1 saveButton">Save</button>
    </div>
    <div class="clear"></div>
    <div class="form-instructions">@Html.Raw(description)</div>
    <div id="progress" data-bind="visible: InProgress"><i class="fa fa-spinner fa-spin fa-4x"></i></div>

    <div class="row">
        <div class="col s6">
            <div class="FieldNameRequired">@(Resources.FieldInfo.RelationshipSide1_Name)</div>
            <div data-bind="intersectTypeSide1FilteredDropdown, jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: true,
                 selectedIndex: Side1Index,
                 source: Side1Options,
                 disabled: LimitedChangesOnly,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase' }"></div>
            <span data-bind="visible: Side1OptionsLoading">Loading, please wait...</span>
        </div>
        <div class="col s6">
            <div class="FieldNameRequired">@(Resources.FieldInfo.RelationshipSide2_Name)</div>
            <div data-bind="intersectTypeSide2FilteredDropdown, jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: true,
                 selectedIndex: Side2Index,
                 source: Side2Options,
                 disabled: LimitedChangesOnly,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase' }"></div>
            <span data-bind="visible: Side2OptionsLoading">Loading, please wait...</span>
        </div>
    </div>

    <div class="row">
        <div class="col s6">
            <div class="FieldNameRequired">@(Resources.FieldInfo.FriendlyName_Name)</div>
            <input type="text" data-bind="jqxInput: { width: field_width, height: field_height, theme: theme, value: Side1DisplayText}" />
        </div>
        <div class="col s6">
            <div class="FieldNameRequired">@(Resources.FieldInfo.FriendlyName_Name)</div>
            <input type="text" data-bind="jqxInput: { width: field_width, height: field_height, theme: theme, value: Side2DisplayText}" />
        </div>
    </div>

    <div class="row" style="display:none">
        <div class="col s12">
            <div class="tile root-tile">
                <header>
                    Available Roles
                    <div class="TileTools">
                        <button type="button" alt="Add role" data-bind="click:addRole" class="btn-floating waves-effect waves-light brown lighten-1"><i class="fa fa-plus"></i></button>
                    </div>
                </header>
                <table class="responsive-table">
                    <thead>
                        <tr>
                            <th>Role</th>
                            <th>Side 1 Label</th>
                            <th>Side 2 Label</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody data-bind="template: {name: 'intersectTypeRoleTmpl', foreach: Roles }"></tbody>
                </table>
            </div>
        </div>
    </div>
</script>

<div class="small-overlay">
    <div class="ui segment">
        <div id="IntersectTypeFormWrapper" data-bind="template: {name: 'intersectTypeTmpl' }"></div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        var model = new IntersectTypeViewModel({
            ID: @(ViewBag.ID),
            Context: "@(ContextList.IntersectType)"
        });
        ko.applyBindings(model, document.getElementById('IntersectTypeFormWrapper'));
        model.loadCurrentIntersectType();

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
