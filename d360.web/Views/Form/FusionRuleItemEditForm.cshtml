@model d360.web.Models.FusionRuleItemEditorModel
@Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = ContextList.FusionPromotionRuleItem, Description = "Select a level in the grid below to target all child items for promotion.  These targeted items will then be promoted to the selected business-level type.", Name = Model.FormName })
<div class="small-overlay">
    @using (Ajax.BeginForm(new AjaxOptions { HttpMethod = Model.FormMethod, Url = Model.FormUri, OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
    {
        <input type="hidden" id="ID" name="ID" value="@(Model.Item.ID)" />
        <input type="hidden" id="RuleID" name="RuleID" value="@(Model.Item.RuleID)" />
        <input type="hidden" id="FusionAttributeID" name="FusionAttributeID" />
        <div class="row">
            <div class="col s10">
                <div id='SourceTip' class="FieldNameRequired">Filter Level</div>
                <div id="FilterNodeGrid"></div>
            </div>
            <div class="col s2">
                <div class="input-field">
                    <input type="checkbox" id="AllSelected" name="AllSelected" />
                    <label for="AllSelected">Select All?</label>
                </div>
            </div>
        </div>
    }
</div>


<script type="text/javascript">
    var fusionID = "@(Model.FusionID)";
    var targetFusionAttributeTypeID = "@(Model.TargetFusionAttributeTypeID)";
    var ruleID = "@(Model.Item.RuleID)";
    var checkedIDs = [];
    var concatenateCheckedIDs = function () {
        var concatenatedValue = '';
        $.each(checkedIDs, function (ix, item) {
            concatenatedValue += ((concatenatedValue == '') ? '' : ',') + item;
        });
        return concatenatedValue;
    }

    var uncheckAndDisableRow = function (parentRow) {
        if (parentRow.records) {
            $.each(parentRow.records, function () {
                var thisRow = $('#FilterNodeGrid').jqxTreeGrid('getRow', this.uid);
                uncheckAndDisableRow(thisRow);
                $("#FilterNodeGrid").jqxTreeGrid('uncheckRow', this.uid);
                $("#FilterNodeGrid").jqxTreeGrid('lockRow', this.uid);
            });
        }
    }

    var enableRow = function (parentRow) {
        if (parentRow.records) {
            $.each(parentRow.records, function () {
                var thisRow = $('#FilterNodeGrid').jqxTreeGrid('getRow', this.uid);
                enableRow(thisRow);
                $("#FilterNodeGrid").jqxTreeGrid('unlockRow', this.uid);
            });
        }
    }

    var removeFromArray = function (arr, valueToRemove) {
        var ax;
        while ((ax = arr.indexOf(valueToRemove)) !== -1) {
            arr.splice(ax, 1);
        }
        return arr;
    };

    $(function () {

        //#region Grid

        var source =
               {
                   dataType: "json",
                   dataFields: [
                       { name: 'ID', type: 'number' },
                       { name: 'ParentID', type: 'number' },
                       { name: 'FusionAttributeTypeID', type: 'number' },
                       { name: 'Name', type: 'string' }
                   ],
                   hierarchy:
                   {
                       keyDataField: { name: 'ID' },
                       parentDataField: { name: 'ParentID' }
                   },
                   id: 'ID',
                   //root: 'value',
                   url: "/api/fusion/promotion/ChildAttributeNodes?fusionID=" + fusionID + "&targetFusionAttributeTypeID=" + targetFusionAttributeTypeID + "&ruleID=" + ruleID
               };
        // create Tree Grid
        $("#FilterNodeGrid").jqxTreeGrid(
        {
            theme: theme,
            height: 400,
            filterable: true,
            selectionMode: "custom",//"singleRow",
            checkboxes: true,
            virtualModeCreateRecords: function (expandedRecord, done) {
                var dataAdapter = new $.jqx.dataAdapter(source,
                    {
                        formatData: function (data) {
                            if (expandedRecord != null) {
                                data.currentFusionAttributeTypeID = expandedRecord.FusionAttributeTypeID;
                                data.fusionAttributeID = expandedRecord.ID;
                            }
                            return data;
                        },
                        loadComplete: function () {
                            done(dataAdapter.records);
                        },
                        loadError: function (xhr, status, error) {
                            done(false);
                            throw new Error(error.toString());
                        }
                    }
                );
                dataAdapter.dataBind();
            },
            virtualModeRecordCreating: function (record) {
                // record is creating.
            },
            columns: [
              { text: 'Name', dataField: 'Name' }
            ]
        });

        //#endregion

        $('#FilterNodeGrid').on('rowCheck', function (event) {
            var args = event.args;
            var row = args.row;
            var key = args.key;

            checkedIDs.push(key);
            $('#FusionAttributeID').val(concatenateCheckedIDs());
            //console.log(concatenateCheckedIDs());
            //var thisRow = $('#FilterNodeGrid').jqxTreeGrid('getRow', key);
            //uncheckAndDisableRow(thisRow);
        });

        $('#FilterNodeGrid').on('rowUncheck', function (event) {
            var args = event.args;
            var row = args.row;
            var key = args.key;
            //var thisRow = $('#FilterNodeGrid').jqxTreeGrid('getRow', key);
            //enableRow(thisRow);

            checkedIDs = removeFromArray(checkedIDs, key);
            //checkedIDs.remove(key);
            $('#FusionAttributeID').val(concatenateCheckedIDs());
            console.log(concatenateCheckedIDs());
        });

        //$('#FilterNodeGrid').on('rowSelect', function (event) {
        //    var row = event.args.row;
        //    $('#FusionAttributeID').val(row.ID);
        //});

        $('#AllSelected').on('change', function () {
            if (this.checked) {
                $('#FilterNodeGrid').jqxTreeGrid('clearSelection');
                $('#FusionAttributeID').val('');
            }

            $('#FilterNodeGrid').jqxTreeGrid({ disabled: this.checked });
        });

        $('#EditableFormSaveButton').on('click', function () {
            $('#form0').submit();
        });

        $('#EditableFormCancelButton').on('click', function () {
            amplify.publish("CancelAction", { context: $('#EditableFormCancelButton').data('context') });
        });
        amplify.subscribe("ErrorOccurredAction", function (data) {
            $('#EditableFormSaveButton').hide();
        });
        amplify.subscribe("StartingAjax", function () {
            $('#progress').html(progressIndicatorHtml);
        });
        amplify.subscribe("EndingAjax", function () {
            $('#progress').html('');
        });
        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
