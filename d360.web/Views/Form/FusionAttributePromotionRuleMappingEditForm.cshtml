@model d360.web.Models.FusionPromotionRuleMappingEditorModel
@Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = ContextList.FusionPromotionRuleMapping, Description = "By assigning a field mapping you are promoting any selected fusion objects to become a business-level item, allowing you to then associated attributes and establish other relationships to the promoted item.", Name = Model.FormName })
@using (Ajax.BeginForm(new AjaxOptions { HttpMethod = Model.FormMethod, Url = Model.FormUri, OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
{
    <input type="hidden" id="ID" name="ID" value="@(Model.Item.ID)" />
    <input type="hidden" id="FusionAttributePromotionRuleID" name="FusionAttributePromotionRuleID" value="@(Model.Item.FusionAttributePromotionRuleID)" />
    <div class="row">
        <div class="col s12 m12 l6">
            <div id='SourceTip' class="FieldNameRequired">Source</div>
            <div id="PrOptionsDropdown"></div>
            @Html.DropDownList("Source", Model.SourceFields, new { @class = "browser-default" })
        </div>
        <div class="col s12 m12 l6">
            <div id='TargetTip' class="FieldNameRequired">Target</div>
            @Html.DropDownList("Target", Model.TargetFields, new { @class = "browser-default" })
        </div>
    </div>
}

<script type="text/javascript">
    $(function () {

        //#region Options

        $("#Source").jqxDropDownList({ theme: theme, width: field_width, height: field_height });
        $("#Target").jqxDropDownList({ theme: theme, width: field_width, height: field_height });

        //#endregion

        //#region Tooltips

        tipCss = 'qtip-blue qtip-shadow';
        $('#SourceTip').qtip({
            content: {
                text: "The name of the field to source data from."
            },
            style: {
                classes: tipCss
            }
        });

        $('#TargetTip').qtip({
            content: {
                text: "The name of the field to load source data into."
            },
            style: {
                classes: tipCss
            }
        });

        //#endregion

        $('#EditableFormSaveButton').on('click', function () {
            $('#form0').submit();
        });
        $('#EditableFormCancelButton').on('click', function () {
            amplify.publish("CancelAction", { context: $('#EditableFormCancelButton').data('context') });
        });
        amplify.subscribe("ErrorOccurredAction", function (data) {
            $('#EditableFormSaveButton').hide();
        });
        amplify.subscribe("StartingAjax", function () {
            $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');
        });
        amplify.subscribe("EndingAjax", function () {
            $('#progress').html('');
        });

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
