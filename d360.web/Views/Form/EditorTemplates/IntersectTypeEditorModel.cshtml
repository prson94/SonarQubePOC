@model d360.web.Models.IntersectTypeEditorModel
@Html.HiddenFor(m => m.ID)
@Html.HiddenFor(m => m.Side1ID)
@Html.HiddenFor(m => m.Side2ID)
<div class="row">
    <div class="col s6">
        <div class="FieldNameRequired">@(Resources.FieldInfo.RelationshipSide1_Name)</div>
       @Html.DropDownList("Side1", Model.Side1Options, "Choose a starting node type...", new { @class = "browser-default" })
    </div>
    <div class="col s6">
        <label class="FieldNameRequired">@(Resources.FieldInfo.RelationshipSide2_Name)</label>
        @Html.DropDownList("Side2", Model.Side2Options, "Choose an ending node type...", new { @class = "browser-default" })
    </div>
</div>
<div class="row">
    <div class="col s6">
        <label class="FieldName" @((string.IsNullOrEmpty(Model.Side1DisplayText)) ? "" : "class=active")>@(Resources.FieldInfo.FriendlyName_Name)</label>
        @Html.TextBoxFor(m => m.Side1DisplayText)
    </div>
    <div class="col s6">
        <label class="FieldName" @((string.IsNullOrEmpty(Model.Side2DisplayText)) ? "" : "class=active")>@(Resources.FieldInfo.FriendlyName_Name)</label>
        @Html.TextBoxFor(m => m.Side2DisplayText)
    </div>
</div>


<script type="text/javascript">
    $(function () {

        $("#Side1").jqxDropDownList({ width: field_width, theme: theme });
        $("#Side2").jqxDropDownList({ width: field_width, theme: theme });
        $("#Side1DisplayText").jqxInput({ width: field_width, theme: theme, height: 25 });
        $("#Side2DisplayText").jqxInput({ width: field_width, theme: theme, height: 25 });

        //#region Form Processing

        //$('#form0').jqxValidator({
        //    hintType: 'label',
        //    rules: [
        //        {
        //            input: "#Name",
        //            rule: 'required',
        //            action: 'blur',
        //            message: 'Name is required.'
        //        }
        //    ]
        //});

        //$('#form0').on('validationSuccess', function (event) {
        //    // You can submit the form.
        //    $('#form0').submit();
        //});

        $('#EditableFormSaveButton').on('click', function () {
            $('#form0').submit();
            //$('#form0').jqxValidator('validate');
        });

        $('#EditableFormCancelButton').on('click', function () {
            amplify.publish("CancelAction", { context: $('#EditableFormCancelButton').data('context') });
        });

        //#endregion

    });
</script>