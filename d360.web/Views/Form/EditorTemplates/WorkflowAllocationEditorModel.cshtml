@model d360.web.Models.WorkflowAllocationEditorModel
@{
    var daySelectedValue = "";
    if (Model.Properties.ContainsKey("DayForScheduleCalculation"))
    {
        daySelectedValue = Model.Properties["DayForScheduleCalculation"];
    }
    var monthSelectedValue = "";
    if (Model.Properties.ContainsKey("MonthForScheduleCalculation"))
    {
        monthSelectedValue = Model.Properties["MonthForScheduleCalculation"];
    }
    var months = new List<SelectListItem>();
    months.Add(new SelectListItem { Text = "Jan", Value = "1", Selected = (monthSelectedValue == "1") });
    months.Add(new SelectListItem { Text = "Feb", Value = "2", Selected = (monthSelectedValue == "2") });
    months.Add(new SelectListItem { Text = "Mar", Value = "3", Selected = (monthSelectedValue == "3") });
    months.Add(new SelectListItem { Text = "Apr", Value = "4", Selected = (monthSelectedValue == "4") });
    months.Add(new SelectListItem { Text = "May", Value = "5", Selected = (monthSelectedValue == "5") });
    months.Add(new SelectListItem { Text = "Jun", Value = "6", Selected = (monthSelectedValue == "6") });
    months.Add(new SelectListItem { Text = "Jul", Value = "7", Selected = (monthSelectedValue == "7") });
    months.Add(new SelectListItem { Text = "Aug", Value = "8", Selected = (monthSelectedValue == "8") });
    months.Add(new SelectListItem { Text = "Sep", Value = "9", Selected = (monthSelectedValue == "9") });
    months.Add(new SelectListItem { Text = "Oct", Value = "10", Selected = (monthSelectedValue == "10") });
    months.Add(new SelectListItem { Text = "Nov", Value = "11", Selected = (monthSelectedValue == "11") });
    months.Add(new SelectListItem { Text = "Dec", Value = "12", Selected = (monthSelectedValue == "12") });

}
<input type="hidden" id="_context" name="_context" value="WorkflowTypeRelation" />
<input type="hidden" id="WorkflowType" name="WorkflowType" value="@(Model.WorkflowType)" />
<input type="hidden" id="ObjectType" name="ObjectType" value="@(Model.ObjectType)" />
<input type="hidden" id="ObjectID" name="ObjectID" value="@(Model.ObjectID)" />
<div class="row">
    <div class="col l6 m6">
        <label>Responsibilities</label>
        @Html.ListBox("Responsibilities", Model.Responsibilities)
    </div>
    <div class="col l3 m3">
        <label>Enabled?</label>
        @Html.CheckBoxFor(m => m.Enabled)
    </div>
    <div class="col l3 m3">
        <label>Required?</label>
        @Html.CheckBoxFor(m => m.Required)
    </div>
</div>
<div class="row">
    <div class="col l6 m6">
        @{
            switch (Model.WorkflowType)
            {
                case d360.workflow.WorkflowType.CertifyArtifact:
                    <label>Date for Scheduling Calculation</label>
                    @Html.DropDownList("MonthForScheduleCalculation", months)
                    @Html.TextBox("DayForScheduleCalculation", daySelectedValue)
                    break;
                case d360.workflow.WorkflowType.SuggestNewArtifact:
                    break;
            }
        }
    </div>
    <div class="col l6 m6">
        @{
            switch (Model.WorkflowType)
            {
                case d360.workflow.WorkflowType.CertifyArtifact:
                    break;
                case d360.workflow.WorkflowType.SuggestNewArtifact:
                    break;
            }
        }
    </div>
</div>

<script type="text/javascript">
    $(function () {
        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>