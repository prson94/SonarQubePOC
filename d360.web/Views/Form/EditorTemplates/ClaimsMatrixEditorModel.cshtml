@using d360.core.enums;
@model d360.web.Models.ClaimsMatrixEditorModel
@Html.Hidden("_context", ContextList.ResponsibilityTypeObjectClaim.ToString())
<table class="ui segment definition table">
    <thead>
        <tr>
            <th></th>
            <th style="width: 15%">@ClaimObject.Root.ToString()</th>
            <th style="width: 15%">@ClaimObject.Attribute.ToString()</th>
            <th style="width: 15%">@ClaimObject.Governance.ToString()</th>
            <th style="width: 15%">@ClaimObject.Relationship.ToString()</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Claim.Read.ToString()</td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Root, (int)Claim.Read))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Root, (int)Claim.Read))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Root, (int)Claim.Read))"></label></td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Attribute, (int)Claim.Read))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Attribute, (int)Claim.Read))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Attribute, (int)Claim.Read))"></label></td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Governance, (int)Claim.Read))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Governance, (int)Claim.Read))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Governance, (int)Claim.Read))"></label></td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Relationship, (int)Claim.Read))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Relationship, (int)Claim.Read))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Relationship, (int)Claim.Read))"></label></td>
        </tr>
        <tr>
            <td>@Claim.Create.ToString()</td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Root, (int)Claim.Create))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Root, (int)Claim.Create))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Root, (int)Claim.Create))"></label></td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Attribute, (int)Claim.Create))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Attribute, (int)Claim.Create))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Attribute, (int)Claim.Create))"></label></td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Governance, (int)Claim.Create))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Governance, (int)Claim.Create))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Governance, (int)Claim.Create))"></label></td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Relationship, (int)Claim.Create))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Relationship, (int)Claim.Create))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Relationship, (int)Claim.Create))"></label></td>
        </tr>
        <tr>
            <td>@Claim.Update.ToString()</td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Root, (int)Claim.Update))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Root, (int)Claim.Update))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Root, (int)Claim.Update))"></label></td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Attribute, (int)Claim.Update))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Attribute, (int)Claim.Update))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Attribute, (int)Claim.Update))"></label></td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Governance, (int)Claim.Update))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Governance, (int)Claim.Update))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Governance, (int)Claim.Update))"></label></td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Relationship, (int)Claim.Update))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Relationship, (int)Claim.Update))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Relationship, (int)Claim.Update))"></label></td>
        </tr>
        <tr>
            <td>@Claim.Delete.ToString()</td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Root, (int)Claim.Delete))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Root, (int)Claim.Delete))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Root, (int)Claim.Delete))"></label></td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Attribute, (int)Claim.Delete))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Attribute, (int)Claim.Delete))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Attribute, (int)Claim.Delete))"></label></td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Governance, (int)Claim.Delete))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Governance, (int)Claim.Delete))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Governance, (int)Claim.Delete))"></label></td>
            <td><input type="checkbox" id="@(string.Format("{0}_{1}", (int)ClaimObject.Relationship, (int)Claim.Delete))" name="@(string.Format("{0}_{1}", (int)ClaimObject.Relationship, (int)Claim.Delete))" /><label for="@(string.Format("{0}_{1}", (int)ClaimObject.Relationship, (int)Claim.Delete))"></label></td>
        </tr>
    </tbody>
</table>
<script type="text/javascript">
    $(function () {
        @{
            foreach (var i in Model.Items)
            {
                <text>$('#@((int)i.ClaimObject)_@((int)i.Claim)').prop('checked', 'checked');</text>
            }
        }
        });
</script>
