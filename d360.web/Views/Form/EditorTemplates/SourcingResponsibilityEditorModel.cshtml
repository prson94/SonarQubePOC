@using d360.core.resources
@model d360.web.Models.SourcingResponsibilityEditorModel

<input type="hidden" id="_context" name="_context" value="@(ContextList.ActionResponsibility)" />
@Html.HiddenFor(i => i.ResponsibilityTypeID)
@Html.HiddenFor(i => i.ObjectType)
@Html.HiddenFor(i => i.ObjectID)

<div class="ui form">
    <div class="two fields">
        <div class="field">
            <label><span id='ArtifactTip'>Artifact to Source From</span></label>
            <div class="ui labeled input">
                <div id="Artifact"></div>
                <div class="ui corner label">
                    <i class="icon asterisk"></i>
                </div>
            </div>
        </div>
        <div class="fields">
            <label><span id='ContextTip'>Contexts</span></label>
            <div class="ui labeled input">
                <div id="Context"></div>
                <div class="ui corner label">
                    <i class="icon asterisk"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var ArtifactSourceSelectedIndex = -1;

    @{
        for (var i = 0; i < Model.Artifacts.Count; i++)
        {
            if (Model.Artifacts[i].Selected) { <text>ArtifactSourceSelectedIndex = @(i)</text><text>;</text> }
        }
    }

    var Artifacts = [
    @{
        for (var i = 0; i < Model.Artifacts.Count; i++)
        {
            if(i > 0) {<text>,</text>} <text>{ label: "@(Model.Artifacts[i].Text)", value: @(Model.Artifacts[i].Value), checked: @(Model.Artifacts[i].Selected ? "true" : "false") }</text>
        }
    }
    ];

    var ContextSource = [
        @{for (var i = 0; i < Model.Contexts.Count; i++)
    {
        if(i > 0) {<text>,</text>} <text>{ label: "@(Model.Contexts[i].Text)", value: @(Model.Contexts[i].Value), checked: @(Model.Contexts[i].Selected ? "true" : "false"), group: "@(Model.Contexts[i].Group)" }</text>
        }
    }
    ];

    $(function () {
        $('#form0').jqxValidator({
            hintType: 'label',
            rules: [
                //{
                //    input: "#Name",
                //    rule: 'required',
                //    action: 'blur',
                //    message: 'Name is required.'
                //}
            ]
        });

        var ArtifactSource =
                {
                    datatype: "json",
                    datafields: [
                        { name: 'value' },
                        { name: 'label' },
                        { name: 'checked' }
                    ],
                    localdata: Artifacts
                };
        var ArtifactAdapter = new $.jqx.dataAdapter(ArtifactSource);

        $("#Artifact").jqxComboBox({ theme: theme, source: ArtifactAdapter, width: '98%', selectedIndex: ArtifactSourceSelectedIndex, valueMember: 'value', displayMember: 'label' });
        $("#Context").jqxComboBox({ theme: theme, checkboxes: true, source: ContextSource, width: '98%' });


        $('#ArtifactTip').qtip({
            content: {
                text: "@(d360.core.resources.Fields.Description_Description)",
                position: {
                    my: 'top right',  // Position my top left...
                    at: 'bottom left', // at the bottom right of...
                    target: $('#Artifact') // my target
                }
            },
            style: {
                classes: 'qtip-blue qtip-shadow'
            }
        });

        $('#ContextTip').qtip({
            content: {
                text: "@(d360.core.resources.Fields.Description_Description)",
                position: {
                    my: 'top right',  // Position my top left...
                    at: 'bottom left', // at the bottom right of...
                    target: $('#Context') // my target
                }
            },
            style: {
                classes: 'qtip-blue qtip-shadow'
            }
        });

        $('#form0').on('validationSuccess', function (event) {
            // You can submit the form.
            $('#form0').submit();
        });
        $('#EditableFormSaveButton').on('click', function () {
            $('#form0').jqxValidator('validate');
        });

        $('#EditableFormCancelButton').on('click', function () {
            amplify.publish("CancelAction", { context: '@(ContextList.ActionResponsibility)' });
        });
        amplify.subscribe("ErrorOccurredAction", function (data) {
            $('#EditableFormSaveButton').hide();
        });
        amplify.subscribe("StartingAjax", function () {
            $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');
        });
        amplify.subscribe("EndingAjax", function () {
            $('#progress').html('');
        });

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
