@using d360.web.Models;
@model FieldTypeEditorModel

<div class="medium-overlay">
    <div class="ui segment">
        @Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = ContextList.FieldType, Description = "Modify your field using the form below.  There are many types of fields from Simple Text and HTML to Lookups and Dates.", Name = Model.FormName })
        @using (Ajax.BeginForm(new AjaxOptions { HttpMethod = Model.FormMethod, Url = Model.FormUri, OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
        {
            <input type="hidden" id="_context" name="_context" value="@(ContextList.FieldType)" />
            <input type="hidden" id="ID" name="ID" value="@(Model.FieldType.ID)" />
            <input type="hidden" id="Object" name="Object" value="@(Model.FieldType.Object)" />
            <input type="hidden" id="ObjectID" name="ObjectID" value="@(Model.FieldType.ObjectID)" />

            <div class="row">
                <div class="col s6">
                    <div id='FriendlyNameTip' class="FieldNameRequired">@(Resources.FieldInfo.Name_Name)</div>
                    <input id="FriendlyName" name="FriendlyName" type="text" value="@(Model.FieldType.FriendlyName)" />
                </div>
                <div class="col s6">
                    <div id='NameTip' class="FieldNameRequired">@(Resources.FieldInfo.ApiName_Name)</div>
                    <input id="Name" name="Name" type="text" value="@(Model.FieldType.Name)" />
                </div>
            </div>

            <div class="row">
                <div class="col s6">
                    <div id='TypeTip' class="FieldNameRequired">@(Resources.FieldInfo.InputType_Name)</div>
                    @Html.DropDownList("Type", Model.DataTypes, new { @class = "browser-default" })
                </div>
                <div class="col s3 input-field">
                    <div id='IsListableTip' class="FieldName">@(Resources.FieldInfo.FilterEnabled_Name)</div>
                    <input id="IsListable" name="IsListable" type="checkbox" value="@(Model.FieldType.IsListable)" @(Model.FieldType.IsListable ? "checked='checked'" : "") />
                </div>
                <div class="col s3 input-field">
                    <div id='IsRequiredTip' class="FieldName">@(Resources.FieldInfo.Required_Name)</div>
                    <input id="IsRequired" name="IsRequired" type="checkbox" value="@(Model.FieldType.IsRequired)" @(Model.FieldType.IsRequired ? "checked='checked'" : "") />
                </div>
            </div>
            <div class="row LookupSection">
                <div class="col s6">
                    <div id='LookupObjectTip' class="FieldNameRequired">@(Resources.FieldInfo.ListType_Name)</div>
                    @Html.DropDownList("LookupObject", Model.LookupLists, new { @class = "browser-default" })
                </div>
                <div class="col s3">
                    <div id='LookupDisplayFormatTip' class="FieldNameRequired">@(Resources.FieldInfo.ListDisplayFormat_Name)</div>
                    <input id="LookupDisplayFormat" name="LookupDisplayFormat" type="text" value="@(Model.FieldType.LookupDisplayFormat)" />
                </div>
                <div class="col s3">
                    <div class="FieldName">&nbsp;</div>
                    <select id="Tokens" class="browser-default">
                        <option value="" disabled selected>Select token</option>
                    </select>
                </div>
            </div>
            <div class="row ValidationSection">
                <div class="col s3">
                    <div id='PatternTip' class="FieldName">@(Resources.FieldInfo.Pattern_Name)</div>
                    <input id="Pattern" name="Pattern" type="text" value="@(string.IsNullOrEmpty(Model.FieldType.Pattern) ? "" : Model.FieldType.Pattern.Replace(@"\\", @"\"))" />
                </div>
                <div class="col s3">
                    <div class="FieldName">&nbsp;</div>
                    <select id="CommonPatterns" class="browser-default">
                        <option value="">Choose sample...</option>
                        <option value="@(@"\b([A-Za-z0-9_\.-]+)@([\dA-Za-z\.-]+)\.([A-Za-z\.]{2,6})\b")">Email</option>
                        <option value="\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\b"> IP Address</option>
                        <option value="\b\d{3}[-.]?\d{3}[-.]?\d{4}\b">North American Phone</option>
                        <option value="\b\d+(\.\d{1,10})?\b">Numbers Only</option>
                        <option value="(\\{2})([\da-z\.-]+)(\\)([\w \.-]+)">Unc/Network Path</option>
                        <option value="\b(https?:\/\/)?([\da-z\.-]+)([\/\w \.-]*)*\/?\b">Internal Url</option>
                        <option value="\b(https?:\/\/)?([\da-z\.-]+)\.([a-z\.]{2,6})([\/\w \.-]*)*\/?\b">Public Url</option>
                        <option value="\b[0-9]{5}(?:-[0-9]{4})?\b">US Zip Code</option>
                    </select>
                </div>
                <div class="col s3">
                    <div id='MinimumLengthTip' class="FieldName">@(Resources.FieldInfo.MinimumLength_Name)</div>
                    <div id="MinimumLength" name="MinimumLength"></div>
                </div>
                <div class="col s3">
                    <div id='MaximumLengthTip' class="FieldName">@(Resources.FieldInfo.MaximumLength_Name)</div>
                    <div id="MaximumLength" name="MaximumLength"></div>
                </div>
            </div>
            <div id="PatternValidationSection" class="row ValidationSection">
                <div class="col s3">
                    <div class="FieldNameRequired">@(Resources.FieldInfo.TestPattern_Name)</div>
                    <input id="PatternValidationText" type="text" />
                </div>
                <div class="col s3">
                    <div for="FieldNameRequired">&nbsp;</div>
                    <div id="PatternValidationLabel"></div>
                </div>
                <div class="col s12">
                    <div id='ValidationDescriptionTip' class="FieldName">@(Resources.FieldInfo.ValidationDescription_Name)</div>
                    <textarea id="ValidationDescription" name="ValidationDescription" class="htmlArea">@Html.Raw(Model.FieldType.ValidationDescription)</textarea>
                </div>
            </div>
            <div id="FusionLookupSection" class="row FusionLookupSection">
                <div class="row">
                    <div class="col s6">
                        <div class="FieldNameRequired">For</div>
                        @Html.DropDownList("FromFusionAttributeTypeID", Model.FromFusionAttributeTypeList, new { @class = "browser-default" })
                    </div>
                    <div class="col s6">
                        <div class="FieldNameRequired">Display</div>
                        @Html.DropDownList("ToFusionAttributeTypeID", Model.ToFusionAttributeTypeList, new { @class = "browser-default" })
                    </div>
                </div>
                <div class="row">
                    <div class="col s6">
                        <div class="FieldNameRequired">Show</div>
                        @Html.DropDownList("FusionShow", Model.FusionDisplayList, new { @class = "browser-default" })
                    </div>                    
                    <div class="col s6 input-field">
                        <div class="FieldName">Show Parent Child</div>
                        <input id="IsParentChildRel" name="IsParentChildRel" type="checkbox" value="@(Model.IsParentChildRel)" @(Model.IsParentChildRel ? "checked='checked'" : "") />
                    </div>
                </div>                
            </div>
            <div class="row">
                <div class="col s6">
                    <div id='DisplayDescriptionTip' class="FieldName">@(Resources.FieldInfo.DisplayDescription_Name)</div>
                    <textarea id="DisplayDescription" name="DisplayDescription" class="htmlArea">@Html.Raw(Model.FieldType.DisplayDescription)</textarea>
                </div>
                <div class="col s6">
                    <div id='FormDescriptionTip' class="FieldName">@(Resources.FieldInfo.FormDescription_Name)</div>
                    <textarea id="FormDescription" name="FormDescription" class="htmlArea">@Html.Raw(Model.FieldType.FormDescription)</textarea>
                </div>
            </div>
        }

    </div>
</div>

<script type="text/javascript">
    var used = @(Model.FieldIsUsed ? "true" : "false");

    $(function () {
        var w = '100%',
            h = 25;

        var switchControlsBasedOnType = function(value){
            switch (value) {
                case 'Text':
                    $('.ValidationSection').fadeIn(100);
                    $('.LookupSection').fadeOut(100);
                    if ($('#Pattern').val() == '') {
                        $('#PatternValidationSection').hide();
                    }
                    else {
                        $('#PatternValidationSection').show();
                    }
                    $('.FusionLookupSection').fadeOut(100);
                    $('#IsListable').removeAttr("disabled");
                    break;
                case 'Lookup':
                    $('.ValidationSection').fadeOut(100);
                    $('.LookupSection').fadeIn(100);
                    $('.FusionLookupSection').fadeOut(100);
                    $('#IsListable').removeAttr("disabled");
                    break;
                case 'FusionLookup':
                    $('.FusionLookupSection').fadeIn(100);
                    $('.ValidationSection').fadeOut(100);
                    $('.LookupSection').fadeOut(100);
                    $('#IsListable').attr("disabled", true).attr('checked', false);
                    break;
                default:
                    $('.ValidationSection').fadeOut(100);
                    $('.LookupSection').fadeOut(100);
                    $('.FusionLookupSection').fadeOut(100);
                    $('#IsListable').removeAttr("disabled");
                    break;
            }
        }

        var switchTokensBasedOnLookup = function() {
            try {
                var textValue = $('#LookupObject').val();
                if (textValue != '') {
                    var values = textValue.split('|');
                    if (values.length == 2) {
                        var t = values[0];
                        var i = values[1];
                        if (t != "DomainItem") t += 'Type';
                        $.getJSON("/api/" + t + "/" + i + "/fields", function(tokenData) {
                            var tokensDdl = $('#Tokens');
                            //tokensDdl.html('');
                            //tokensDdl.append('<option value="" disabled selected>Select token</option>');
                            tokensDdl.jqxDropDownList('clear');
                            $.each(tokenData, function(){
                                tokensDdl.jqxDropDownList('addItem', { label: this.Text, value: this.Value });
                                //tokensDdl.append('<option value="' + this.Value + '">' + this.Text + '</option>');
                            });
                        })
                    }
                }
            } catch (e) {
                console.log(e);
            }
        }

        //#region Control Instantiation

        $("#Name").jqxInput({ width: field_width, theme: theme, height: h });
        $("#FriendlyName").jqxInput({ width: field_width, theme: theme, height: h });
        $("#Type").jqxDropDownList({ width: field_width, theme: theme });
        $("#LookupObject").jqxDropDownList({ width: field_width, theme: theme, filterable:true, searchMode: 'containsignorecase' });
        $("#LookupDisplayFormat").jqxInput({ width: field_width, theme: theme, height: h });
        $("#Tokens").jqxDropDownList({ width: field_width, theme: theme });
        $("#Pattern").jqxInput({ width: field_width, theme: theme, height: h });
        $("#CommonPatterns").jqxDropDownList({ width: field_width, theme: theme });
        $("#MinimumLength").jqxNumberInput({ width: field_width, height: h, min: 0, max: 100, decimalDigits: 0, inputMode: 'simple', spinButtons: true });
        $('#MinimumLength').jqxNumberInput('val', @(Model.FieldType.MinimumLength.HasValue ? Model.FieldType.MinimumLength.Value : 1));
        $("#MaximumLength").jqxNumberInput({ width: field_width, height: h, min: 1, max: 100000, decimalDigits: 0, inputMode: 'simple', spinButtons: true });
        $('#MaximumLength').jqxNumberInput('val', @(Model.FieldType.MaximumLength.HasValue ? Model.FieldType.MaximumLength.Value : 1000));
        $("#PatternValidationText").jqxInput({ width: field_width, theme: theme, height: h });
        $("#FromFusionAttributeTypeID").jqxDropDownList({ width: field_width, theme: theme });
        $("#ToFusionAttributeTypeID").jqxDropDownList({ width: field_width, theme: theme });
        $("#FusionShow").jqxDropDownList({ width: field_width, theme: theme });

        $('#form0').jqxValidator({
            hintType: 'label',
            rules: [
                {
                    input: "#Name",
                    rule: function () {
                        var nameToTest = $('#Name').val();
                        var nameRegex = new RegExp("^[a-zA-Z0-9]+$");
                        return nameRegex.test(nameToTest);
                    },
                    action: 'blur',
                    message: 'Name can only have uppercase and lowercase letters and numbers.'
                },
                {
                    input: "#Name",
                    rule: 'required',
                    action: 'blur',
                    message: 'Name is required.'
                },
                {
                    input: "#FriendlyName",
                    rule: 'required',
                    action: 'blur',
                    message: 'Friendly Name is required.'
                },
                {
                    input: '#MaximumLength', message: 'Maximum Length must be greater than or equal to Minimum Length.', action: 'blur',
                    rule: function () {
                        var minLength = $('#MinimumLength').val();
                        var success = false;
                        var maxLength = $('#MaximumLength').val();
                        if (minLength != '' && maxLength != '') {
                            success = (maxLength >= minLength);
                        }
                        else {
                            success = true;
                        }
                        return success;
                    }
                },
                {
                    input: '#LookupDisplayFormat', message: 'Tokenized value required if the field type is List.', action: 'blur',
                    rule: function () {
                        var typeValue = $("select#Type option").filter(":selected").val();
                        var success = false;
                        if (typeValue == 'Lookup') {
                            var format = $('#LookupDisplayFormat').val();
                            var tokens = $("option", $("#Tokens"));
                            //var tokens = $("#Tokens").jqxDropDownList('getItems');
                            for (t in tokens) {
                                var token = tokens[t];
                                success = (format.indexOf(token.value) > -1)
                                if (success)
                                    break;
                            }
                        }
                        else {
                            success = true;
                        }
                        return success;
                    }
                }
            ]
        });

        //#endregion

        //#region Help Tooltips

        tipCss = 'qtip-blue qtip-shadow';
        $('#NameTip').qtip({
            content: {
                text: "@(Resources.FieldInfo.ApiName_Description)"
            },
            style: {
                classes: tipCss
            }
        });
        $('#FriendlyNameTip').qtip({
            content: {
                text: "@(Resources.FieldInfo.FriendlyName_Description)"
            },
            style: {
                classes: tipCss
            }
        });
        $('#TypeTip').qtip({
            content: {
                text: "@(Resources.FieldInfo.InputType_Description)"
            },
            style: {
                classes: tipCss
            }
        });
        $('#IsListableTip').qtip({
            content: {
                text: "@(Resources.FieldInfo.FilterEnabled_Description)"
            },
            style: {
                classes: tipCss
            }
        });
        $('#IsRequiredTip').qtip({
            content: {
                text: "@(Resources.FieldInfo.Required_Description)"
            },
            style: {
                classes: tipCss
            }
        });
        $('#LookupObjectTip').qtip({
            content: {
                text: "@(Resources.FieldInfo.ListType_Description)"
            },
            style: {
                classes: tipCss
            }
        });
        $('#LookupDisplayFormatTip').qtip({
            content: {
                text: "@(Resources.FieldInfo.ListDisplayFormat_Description)"
            },
            style: {
                classes: tipCss
            }
        });
        $('#PatternTip').qtip({
            content: {
                text: "@(Resources.FieldInfo.Pattern_Description)"
            },
            style: {
                classes: tipCss
            }
        });
        $('#MinimumLengthTip').qtip({
            content: {
                text: "@(Resources.FieldInfo.MinimumLength_Description)"
            },
            style: {
                classes: tipCss
            }
        });
        $('#MaximumLengthTip').qtip({
            content: {
                text: "@(Resources.FieldInfo.MaximumLength_Description)"
            },
            style: {
                classes: tipCss
            }
        });
        $('#DisplayDescriptionTip').qtip({
            content: {
                text: "@(Resources.FieldInfo.DisplayDescription_Description)"
            },
            style: {
                classes: tipCss
            }
        });
        $('#FormDescriptionTip').qtip({
            content: {
                text: "@(Resources.FieldInfo.FormDescription_Description)"
            },
            style: {
                classes: tipCss
            }
        });
        $('#ValidationDescriptionTip').qtip({
            content: {
                text: "@(Resources.FieldInfo.ValidationDescription_Description)"
            },
            style: {
                classes: tipCss
            }
        });


        //#endregion

        //#region Events

        $('#PatternValidationText').on('keyup', function(){
            var textToTest = $('#PatternValidationText').val();
            var patternToTest = $('#Pattern').val();
            var patternRegex = new RegExp(patternToTest);
            var success = patternRegex.test(textToTest);

            if (textToTest != '') {
                $('#PatternValidationLabel').removeClass(success ? "bg-danger" : "bg-success").addClass(success ? "bg-success" : "bg-danger");
                $('#PatternValidationLabel').text(success ? "Success" : "Fail");
            }
            else {
                $('#PatternValidationLabel').removeClass("bg-danger").removeClass("bg-success");
                $('#PatternValidationLabel').text("");
            }
        });

        $('#FriendlyName').on('change', function () {
            var n = $('#Name').val();
            var f = $('#FriendlyName').val();
            if (n == "") {
                f = f.replace(/[\s\W]/g, '');
                $("#Name").val(f);
            }
        });

        //$(document.body).on('change', '#Type', function (value) {
        $('#Type').on('change', function (event) {
            //var optionSelected = $("option:selected", this);
            var valueSelected = event.args.item.value; //this.value;
            switchControlsBasedOnType(valueSelected);
        });

        $('#LookupObject').on('change', function (event) {
            switchTokensBasedOnLookup();
        });

        //$(document.body).on('change', '#Tokens', function (value) {
        $('#Tokens').on('change', function (event) {
            //var optionSelected = $("option:selected", this);
            var valueSelected = event.args.item.value; //this.value;
            var currentValue = $("#LookupDisplayFormat").val();
            if (currentValue.indexOf(valueSelected) == -1){
                $("#LookupDisplayFormat").val(currentValue + valueSelected);
            }
        });

        $('#CommonPatterns').on('change', function (event) {
            //var args = event.args;
            //if (args) {
            var text = event.args.item.value; //$('#CommonPatterns').val();
            $("#Pattern").val(text);//(args.item.value);
            if (text == '') {
                $('#PatternValidationSection').hide();
            }
            else {
                $('#PatternValidationSection').show();
            }
            //}
        });

        $('#form0').on('validationSuccess', function (event) {
            $('#form0').submit();
        });
        $('#EditableFormSaveButton').on('click', function () {
            $('#form0').jqxValidator('validate');
        });

        $('#EditableFormCancelButton').on('click', function () {
            amplify.publish("CancelAction", { context: $('#EditableFormCancelButton').data('context') });
        });
        amplify.subscribe("ErrorOccurredAction", function (data) {
            $('#EditableFormSaveButton').hide();
        });
        amplify.subscribe("StartingAjax", function () {
            $('#EditableFormSaveButton').attr('disabled', 'disabled');
            $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');
        });
        amplify.subscribe("EndingAjax", function () {
            $('#EditableFormSaveButton').removeAttr('disabled');
            $('#progress').html('');
        });

        //#endregion

        //#region Set Values

        $("#Type").jqxDropDownList('val', '@(Model.FieldType.Type)');
        switchTokensBasedOnLookup();

        if ($('#Pattern').val() == '') {
            $('#PatternValidationSection').hide();
        }
        else {
            $('#PatternValidationSection').show();
        }

        //#endregion

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
