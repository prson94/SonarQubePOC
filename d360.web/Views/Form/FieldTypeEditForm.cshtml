@using d360.web.Models;
@model FieldTypeEditorModel
<style type="text/css">
    .form-instructions-error {
        color: red;
        margin-top: 15px;
    }

    .FieldNameError {
        color: red;
        margin-left: 10px;
    }
</style>
<script id="fieldTypeTmpl" type="text/html">
    <div class="left form-header-info">
        <h4>@((Model.FieldType.ID > 0) ? "Update Field" : "Add Field")</h4>
    </div>
    <div class="right">
        <button type="button" data-bind="click: cancel" class="btn waves-effect waves-light brown lighten-4">Cancel</button>
        <button type="button" data-bind="click: save" class="btn waves-effect waves-light brown lighten-1 saveButton">Save</button>
    </div>
    <div class="clear"></div>
    <div class="form-instructions">
        Modify your field using the form below.  There are many types of fields from Simple Text and HTML to Lookups and Dates.
        <div class="form-instructions-error" data-bind="visible: FormInvalid, text: FormValidationMessage">
        </div>
    </div>
    <div id="progress" data-bind="visible: InProgress"><i class="fa fa-spinner fa-spin fa-4x"></i></div>

    <div class="row">
        <div class="col s5">
            <div id='FriendlyNameTip' class="FieldNameRequired">@(Resources.FieldInfo.Name_Name)<span class="FieldNameError" data-bind="visible: FriendlyNameInvalid">*</span></div>
            <input type="text" data-bind="nameCharacterCheck, jqxInput: {width: field_width, height: field_height, theme: theme, value: FriendlyName }" />
        </div>
        <div class="col s5">
            <div id='NameTip' class="FieldNameRequired">@(Resources.FieldInfo.ApiName_Name)<span class="FieldNameError" data-bind="visible: ApiNameInvalid">*</span></div>
            <input type="text" data-bind="jqxInput: {width: field_width, height: field_height, theme: theme, value: ApiName}" />
        </div>
        <div class="col s2">
            <div id='CategoryTip' class="FieldNameRequired">@(Resources.FieldInfo.FieldTypeCategory_Name)</div>
            <input type="text" data-bind="nameCharacterCheck, jqxInput: {width: field_width, height: field_height, theme: theme, value: Category}" />
        </div>
    </div>

    <div class="row">
        <div class="col s6">
            <div id='TypeTip' class="FieldNameRequired">@(Resources.FieldInfo.InputType_Name)<span class="FieldNameError" data-bind="visible: DataTypeInvalid">*</span></div>
            <div data-bind="dataTypeFilteredDropdown, jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: false,
                 selectedIndex: DataTypeIndex,
                 source: DataTypeOptions,
                 disabled: LimitedChangesOnly,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase' }"></div>
        </div>
        <div class="col s3 input-field">
            <input type="checkbox" data-bind="disabled: IsCheckboxValid, checked: IsListable" />@(Resources.FieldInfo.FilterEnabled_Name)
            @*<div data-bind="jqxCheckBox: { theme: theme, checked: IsListable }">@(Resources.FieldInfo.FilterEnabled_Name)</div>*@
        </div>
        <div class="col s3 input-field">
            <input type="checkbox" data-bind="disabled: IsCheckboxValid, checked: IsRequired" />@(Resources.FieldInfo.Required_Name)
            @*<div data-bind="jqxCheckBox: { theme: theme, checked: IsRequired }">@(Resources.FieldInfo.Required_Name)</div>*@
        </div>
    </div>

    <div class="row" data-bind="visible: AttributeDataTypeSelected">
        <div class="col s6">
            <div id='AttributeTip' class="FieldNameRequired">@(Resources.FieldInfo.ListType_Name)<span class="FieldNameError" data-bind="visible: AttributeInvalid">*</span></div>
            <div data-bind="attributeFilteredDropdown, jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: false,
                 selectedIndex: AttributeIndex,
                 source: AttributeOptions,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase' }"></div>
        </div>
    </div>

    <div class="row" data-bind="visible: LookupDataTypeSelected">
        <div class="col s6">
            <div id='LookupObjectTip' class="FieldNameRequired">@(Resources.FieldInfo.ListType_Name)<span class="FieldNameError" data-bind="visible: LookupObjectInvalid">*</span></div>
            <div data-bind="lookupObjectFilteredDropdown, jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: false,
                 selectedIndex: LookupObjectIndex,
                 source: LookupObjectOptions,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase' }"></div>
        </div>
        <div class="col s3">
            <div id='LookupDisplayFormatTip' class="FieldNameRequired">@(Resources.FieldInfo.ListDisplayFormat_Name)<span class="FieldNameError" data-bind="visible: LookupDisplayFormatInvalid">*</span></div>
            <input type="text" data-bind="jqxInput: {width: field_width, height: field_height, theme: theme, value: LookupDisplayFormat}" />
        </div>
        <div class="col s3">
            <div class="FieldName">&nbsp;</div>
            <div data-bind="tokensFilteredDropdown, jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: false,
                 source: TokenOptions,
                 selectedIndex: TokenOptionIndex,
                 displayMember: 'title',
                 valueMember: 'value'
                 }"></div>
        </div>
    </div>

    <div class="row" data-bind="visible: TextDataTypeSelected">
        <div class="col s3">
            <div id='PatternTip' class="FieldName">@(Resources.FieldInfo.Pattern_Name)</div>
            <input type="text" data-bind="jqxInput: {width: field_width, height: field_height, theme: theme, value: Pattern }" />
        </div>
        <div class="col s3">
            <div class="FieldName">&nbsp;</div>
            <div data-bind="patternsFilteredDropdown, jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: false,
                 source: PatternOptions,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase' }"></div>
        </div>
        <div class="col s3">
            <div id='MinimumLengthTip' class="FieldName">@(Resources.FieldInfo.MinimumLength_Name)</div>
            <div data-bind="jqxNumberInput: {value: MinimumLength, inputMode: 'simple', spinButtons: true, digits: 4, decimalDigits: 0, width: field_width, theme: theme}"></div>
        </div>
        <div class="col s3">
            <div id='MaximumLengthTip' class="FieldName">@(Resources.FieldInfo.MaximumLength_Name)</div>
            <div data-bind="jqxNumberInput: {value: MaximumLength, inputMode: 'simple', spinButtons: true, digits: 4, decimalDigits: 0, width: field_width, theme: theme}"></div>
        </div>
    </div>

    <div class="row" data-bind="visible: PatternEnabled">
        <div class="col s3">
            <div class="FieldNameRequired">@(Resources.FieldInfo.TestPattern_Name)</div>
            <input type="text" data-bind="jqxInput: {width: field_width, height: field_height, theme: theme, value: PatternValidationText}" />
        </div>
        <div class="col s3">
            <div for="FieldNameRequired">&nbsp;</div>
            <div data-bind="text: PatternValidationLabel"></div>
        </div>
    </div>

    <div class="row" data-bind="visible: ValidationEnabled">
        <div class="col s12">
            <div id='ValidationDescriptionTip' class="FieldName">@(Resources.FieldInfo.ValidationDescription_Name)</div>
            <textarea data-bind="htmlarea: ValidationDescription"></textarea>
        </div>
    </div>

    <div class="row" data-bind="visible: FusionLookupDataTypeSelected">
        <div class="col s12" style="margin: 10px 0 10px 0">
            <h5>Fusion Lookups</h5>
            <table class="highlight, striped" cellpadding="5">
                <thead>
                    <tr>
                        <th>Target Item</th>
                        <th>Reference Type</th>
                        <th>Reference Item</th>
                        <th>Reference Columns</th>
                        <th>Table Settings</th>
                        <th style="width: 50px; text-align: right">
                            <a class='btn-flat waves-effect blue-text' data-bind="click: addFusionItem"><i class='fa fa-plus' title='Add fusion item'></i></a>
                        </th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: FusionItems">
                    <tr>
                        <td>
                            <div data-bind="fusionSourceFusionAttributeTypeFilteredDropdown, jqxDropDownList: {
                                 width: 250, dropDownWidth: 350, theme: theme,
                                 filterable: false,
                                 selectedIndex: SourceFusionAttributeTypeIndex,
                                 source: SourceFusionAttributeTypeOptions,
                                 displayMember: 'title',
                                 valueMember: 'value' }"></div>
                        </td>
                        <td>
                            <div data-bind="fusionReferenceTypeFilteredDropdown, jqxDropDownList: {
                                 width: 250, dropDownWidth: 350, theme: theme,
                                 filterable: false,
                                 selectedIndex: ReferenceTypeIndex,
                                 source: ReferenceTypeOptions,
                                 displayMember: 'title',
                                 valueMember: 'value' }"></div>
                        </td>
                        <td>
                            <div data-bind="fusionTargetFusionAttributeTypeFilteredDropdown, jqxDropDownList: {
                                 width: 250, dropDownWidth: 350, theme: theme,
                                 filterable: false,
                                 selectedIndex: TargetFusionAttributeTypeIndex,
                                 disabled: TargetFusionAttributeTypeDisabled,
                                 source: TargetFusionAttributeTypeOptions,
                                 displayMember: 'title',
                                 valueMember: 'value' }"></div>
                        </td>
                        <td>
                            <div data-bind="fusionDisplayFieldFilteredDropdown, jqxDropDownList: {
                                 width: 250, dropDownWidth: 350, theme: theme,
                                 filterable: false,
                                 disabled: DisplayFieldsDisabled,
                                 source: DisplayFieldOptions,
                                 selectedIndex: DisplayFieldOptionsIndex,
                                 checkboxes: true,
                                 displayMember: 'title',
                                 valueMember: 'value' }"></div>
                        </td>
                        <td>
                            <input type="checkbox" data-bind="checked: HideHeader" />Hide Header?<br />
                            <input type="checkbox" data-bind="checked: HideFooter" />Hide Footer?
                            @*<div data-bind="jqxCheckBox: { theme: theme, checked: HideHeader }">Hide Header?</div>
                            <div data-bind="jqxCheckBox: { theme: theme, checked: HideFooter }">Hide Footer?</div>*@
                        </td>
                        <td><a class='btn-flat waves-effect red-text' data-bind="click: $parent.deleteFusionItem"><i class='fa fa-trash' title='Remove'></i></a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="row" data-bind="visible: RelationLookupDataTypeSelected">
        <div class="col s12" style="margin: 10px 0 10px 0">
            @*<table class="highlight, striped" cellpadding="5">
                <thead>
                    <tr>
                        <th>Relation</th>
                        <th>Fields</th>
                        <th>Table Settings</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: RelationItems">
                    <tr>
                        <td>
                            <div data-bind="relationIntersectTypeFilteredDropdown, jqxDropDownList: {
                                 width: 250, dropDownWidth: 350, theme: theme,
                                 filterable: false,
                                 selectedIndex: IntersectTypeIndex,
                                 source: IntersectTypeOptions,
                                 displayMember: 'title',
                                 valueMember: 'value' }"></div>
                        </td>
                        <td>

                        </td>
                        <td>
                            <div data-bind="jqxCheckBox: { theme: theme, checked: HideHeader }">Hide Header?</div>
                            <div data-bind="jqxCheckBox: { theme: theme, checked: HideFooter }">Hide Footer?</div>
                        </td>
                    </tr>
                </tbody>
            </table>*@
            <table cellpadding="5">
                <thead>
                    <tr>
                        <th>Relation</th>
                        <th>Reference Type</th>
                        <th>Child Relation</th>
                        <th>Reference Columns</th>
                        <th>Table Settings</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: RelationItems">
                    <tr>
                        <td style="vertical-align: top; width: 260px">
                            <div data-bind="relationIntersectTypeFilteredDropdown, jqxDropDownList: {
                                 width: 250, dropDownWidth: 350, theme: theme,
                                 filterable: false,
                                 selectedIndex: IntersectTypeIndex,
                                 source: IntersectTypeOptions,
                                 displayMember: 'title',
                                 valueMember: 'value' }"></div>
                        </td>
                        <td style="vertical-align: top; width: 260px">
                            <div data-bind="relationReferenceTypeFilteredDropdown, jqxDropDownList: {
                                 width: 250, dropDownWidth: 350, theme: theme,
                                 filterable: false,
                                 selectedIndex: ReferenceTypeIndex,
                                 source: ReferenceTypeOptions,
                                 displayMember: 'title',
                                 valueMember: 'value' }"></div>
                        </td>
                        <td style="vertical-align: top; width: 260px">
                            <div data-bind="relationChildIntersectTypeFilteredDropdown, jqxDropDownList: {
                                 width: 250, dropDownWidth: 350, theme: theme,
                                 filterable: false,
                                 selectedIndex: ChildIntersectTypeIndex,
                                 disabled: ChildIntersectTypeDisabled,
                                 source: ChildIntersectTypeOptions,
                                 displayMember: 'title',
                                 valueMember: 'value' }"></div>
                        </td>
                        <td style="vertical-align: top">
                            <table class="striped highlight">
                                <thead>
                                    <th>Name</th>
                                    <th>Show?</th>
                                    <th>Sort</th>
                                    <th>Filter</th>
                                </thead>
                                <tbody data-bind="foreach: DisplayFieldOptions" style="max-height:250px; height: 250px; overflow-y: scroll">
                                    <tr>
                                        <td style="width: 30%" data-bind="text: title"></td>
                                        <td style="width: 20%">
                                            <input type="checkbox" data-bind="checked: Show" />
                                            @*<div data-bind="jqxCheckBox: { theme: theme, checked: Show }"></div>*@
                                        </td>
                                        <td style="width: 15%">
                                            <div data-bind="sortOrderDropdown, jqxDropDownList: {
                                                 width: 75, dropDownWidth: 50, theme: theme,
                                                 filterable: false,
                                                 source: SortOrderOptions,
                                                 selectedIndex: SortOrderIndex,
                                                 displayMember: 'title',
                                                 valueMember: 'value' }"></div>
                                            
                                        </td>
                                        <td><input  data-bind="jqxInput: { theme: theme, width: field_width98, height: field_height, value: FilterValue }" /></td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                        <td style="vertical-align: top; width: 125px">
                            <input type="checkbox" data-bind="checked: HideHeader" />Hide Header?<br/>
                            <input type="checkbox" data-bind="checked: HideFooter" />Hide Footer?
                            @*<div data-bind="jqxCheckBox: { theme: theme, checked: HideHeader }">Hide Header?</div>
                            <div data-bind="jqxCheckBox: { theme: theme, checked: HideFooter }">Hide Footer?</div>*@
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col s6">
            <div id='DisplayDescriptionTip' class="FieldName">@(Resources.FieldInfo.DisplayDescription_Name)</div>
            <textarea data-bind="htmlarea: DisplayDescription"></textarea>
        </div>
        <div class="col s6">
            <div id='FormDescriptionTip' class="FieldName">@(Resources.FieldInfo.FormDescription_Name)</div>
            <textarea data-bind="htmlarea: FormDescription"></textarea>
        </div>
    </div>
</script>

<div class="large-overlay">
    <div class="ui segment">
        <div id="FieldTypeFormWrapper" data-bind="template: {name: 'fieldTypeTmpl' }"></div>
    </div>
</div>

<script type="text/javascript">
    //#region Binding Handlers
    ko.bindingHandlers.nameCharacterCheck = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('keypress', function (e) {
                var key = String.fromCharCode(!e.charCode ? e.which : e.charCode);
                if (/[\[\]\.\n\{\}\'\"\<\>]+/.test(key)) {
                    e.preventDefault();
                    return false;
                }
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    ko.bindingHandlers.dataTypeFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.DataType(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    ko.bindingHandlers.attributeFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.Attribute(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    ko.bindingHandlers.lookupObjectFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.LookupObject(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    ko.bindingHandlers.patternsFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.Pattern(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };

    ko.bindingHandlers.fusionSourceFusionAttributeTypeFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.SourceFusionAttributeType(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    ko.bindingHandlers.fusionReferenceTypeFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.ReferenceType(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    ko.bindingHandlers.fusionTargetFusionAttributeTypeFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.TargetFusionAttributeType(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    //ko.bindingHandlers.fusionDisplayFieldFilteredDropdown = {
    //    init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
    //        $(element).on('checkChange', function (event) {
    //            var checked = event.args.item.checked;
    //            var value = event.args.item.value;
    //            if (checked) {
    //                viewModel.DisplayFields.push(value);
    //            }
    //            else {
    //                viewModel.DisplayFields.remove(value);
    //            }
    //        });
    //    },
    //    update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    //};
    ko.bindingHandlers.sortOrderDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.SortOrder(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    ko.bindingHandlers.tokensFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.LookupDisplayFormat(viewModel.LookupDisplayFormat() + event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };

    ko.bindingHandlers.relationIntersectTypeFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.IntersectType(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    ko.bindingHandlers.relationReferenceTypeFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.ReferenceType(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    ko.bindingHandlers.relationChildIntersectTypeFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('change', function (event) {
                viewModel.ChildIntersectType(event.args.item.value);
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) { }
    };
    ko.bindingHandlers.relationDisplayFieldFilteredDropdown = {
        init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
            $(element).on('checkChange', function (event) {
                var checked = event.args.item.checked;
                var value = event.args.item.value;
                if (checked) {
                    viewModel.DisplayFields.push(value);
                }
                else {
                    viewModel.DisplayFields.remove(value);
                }
            });
        },
        update: function (element, valueAccessor, allBindings, viewModel, bindingContext) {
        }
    };
    //#endregion

    function FieldTypeFusionItemViewModel(data, parent) {
        var self = this;
        data = data || {};

        //#region Simple Properties

        self.ID = ko.observable(data.ID);

        self.SourceFusionAttributeTypeIndex = ko.observable(data.SourceFusionAttributeTypeIndex || -1);
        self.SourceFusionAttributeType = ko.observable(data.SourceFusionAttributeType);

        self.ReferenceTypeIndex = ko.observable(data.ReferenceTypeIndex || -1);
        self.ReferenceType = ko.observable(data.ReferenceType || 0);

        self.TargetFusionAttributeTypeIndex = ko.observable(data.TargetFusionAttributeTypeIndex || -1);
        self.TargetFusionAttributeType = ko.observable(data.TargetFusionAttributeType);

        self.DisplayFields = ko.observableArray(data.DisplayFields);

        self.HideHeader = ko.observable(data.HideHeader);
        self.HideFooter = ko.observable(data.HideFooter);

        //#endregion

        //#region Computed Properties

        self.TargetFusionAttributeTypeDisabled = ko.pureComputed(function () {
            return (self.ReferenceType() == "1" || self.TargetFusionAttributeTypeOptions().length == 0);
        }, self);

        self.DisplayFieldsDisabled = ko.pureComputed(function () {
            return (self.ReferenceType() != "1" && (self.TargetFusionAttributeTypeOptions().length == 0 || (self.TargetFusionAttributeTypeOptions().length > 0 && self.TargetFusionAttributeType == "")));
        }, self);

        //#endregion

        //#region List Properties

        self.SourceFusionAttributeTypeOptions = ko.observableArray(parent.FusionAttributeTypeOptions());
        self.ReferenceTypeOptions = ko.observableArray([
            { title: 'Self Reference', value: '1' },
            { title: 'Parent Reference', value: '2' },
            { title: 'Child Reference', value: '3' },
            { title: 'Relationship Reference', value: '4' }
        ]);
        self.TargetFusionAttributeTypeOptions = ko.observableArray();
        self.DisplayFieldOptions = ko.observableArray();
        self.DisplayFieldOptionsIndex = ko.observable(-1);
        //#endregion

        //#region Internal Methods


        self.isValid = function () {
            if (self.SourceFusionAttributeTypeIndex() == -1)
                return false;
            if (self.ReferenceTypeIndex() == -1)
                return false;
            if (self.DisplayFields().length < 1)
                return false;
            return true;
        };
        var loadDisplayFields = function(id, existingItems) {
            return $.getJSON('/form/FieldType_FusionLookup_DisplayFields', { id: id }, function(items) {
                if (existingItems) {
                    $.each(existingItems, function(e_ix, e_item){
                        $.each(items, function(ix, item) {
                            if (item.value === e_item) {
                                item.checked = true;
                            }
                        });
                    });
                }
                self.DisplayFieldOptions(items);
            });
        };

        var loadTargetAttributeTypes = function(s, r) {
            return $.getJSON(
                '/form/FieldType_FusionLookup_TargetAttributeTypes', { s: s, r: r },
                function(refTargets) {
                    self.TargetFusionAttributeTypeOptions(refTargets);
                }
            );
        };

        var setSubscriptions = function() {

            self.SourceFusionAttributeType.subscribe(function (value) {
                self.TargetFusionAttributeTypeOptions.removeAll();
                self.DisplayFieldOptions.removeAll();
                self.DisplayFields.removeAll();

                if (self.ReferenceType() != "" && self.ReferenceType() != "1") {
                    loadTargetAttributeTypes(value, self.ReferenceType());
                }
            });

            self.ReferenceType.subscribe(function (value) {
                self.TargetFusionAttributeTypeOptions.removeAll();
                self.DisplayFieldOptions.removeAll();
                self.DisplayFields.removeAll();

                if (value) {
                    if (value == "1"){
                        //Load the display fields for the Source Type.
                        loadDisplayFields(self.SourceFusionAttributeType());
                    }
                    else {
                        loadTargetAttributeTypes(self.SourceFusionAttributeType(), value);
                    }
                }
            });

            self.TargetFusionAttributeType.subscribe(function (value) {
                self.DisplayFieldOptions.removeAll();
                self.DisplayFields.removeAll();

                if (value) {
                    loadDisplayFields(value);
                }
            });

        };

        //#endregion

        //#region Initialize before subscribes

        if (self.ID() > 0) {
            var indexToSelect = -1;

            var fullSourceFusionAttributeType = 0;
            $.each(self.SourceFusionAttributeTypeOptions(), function (ix, item) {
                if (item.value == self.SourceFusionAttributeType()) {
                    indexToSelect = ix;
                    fullSourceFusionAttributeType = item.value;
                }
            });
            self.SourceFusionAttributeTypeIndex(indexToSelect);

            indexToSelect = -1;
            var fullReferenceTypeValue = "";
            $.each(self.ReferenceTypeOptions(), function (ix, item) {
                if (item.value == self.ReferenceType()) {
                    indexToSelect = ix;
                    fullReferenceTypeValue = item.value;
                }
            });
            self.ReferenceTypeIndex(indexToSelect);

            if (fullSourceFusionAttributeType > 0 && fullReferenceTypeValue > 1) {

                loadTargetAttributeTypes(fullSourceFusionAttributeType, fullReferenceTypeValue).then(function(){
                    indexToSelect = -1;

                    var fullTargetFusionAttributeType = 0;

                    $.each(self.TargetFusionAttributeTypeOptions(), function (ix, item) {
                        if (item.value == self.TargetFusionAttributeType()) {
                            indexToSelect = ix;
                            fullTargetFusionAttributeType = item.value;
                        }
                    });
                    self.TargetFusionAttributeTypeIndex(indexToSelect);
                    if (indexToSelect > -1) {
                        loadDisplayFields(fullTargetFusionAttributeType, self.DisplayFields());
                    }
                }).then(function(){
                    setSubscriptions();
                });

            }
            else {
                loadDisplayFields(self.SourceFusionAttributeType(), self.DisplayFields()).then(function(){
                    setSubscriptions();
                });
            }
        }
        else {
            setSubscriptions();
        }

        //#endregion
    }
    
    function FieldTypeRelationDisplayFieldOptionViewModel(data, fieldCount) {
        var self = this;
        data = data || {};

        self.title = ko.observable(data.title);
        self.value = ko.observable(data.value);
        
        self.FilterValue = ko.observable(data.FilterValue || '');

        self.Show = ko.observable(data.Show);

        self.SortOrder = ko.observable(data.SortOrder);
        self.SortOrderIndex = ko.observable(0);

        var values = [{value: '', title: ''}];
        for(var position = 1; position <= fieldCount; position++) {
            values.push({ value: position, title: position });
        }
        self.SortOrderOptions = ko.observableArray(values);
        
        var indexToSelect = 0;
        $.each(self.SortOrderOptions(), function (ix, item) {
            if (self.SortOrder()) {
                if (item.value == self.SortOrder()) {
                    indexToSelect = ix;
                }            
            }
        });
        self.SortOrderIndex(indexToSelect);
    }

    function FieldTypeRelationItemViewModel(data, parent) {
        var self = this;
        data = data || {};

        //#region Simple Properties

        self.ID = ko.observable(data.ID);

        self.IntersectTypeIndex = ko.observable(data.IntersectTypeIndex || -1);
        self.IntersectType = ko.observable(data.IntersectType);
        self.ReferenceTypeIndex = ko.observable(data.ReferenceTypeIndex || -1);
        self.ReferenceType = ko.observable(data.ReferenceType);
        self.ChildIntersectTypeIndex = ko.observable(data.ChildIntersectTypeIndex || -1);
        self.ChildIntersectType = ko.observable(data.ChildIntersectType);
        self.DisplayFields = ko.observableArray(data.DisplayFields);

        self.HideHeader = ko.observable(data.HideHeader);
        self.HideFooter = ko.observable(data.HideFooter);

        //#endregion

        //#region Computed Properties

        self.ChildIntersectTypeDisabled = ko.pureComputed(function () {
            return (self.ReferenceType() == "1" || self.ChildIntersectTypeOptions().length == 0);
        }, self);

        self.DisplayFieldsDisabled = ko.pureComputed(function () {
            return (self.ReferenceType() != "1" && (
                self.ChildIntersectTypeOptions().length == 0 ||
                (self.ChildIntersectTypeOptions().length > 0 && self.ChildIntersectType == ""))
            );
        }, self);

        //#endregion

        //#region List Properties

        self.IntersectTypeOptions = ko.observableArray(parent.IntersectTypeOptions());
        self.ReferenceTypeOptions = ko.observableArray([
            { title: 'Self Reference', value: '1' },
            { title: 'Child Reference', value: '2' }
        ]);
        self.ChildIntersectTypeOptions = ko.observableArray();
        self.DisplayFieldOptions = ko.observableArray();

        //#endregion

        //#region Internal Methods


        self.isValid = function () {
            if (self.IntersectTypeIndex() == -1)
                return false;
            if (self.ReferenceTypeIndex() == -1)
                return false;

            var oneOrMoreFieldsSelected = false;
            $.each(self.DisplayFieldOptions(), function(fix, fid){                                
                if (!oneOrMoreFieldsSelected) {
                    oneOrMoreFieldsSelected = (fid.Show() || fid.SortOrder() || fid.FilterValue() != '');
                }
            });

            return (oneOrMoreFieldsSelected);
        }

        var loadChildIntersects = function(intersectTypeID) {
            return $.getJSON(
                '/form/FieldType_RelationLookup_ChildIntersectTypes',
                { id: intersectTypeID },
                function(items) {
                    self.ChildIntersectTypeOptions(items);
                }
            );
        }
        var loadDisplayFields = function(intersectTypeID, type, id, existingItems) {
            return $.getJSON(
                '/form/FieldType_RelationLookup_DisplayFields',
                { intersectTypeID: intersectTypeID, type: type, id: id },
                function(items) {
                    if (existingItems) {
                        $.each(existingItems, function(e_ix, e_item){
                            $.each(items, function(ix, item) {
                                if (item.value === e_item.value) {
                                    //item.checked = true;
                                    item.FilterValue = e_item.FilterValue;
                                    item.Show = e_item.Show;
                                    item.SortOrder = e_item.SortOrder;
                                }
                            });
                        });
                    }
                    var mappedItems = $.map(items, function (item) { return new FieldTypeRelationDisplayFieldOptionViewModel(item, items.length); });
                    self.DisplayFieldOptions(mappedItems);//self.DisplayFieldOptions(items);
                }
            );
        }
        var setSubscriptions = function(){
            self.IntersectType.subscribe(function (value) {
                self.ChildIntersectTypeOptions.removeAll();
                self.DisplayFieldOptions.removeAll();
                self.DisplayFields.removeAll();
                if (value) {
                    var values = value.split('|');

                    if (self.ReferenceType() != "" && self.ReferenceType() != "1") {
                        loadChildIntersects(values[0]);
                    }
                    else {
                        loadDisplayFields(values[0], values[1], values[2]);
                    }
                }
            });

            self.ReferenceType.subscribe(function (value) {
                self.ChildIntersectTypeOptions.removeAll();
                self.DisplayFieldOptions.removeAll();
                self.DisplayFields.removeAll();

                if (value) {
                    var values = self.IntersectType().split('|');

                    if (value == "1"){
                        //Load the display fields for the Source Type.
                        loadDisplayFields(values[0], values[1], values[2]);
                    }
                    else {
                        loadChildIntersects(values[0]);
                    }
                }
            });

            self.ChildIntersectType.subscribe(function (value) {
                self.DisplayFieldOptions.removeAll();
                self.DisplayFields.removeAll();

                if (value) {
                    var values = value.split('|');
                    loadDisplayFields(values[0], values[1], values[2]);
                }
            });
        }

        //#endregion

        //#region Initialize before subscribes

        if (self.ID() > 0) {
            var indexToSelect = -1;

            var fullIntersectTypeValue = "";
            $.each(self.IntersectTypeOptions(), function (ix, item) {
                if (item.value.substring(0, item.value.indexOf('|')) == self.IntersectType()) {
                    indexToSelect = ix;
                    fullIntersectTypeValue = item.value;
                }
            });
            self.IntersectTypeIndex(indexToSelect);

            indexToSelect = -1;
            var fullReferenceTypeValue = 0;
            $.each(self.ReferenceTypeOptions(), function (ix, item) {
                if (item.value == self.ReferenceType()) {
                    indexToSelect = ix;
                    fullReferenceTypeValue = item.value;
                }
            });
            self.ReferenceTypeIndex(indexToSelect);

            if (fullIntersectTypeValue > "" && fullReferenceTypeValue > 1) {

                var values = fullIntersectTypeValue.split('|');

                loadChildIntersects(values[0]).then(function(){
                    indexToSelect = -1;

                    var fullChildIntersectTypeValue = "";

                    $.each(self.ChildIntersectTypeOptions(), function (ix, item) {
                        if (item.value.substring(0, item.value.indexOf('|')) == self.ChildIntersectType()) {
                            indexToSelect = ix;
                            fullChildIntersectTypeValue = item.value;
                        }
                    });
                    self.ChildIntersectTypeIndex(indexToSelect);
                    if (indexToSelect > -1) {
                        var values = fullChildIntersectTypeValue.split('|');
                        loadDisplayFields(values[0], values[1], values[2], self.DisplayFields());
                    }
                }).then(function(){
                    setSubscriptions();
                });

            }
            else {
                var values = fullIntersectTypeValue.split('|');
                loadDisplayFields(values[0], values[1], values[2], self.DisplayFields()).then(function(){
                    setSubscriptions();
                });
            }
        }
        else {
            setSubscriptions();
        }

        //#endregion
    }

    function FieldTypeViewModel(data) {
        var self = this;
        data = data || {};

        //#region Simple Properties

        self.ID = ko.observable(data.ID);
        self.Context = ko.observable(data.Context);
        self.Object = ko.observable(data.Object);
        self.ObjectID = ko.observable(data.ObjectID);

        self.Category = ko.observable(data.Category || "");
        self.FriendlyName = ko.observable(data.FriendlyName || "");
        self.ApiName = ko.observable(data.ApiName || "");
        self.IsListable = ko.observable(data.IsListable || false);
        self.IsRequired = ko.observable(data.IsRequired || false);

        self.DataTypeIndex = ko.observable(data.DataTypeIndex || -1);
        self.DataType = ko.observable(data.DataType || '');

        self.DisplayDescription = ko.observable(data.DisplayDescription || "");
        self.FormDescription = ko.observable(data.FormDescription || "");

        self.AttributeIndex = ko.observable(data.AttributeIndex || -1);
        self.Attribute = ko.observable(data.Attribute || '');

        self.LookupObjectIndex = ko.observable(data.LookupObjectIndex || -1);
        self.LookupObject = ko.observable(data.LookupObject || '');
        self.LookupDisplayFormat = ko.observable("");

        self.Pattern = ko.observable(data.Pattern || "");
        self.MinimumLength = ko.observable(data.MinimumLength || 0);
        self.MaximumLength = ko.observable(data.MaximumLength || 1000);
        self.ValidationDescription = ko.observable(data.ValidationDescription || "");

        self.PatternValidationText = ko.observable('');
        //self.PatternValidationLabel = ko.observable();

        self.LimitedChangesOnly = ko.observable(data.LimitedChangesOnly || false);
        self.InProgress = ko.observable(false);

        //#endregion

        //#region Validation Properties

        self.FormInvalid = ko.observable(false);
        self.FormValidationMessage = ko.observable('');

        self.FriendlyNameInvalid = ko.pureComputed(function () {
            return (self.FriendlyName() === "");
        }, self);

        self.ApiNameInvalid = ko.pureComputed(function () {
            return (self.ApiName() === "");
        }, self);

        self.AttributeInvalid = ko.pureComputed(function () {
            return (self.AttributeIndex() == -1);
        }, self);

        self.DataTypeInvalid = ko.pureComputed(function () {
            return (self.DataType() === "");
        }, self);

        self.IsCheckboxValid = ko.pureComputed(function(){
            return (self.DataType() !== "Attribute" && self.DataType() !== "RelationLookup");
        }, self);

        self.LookupObjectInvalid = ko.pureComputed(function () {
            return (self.LookupObjectIndex() == -1);
        }, self);

        self.LookupDisplayFormatInvalid = ko.pureComputed(function () {
            return (self.LookupDisplayFormat() === "");
        }, self);

        self.validateForm = function () {
            self.FormInvalid(false);
            self.FormValidationMessage('Please check all fields below indicated with a red *.');

            if (self.FriendlyNameInvalid() || self.ApiNameInvalid() || self.DataTypeInvalid()) {
                self.FormInvalid(true);
                return;
            }

            switch(self.DataType())
            {
                case "Attribute":
                    if (self.AttributeInvalid() ) {
                        self.FormInvalid(true);
                        return;
                    }
                    break;
                case "Lookup":
                    if (self.LookupObjectInvalid() || self.LookupDisplayFormatInvalid() ) {
                        self.FormInvalid(true);
                        return;
                    }
                    break;
                case "FusionLookup":
                    if (self.FusionItems().length < 1) {
                        self.FormValidationMessage('Please add at least one fusion item.');
                        self.FormInvalid(true);
                    } else {
                        for(var i = 0; i < self.FusionItems().length; i++) {
                            if (!self.FusionItems()[i].isValid()) {
                                self.FormInvalid(true);
                                self.FormValidationMessage('One or more fusion items is invalid. Please make sure all required fields are selected.');
                            }
                        }
                    }
                    break;
                case "RelationLookup":
                    if (self.RelationItems().length < 1) {
                        self.FormValidationMessage('There is no relation item available for this field.');
                    } else {
                        for(var i = 0; i < self.RelationItems().length; i++) {
                            if (!self.RelationItems()[i].isValid()) {
                                self.FormInvalid(true);
                                self.FormValidationMessage('The relation item is invalid. Please make sure all required fields are selected.');
                            }
                        }
                    }
                    break;
            }
        }

        //#endregion

        //#region Computed Properties

        self.AttributeDataTypeSelected = ko.pureComputed(function () {
            return (self.DataType() == "Attribute");
        }, self);

        self.FusionLookupDataTypeSelected = ko.pureComputed(function () {
            return (self.DataType() == "FusionLookup");
        }, self);
        self.LookupDataTypeSelected = ko.pureComputed(function () {
            return (self.DataType() == "Lookup");
        }, self);
        self.RelationLookupDataTypeSelected = ko.pureComputed(function () {
            return (self.DataType() == "RelationLookup");
        }, self);
        self.TextDataTypeSelected = ko.pureComputed(function () {
            return (self.DataType() == "Text");
        }, self);
        self.NonTextDataTypeSelected = ko.pureComputed(function () {
            return (self.DataType() != "FusionLookup" && self.DataType() != "Lookup" && self.DataType() != "RelationLookup" && self.DataType() != "Text");
        }, self);
        self.ValidationEnabled = ko.pureComputed(function () {
            return (self.Pattern() > "" || self.MinimumLength() > 0 || self.IsRequired());
        }, self);
        self.PatternEnabled = ko.pureComputed(function () {
            return (self.ValidationEnabled() && self.Pattern() > "");
        }, self);

        self.PatternValidationLabel = ko.pureComputed(function () {
            if (self.Pattern() > "" && self.PatternValidationText() > "")
            {
                var patternRegex = new RegExp(self.Pattern());
                return (patternRegex.test(self.PatternValidationText())) ? 'Success' : 'Fail';
            }
            else
            {
                return '';
            }
        }, self);

        //#endregion

        //#region List Properties

        self.AttributeOptions = ko.observableArray();   // attributes.

        self.DataTypeOptions = ko.observableArray();    // Data Types.

        self.FusionItems = ko.observableArray();        // Target Fusion Look-through references.
        self.FusionAttributeTypeOptions = ko.observableArray();

        self.LookupObjectOptions = ko.observableArray();// Lookup lists.

        self.PatternOptions = ko.observableArray();     // Patterns.

        self.RelationItems = ko.observableArray();      // Target Relation Look-through references.
        self.IntersectTypeOptions = ko.observableArray();

        self.TokenOptions = ko.observableArray();
        self.TokenOptionIndex = ko.observable(-1);
        //#endregion

        //#region Methods

        var loadTokens = function(type, id){
            if (type != "DomainItem") type += 'Type';
            $.getJSON("/form/FieldType_Lookup_Tokens", { type: type, id: id }, function(tokens) {
                self.TokenOptions.removeAll();
                self.TokenOptions(tokens);
                //console.log(tokens[0]);
            });
        }

        var setSubscriptions = function() {

            self.IsRequired.subscribe(function (value) {

                if (value) {
                    if (self.MinimumLength() <= 0) {
                        self.MinimumLength(1);
                    }
                }
                else {
                    self.MinimumLength(0);
                }
            });

            self.FriendlyName.subscribe(function (value) {

                if (value) {
                    if (value.length > 0) {
                        self.ApiName(value.replace(/[^a-zA-Z0-9-_]/g, ''));
                    }
                }
            });

            self.LookupObject.subscribe(function (value) {
                if (value) {
                    var values = value.split('|');
                    loadTokens(values[0], values[1]);
                    self.LookupDisplayFormat('');
                }
            });

        }

        self.addFusionItem = function() {
            self.FusionItems.push(new FieldTypeFusionItemViewModel({}, self));
        };

        ////self.addRelationItem = function() {
        ////    self.RelationItems.push(new FieldTypeRelationItemViewModel({}, self));
        ////};

        self.cancel = function () {
            amplify.publish("CancelAction", { context: self.Context() });
        };

        self.deleteFusionItem = function () {
            self.FusionItems.remove(this);
        };

        ////self.deleteRelationItem = function () {
        ////    self.RelationItems.remove(this);
        ////};

        self.loadCurrentType = function () {

            amplify.request.define( "FieldType_Lookups", "ajax", {
                url: "/form/FieldType_Lookups?type={type}&id={id}",
                dataType: "json",
                type: "GET",
                cache: true
            });

            amplify.request(
                'FieldType_Lookups',
                { type: self.Object(), id: self.ObjectID() },
                function(lookups) {
                    self.DataTypeOptions(lookups.DataTypes);
                    self.PatternOptions(lookups.Patterns);

                    if (lookups.Attributes) {
                        self.AttributeOptions(lookups.Attributes);
                    }
                    if (lookups.FusionAttributeTypes) {
                        self.FusionAttributeTypeOptions(lookups.FusionAttributeTypes);
                    }
                    if (lookups.IntersectTypes) {
                        self.IntersectTypeOptions(lookups.IntersectTypes);
                    }
                    if (lookups.Lookups) {
                        self.LookupObjectOptions(lookups.Lookups);
                    }

                    if (self.ID() > 0) {
                        $.getJSON('/form/FieldType_FormData', { id: self.ID() }, function (ftData) {
                            if (ftData.FieldType) {
                                self.Category(ftData.FieldType.Category);
                                self.ApiName(ftData.FieldType.Name);
                                self.FriendlyName(ftData.FieldType.FriendlyName);
                                self.IsListable(ftData.FieldType.IsListable);
                                self.IsRequired(ftData.FieldType.IsRequired);

                                var indexToSelect = -1;

                                self.DataType(ftData.FieldType.Type);
                                $.each(self.DataTypeOptions(), function (ix, item) {
                                    if (item.value == ftData.FieldType.Type) {
                                        indexToSelect = ix;
                                    }
                                });
                                self.DataTypeIndex(indexToSelect);

                                self.DisplayDescription(ftData.FieldType.DisplayDescription);
                                self.FormDescription(ftData.FieldType.FormDescription);

                                if (ftData.FieldType.LookupObjectType && ftData.FieldType.LookupObjectID) {
                                    indexToSelect = -1;
                                    var searchString = ftData.FieldType.LookupObjectType + '|' + ftData.FieldType.LookupObjectID;

                                    if (self.DataType() == "Attribute") {

                                        $.each(self.AttributeOptions(), function (ix, item) {
                                            if (item.value == searchString) {
                                                indexToSelect = ix;
                                            }
                                        });
                                        if (indexToSelect > -1) {
                                            self.AttributeIndex(indexToSelect);
                                            self.Attribute(searchString);
                                        }

                                    }
                                    else {

                                        $.each(self.LookupObjectOptions(), function (ix, item) {
                                            if (item.value == searchString) {
                                                indexToSelect = ix;
                                            }
                                        });
                                        if (indexToSelect > -1) {
                                            self.LookupObjectIndex(indexToSelect);
                                            self.LookupObject(searchString);
                                            self.LookupDisplayFormat(ftData.FieldType.LookupDisplayFormat);
                                            loadTokens(ftData.FieldType.LookupObjectType, ftData.FieldType.LookupObjectID);
                                        }

                                    }
                                }

                                self.Pattern(ftData.FieldType.Pattern);
                                self.MinimumLength(ftData.FieldType.MinimumLength);
                                self.MaximumLength(ftData.FieldType.MaximumLength);
                                self.ValidationDescription(ftData.FieldType.ValidationDescription);

                                if (ftData.FusionItems) {
                                    var list = $.map(ftData.FusionItems, function (item) { return new FieldTypeFusionItemViewModel(item, self); });
                                    self.FusionItems(list);
                                }

                                if (ftData.RelationItems) {
                                    var list = $.map(ftData.RelationItems, function (item) { return new FieldTypeRelationItemViewModel(item, self); });
                                    self.RelationItems(list);
                                } else {
                                    self.RelationItems.push(new FieldTypeRelationItemViewModel({}, self));
                                }
                            }
                        }).then(function(){
                            setSubscriptions();
                        });
                    }
                    else {
                        self.RelationItems.push(new FieldTypeRelationItemViewModel({}, self));
                        setSubscriptions();
                    }
                }
            );
        };

        self.save = function () {
            self.validateForm();

            if (!self.FormInvalid()) {
                self.FormInvalid(false);
                self.InProgress(true);

                var postModel = {
                    FieldType: {
                        ID: self.ID(),
                        Name: self.ApiName(),
                        Category: self.Category(),
                        DisplayDescription: self.DisplayDescription(),
                        FormDescription: self.FormDescription(),
                        ValidationDescription: self.ValidationDescription(),
                        FriendlyName: self.FriendlyName(),
                        Type: self.DataType(),
                        AttributeTypeID: null,
                        LookupObjectType: null,
                        LookupObjectID: null,
                        LookupDisplayFormat: null,
                        MinimumLength: self.MinimumLength(),
                        MaximumLength: self.MaximumLength(),
                        Pattern: self.Pattern(),
                        Object: self.Object(),
                        ObjectID: self.ObjectID(),
                        IsListable: self.IsListable(),
                        IsRequired: self.IsRequired()
                    },
                    FusionItems: [],
                    RelationItem: {
                        IntersectType: 0,
                        ReferenceType: 1,
                        ChildIntersectType: null,
                        DisplayFields: [],
                        HideHeader: false,
                        HideFooter: false
                    }
                };

                if (self.DataType() === "Attribute") {
                    var attribute = self.Attribute();
                    if (attribute !== "") {
                        postModel.FieldType.LookupObjectType = attribute.split('|')[0];
                        postModel.FieldType.LookupObjectID = attribute.split('|')[1];
                    }
                }

                if (self.DataType() === "Lookup") {
                    var lookupType = self.LookupObject();
                    if (lookupType !== "") {
                        postModel.FieldType.LookupObjectType = lookupType.split('|')[0];
                        postModel.FieldType.LookupObjectID = lookupType.split('|')[1];
                        postModel.FieldType.LookupDisplayFormat = self.LookupDisplayFormat();
                    }
                }

                $.each(self.FusionItems(), function(fusionItemIx, fusionItem){
                    try {
                        var fim = {
                            ID: fusionItem.ID(),
                            SourceFusionAttributeType: fusionItem.SourceFusionAttributeType(),
                            ReferenceType: fusionItem.ReferenceType(),
                            TargetFusionAttributeType: fusionItem.TargetFusionAttributeType(),
                            DisplayFields: [],
                            HideHeader: fusionItem.HideHeader(),
                            HideFooter: fusionItem.HideFooter()
                        };
                        $.each(fusionItem.DisplayFields(), function(fix, fid){
                            if (fid > "") {
                                var values = fid.split('|');
                                fim.DisplayFields.push({
                                    FieldTypeID: values[0],
                                    FieldTypeName: values[1]
                                });
                            }
                        });
                        postModel.FusionItems.push(fim);
                    } catch (e) {
                        console.log(e);
                    }
                });

                if (self.RelationItems().length > 0) {
                    try {
                        var ri = self.RelationItems()[0];
                        if (ri.IntersectType() > '') {
                            postModel.RelationItem["ID"] = ri.ID();
                            postModel.RelationItem.IntersectType = ri.IntersectType().split('|')[0];
                            postModel.RelationItem.ReferenceType = ri.ReferenceType();
                            if (ri.ChildIntersectType() > '') {
                                postModel.RelationItem.ChildIntersectType = ri.ChildIntersectType().split('|')[0];
                            }
                            $.each(ri.DisplayFieldOptions(), function(fix, fid){
                                var values = fid.value().split('|');
                                
                                if (fid.Show() || fid.SortOrder() || fid.FilterValue() != '') {
                                    postModel.RelationItem.DisplayFields.push({
                                        FieldTypeID: values[0],
                                        FieldTypeName: values[1],
                                        Show: fid.Show(),
                                        SortOrder: fid.SortOrder(),
                                        FilterValue: fid.FilterValue()
                                    });                                
                                }
                            });
                            postModel.RelationItem.HideHeader = ri.HideHeader();
                            postModel.RelationItem.HideFooter = ri.HideFooter();
                        }
                    } catch (e) {
                        console.log(e);
                    }
                }

                var uri = '';
                var method = '';
                if (self.ID() > 0) {
                    uri = '/form/EditFieldType';
                    method = 'PUT';
                }
                else {
                    uri = '/form/AddFieldType';
                    method = 'POST';
                }

                $.ajax(uri, {
                    data: postModel,
                    dataType: 'json',
                    method: method
                }).done(function (data, status, xhr) {
                    if (data != null) {
                        if (data.type == 'error') {
                            amplify.publish("ShowMessage", { type: "error", title: data.title, message: data.message });
                        } else {
                            amplify.publish("SaveAction", { context: self.Context(), action: 'add', id: 0, custom: {} });
                            amplify.publish("ShowMessage", { type: "confirm", title: "Success!", message: 'Field type successfully created.' });
                        }
                    }

                }).fail(function (xhr, status, error) {
                    amplify.publish("ShowMessage", { type: "error", title: "Error!", message: error });
                }).always(function (data, status, error) {
                    self.InProgress(false);
                });
            }
        }

        //#endregion

        return self;
    }

    $(function () {
        var model = new FieldTypeViewModel({
            ID: @(Model.FieldType.ID),
            Context: "@(ContextList.FieldType)",
            Object: "@(Model.FieldType.Object)",
            ObjectID: "@(Model.FieldType.ObjectID)"
        });
        ko.applyBindings(model, document.getElementById('FieldTypeFormWrapper'));
        model.loadCurrentType();

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>