    <!-- /ko -->
    <tr style="vertical-align: top">
        @*<td><input type="text" style="font-size: 150%; font-weight: 600" data-bind="jqxInput: { theme: theme, width: field_width, height: field_height, value: Name}" /></td>*@
        <td colspan="3"><textarea data-bind="textInput: Formula" /></td>
        <td style="width: 20px; border: none !important"></td>
        <td colspan="3"><textarea data-bind="textInput: Definition" /></td>
        <td style="width: 20px; border: none !important"></td>
        @*<td></td>*@
        <td style="width: 20px; text-align: right">
            <a style="padding: 0 .5rem;" class="waves-effect waves-teal btn-flat" title="Add item to group" data-bind="click:addItem"><i class="fa fa-plus-circle"></i></a>
        </td>
        <td style="width: 20px; text-align: right">
            <a style="padding: 0 .5rem;" class="waves-effect waves-teal btn-flat" title="Remove this group" data-bind="click: $parent.deleteGroup"><i class="fa fa-trash"></i></a>
        </td>
    </tr>
    <tr>
        <td colspan="10" style="height: 20px">&nbsp;</td>
    </tr>
</script>

<script id="sourceToTargetTmpl" type="text/html">
    <div class="left form-header-info">
        <h4>@(Model.FormTitle)</h4>
    </div>
    <div class="right">
        <button type="button" id="EditableFormCancelButton" data-bind="click: cancel" class="btn waves-effect waves-light brown lighten-4">Cancel</button>
        <button type="button" id="EditableFormSaveButton" data-bind="click: save, css: { disabled: GroupsNotPresent }" class="btn waves-effect waves-light brown lighten-1 saveButton">Save</button>
    </div>
    <div class="clear"></div>
    <div class="form-instructions">@Html.Raw(Model.FormDescription)</div>
    <div id="progress" data-bind="visible: InProgress"><i class="fa fa-spinner fa-spin fa-4x"></i></div>

    <div class="row" id="Step1">
        <div class="col s6">
            <div class="FieldNameRequired" data-bind="text: Step1Title"></div>
            <div id="Relationships" data-bind="jqxDropDownList: {
                 width: field_width,
                 theme: theme,
                 filterable: true,
                 source: RelationshipOptions,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase',
                 checkboxes: true }"></div>
            <span data-bind="visible: RelationshipOptionsLoading">Loading, please wait...</span>
        </div>
        @*<div class="right">
                <button title="Next"><i class="fa fa-chevron-right"></i></button>
            </div>
            <div class="clear"></div>*@
    </div>

    <div class="row" id="Step2" data-bind="visible: RelationshipsLoaded">
        <div class="col s12">
            <div class="tile root-tile">
                <header>
                    Build Mappings
                    <div class="TileTools">
                        <button type="button" alt="Add group" data-bind="click:addGroup" class="btn-floating waves-effect waves-light brown lighten-1"><i class="fa fa-plus"></i></button>
                    </div>
                </header>
                <table class="responsive-table">
                    <thead>
                        <tr>
                            <th colspan="3" style="font-size: 140%" class="brown lighten-5">Source</th>
                            <th style="width: 20px; border: none !important"></th>
                            <th colspan="3" style="font-size: 140%" class="brown lighten-5">Target</th>
                            <th style="width: 20px; border: none !important"></th>
                            @*<th style="font-size: 140%" class="brown lighten-5">Context</th>*@
                            <th colspan="2"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="template: {name: 'sourceToTargetGroupsTmpl', foreach: Groups }"></tbody>
                </table>
                @*<footer>
                        <div class="TileTools">
                            <button alt="Previous" class="btn-floating waves-effect waves-light brown lighten-1"><i class="fa fa-chevron-left"></i></button>
                            <button alt="Next" class="btn-floating waves-effect waves-light brown lighten-1"><i class="fa fa-chevron-right"></i></button>
                        </div>
                    </footer>*@
            </div>
        </div>
    </div>

    @*<div class="row" id="Step3" data-bind="visible: RelationshipsLoaded">
        <div class="col s12">
            <div class="FieldNameRequired">Where is this Executed?</div>
            <table class="bordered responsive-table">
                <thead>
                    <tr>
                        <th>Location</th>
                        <th>Group</th>
                        <th>Timing</th>
                    </tr>
                </thead>
                <tbody data-bind="template: {name: 'sourceToTargetEnvironmentsTmpl', foreach: Environments }"></tbody>
            </table>
        </div>*@
    @*<div class="right">
            <button title="Previous"><i class="fa fa-chevron-left"></i></button>
            <button title="Next"><i class="fa fa-chevron-right"></i></button>
        </div>
        <div class="clear"></div>
    </div>*@

    @*<div class="row" id="Step4">
            <div class="col s12">
                <div class="FieldNameRequired">Continue with Mappings?</div>
                <div id="Summary"></div>
            </div>
            <div class="right">
                <button title="Previous"><i class="fa fa-chevron-left"></i></button>
                <button title="Finish"><i class="fa fa-chevron-right"></i></button>
            </div>
            <div class="clear"></div>
        </div>*@
</script>

<script type="text/javascript">
    var formUri = "@(Model.FormUri)";
    var formMethod = "@(Model.FormMethod)";
    var object = "@(Model.Object)";
    var objectID = @(Model.ObjectID);
    var objectName = "@(Model.ObjectName)";
    var context = "@(Model.Context)";

    $(function () {

        var model = new SourceToTargetViewModel({
            Object: object,
            ObjectID: objectID,
            ObjectName: objectName,
            Context: context
        });
        ko.applyBindings(model, document.getElementById('SourceToTargetWrapper'));
        model.getRelationshipOptions();

        $("#Relationships").on('checkChange', function (event)
        {
            if (event.args) {
                var item = event.args.item;
                var value = item.value;
                var label = item.label;

                var selectedRelation = { Object: 'Artifact', ObjectID: value, ObjectName: item.label };
                if (item.checked) {
                    model.addRelationship(selectedRelation);
                }
                else {
                    model.deleteRelationship(selectedRelation);
                }
                //console.log(model.Relationships().length);
            }
        });

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
