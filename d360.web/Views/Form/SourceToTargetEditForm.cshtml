                 searchMode: 'containsignorecase'
                 }"></div>
        </td>
        <th style="width: 20px; border: none !important"></th>

        <td>
            <div data-bind="targetSystemFilteredDropdown, jqxDropDownList: {
                 width: field_width98,
                 dropDownWidth: 600,
                 theme: theme,
                 filterable: true,
                 source: $parent.Systems,
                 selectedIndex: TargetSystemIndex,
                 displayMember: 'ObjectName',
                 valueMember: 'ObjectID',
                 searchMode: 'containsignorecase'
                 }"></div>
        </td>
        <td>
            <div data-bind="targetObjectFilteredDropdown, jqxDropDownList: {
                 width: field_width98,
                 dropDownWidth: 600,
                 theme: theme,
                 filterable: true,
                 source: TargetObjectOptions,
                 selectedIndex: TargetObjectIndex,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase'
                 }"></div>
        </td>
        <td>
            <div data-bind="targetFusionAttributeFilteredDropdown, jqxDropDownList: {
                 width: field_width98,
                 dropDownWidth: 600,
                 theme: theme,
                 filterable: true,
                 source: TargetFusionAttributeOptions,
                 selectedIndex: TargetFusionAttributeIndex,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase'
                 }"></div>
        </td>
        <th style="width: 20px; border: none !important"></th>

        @*<td><input type="text" data-bind="textInput: Contexts" style="font-size: 70%" /></td>*@
