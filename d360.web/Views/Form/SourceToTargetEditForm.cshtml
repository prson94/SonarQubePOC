@using d360.web.Models;
@model SourceToTargetEditForm
<div class="large-overlay">
    <div class="ui segment">
        <div id="SourceToTargetWrapper" data-bind="template: {name: 'sourceToTargetTmpl' }"></div>
    </div>
</div>

<script id="sourceToTargetEnvironmentsTmpl" type="text/html">
    <tr style="vertical-align: top">
        <td><input type="text" data-bind="textInput: Object" /></td>
        <td colspan="2"><textarea data-bind="textInput: Group" /></td>
        <td colspan="3"><textarea data-bind="textInput: Timing" /></td>
        <td>
            <button type="button" title="Remove this location" data-bind="click: $parent.deleteEnvironment"><i class="fa fa-trash"></i></button>
        </td>
    </tr>
</script>

<script id="sourceToTargetGroupsTmpl" type="text/html">
    <tr class="blue lighten-4">
        <td>System</td>
        <td>Business Term</td>
        <td>Fusion Attribute</td>
        <td style="width: 20px; border: none !important"></td>

        <td>System</td>
        <td>Business Term</td>
        <td>Fusion Attribute</td>
        <td style="width: 20px; border: none !important"></td>

        <td colspan="2"></td>
    </tr>
    <!-- ko foreach: Items -->
    <tr>
        <td>
            <div data-bind="sourceSystemFilteredDropdown, jqxDropDownList: {
                 width: field_width98,
                 dropDownWidth: 600,
                 theme: theme,
                 filterable: true,
                 source: $parent.Systems,
                 selectedIndex: SourceSystemIndex,
                 displayMember: 'ObjectName',
                 valueMember: 'ObjectID',
                 searchMode: 'containsignorecase'
                 }"></div>
        </td>
        <td>
            <div data-bind="sourceObjectFilteredDropdown, jqxDropDownList: {
                 width: field_width98,
                 dropDownWidth: 600,
                 theme: theme,
                 filterable: true,
                 source: SourceObjectOptions,
                 selectedIndex: SourceObjectIndex,
                 displayMember: 'title',
                 valueMember: 'value',
                 searchMode: 'containsignorecase'
                 }"></div>
        </td>
        <td>
            <div data-bind="sourceFusionAttributeFilteredDropdown, jqxDropDownList: {
                 width: field_width98,
                 dropDownWidth: 600,
                 theme: theme,
                 filterable: true,
                 source: SourceFusionAttributeOptions,
                 selectedIndex: SourceFusionAttributeIndex,
                 displayMember: 'title',
