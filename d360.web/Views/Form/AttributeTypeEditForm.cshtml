@using d360.web.Models;
@model d360.web.Models.AttributeTypeEditorModel
<div class="small-overlay">
    <div class="ui segment">
        @using (Ajax.BeginForm(new AjaxOptions { HttpMethod = Model.FormMethod, Url = Html.Raw(Model.FormUri).ToHtmlString(), OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
        {
            @Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = ContextList.AttributeType, Description = Model.FormDescription, Name = Model.FormName })
            <input type="hidden" id="_context" name="_context" value="@(ContextList.AttributeType)" />
            <input type="hidden" id="ID" name="ID" value="@(Model.AttributeType.ID)" />
            <input type="hidden" id="ParentID" name="ParentID" value="@(Model.AttributeType.ParentID)" />
            <div class="row">
                <div class="col s9">
                    <div id='NameTip' class="FieldNameRequired">@Model.AttributeType.GetName(i => i.Name)</div>
                    <input id="Name" name="Name" type="text" />
                </div>
                <div class="col s3">
                    <div id='ShowNameInTreeTip' class="FieldName">@Model.AttributeType.GetName(i => i.ShowNameInTree)</div>
                    <input id="ShowNameInTree" name="ShowNameInTree" type="checkbox" @(Model.AttributeType.ShowNameInTree ? "checked='checked'" : "") />
                </div>
            </div>
            <div class="row">
                <div class="col s8">
                    <div id='TextFormatStringTip' class="FieldNameRequired">@Model.AttributeType.GetName(i => i.TextFormatString)</div>
                    <input id="TextFormatString" name="TextFormatString" type="text" />
                </div>
                <div class="col s4">
                    <div class="FieldNameRequired">&nbsp;</div>
                    @Html.DropDownList("Tokens", Model.Tokens, "Field Tokens", new { @class = "browser-default" })
                </div>
            </div>
            <div class="row">
                <div class="col s12">
                    <div id='AttributeTypeCategoryTip' class="FieldNameRequired">@Model.AttributeType.GetName(i => i.AttributeTypeCategoryID)</div>
                    @Html.DropDownList("AttributeTypeCategoryID", Model.AttributeTypeCategories, new { @class = "browser-default" })
                </div>
            </div>
            <div class="row">
                <div class="col s12">
                    <div class="FieldName"><span id='DescriptionTip'>@Model.AttributeType.GetName(i => i.Description)</span></div>
                    <div id="Description" class="htmlArea" style="width:100%">@Html.Raw(Model.AttributeType.Description)</div>
                </div>
            </div>
        }
    </div>
</div>
<script type="text/javascript">
    var used = false;
    var tokens = @(Model.Tokens.Count);

    $(function () {
        var w = '100%',
            h = 25;

        $("#Name").jqxInput({ width: field_width, theme: theme, height: h });
        $("#TextFormatString").jqxInput({ width: field_width, theme: theme, height: h });
        $("#Tokens").jqxDropDownList({ width: field_width, theme: theme });
        $("#AttributeTypeCategoryID").jqxDropDownList({ width: field_width, theme: theme });

        $('#form0').jqxValidator({
            hintType: 'label',
            rules: [
                {
                    input: "#Name",
                    rule: 'required',
                    action: 'blur',
                    message: 'Name is required.'
                },
                {
                    input: '#TextFormatString', message: 'Tokenized value required.', action: 'blur',
                    rule: function () {
                        var success = false;
                        if (tokens > 0) {
                            var format = $('#TextFormatString').val();
                            success = (format != '');
                        }
                        else {
                            success = true;
                        }
                        return success;
                    }
                }
            ]
        });

        //#region Help Tooltips

        tipCss = 'qtip-blue qtip-shadow';
        $('#NameTip').qtip({
            content: {
                text: "Please provide a name for this attribute type."
            },
            style: {
                classes: tipCss
            }
        });
        $('#TextFormatStringTip').qtip({
            content: {
                text: "You may provide one or more tokenized values from the dropdown to the right."
            },
            style: {
                classes: tipCss
            }
        });
        $('#DescriptionTip').qtip({
            content: {
                text: "Provide any description that will be displayed by default any time someone sees information in this field."
            },
            style: {
                classes: tipCss
            }
        });
        $('#AttributeTypeCategoryTip').qtip({
            content: {
                text: "You may assign this attribute to belong to a particular category.  It can also be an enterprise-wide attribute."
            },
            style: {
                classes: tipCss
            }
        });
        $('#VocabularyTip').qtip({
            content: {
                text: "You may assign this attribute to belong to a particular vocabulary.  It can also be an enterprise-wide attribute."
            },
            style: {
                classes: tipCss
            }
        });

        //#endregion

        //#region Events

        $('#Tokens').on('change', function () {
            $("#TextFormatString").val($("#TextFormatString").val() + $('#Tokens').val());
            $('#Tokens').val('');
        });

        $('#form0').on('validationSuccess', function (event) {
            // You can submit the form.
            $('#form0').submit();
        });
        $('#EditableFormSaveButton').on('click', function () {
            $('#form0').jqxValidator('validate');
        });

        $('#EditableFormCancelButton').on('click', function () {
            amplify.publish("CancelAction", { context: $('#EditableFormCancelButton').data('context') });
        });
        amplify.subscribe("ErrorOccurredAction", function (data) {
            $('#EditableFormSaveButton').hide();
        });
        amplify.subscribe("StartingAjax", function () {
            $('#EditableFormSaveButton').attr('disabled', 'disabled');
            $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');
        });
        amplify.subscribe("EndingAjax", function () {
            $('#EditableFormSaveButton').removeAttr('disabled');
            $('#progress').html('');
        });

        //#endregion

        //#region Set Values HttpUtility.JavaScriptStringEncode
        $("#Name").val("@(Html.Raw(HttpUtility.JavaScriptStringEncode(Model.AttributeType.Name)))");
        $("#TextFormatString").val("@(Html.Raw(HttpUtility.JavaScriptStringEncode(Model.AttributeType.TextFormatString)))");
        //#endregion

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
