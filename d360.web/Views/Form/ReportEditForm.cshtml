@using d360.web.Models;
@using d360.core.resources;
@model ReportEditorModel
<div class="small-overlay">
    <div class="ui segment">
        @Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = ContextList.Report, Description = Model.FormDirections, Name = Model.FormName })
        @using (Ajax.BeginForm(new AjaxOptions { HttpMethod = Model.FormMethod, Url = Model.FormUri, OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnBegin = "OnStarting" }))
        {
            <input type="hidden" id="_context" name="_context" value="@(ContextList.Report)" />
            <input type="hidden" id="ID" name="ID" value="@(Model.Report.ID)" />

            <div class="row">
                <div class="col s6">
                    <div id='NameTip' class="FieldNameRequired">Name</div>
                    <input id="Name" name="Name" type="text" value="@(Model.Report.Name)" />
                </div>
                <div class="col s6">
                    <div id='ObjectTypeTip' class="FieldNameRequired">Target Type</div>
                    @Html.DropDownList("ObjectType", Model.ObjectTypes, "Select target type", new { @class = "browser-default" })
                </div>
            </div>

            <div class="row">
                <div class="col s6">
                    <div id='ReportLayoutTip' class="FieldNameRequired">@Model.Report.GetName(i => i.ReportLayout)</div>
                    @Html.DropDownList("ReportLayoutID", Model.ReportLayouts, "Select layout", new { @class = "browser-default" })
                </div>
                <div class="col s6">
                    <div class="FieldName">Layout Sample</div>
                    <div id="ReportLayoutSample" data-bind="template: { name: 'reportTmpl' }"></div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-12 col-md-12">
                    <div id='DescriptionTip' class="FieldName">Description</div>
                    <div id="Description" class="htmlArea" style="width:100%">@Html.Raw(Model.Report.Description)</div>
                </div>
            </div>
        }
    </div>
</div>

<script type="text/javascript">
    $(function () {
        var reportLayoutID = @(Model.Report.ReportLayoutID);
        var formUri = "@(Model.FormUri)";
        var formMethod = "@(Model.FormMethod)";

        var nameTip = "@Model.Report.GetDescription(i => i.Name)";
        var descriptionTip = "@Model.Report.GetDescription(i => i.Description)";
        var reportLayoutTip = "@Model.Report.GetDescription(i => i.ReportLayoutID)";

        var layoutTileVm = new ReportLayoutModel(reportLayoutID);
        ko.applyBindings(layoutTileVm, document.getElementById('ReportLayoutSample'));
        if (reportLayoutID > 0) {
            layoutTileVm.ChangeObject(reportLayoutID);
        }

        //#region Control Instantiation

        $("#Name").jqxInput({ width: field_width, theme: theme, height: 25 });
        $("#ObjectType").jqxDropDownList({ width: field_width, theme: theme });
        $("#ReportLayoutID").jqxDropDownList({ width: field_width, theme: theme });

        $('#form0').jqxValidator({
            hintType: 'label',
            rules: [
                {
                    input: "#Name",
                    rule: 'required',
                    action: 'blur',
                    message: 'Name is required.'
                }
            ]
        });

        //#endregion

        //#region Help Tooltips

        tipCss = 'qtip-blue qtip-shadow';
        $('#NameTip').qtip({
            content: { text: nameTip },
            style: { classes: tipCss }
        });

        $('#DescriptionTip').qtip({
            content: { text: descriptionTip },
            style: { classes: tipCss }
        });

        $('#ReportLayoutTip').qtip({
            content: { text: reportLayoutTip },
            style: { classes: tipCss }
        });

        //#endregion

        //#region Events

        $('#ReportLayoutID').on('change', function () {
            if ($('#ReportLayoutID').val() != '') {
                reportLayoutID = $('#ReportLayoutID').val();
                layoutTileVm.ChangeObject(reportLayoutID);
            }
        });

        $('#form0').on('validationSuccess', function (event) {
            // You can submit the form.
            $('#form0').submit();
        });
        $('#EditableFormSaveButton').on('click', function () {
            $('#form0').jqxValidator('validate');
        });

        $('#EditableFormCancelButton').on('click', function () {
            amplify.publish("CancelAction", { context: $('#EditableFormCancelButton').data('context') });
        });
        amplify.subscribe("ErrorOccurredAction", function (data) {
            $('#EditableFormSaveButton').hide();
        });
        amplify.subscribe("StartingAjax", function () {
            $('#EditableFormSaveButton').attr('disabled', 'disabled');
            $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');
        });
        amplify.subscribe("EndingAjax", function () {
            $('#EditableFormSaveButton').removeAttr('disabled');
            $('#progress').html('');
        });

        //#endregion

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
