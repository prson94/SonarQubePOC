@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Excel</title>
    <link href="/Content/styles/jqx.base.min.css" rel="stylesheet" />
    <link href="/Content/styles/jqx.metro.min.css" rel="stylesheet" />
    <link href="/Content/styles/OfficeApps.min.css" rel="stylesheet" />
    <script src="/Scripts/jquery-2.1.3.js"></script>
    <script src="https://appsforoffice.microsoft.com/lib/1.1/hosted/office.js" type="text/javascript"></script>
    <script src="/Scripts/jqx/3.6.0/jqx-all.js"></script>
    <script src="/Scripts/OfficeApps.js"></script>
    <script type="text/javascript">
        (function () {
            "use strict";

            var parameters = {
                ReportID: 0,
                TileID: 0,
                Type: '',
                ID: 0
            };

            // The initialize function must be run each time a new page is loaded
            Office.initialize = function (reason) {

                //#region Office Excel extensions

                //extension to Office.TableData to add headers
                Office.TableData.prototype.addHeaders = function (obj) {
                    var h = new Array();
                    for (var prop in obj) {
                        //ignore complex types empty columns and __type from WCF
                        if (typeof (obj[prop]) != 'object' &&
                            prop.trim().length > 0 &&
                            prop != '__type')
                            h.push(prop);
                    }
                    this.headers = h;
                }

                //extension to Office.TableData to add a range of rows
                Office.TableData.prototype.addRange = function (array) {
                    for (var i = 0; i < array.length; i++) {
                        var itemsTemp = new Array();
                        $(this.headers[0]).each(function (ii, ee) {
                            itemsTemp.push(array[i][ee]);
                        });
                        this.rows.push(itemsTemp);
                    }
                }

                //#endregion

                $(document).ready(function () {

                    $('#get-data-from-selection').jqxButton({ theme: 'metro' });
                    $('#TileDataUri').jqxInput({ theme: 'metro', width: '100%', disabled: true });

                    //#region Grid Logic

                    var GridSource = {
                        datatype: 'json',
                        url: '/reports/tiles',
                        datafields: [
                            { name: 'ID' },
                            { name: 'Name' },
                            { name: 'ReportID' },
                            { name: 'Report' },
                            { name: 'ObjectType' },
                            { name: 'ObjectID' }
                        ],
                        id: 'ID'
                    };

                    var GridAdapter = new $.jqx.dataAdapter(GridSource);

                    $('#Grid').jqxGrid({
                        altrows: true,
                        width: '100%',
                        autoheight: true,
                        sortable: true,
                        filterable: true,
                        showfilterrow: true,
                        virtualmode: false,
                        pageable: true,
                        pagesizeoptions: ['5', '10', '25'],
                        pagesize: 5,
                        columnsresize: false,
                        enabletooltips: true,
                        source: GridAdapter,
                        theme: 'metro',
                        columns: [
                            { datafield: "Report", text: "Report", width: '50%' },
                            { datafield: "Name", text: "Tile", width: '50%' }
                        ]
                    });

                    //#endregion

                    //#region Dropdown Logic

                    var InstanceSource = {
                        datatype: 'json',
                        url: null,
                        datafields: [
                            { name: 'ID' },
                            { name: 'Name' }
                        ],
                        id: 'ID'
                    };

                    var InstanceAdapter = new $.jqx.dataAdapter(InstanceSource);

                    $('#InstanceDropdown').jqxListBox({
                        disabled: true,
                        theme: 'metro',
                        width: '100%',
                        height: 100,
                        source: InstanceAdapter,
                        valueMember: 'ID',
                        displayMember: 'Name'
                    });

                    //#endregion

                    //#region Events

                    $('#Grid').on('rowselect', function (event) {

                        var args = event.args;              // event arguments.
                        var rowBoundIndex = args.rowindex;  // row's bound index.
                        var data = args.row;             // row's data.

                        parameters.ReportID = data.ReportID;
                        parameters.TileID = data.ID;
                        parameters.Type = data.ObjectType;
                        parameters.ID = data.ObjectID;

                        if (data.ObjectType == 'Artifact' || data.ObjectType == 'Domain' || data.ObjectType == 'Taxonomy') {
                            $('#InstanceDropdown').jqxListBox('disabled', false);
                            $('#InstanceArea').fadeIn(500);
                            InstanceSource.url = "/reports/instances/" + data.ObjectType + "Type/" + data.ObjectID;
                            InstanceAdapter.dataBind();
                            $('#ButtonArea').fadeOut(500);
                        }
                        else {
                            $('#TileDataUri').val(getTileDataUri());
                            $('#InstanceArea').fadeOut(500);
                            $('#InstanceDropdown').jqxListBox('disabled', true);

                            $('#ButtonArea').fadeIn(500);
                        }
                    });

                    $('#InstanceDropdown').on('change', function (event) {
                        var args = event.args;
                        if (args) {
                            // index represents the item's index.
                            //var index = args.index;
                            var item = args.item;
                            // get item's label and value.
                            //var label = item.label;
                            var value = item.value;
                            parameters.ID = value;
                            $('#TileDataUri').val(getTileDataUri());

                            if (parameters.ID > 0) {
                                $('#ButtonArea').fadeIn(500);
                            }
                            else {
                                $('#ButtonArea').fadeOut(500);
                            }
                        }
                    });

                    $('#get-data-from-selection').on('click', function () {
                        var uri = getTileDataUri();//(7, 13, 'ArtifactType', 1);
                        loadDataIntoSheet(uri);
                        //// Get what the user has selected in the spreadsheet
                        //Office.context.document.getSelectedDataAsync(Office.CoercionType.Text,
                        //    function (result) {
                        //        if (result.status === Office.AsyncResultStatus.Succeeded) {
                        //            app.showNotification('The selected text is:', '"' + result.value + '"');
                        //        } else {
                        //            app.showNotification('Error:', result.error.message);
                        //        }
                        //    }
                        //);
                    });

                    //#endregion

                });
            };

            //#region Utility methods

            function loadDataIntoSheet(uri) {
                $.ajax({
                    url: uri,
                    method: 'GET',
                    success: function (data, status, xhr) {
                        var officeTable = new Office.TableData();
                        officeTable.addHeaders(data[0]);
                        officeTable.addRange(data);
                        setExcelData(officeTable);
                    },
                    error: function (xhr, status, error) {
                        app.showNotification('Error Getting Data', error + ' ' + status);
                    },
                    complete: function (xhr, status) {
                        //app.showNotification('Complete', status);
                    }
                });
            }

            function getTileDataUri() {//(reportID, tileID, type, id) {
                return '/reports/' + parameters.ReportID + '/' + parameters.Type + '/' + parameters.ID + '/tiles/' + parameters.TileID + '/data';
                //return '/reports/' + reportID + '/' + type + '/' + id + '/tiles/' + tileID + '/data';
            }

            //write the TableData to Excel
            function setExcelData(officeTable) {
                if (officeTable != null) {
                    Office.context.document.setSelectedDataAsync(officeTable, { coercionType: Office.CoercionType.Table }, function (asyncResult) {
                        if (asyncResult.status == Office.AsyncResultStatus.Failed) {
                            app.showNotification('Error', 'Set Selected Data Failed');
                        }
                        //else {
                        //    app.showNotification('Success', 'Set Selected Data Success');
                        //}
                    });
                }
            }

            //#endregion

        })();
    </script>
</head>
<body>
    <div id="content-header">
        <div>Tile Data Viewer</div>
    </div>
    <div id="content-main">
        <div class="padding">
            <label for="Grid">Choose a report tile:</label>
            <div id="Grid"></div>
            <div id="InstanceArea" style="display:none; margin-top: 20px">
                <label for="InstanceDropdown">Choose an instance:</label>
                <div id="InstanceDropdown"></div>
            </div>
            <div id="ButtonArea" style="display:none; margin-top: 20px">
                <button id="get-data-from-selection">Get tile data</button>
                <br />
                <label for="Grid">Or copy this into PowerQuery:</label>
                <input id="TileDataUri" type="text" />
            </div>
        </div>
    </div>
    <div id="notification-message">
        <div class="padding">
            <div id="notification-message-close"></div>
            <div id="notification-message-header"></div>
            <div id="notification-message-body"></div>
        </div>
    </div>
    <script type="text/javascript">
        $('#notification-message-close').click(function () {
            $('#notification-message').hide();
        });
    </script>
</body>
</html>
