@model d360.web.Models.LoginModel
@{
    ViewBag.Title = "Login";
    Layout = null;
    var VersionNumber = ViewData["VersionNumber"].ToString();
    var suffix = System.Configuration.ConfigurationManager.AppSettings["ResourceSuffix"];
}
<!DOCTYPE html>
<html class="no-js">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Data3Sixty, Inc.</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="Shortcut Icon" href="/favicon.ico" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.4/jquery.min.js"></script>
    <script src="/Scripts/jqx/3.7.1/jqx-all.js"></script>
    <link rel="stylesheet" href="/Content/styles/root@(suffix).css?version=@(VersionNumber)" />
    <script type="text/javascript">
    $(document).ready(function () {
        $("#UserName").jqxInput({ width: '95%', theme: 'd3s', minLength: 10 });
        $("#Password").jqxInput({ width: '95%', theme: 'd3s', minLength: 6 });
        $("#LoginButton").jqxButton({ width: '95%', theme: 'd3s' });
        $("#UserName").focus();
        $('input').keypress(function (e) {
            if (e.which == 13) {
                $('#LoginButton').submit();
            }
        });
    });
    </script>
</head>
<body>
    <div id="loginForm">
        @Html.ValidationSummary()

        @using (Html.BeginForm())
        {
            <div class="FieldNameRequired">@Html.LabelFor(m => m.UserName)</div>
            <input type="text" id="UserName" name="UserName" />
            @Html.ValidationMessageFor(m => m.UserName)
            <div class="FieldNameRequired">@Html.LabelFor(m => m.Password)</div>
            <input type="password" id="Password" name="Password" autocomplete="off" />
            @Html.ValidationMessageFor(m => m.Password)
            <br /><br />
            <input id="LoginButton" type="submit" value="Login!" tabindex="3" />
        }
    </div>
</body>
</html>