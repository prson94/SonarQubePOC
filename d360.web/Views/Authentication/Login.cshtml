@model d360.web.Models.LoginModel
@{
    ViewBag.Title = "Login";
    Layout = "../Shared/Anonymous.cshtml";

    var settings = (Dictionary<string, string>)ViewData["Settings"];
    var hasRegisterSetting = settings["HasRegisterLink"];
    var hasRegister = false;

    if ((hasRegisterSetting ?? "").ToLower() == "true")
    {
        hasRegister = true;
    }
}
@section TopCss {

}
<body class="loginBody">
    <span class="loginlogo"></span>
    <div id="loginForm">
        <h4>Log in To Data360</h4>
        @Html.ValidationSummary()

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <input placeholder="Username" type="text" id="UserName" name="UserName" required pattern=".{10,}" title="Username must be at least 10 characters long." style="width:100%" />
            @Html.ValidationMessageFor(m => m.UserName)
            <div>&nbsp;</div>
            <input type="password" placeholder="Password" id="Password" name="Password" autocomplete="off" required pattern=".{6,}" title="Password must be at least 6 characters long." style="width:100%" />
            @Html.ValidationMessageFor(m => m.Password)
            <br /><br />
            <div><input id="loginButton" type="submit" value="Log in" tabindex="3" style="width:100%" /></div>
            <br/>
        }
        <a href="reset">Forgot your Password?</a>@if(hasRegister)
        {
            @:&nbsp; &#124;&nbsp;<a href="register">Register</a>
        }
    </div>
</body>
