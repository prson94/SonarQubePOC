@model d360.web.Models.LoginModel
@{
    ViewBag.Title = "Login";
    Layout = null;
    var VersionNumber = ViewData["VersionNumber"].ToString();
    var suffix = System.Configuration.ConfigurationManager.AppSettings["ResourceSuffix"];
}
<!DOCTYPE html>
<html class="no-js">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Data3Sixty, Inc.</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="Shortcut Icon" href="/favicon.ico" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.4/jquery.min.js"></script>    
    <link rel="stylesheet" href="/Content/styles/root@(suffix).css?version=@(VersionNumber)" />
    <script type="text/javascript">
    $(document).ready(function () {        
        $("#UserName").focus();
        $('input').keypress(function (e) {
            if (e.which == 13) {
                $('#loginButton').submit();
            }
        });
    });
    </script>
    <style>
        .loginlogo{
            background-image: url(/Content/images/logo.new.png);
            background-repeat: no-repeat;
            background-position: left top;
            background-size: auto 40px;
            height: 40px;
            width:200px;
            display:inline-block;
        }
    </style>
</head>
<body class="loginBody">
    <span class="loginlogo"></span>
    <div id="loginForm">
        <h4>Log in To Data3Sixty</h4>        
        @Html.ValidationSummary()

        @using (Html.BeginForm())
        {
            <input placeholder="Username" type="text" id="UserName" name="UserName" required pattern=".{10,}" title="Username must be at least 10 characters long." style="width:100%" />
            @Html.ValidationMessageFor(m => m.UserName)
            <div>&nbsp;</div>
            <input type="password" placeholder="Password" id="Password" name="Password" autocomplete="off" required pattern=".{6,}" title="Password must be at least 6 characters long." style="width:100%" />
            @Html.ValidationMessageFor(m => m.Password)
            <br /><br />
            <div><input id="loginButton" type="submit" value="Log in" tabindex="3" style="width:100%" /></div>
        }
    </div>
</body>

</html>