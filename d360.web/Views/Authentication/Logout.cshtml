@model d360.web.Models.LoginModel
@{
    ViewBag.Title = "Logout";
    Layout = null;
    var VersionNumber = ViewData["VersionNumber"].ToString();
    var suffix = System.Configuration.ConfigurationManager.AppSettings["ResourceSuffix"];
}
<!DOCTYPE html>
<html class="no-js">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Data3Sixty, Inc.</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="Shortcut Icon" href="/favicon.ico" />    
    <link rel="stylesheet" href="/Content/styles/root@(suffix).css?version=@(VersionNumber)" />    
    <style>
        .loginlogo {
            background-image: url(/Content/images/logo.new.png);
            background-repeat: no-repeat;
            background-position: left top;
            background-size: auto 40px;
            height: 40px;
            width: 200px;
            display: inline-block;
        }
    </style>
</head>
<body class="loginBody">
    <span class="loginlogo"></span>
    <div id="loginForm">
        <h4>You have been logged out of Data3Sixty</h4>        
        <p>Please click <a href="/">here</a> to log back in</p>
    </div>
</body>
</html>