@{
    var idPrefix = ViewData["Object"].ToString();
}
<div class="tile tile-detail">
    <header>Business Attributes</header>
    <article class="row">
        <div class="col-lg-5 col-md-5 col-sm-6">
            <div id="@(idPrefix)AttributeTree"></div>
        </div>
        <div class="col-lg-7 col-md-7 col-sm-6">
            <div id="@(idPrefix)AttributeViewer">
                <div id="@(idPrefix)AttributeToolbar"></div>
                <div id="@(idPrefix)AttributeDetail"></div>
            </div>
            <div id="@(idPrefix)AttributeEditor"></div>
        </div>
    </article>
</div>
<script type="text/javascript">
    var contextMenu;
    var showTechnical = false;
    var object = "@(ViewData["Object"])";
    var objectID = "@(ViewData["ObjectID"])";
    var context = 'attributeform';

    function attributeSwitchToEditor(uri) {
        $('#@(idPrefix)AttributeDetail').Detail('clear');
        $('#@(idPrefix)AttributeViewer').hide();
        $('#@(idPrefix)AttributeEditor').fadeIn();
        $('#@(idPrefix)AttributeEditor').load(uri);
    }

    function attributeSwitchToViewer(type, id) {
        $('#@(idPrefix)AttributeEditor').html('');
        if (type && id) {
            $('#@(idPrefix)AttributeDetail').Detail('reload', type, id);
        }
        else {
            $('#@(idPrefix)AttributeDetail').Detail('clear');
        }
        $('#@(idPrefix)AttributeViewer').fadeIn();
        $('#@(idPrefix)AttributeEditor').hide();
    }

    $(function () {

        $('#@(idPrefix)AttributeDetail').Detail({ context: context, prefix: 'Attribute', listenfortoolactions: true });

        $("#@(idPrefix)AttributeToolbar").AttributeToolbar();

        //#region TreeGrid Logic

        var source = {
            dataType: "json",
            url: '/attributes/hierarchy/' + object + '/' + objectID,
            dataFields: [
                { name: 'ID' },
                { name: 'TypeID', type: 'int' },
                { name: 'IsCategory', type: 'bool' },
                { name: 'IsTechnical', type: 'bool' },
                { name: 'ObjectType', type: 'string' },
                { name: 'ObjectID', type: 'int' },
                { name: 'TargetObjectType', type: 'string' },
                { name: 'TargetObjectID', type: 'int' },
                { name: 'ParentObjectType', type: 'string' },
                { name: 'ParentObjectID', type: 'int' },
                { name: 'ObjectTypeName', type: 'string' },
                { name: 'expanded', type: 'bool' },
                { name: 'Name', type: 'string' },
                { name: 'Items', type: 'array' }
            ],
            hierarchy:
            {
                root: 'Items'
            },
            id: 'ID'
        };

        var dataAdapter = new $.jqx.dataAdapter(source);

        $("#@(idPrefix)AttributeTree").jqxTreeGrid({
            width: '99.5%',
            theme: list_theme,
            showHeader: false,
            selectionMode: 'singleRow',
            source: dataAdapter,
            sortable: true,
            icons: true,
            columns: [
              {
                  text: 'Name',
                  dataField: 'Name',
                  width: '100%',
                  cellsRenderer: function (rowKey, dataField, value, data) {
                      if (data.IsCategory) {
                          return "<span class='Attribute-Category'>" + data.Name + "</span>";
                      }
                      else {
                          return "<b>" + data.ObjectTypeName + "</b> : " + data.Name;
                      }
                  }
              }
            ],
            ready: function () {
                try {
                    //var firstRow = $('#AttributeTree').jqxTreeGrid('getRows')[0];
                    //var key = $("#AttributeTree").jqxTreeGrid('getKey', firstRow);
                    $('#@(idPrefix)AttributeTree').jqxTreeGrid('selectRow', 'EC');
                } catch (e) {
                    console.log(e);
                }
            }
        });

        $("#@(idPrefix)AttributeTree").bind("rowSelect", function (evt) {
            try {
                // event args.
                var args = evt.args;
                // row data.
                var row = args.row;
                // row key.
                var key = args.key;

                var type = row.ObjectType;//null;
                var id = row.ObjectID;//null;
                var detailtype = null;
                var detailid = null;
                var roottype = row.ParentObjectType; //null;
                var rootid = row.ParentObjectID; //null;
                var attributeID = null;
                var targetType = row.TargetObjectType;

                if (type == 'Attribute') {
                    attributeID = id;
                }

                if (targetType) {
                    detailtype = targetType;
                    detailid = row.TargetObjectID;
                }
                else {
                    detailtype = type;
                    detailid = id;
                }

                $('#@(idPrefix)AttributeToolbar').AttributeToolbar('loadTools', type, id, roottype, rootid, attributeID);

                if (detailid && detailtype == "Attribute") {
                    $('#@(idPrefix)AttributeDetail').Detail('reload', detailtype, detailid);
                }
                else {
                    $('#@(idPrefix)AttributeDetail').Detail('clear');
                }
            } catch (e) {
                logError("Children : AttributeTree.select", e);
            }
        });

        //#endregion

        //#region Event Subscriptions

        amplify.subscribe("AttributeToolAction", function (data) {
            if (data.context != "nullform") {
                try {
                    attributeSwitchToEditor(data.uri);
                } catch (e) {
                    logError("SPA : AttributeToolAction", e);
                }
            }
        });

        amplify.subscribe("CancelAction", function (data) {
            try {
                switch (data.context) {
                    case context:
                        var row = $("#@(idPrefix)AttributeTree").jqxTreeGrid('getSelection')[0];
                        if (row) {
                            attributeSwitchToViewer(row.ObjectType, row.ObjectID);
                        }
                        //removeOverlay();
                        break;
                }
            } catch (e) {
                logError("Children : CancelAction", e);
            }
        });

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case context:
                        //removeOverlay();
                        $('#@(idPrefix)AttributeTree').jqxTreeGrid('updateBoundData');
                        switch (data.action) {
                            case "add":
                                //load child items under selected tree node.
                                if (data.id) {
                                    //$('#AttributeTree').jqxTreeGrid('updateBoundData');
                                    $('#@(idPrefix)AttributeTree').jqxTreeGrid('selectRow', data.id);
                                    attributeSwitchToViewer('Attribute', data.id);
                                }
                                break;
                            case "delete":
                                //$('#AttributeTree').jqxTreeGrid('deleteRow', data.id);
                                attributeSwitchToViewer(null, null);
                                break;
                            case "edit":
                                //reload selected tree node.
                                $('#@(idPrefix)AttributeTree').jqxTreeGrid('selectRow', data.id);
                                //$('#AttributeTree').jqxTreeGrid('updateRow', data.id, data.custom);
                                attributeSwitchToViewer('Attribute', data.id);
                                break;
                        }
                        break;
                }
            } catch (e) {
                logError("Children : SaveAction", e);
            }
        });

        //#endregion

    });
</script>