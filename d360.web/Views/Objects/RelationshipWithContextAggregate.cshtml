@using d360.core;
@model d360.core.entities.ObjectModel
<div id="RelationshipWithContextAggregate"></div>

<script type="text/javascript">
    $(function () {
        var RelationshipWithContextAggregateContext = "@(ContextList.Intersect)";
        var type = "@(Model.ObjectType)";
        var id = @(Model.ObjectID);
        var fields = [];
        var columns = [];

        var RelationshipWithContextAggregateToolsRenderer = function (index, datafield, value, defaultvalue, column, data) {
            return renderToolsHtml(
                value, [
                    //{ icon: 'pencil', urlprefix: '/form/EditAttributeTypeRelation?id=' + data.AttributeTypeID + "&objectType=" + data.ObjectType + "&objectTypeID=" + data.ObjectID },
                    //{ icon: 'trash-o', urlprefix: '/form/DeleteAttributeTypeRelation?id=' + data.AttributeTypeID + "&objectType=" + data.ObjectType + "&objectTypeID=" + data.ObjectID }
                ],
                RelationshipWithContextAggregateContext
            );
        }

        var RelationshipWithContextAggregateIconRenderer = function (index, datafield, value, defaultvalue, column, data) {
            return "<div title='" + data.TypeName + "' style='vertical-align: middle; text-align: center; font-size: 8px; font-weight: 700; line-height: 23px; height: 23px; width: 23px; border-radius: 6px; background-color: " + data.IconBackColor + "; color: " + data.IconForeColor + "'>" + data.IconText + "</div>";
        }

        //#region Grid

        var RelationshipWithContextAggregateSource = {
            datatype: 'json',
            url: '/' + type + '/' + id + '/reports/RelationshipWithContextAggregate/data',
            datafields: [
                { name: 'ObjectType' },
                { name: 'ObjectID' },
                { name: 'IntersectID' },
                { name: 'Name' },
                { name: 'TypeName' },
                { name: 'TypeID' },
                { name: 'IconBackColor' },
                { name: 'IconForeColor' },
                { name: 'IconText' },
                { name: 'ContextCount' },
                { name: 'CriticalContextCount' }
            ]
        };

        var RelationshipWithContextAggregateAdapter = new $.jqx.dataAdapter(RelationshipWithContextAggregateSource);

        $("#RelationshipWithContextAggregate").jqxGrid({
            altrows: true,
            width: grid_width,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            autoheight: true,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            pageable: true,
            source: RelationshipWithContextAggregateAdapter,
            theme: theme,
            columns: [
                { text: '', dataField: 'IntersectID', width: '35px', cellsRenderer: RelationshipWithContextAggregateIconRenderer },
                { text: 'Type', dataField: 'TypeName', width: 150 },
                { text: 'Name', dataField: 'Name' },
                { text: '# Contexts', dataField: 'ContextCount', width: 80 },
                { text: '# Critical Contexts', dataField: 'CriticalContextCount', width: 125 }
            ]
        });

        //#endregion

        //#region Event Subscriptions

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case RelationshipWithContextAggregateContext:
                        $('#RelationshipWithContextAggregate').jqxGrid('updatebounddata');
                        break;
                }
            } catch (e) {
                logError("RelationshipWithContextAggregate", e);
            }
        });

        //#endregion
    });
</script>
