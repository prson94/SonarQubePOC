@{
    var pID = ViewData["ParentID"];
    var context = ViewData["Context"];
    }
<div class="tile tile-detail" style="z-index: 0; width:100%">
    <header>Child Artifacts</header>
    <article id="ChildArtifacts"></article>
</div>
<script type="text/javascript">
    var parentID = '@(pID)';

    $(document).ready(function () {

        //#region Grid

        var childArtifactToolsRenderer = function (index, datafield, value, defaultvalue, column, data) {
            var detailUri = '/artifacts/' + data.ArtifactTypeID + '/{0}';
            var tools = [
                { isitemlink: true, urlprefix: '#' + detailUri, type: 'Artifact', context: 'Preview' },
                { icon: 'pencil', urlprefix: 'form' + detailUri + '/edit' },
                { icon: 'trash-o', urlprefix: 'form' + detailUri + '/delete' }
            ];
            return renderToolsHtml(value, tools, contextList.Artifact, data);
        };

        var srcChildArtifactsGrid = {
            datatype: 'json',
            url: '/Artifacts/ByParent?parentID=' + parentID,
            datafields:
            [
                { name: 'ID' },
                { name: 'Name' },
                { name: 'Status' },
                { name: 'Description' },
                { name: 'ArtifactTypeID' },
                { name: 'ArtifactType' },
                { name: 'AllowCreate' },
                { name: 'AllowDelete' },
                { name: 'AllowRead' },
                { name: 'AllowUpdate' }
            ],
            beforeprocessing: function (data) {
                srcChildArtifactsGrid.totalrecords = data.total;
            },
            filter: function () {
                $("#ChildArtifacts").jqxGrid('updatebounddata');
            },
            sort: function () {
                $("#ChildArtifacts").jqxGrid('updatebounddata');
            }
        };

        var adapterChildArtifactsGrid = new $.jqx.dataAdapter(srcChildArtifactsGrid);

        //var childArtifactGridWidth = $("#ChildArtifacts").parent().width();
        $("#ChildArtifacts").jqxGrid({
            altrows: true,
            width: grid_width,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            autoheight: true,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            virtualmode: true,
            rendergridrows: function () {
                return adapterChildArtifactsGrid.records;
            },
            pageable: true,
            columnsresize: true,
            enabletooltips: true,
            source: adapterChildArtifactsGrid,
            theme: list_theme,
            columns: [
                { datafield: "ArtifactType", text: "Type", width: 100 },
                { datafield: "Name", text: "Name" },
                { datafield: "Description", text: "Description", width: 200 },
                { datafield: "Status", text: "Status", width: 75 },
                { datafield: "ID", text: "", width: 120, cellsrenderer: childArtifactToolsRenderer }
            ]
        });

        //#endregion

        //#region Event Subscriptions

        $('#ChildArtifacts').on('rowdoubleclick', function (event) {
            try {
                var args = event.args;
                var row = args.rowindex;
                var data = $("#ChildArtifacts").jqxGrid('getrowdata', row);
                location.assign('#/artifacts/' + data.ArtifactTypeID + '/' + data.ID);
            } catch (e) {
                logError("ChildArtifacts : ChildArtifacts.rowdoubleclick", e);
            }
        });

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case contextList.Artifact:
                        $('#ChildArtifacts').jqxGrid('updatebounddata');
                        break;
                }
            } catch (e) {
                logError("ChildArtifacts : SaveAction", e);
            }

        });

        //#endregion

    });
</script>