
@{
    ViewBag.Title = "Search";
    Layout = "~/Views/Shared/Apps.cshtml";
    var phrase = ViewBag.Phrase;
}

<div id="SearchResults"></div>
<h6 class="grey-text lighten-2 center-align" style="margin:10px;"><span id="Timing"></span> | <input type="button" class="btn-flat grey-text lighten-2" style="padding:0;text-transform:none;vertical-align:baseline" value="Export Results" id="Export" /> | <a class="btn-flat grey-text lighten-2" style="padding:0;text-transform:none;vertical-align:baseline" href="mailto:ideas@data3sixty.com">Feedback</a></h6>

<script>

    $(function () {
        var phrase = "@(phrase)";
        var permissions = new PermissionsModel();
        var ellapsed = '';

        var context = {
            Responsibility : "@(ContextList.Responsibility)"
        }
                
        var initrowdetails = function (index, parentElement, gridElement, datarecord) {
            var div = $($(parentElement).children()[0]);
            if (div != null) {
                var ID = datarecord.ID
                var Group = datarecord.Group;
                var title = div.find('.title');
                title.text(datarecord.Name);
                var details = div.find('.desc');
                var detId = ID + '_det';
                var respId = ID + '_resp';
                var sourcingId = ID + '_src';
                var scoreId = ID + '_score';
                var resp = div.find('.resp');
                var src = div.find('.src');
                var score = div.find('.score');
                details.attr('id', detId);
                resp.attr('id', respId);
                src.attr('id', sourcingId);
                score.attr('score', scoreId);
                DetailTile(detId, null, permissions, Group, ID);
                //ObjectStatisticsTile(scoreId, Group, ID);
                PeopleResponsibilityTile(respId, context, permissions, Group, ID, ' ', true);
                environment_diagram(sourcingId, permissions, Group, ID);
                $(div).jqxTabs({ width: '95%', height: 380, theme:theme });
            }
        }

        var source = {
            datatype: "json",
            datafields: [
                { name: 'Score', type: 'float' },
                { name: 'Name', type: 'string' },
                { name: 'Type', type: 'string' },
                { name: 'Group', type: 'string' },
                { name: 'Description', type: 'string' },
                { name: 'ID', type: 'number' }
            ],
            type: 'POST',
            dataType: 'json',
            url: '/search/results',
            data: { search: phrase },
            id:'ID',
            sortcolumn: 'Score',
            sortdirection: 'desc'
        };

        var dataAdapter = new $.jqx.dataAdapter(
            source, {
                loadComplete: function (data) {
                    if (data) { console.log(data); $('#Timing').text(data.ElapsedTime); }
                },
                beforeLoadComplete: function (records) {
                    var data = new Array();
                    // update the loaded records. Dynamically add EmployeeName and EmployeeID fields. 
                    for (var i = 0; i < records.length; i++) {
                        var row = records[i];
                        row.Score = row.Score * 100;                        
                        data.push(row);
                    }
                    return data;
                }
        });

        $("#SearchResults").jqxGrid({
            altrows: true,
            width: '98%',
            autoheight: true,
            sortable: true,
            filterable: true,
            filtermode: 'excel',
            pageable: true,
            pagesize: 10,
            pagermode: 'simple',
            columnsresize: true,
            source: dataAdapter,
            theme: theme,
            rowdetails: true,
            autorowheight: true,
            rowdetailstemplate: { rowdetails: "<div style='margin: 10px 5px 10px 5px;'><ul><li class='title'></li><li>People Responsibilities</li><li>Rank</li><li>Lifecycle</li></ul><div class='desc'></div><div class='resp'></div><div class='score'></div><div class='src'></div></div>", rowdetailsheight: 420 },
            initrowdetails: initrowdetails,            
            columns: [
                { text: 'Name', dataField: 'Name', width: '20%' },
                { text: 'Description', dataField: 'Description', width: '48%' },
                { text: 'Rank', dataField: 'Score', width: '7%', filterable: false, cellsformat: 'p1' },
                { text: 'Category', dataField: 'Group', width: '10%' },
                { text: 'Type', dataField: 'Type', width: '15%' }                
            ]
        });

        $('#Export').click(function () {
            $("#SearchResults").jqxGrid('exportdata', 'csv', 'jqxGrid');
        });
    });
</script>
<script src="/Scripts/d3/d3.js"></script>


