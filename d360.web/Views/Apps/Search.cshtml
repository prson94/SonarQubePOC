
@{
    ViewBag.Title = "Search";
    Layout = "~/Views/Shared/Apps.cshtml";
    var phrase = ViewBag.Phrase;
}
@Html.Partial("KnockoutTemplates")
<div id="SearchResults"></div>
<h6 class="grey-text lighten-2 center-align" style="margin:10px;"><span id="Timing">Loading Results...</span> | <input type="button" class="btn-flat grey-text lighten-2" style="padding:0;text-transform:none;vertical-align:baseline" value="Export Results" id="Export" /> | <a class="btn-flat grey-text lighten-2" style="padding:0;text-transform:none;vertical-align:baseline" href="mailto:ideas@data3sixty.com">Feedback</a></h6>
<script>
    $(function () {
        var phrase = "@(phrase)";
        var permissions = new PermissionsModel();        
        
        var context = {
            Responsibility : "@(ContextList.Responsibility)"
        }
            
        var initrowdetails = function (index, parentElement, gridElement, datarecord) {
            var div = $($(parentElement).children()[0]);
            if (div != null) {                
                var ID = datarecord.ID;
                var Group = datarecord.Group;
                var title = div.find('.title');
                title.text(datarecord.Name);
                var details = div.find('.desc');
                var detId = ID + '_det';
                var respId = ID + '_resp';
                var scoreId = ID + '_score';
                var resp = div.find('.resp');
                var score = div.find('.score');                
                details.attr('id', detId);
                resp.attr('id', respId);
                score.attr('id', scoreId);
                score.attr('d3sId', ID);
                score.attr('d3sGroup', Group);
                DetailTile(detId, null, permissions, Group, ID);                
                PeopleResponsibilityTile(respId, context, permissions, Group, ID, ' ', true);                
                $(div).jqxTabs({ width: '95%', height: 380, theme: theme });
                $(div).on('tabclick', function (event) {
                    var pageIndex = event.args.item + 1;
                    switch (pageIndex) {                        
                        case 3:
                            var scoreDiv = $(event.target).find('.score');
                            console.log('D3S Group:' + scoreDiv.attr('d3sGroup'));
                            console.log('D3S ID:' + scoreDiv.attr('d3sId'));
                            ObjectStatisticsTile(scoreDiv.attr('id'), scoreDiv.attr('d3sGroup'), scoreDiv.attr('d3sId')); //tab needs to be visible before rendering chart                      
                            break;                        
                        default:
                    }
                });
            }
        }
            
        var percentrenderer = function (row, column, value) {
            return '<div style="margin: 3px;vertical-align: top;">' + (value *100).toFixed(1) + '%</div>';
        }

        var textrenderer = function (row, column, value) {
            return '<div style="margin: 3px;vertical-align: top;">' + value + '</div>';
        }

        var cellsrenderer = function (row, column, value) {
            return '<div style="margin: 3px;">' + value + '</div>';
        }

        var source = {
            datatype: "json",
            datafields: [
                { name: 'NormalizedScore', type: 'float' },
                { name: 'Name', type: 'string' },
                { name: 'Type', type: 'string' },
                { name: 'Group', type: 'string' },
                { name: 'Description', type: 'string' },
                { name: 'ID', type: 'number' },
                { name: 'Merged', type: 'string' },
                { name: 'Url', type: 'string' }
            ],
            type: 'POST',
            dataType: 'json',
            url: '/search/results',
            data: { search: phrase },
            id:'ID',
            sortcolumn: 'NormalizedScore',
            sortdirection: 'desc'
        };

        var dataAdapter = new $.jqx.dataAdapter(
            source, {
                loadComplete: function (data) {
                    if (data) { $('#Timing').text(data.ElapsedTime); }
                },
                beforeLoadComplete: function (records) {
                    var data = new Array();
                    for (var i = 0; i < records.length; i++) {
                        var row = records[i];                        
                        row.Merged = "<h5 class='blue-text text-darken-4'><a href='/" + row.Url + "' target='D3SApp' class='blue-text text-darken-4' title='View in Data3Sixty Website.'>" + row.Name + "</a></h5>" + row.Description;
                        data.push(row);
                    }
                    return data;
                }
        });

        $("#SearchResults").jqxGrid({
            altrows: true,
            width: '98%',
            autoheight: true,
            sortable: true,
            filterable: true,
            filtermode: 'excel',
            pageable: true,
            pagesize: 10,
            pagermode: 'simple',
            columnsresize: true,
            source: dataAdapter,
            theme: theme,
            rowdetails: true,
            autorowheight: true,
            showfilterrow: true,
            rowdetailstemplate: { rowdetails: "<div style='margin: 10px 5px 10px 5px;'><ul><li class='title'></li><li>People Responsibilities</li><li>Score</li></ul><div class='desc'></div><div class='resp'></div><div class='score'></div></div>", rowdetailsheight: 420 },
            initrowdetails: initrowdetails,
            columns: [
                { text: 'Term', dataField: 'Merged', width: '70%', cellsrenderer: cellsrenderer },
                { text: 'Rank', dataField: 'NormalizedScore', width: '10%', filterable: false, cellsrenderer: percentrenderer },
                { text: 'Type', dataField: 'Type', width: '20%', filtertype: 'checkedlist', cellsrenderer: textrenderer }
            ]
        });

        $('#Export').click(function () {
            $("#SearchResults").jqxGrid('exportdata', 'csv', 'jqxGrid');
        });
    });
</script>
<script src="/Scripts/d3/d3.js"></script>