@model d360.web.Models.ReportOverlayModel
<div class="large-overlay">
    <div class="ui segment">
        <h4>@(Model.ReportName)</h4>
        <div class="form-instructions"></div>
        <div id="Layout" data-bind="template: { name: 'reportTmpl' }"></div>
    </div>
</div>


<script type="text/javascript">
    $(function () {
        var reportID = @(Model.ReportID);
        var reportType = '@(Model.ObjectType)';
        var reportTypeID = @(Model.ObjectID);

        var layoutTileVm = new ReportModel(reportID, reportType, reportTypeID, false);
        ko.applyBindings(layoutTileVm, document.getElementById('Layout'));
        
        var changePromise = layoutTileVm.ChangeObject(reportID, reportType, reportTypeID);
        changePromise
            .then(layoutTileVm.GetLayout)
            .done(function (message) {
                layoutTileVm.Render();
            });
    });
</script>
