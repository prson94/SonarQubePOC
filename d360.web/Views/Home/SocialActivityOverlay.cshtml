<div class="medium-overlay">
    <div class="ui segment">
        <h4 id="title">@(ViewBag.CategoryName)(s) for past @(ViewBag.LookBackDays) day(s)</h4>
        <div class="form-instructions"></div>
        <div id="HomeBoard" data-bind="template: {name: 'boardTmpl' }"></div>
    </div>
</div>


<script type="text/javascript">
    var id = "@(ViewBag.ID)";
    $(function () {

        HomeSocial = new BoardViewModel();
        HomeSocial.ShowDateFilter = false;
        HomeSocial.ShowTypeFilter = false;
        HomeSocial.ShowAddCommentControls = false;
        HomeSocial.selectedDateFilterOption = ko.observable(@(ViewBag.LookBackDays));
        HomeSocial.selectedTypeFilterOption = ko.observable(@(ViewBag.Category));
        ko.applyBindings(HomeSocial, document.getElementById('HomeBoard'));
        HomeSocial.getMoreComments();
    });
</script>
