@{
    Layout = null;
    var CurrentResourceID = ViewData["ResourceID"].ToString();
    var VersionNumber = ViewData["VersionNumber"].ToString();
    var suffix = System.Configuration.ConfigurationManager.AppSettings["ResourceSuffix"];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Data3Sixty, Inc</title>
    <meta name="description" content="Data3Sixty: Data Collaboration Suite" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="Shortcut Icon" href="/favicon.ico" />
    <link href="https://fonts.googleapis.com/css?family=Roboto+Condensed" rel="stylesheet" type="text/css">
    <link rel="stylesheet" href="/Content/styles/Angular@(suffix).css?version=@(VersionNumber)" />    
    @RenderSection("AppStyles", false)
    <script type="text/javascript">
    var currentUserName = "@(User.Identity.Name)";
    </script>
</head>

    @RenderBody()

    <!-- getting wierd error with packaged version lets sort out later and use cdn to get working-->
    <!-- <script type="text/javascript" src="/scripts/Angular@(suffix).js?version=@(VersionNumber)"></script>-->

    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.3.15/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.3.15/angular-animate.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.3.15/angular-aria.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.3.15/angular-sanitize.min.js"></script>

    <script src="https://ajax.googleapis.com/ajax/libs/angular_material/0.9.4/angular-material.min.js"></script>

    @RenderSection("AppScripts", false)

</html>
