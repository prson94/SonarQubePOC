@model d360.web.Models.ContextToolbar
<style type="text/css">
    .CommandHeader {
        font-size: 115%;
    }
    .CommandTooltipButton {
        border: none;
        background-color: transparent;
        color: #51a6dc;
        display:inline-block; /*needed to get underline working*/
        text-decoration: solid !important;
        font-size: 115%;
    }
        .CommandTooltipButton:hover {
            text-decoration: none;
            color: #666;
        }
</style>
<table class="table table-condensed">
    <thead>
        <tr>
            @{
                foreach (var rt in Model.Items)
                {
                    <th class="CommandHeader">@rt.Title</th>
                }
            }
        </tr>
    </thead>
    <tbody>
        <tr style="vertical-align: top">
            @{
                foreach (var rt in Model.Items)
                {
                    <td>
                        @if (rt.Items.Count > 0)
                        {
                            foreach (var ct in rt.Items)
                            {
                                @Html.Raw("<br/><button class='CommandTooltipButton' data-" + ct.Type + " data-context='" + ct.Context + "' data-uri='" + ct.Uri + "' data-method='" + ct.Method + "'>" + ct.Title + "</button>")
                            }
                        }
                        else
                        {
                            @Html.Raw("<br/><button class='CommandTooltipButton' data-" + rt.Type + " data-context='" + rt.Context + "' data-uri='" + rt.Uri + "' data-method='" + rt.Method + "'>" + rt.Title + "</button>")
                        }
                    </td>
                }
            }
        </tr>
    </tbody>
</table>