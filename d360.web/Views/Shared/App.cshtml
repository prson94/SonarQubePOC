@{
    Layout = null;
    var CurrentResourceID = ViewData["ResourceID"].ToString();
    var VersionNumber = ViewData["VersionNumber"].ToString();
    var ResourceHomePage = ViewData["ResourceHomePage"].ToString();


    var environmentSettings = (Dictionary<string, string>)ViewData["EnvironmentSettings"];
    var environmentSettingsJson = "";
    foreach (var k in environmentSettings.Keys)
    {
        environmentSettingsJson += (string.IsNullOrEmpty(environmentSettingsJson) ? "" : ", ") + string.Format("{0}: '{1}'", k, environmentSettings[k]);
    }
    environmentSettingsJson = "{" + environmentSettingsJson + "}";

    var settings = (Dictionary<string, string>)ViewData["Settings"];
    var settingsJson = "";
    foreach (var k in settings.Keys)
    {
        if (k != "PowerBIAccessKey" && k != "PowerBIWorkspaceId" && k != "AzureADTenant" && k != "AzureGraphAPIKey" && k != "AzureApplicationId")
        {
            settingsJson += (string.IsNullOrEmpty(settingsJson) ? "" : ", ") + string.Format("{0}: '{1}'", k, settings[k]);
        }
    }
    settingsJson = "{" + settingsJson + "}";

    var suffix = System.Configuration.ConfigurationManager.AppSettings["ResourceSuffix"];
    var customStylesheetURL = (settings["CustomCSSLocation"] ?? "");
    var useCdn = System.Configuration.ConfigurationManager.AppSettings["cdn:enabled"];

    var baseUrl = "";
    if ((useCdn ?? "").ToLower() == "true") {
        baseUrl = System.Configuration.ConfigurationManager.AppSettings["cdn:url"];
    }

    var title = settings["BrowserTitlePrefix"] ?? "Data3Sixty, Inc.";

    var companyLogo = string.Format("{0}/content/images/logo.new.png", baseUrl);
    var companyIcon = string.Format("{0}/favicon.ico", baseUrl);

    companyLogo = settings["CompanyLogo"];
    companyIcon = settings["CompanyIcon"];


}
@functions{
    public string GetAntiForgeryToken()
    {
        string cookieToken, formToken;
        AntiForgery.GetTokens(null, out cookieToken, out formToken);
        return cookieToken + ":" + formToken;
    }
}
<!DOCTYPE html>
<html class="no-js">
<head>
    <base href="/" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta charset="utf-8" />
    <title>@(title)</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="description" content="Data3Sixty: Data Collaboration Suite" />
    <link rel="icon" href="@(companyIcon)" type="image/x-icon" />
    <link rel="Shortcut Icon" href="@(companyIcon)" />
    <script type="text/javascript">
        var EnvironmentSettings = @(Html.Raw(environmentSettingsJson));
        var CompanySettings = @(Html.Raw(settingsJson));
        var CurrentResourceID = @(CurrentResourceID);
        var ResourceHomePage = '@(ResourceHomePage)';
        var SingleSignOn = @(ViewData["SingleSignOn"].ToString().ToLower());
        var ResourceName = '@(ViewData["ResourceName"].ToString())';
        var ResourceEmail = '@(ViewData["ResourceEmail"].ToString())';
        var VersionNumber = '@(VersionNumber)';
    </script>
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/primeng/v6.0.1/primeng.min.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/primeicons/1.0.0-beta.10/primeicons.min.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/font-awesome.min.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/styles/materialize.min.css", baseUrl)" />
    <link rel="stylesheet" href="/Content/styles/ang@(suffix).css?version=@(VersionNumber)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/primeng/v6.0.1/theme.min.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/quill/v1.3.4/quill.snow.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/codemirror/codemirror.min.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/codemirror/eclipse.min.css", baseUrl)" />
    <style type="text/css">
        nav.top{border-bottom:1px solid @(settings["HeaderBackgroundColor"]);}
        .header-search .search-child {
            border-bottom:1px solid @(settings["HeaderBackgroundColor"]);
            border-right:1px solid @(settings["HeaderBackgroundColor"]);
            border-left:1px solid @(settings["HeaderBackgroundColor"]);
        }
        .ng-loading{position:fixed;height:100%;width:100%;top:0;left:0;background:white;}
        .ng-loading-wrap{position:fixed;top:45%;left:50%;color:#54a4da;}
        .ng-loading-image{background-image: url(@string.Format("{0}/content/images/logo.new.color.png", baseUrl));background-size:auto 40px;background-repeat:no-repeat;width:224px;height:44px;margin-left:-65px;}
    </style>
    @if (!string.IsNullOrEmpty(customStylesheetURL))
    {
        <link rel="stylesheet" type="text/css" href="@customStylesheetURL" />
    }
    <script src="@string.Format("{0}/content/quill/v1.3.4/quill.min.js", baseUrl)"></script>
</head>
<body>
    <d3s-app><div class="ng-loading"><div class="ng-loading-wrap"><div class="ng-loading-image">&nbsp;</div>Loading...</div></div></d3s-app>
    <input id="antiForgeryToken" type="hidden" value="@GetAntiForgeryToken()" />
    <script src="scripts/app/polyfills.bundle.js"></script>
    <script src="scripts/app/vendor.bundle.js"></script>
    <script src="scripts/app/main.bundle.js"></script>
</body>
</html>