@{
    Layout = null;
    var CurrentResourceID = ViewData["ResourceID"].ToString();
    var CurrentResourceUid = ViewData["ResourceUid"].ToString();
    var VersionNumber = ViewData["VersionNumber"].ToString();
    var ResourceHomePage = ViewData["ResourceHomePage"].ToString();
    var ApplicationLanguageSetting = ViewData["ApplicationLanguageSetting"] as string;

    var settings = (Dictionary<string, string>)ViewData["Settings"];

    var suffix = System.Configuration.ConfigurationManager.AppSettings["ResourceSuffix"];
    var customStylesheetURL = (settings["CustomCSSLocation"] ?? "");
    var useCdn = System.Configuration.ConfigurationManager.AppSettings["cdn:enabled"];

    var baseUrl = "";
    if ((useCdn ?? "").ToLower() == "true")
    {
        baseUrl = System.Configuration.ConfigurationManager.AppSettings["cdn:url"];
    }

    var title = settings["BrowserTitlePrefix"] ?? "Data360, Inc.";

    var companyIcon = string.Format("{0}/favicon.ico", baseUrl);
    companyIcon = settings["CompanyIcon"];
}
@functions{
    public string GetAntiForgeryToken()
    {
        string cookieToken, formToken;
        AntiForgery.GetTokens(null, out cookieToken, out formToken);
        return cookieToken + ":" + formToken;
    }
}
<!DOCTYPE html>
<html class="no-js" lang="en">
<head>
    <base href="/" />
    <meta name="netsparkerenterprise-site-verification" content="5d7757b2-e472-4569-c8a4-ae0703176d39">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta charset="utf-8" />
    <title>@(title)</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Data360: Data Collaboration Suite" />
    <link rel="icon" href="@(companyIcon)" type="image/x-icon" />
    <link rel="Shortcut Icon" href="@(companyIcon)" />
    <link rel="preload" href="@string.Format("{0}/fonts/fontawesome-webfont.woff2?v=4.7.0", baseUrl)" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="@string.Format("{0}/content/primeicons/fonts/primeicons.ttf", baseUrl)" as="font" type="font/ttf" crossorigin>
    <script type="text/javascript">
        var CurrentResourceID = @(CurrentResourceID);
		var CurrentResourceUid = '@(CurrentResourceUid)';
        var ResourceHomePage = '@(ResourceHomePage)';
        var SingleSignOn = @(ViewData["SingleSignOn"].ToString().ToLower());
        var ResourceName = '@(ViewData["ResourceName"].ToString())';
        var ResourceEmail = '@(ViewData["ResourceEmail"].ToString())';
        var VersionNumber = '@(VersionNumber)';
        var ApplicationLanguageSetting = '@(ApplicationLanguageSetting)';
        var FederationUrlPrefix = "";
    </script>
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/primeng/primeng.min.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/primeicons/primeicons.min.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/primeng/default.min.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/font-awesome.min.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/styles/materialize.min.css", baseUrl)" />
    <link rel="stylesheet" href="/Content/styles/ang@(suffix).css?version=@(VersionNumber)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/primeng/theme.min.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/quill/v1.3.7/quill.snow.min.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/codemirror/codemirror.min.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="@string.Format("{0}/content/codemirror/eclipse.min.css", baseUrl)" />
    <link rel="stylesheet" type="text/css" href="/api/v2/environment/themes/current.css" />
</head>
<body>
    <d3s-app>
        <div class="ng-loading">
            <span class="loginlogo"><span class="background"></span></span>
            <div class="ng-loading-wrap">
                <div class="ng-loading-image"></div>
                <div class="loader">Loading...</div>
            </div>
        </div>
    </d3s-app>
    <input id="antiForgeryToken" type="hidden" value="@GetAntiForgeryToken()" />

    <script src="/scripts/dist/@d360.web.Utilities.InternationalizationUtilities.GetUserLocaleCode(ApplicationLanguageSetting)/runtime.js" defer></script>
    <script src="/scripts/dist/@d360.web.Utilities.InternationalizationUtilities.GetUserLocaleCode(ApplicationLanguageSetting)/polyfills-es5.js" nomodule defer></script>
    <script src="/scripts/dist/@d360.web.Utilities.InternationalizationUtilities.GetUserLocaleCode(ApplicationLanguageSetting)/polyfills.js" defer></script>
    <script src="/scripts/dist/@d360.web.Utilities.InternationalizationUtilities.GetUserLocaleCode(ApplicationLanguageSetting)/vendor.js" defer></script>
    <script src="/scripts/dist/@d360.web.Utilities.InternationalizationUtilities.GetUserLocaleCode(ApplicationLanguageSetting)/main.js" defer></script>

</body>
</html>