    <link rel="stylesheet" type="text/css" href="../../node_modules/primeng/resources/primeng.min.css" />
    <link rel="stylesheet" href="/Content/styles/ang@(suffix).css?version=@(VersionNumber)" />    
    <link rel="stylesheet" type="text/css" href="../../Content/primeng/d3s/theme.css" />    

    <style type="text/css">
        .nav-top .profile a {
            color: @(settings["HeaderProfileLinkColor"]);
        }
        nav.top .logo {
            background-color: @(settings["HeaderBackgroundColor"]);
            background-image: url(@(companyLogo));
            background-repeat: no-repeat;
            background-position: left top;
            background-size: auto 40px;
            height: 40px;
            width:200px;
            display:inline-block;
        }
        nav.top .logo:hover{
            background-color: @(settings["HeaderBackgroundColor"]);
        }
        nav.top{
            border-bottom: 1px solid @(settings["HeaderBackgroundColor"]);
        }
        .header-search .search-child {
            border-bottom:1px solid @(settings["HeaderBackgroundColor"]);
            border-right:1px solid @(settings["HeaderBackgroundColor"]);
            border-left:1px solid @(settings["HeaderBackgroundColor"]);
        }
        .ng-loading{
            position: fixed;
            height: 100%;
            width: 100%;
            top: 0;
            left: 0;
            background: #54a4da;
        }
        .ng-loading-wrap{
            position:fixed;
            top:45%;
            left:50%;
            color:white;
        }
        .ng-loading-image{
            background-image: url(/Content/images/logo.new.png);background-size:auto 40px;background-repeat:no-repeat;width:224px;height:44px;margin-left:-80px;
        }
    </style>
    <!-- Scripts for legacy carry over -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.4/jquery.min.js"></script>
    <script src="/Scripts/jquery.qtip.js"></script>
    <!-- Additional dependencies-->
    <script src="https://cdn.quilljs.com/1.1.2/quill.min.js"></script>
    <script type="text/javascript" src="/Scripts/powerbi.js"></script>
</head>
<body>
    <d3s-app>
        <div class="ng-loading">
            <div class="ng-loading-wrap">
                <div class="ng-loading-image">&nbsp;</div>Loading...
            </div>
        </div>
    </d3s-app>
    <input id="antiForgeryToken" type="hidden" value="@GetAntiForgeryToken()" />

    <!-- Angular 2 -->
    <script src="scripts/app/polyfills.bundle.js"></script>
    <script src="scripts/app/vendor.bundle.js"></script>
    <script src="scripts/app/main.bundle.js"></script>
</body>
</html>