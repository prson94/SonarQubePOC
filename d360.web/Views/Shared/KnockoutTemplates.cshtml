                    <i data-bind="visible: searchFilter().length < 1" class="fa fa-search" style="position:relative; z-index:1; left: -25px; top: 1px; color: rgba(80, 80, 80, 0.85); width: 0; font-size:larger"></i>
                    <i data-bind="visible: searchFilter().length > 0, click: function () { searchFilter('')}" class="fa fa-remove" style="position:relative; z-index:1; left: -25px; top: 1px; color: rgba(80, 80, 80, 0.85); width: 0; font-size:larger"></i>
