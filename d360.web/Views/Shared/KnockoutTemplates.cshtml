<script id="objectStatisticsTile" type="text/x-handlebars-template">
    <table style="width: 99.5%; margin: auto">
        <tr>
            <td>
                <div class="tile-clickable StatisticValue SocialStatisticValue" data-tile data-uri="{{FollowerUrl}}" data-context="TileOverlay">{{FollowerCount}}</div>
                <div class="StatisticName SocialStatisticName">followers</div>
            </td>
            <td>
                <div class="tile-clickable StatisticValue SocialStatisticValue" data-tile data-uri="{{CommentUrl}}" data-context="TileOverlay">{{CommentCount}}</div>
                <div class="StatisticName SocialStatisticName">comments</div>
            </td>
            <td rowspan="2" style="width: 160px; vertical-align: top; text-align: right" align="right" class="tile-clickable" data-tile data-uri="{{ScoreUrl}}" data-context="TileOverlay">
                <div id="ScoreKpi" style="width: 150px; height: 150px;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div class="tile-clickable StatisticValue EventStatisticValue" data-tile data-uri="{{EventUrl}}" data-context="TileOverlay">{{EventCount}}</div>
                <div class="StatisticName EventStatisticName">open events</div>
            </td>
        </tr>
        <tr>
            <td colspan="3">
                <table class="hoverable" style="width: 100%">
                    <tbody>
                        {{#each Items }}
                        <tr class="tile-clickable" data-tile="" data-uri="{{Url}}" data-context="TileOverlay">
                            <td class="ChildArtifactStatisticValue">{{Count}}</td>
                            <td class="ChildArtifactStatisticName">{{Name}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</script>

