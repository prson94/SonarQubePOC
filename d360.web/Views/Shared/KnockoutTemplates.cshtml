<script id="mapSequencesTmpl" type="text/html">
    <div class="row" data-bind="foreach: MapSequenceModels">
        <div style="margin-top: 25px" class="col s12">
            <h4 data-bind="text: Name"></h4>
        </div>
        <div class="col s3">
            <table class="responsive-table striped">
                <thead>
                    <tr>
                        <th>1. Available Sources</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: Available">
                    <tr>
                        <td data-bind="text: Name"></td>
                        <td style="width: 25px">
                            <i data-bind="click: $parent.Add" class="fa fa-lg fa-plus blue-text"></i>
                            @*<div data-bind="jqxButton: {theme: theme, width: 20 }, click: $parent.Add"><i class="fa fa-plus blue-text"></i></div>*@
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="col s9">
            <table class="responsive-table striped">
                <thead>
                    <tr style="vertical-align: top">
                        <th style="width: 30%">2. Referenced Sources</th>
                        <th style="width: 60px; padding-right: 5px">Sequence</th>
                        <th style="width: 30%">Context</th>
                        <th>Translation</th>
                        <th style="width: 30px"></th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: Selected">
                    <tr>
                        <td style="vertical-align: top" data-bind="text: SourceName"></td>
                        <td style="vertical-align: top" data-bind="text: Sequence"></td>
                        <td style="vertical-align: top">
                            <div data-bind="jqxListBox: {
                                    source: Contexts,
                                    theme: theme,
                                    filterable: true,
                                    searchMode: 'containsignorecase',
                                    checkboxes: true,
                                    displayMember: 'Path',
                                    valueMember: 'ID',
                                    height: 150,
                                    width: field_width }">
                            </div>
                        </td>
                        <td style="vertical-align: top">
                            <textarea data-bind="htmlarea150: Description" style="width: 98%"></textarea>
                        </td>
                        <td style="vertical-align: top; text-align: center; width: 25px">
                            <i data-bind="click: $parent.Remove" class="fa fa-lg fa-trash red-text"></i>
                            <i data-bind="click: $parent.MoveUp" class="fa fa-lg fa-arrow-up black-text"></i>
                            <i data-bind="click: $parent.MoveDown" class="fa fa-lg fa-arrow-down black-text"></i>
                            @*<div data-bind="jqxButton: {theme: theme, width: 20 }, "></div>*@
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</script>

<script id="MultiMapRulesEditTmpl" type="text/html">
    <div style="padding:5px">
        <table>
            <thead>
                <tr>
                    <th style="width: 25%">Business Mapping</th>
                    <th style="min-width: 20px">&nbsp;</th>
                    <th style="width: 22%">Source</th>
                    <th style="min-width: 20px">&nbsp;</th>
                    <th style="width: 22%">Target</th>
                    <th style="min-width: 20px">&nbsp;</th>
                    <th style="width: 25%">Transformation</th>
                </tr>
            </thead>
            <tbody data-bind="foreach: MapRules">
                <tr data-bind="template: {name: 'MultiMapRuleEditTmpl', data: $data }, style: {'backgroundColor': ($index()%2 == 0 ? '#fff' : '#eee'), 'vertical-align': 'top'}"></tr>
                <tr data-bind="fadeVisible: ErrorMessages().length > 0, style: {'backgroundColor': ($index()%2 == 0 ? '#fff' : '#eee')}">
                    <td colspan="7" style="color:maroon;font-size:1em;">
                        <ul data-bind="foreach: ErrorMessages" style="padding:0;margin:0;">
                            <li><i class="fa fa-exclamation-circle"></i> <span data-bind="text: $data"></span></li>
                        </ul>
                    </td>
                </tr>
                <tr data-bind="style: {'backgroundColor': ($index()%2 == 0 ? '#fff' : '#eee')}, visible: CanDelete">
                    <td colspan="7" style="text-align:right">
                        <span data-bind="jqxButton: { theme: theme, width: 100}, click: RemoveRule" style="cursor:pointer;"><i class="fa fa-remove" style="color:maroon"></i> Remove Rule</span><div>&nbsp;</div>
                    </td>
                </tr>
            </tbody>
        </table>
        <div data-bind="visible: IsLoading" style="text-align:center">
            <i class="fa fa-2x fa-spinner fa-spin"></i>
        </div>
        <div data-bind="visible: (MapRules().length == 0 && !NoFusionAvailable() && !IsLoading())" style="width:100%;text-align:center;padding:10px;font-size:1.2em;color:#777;">
            No map rules defined
        </div>
        <div data-bind="visible: (NoFusionAvailable() && !IsLoading())" style="width:100%;text-align:center;padding:10px;font-size:1.2em;color:#777;">
            There are no fusion attributes defined for the source or target selected.
        </div>
    </div>
</script>
<script id="MultiMapRuleEditTmpl" type="text/html">
    <td data-bind="visible: !IsLoading()" style="vertical-align:top;">
        <div data-bind="mapDropdown, jqxDropDownList: {
             source: Maps,
             theme: theme,
             selectedIndex: MapSelectedIndex,
             displayMember: 'DisplayText',
             valueMember: 'ValueText',
             autoDropDownHeight: true,
             height: field_height,
             width: field_width98
        }"></div>
    </td>
    <td style="min-width: 20px">&nbsp;</td>
    <td data-bind="visible: !IsLoading()" style="vertical-align:top;">
        <table>
            <tbody>
                <!-- ko foreach: Sources -->
                <tr>
                    <td data-bind="visible: $parent.CanUpdate">
                        <input type="text" placeholder="Search by text path" data-bind="mappingRuleItemInput, jqxInput: { value: FusionAttributeTextPath, valueMember: 'value', displayMember: 'label', height: field_height, width: field_width, theme: theme, source: FindTextPaths, disabled: !$parent.HasSourceIntersectID }" />
                    </td>
                    <td data-bind="visible: $parent.CanUpdate" style="width: 25px">
                        <div data-bind="jqxButton: {theme: theme, width: 20, disabled: ($parent.Sources().length == 1) }, click: RemoveItem" style="color:maroon;cursor:pointer;"><i class="fa fa-remove"></i></div>
                    </td>
                </tr>
                <tr data-bind="fadeVisible: ErrorMessages().length > 0">
                    <td colspan="2" style="color:maroon; font-size:1em;">
                        <ul data-bind="foreach: ErrorMessages" style="padding:0;margin:0;">
                            <li><i class="fa fa-exclamation-circle"></i> <span data-bind="text: $data"></span></li>
                        </ul>
                    </td>
                </tr>
                <!-- /ko -->
                <tr data-bind="visible: CanUpdate">
                    <td></td>
                    <td>
                        <div data-bind="jqxButton: { theme: theme, width: 20, disabled: !HasSourceIntersectID }, click: AddSource"><i class="fa fa-plus" title="Add source mapping item"></i></div>
                    </td>
                </tr>
            </tbody>
        </table>
    </td>
    <td style="min-width: 20px">&nbsp;</td>
    <td data-bind="visible: !IsLoading()" style="vertical-align:top;">
        <table>
            <tbody>
                <!-- ko foreach: Targets -->
                <tr>
                    <td data-bind="visible: $parent.CanUpdate" style="width: 100px">
                        <input type="text" placeholder="Search by text path" data-bind="mappingRuleItemInput, jqxInput: { value: FusionAttributeTextPath, valueMember: 'value', displayMember: 'label', height: field_height, width: field_width, theme: theme, source: FindTextPaths, disabled: !$parent.HasTargetIntersectID }" />
                    </td>
                    <td style="width: 25px">
                        <div data-bind="visible: $parent.CanUpdate, jqxButton: {theme: theme, width: 20, disabled: ($parent.Targets().length == 1) }, click: RemoveItem" style="color:maroon;cursor:pointer;"><i class="fa fa-remove"></i></div>
                    </td>
                </tr>
                <tr data-bind="fadeVisible: ErrorMessages().length > 0">
                    <td colspan="2" style="color:maroon; font-size:1em;">
                        <ul data-bind="foreach: ErrorMessages" style="padding:0;margin:0;">
                            <li><i class="fa fa-exclamation-circle"></i> <span data-bind="text: $data"></span></li>
                        </ul>
                    </td>
                </tr>
                <!-- /ko -->
                <tr data-bind="visible: CanUpdate">
                    <td></td>
                    <td>
                        <div data-bind="jqxButton: { theme: theme, width: 20, disabled: !HasTargetIntersectID }, click: AddTarget" style="cursor:pointer;display:inline-block;"><i class="fa fa-plus"></i></div>
                    </td>
                </tr>
            </tbody>
        </table>
    </td>
    <td style="min-width: 20px">&nbsp;</td>
    <td data-bind="visible: !IsLoading()" style="vertical-align:top;">
        <textarea data-bind="value: Transformation, disable: !CanUpdate()" placeholder="Enter transformation rule..." style="background-color:white; min-height: 50px; height: 100%"></textarea>
    </td>
</script>


