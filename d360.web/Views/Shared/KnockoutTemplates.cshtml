<script id="boardTmpl" type="text/html">
    <div class="social">

        <table class="CommentForm" style="background-color: #efefef; border-radius: 2px;" data-bind="visible: ShowAddCommentControls">
            <tr>
                <td class="input-field" colspan="2" style="padding: 5px">
                    <div class="FieldName">What's on your mind?</div>
                    <textarea class="grey lighten-5" style="border: 1px solid #999" data-bind="textInput: newMessage, htmlarea: {}"></textarea> @*, event: { keyup: checkForTags } class="htmlArea"*@ 
                </td>
            </tr>
            <tr>
                <td colspan="2" style="position: relative; padding: 10px 5px 10px 5px;">
                    <i class="fa fa-2x fa-tags" style="color: #5B401F; position: absolute; top: 5px; left: 5px"></i>
                    <div style="margin-left: 30px;">
                        <!-- ko template: {name: 'commentTagTmpl', foreach: tags } -->
                        <!-- /ko -->
                        <div style="display:inline-block; position: relative">
                            <input data-bind="textInput: newTag" placeholder="Add tag" style="border: none; border-bottom: 1px solid #adacac" />
                            <div class="tagSuggestionDisplay" data-bind="visible: tagSuggestionsPresent" style="position:absolute; z-index:100; border-left:solid 1px #dedede; border-right:solid 1px #dedede; border-bottom:solid 1px #dedede; overflow-y: scroll; background-color: #fff; max-height:250px; box-shadow: 5px 5px 3px grey; border-radius: 3px">
                                <div style="padding:4px; border-top:solid 1px #dedede; font-size:12px; ">
                                    <!-- ko template: {name: 'commentTagSuggestionTmpl', foreach: tagSuggestions } -->
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="type-field" style="padding: 5px"><select data-bind="options: typeEntryOptions, optionsText: 'Text', optionsValue: 'Value', value: newMessageType" class="browser-default" /></td>
                <td style="padding: 5px"><button class="btn waves-effect grey-text grey lighten-5" type="button" data-bind="click: addComment">Share</button></td>
            </tr>
        </table>

        <div class="Board-Spacer" data-bind="visible: ShowAddCommentControls"></div>

        <div class="FieldName">Filter Board</div>
        <div class="FilterForm">
            <table>
                <tr>
                    <td class="date-filter">
                        <select id="BoardDateFilter" data-bind="options: dateFilterOptions, optionsText: 'Text', optionsValue: 'Value', value: selectedDateFilterOption" class="browser-default" />
                    </td>
                    <td class="type-filter">
                        <select id="BoardTypeFilter" data-bind="options: typeFilterOptions, optionsText: 'Text', optionsValue: 'Value', value: selectedTypeFilterOption" class="browser-default" />
                    </td>
                    <td>
                        <button class="btn waves-effect waves-light brown lighten-1" id="BoardFilter" data-bind="click: filterComments"><i class="fa fa-search" title="Filter Comments"></i></button>
                    </td>
                </tr>
            </table>
        </div>

        <div class="Board-Spacer"></div>

        <p class="error" style="color:red" data-bind="text: error"></p>
        <div class="notification" data-bind="visible: newComments().length > 0"><a data-bind="    click: loadNewComments"> <span data-bind="    text: newComments().length"></span> new post(s)</a></div>
        <!-- ko template: {name: 'commentTmpl', foreach: comments } -->
        <!-- /ko -->
        <button class="btn waves-effect grey-text grey lighten-5" style="width: 90%; margin: auto" type="button" data-bind="visible: moreComments(), click: getMoreComments">Load More</button>
    </div>
</script>
<script id="commentTagSuggestionTmpl" type="text/html">
    <div data-bind="click: addTag, css: { 'entry-alt': $index()%2 }">
        <div data-bind="text: TextPath" style="font-weight: 600"></div>
        <div data-bind="text: ObjectTypeName" style="font-size: 75%"></div>
    </div>
</script>
<script id="commentTagTmpl" type="text/html">
    <div style="display: inline-block; margin-right: 10px; padding: 3px; border: 1px solid #999; border-radius: 2px">
        <div style="display:inline-block">
            <i class="fa fa-tag"></i>
        </div>
        <div style="display:inline-block">
            <div>
                <a data-bind="attr: {href: Url, 'data-type': Object, 'data-context': 'Preview', 'data-id': ObjectID}, text: TextPath" style="font-size: 75%; font-weight: 600"></a>
            </div>
            <div data-bind="text: ObjectTypeName" style="font-size: 60%"></div>
        </div>
    </div>
</script>
<script id="commentTmpl" type="text/html">
    <div class="entry top-entry" data-bind="css: { 'entry-alt': $index()%2 }, visible: isVisible, attr: { id: ID }">
        <table>
            <tr>
                <td rowspan="3" class="profile">
                    <i data-bind="css: getCommentTypeCss()"></i>
                </td>
                <td>
                    <div>
                        <a data-bind="attr: { href: ObjectUrl, 'data-type': ObjectType, 'data-context': 'Preview', 'data-id': ObjectID }"><span data-bind="    text: ObjectName"></span></a>
                    </div>
                    <div class="type" data-bind="text: getCommentType()"></div>
                </td>
                <td class="author">
                    <div data-bind="if: isNonResourceComment">
                        <a data-bind="attr: { 'data-type': 'Resource', 'data-context': 'Preview', 'data-id': CreatingResourceID, href: getResourceUrl() }, text: ResourceName"></a>
                    </div>
                    <div data-bind="text: formatDate(DateCreated)"></div>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <div class="message" data-bind="html: Body"></div>
                    <div style="display:inline-block" data-bind="fadeVisible: tagsAreDisplayed">
                        <!-- ko template: {name: 'commentTagTmpl', foreach: CurrentTags } -->
                        <!-- /ko -->
                    </div>
                    <span data-bind="visible: tagsAreHidden, text: CurrentTagCountText"></span>
                    <button style="width: 40px" data-bind="visible: tagsAreHidden, click: displayTags" class="waves-effect waves-green btn-flat" title="Show tags">&gt;&gt;</button>
                    <button style="width: 40px" data-bind="visible: tagsAreDisplayed, click: hideTags" class="waves-effect waves-red btn-flat" title="Hide tags">&lt;&lt;</button>
                </td>
            </tr>
            <tr>
                <td colspan="2" class="ChildComments">
                    <a class="commentNotification" data-bind="click: loadNewComments, visible: NewComments().length > 0"> <span data-bind="    text: NewComments().length"></span> new comment(s)</a>
                    <div data-bind="template: {name: 'subCommentTmpl', foreach: Comments }"></div>
                    <table class="ChildComment" data-bind="visible: ShowAddCommentControls">
                        <tr>
                            <td class="input-field"><textarea data-bind="value: newCommentMessage, htmlarea: {}"></textarea></td>
                            <td><button class="btn-flat waves-effect waves-light" type="button" data-bind="click: addComment"><i class="fa fa-reply" title="Reply"></i></button></td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</script>
<script id="subCommentTmpl" type="text/html">
    <div class="entry sub-entry" data-bind="attr: { id: ID }">
        <table>
            <tr>
                <td rowspan="3" class="profile">
                    <img data-bind="attr: { src: getResourceImage() }" class="img-rounded" />
                </td>
                <td>
                    <div>
                        <div data-bind="if: isNonResourceComment">
                            <a data-bind="attr: { 'data-type': 'Resource', 'data-context': 'Preview', 'data-id': CreatingResourceID, href: getResourceUrl() }, text: ResourceName"></a>
                        </div>
                        @*<a data-bind="attr: { href: ObjectUrl, 'data-type': ObjectType, 'data-context': 'Preview', 'data-id': ObjectID }"><span data-bind="    text: ObjectName"></span></a>*@
                    </div>
                </td>
                <td class="author">
                    <div data-bind="text: formatDate(DateCreated)"></div>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <div class="message" data-bind="html: Body"></div>
                </td>
            </tr>
            <tr>
                <td colspan="2" class="ChildComments">
                    <a class="commentNotification" data-bind="click: loadNewComments, visible: NewComments().length > 0"> <span data-bind="    text: NewComments().length"></span> new comment(s)</a>
                    <div data-bind="template: {name: 'subCommentTmpl', foreach: Comments }"></div>
                </td>
            </tr>
        </table>
    </div>
</script>

<script id="searchResultTmpl" type="text/html">
    <div class="entry" data-bind="attr: {'data-category': Type}">
        <div class="name">
            <strong data-bind="text: Type"></strong> : <a data-bind="attr: {href: Url}, html: Name"></a>
        </div>
        <div class="description" data-bind="html: Description"></div>
    </div>
</script>
<script id="searchResultsCategoriesTmpl" type="text/html">
    <div class="widget" id="CategoryResults">
        <div class='entry'><a href='#' data-category=''>All item(s)</a></div>
        <div data-bind="template: {name: 'searchResultsCategoryTmpl', foreach: categories }"></div>
    </div>
</script>
<script id="searchResultsCategoryTmpl" type="text/html">
    <div class="entry">
        <a href="#" data-bind="attr: {'data-category': Name}, html: Name"></a> : <span data-bind="text: ResultCount"></span> item(s)
    </div>
</script>
