    <!-- /ko-->
    <!--ko if: showFindAction-->
    <div class="row" data-bind="template: {name: 'promotionStepFindActionTmpl', data: actionFindSettings }"></div>
    <!-- /ko-->
    <!--ko if: showLineageAction-->
    <div class="row" data-bind="template: {name: 'promotionStepLineageActionTmpl', data: actionLineageSettings }"></div>
    <!-- /ko-->
    <!--ko if: showRelateAction-->
    <div class="row" data-bind="template: {name: 'promotionStepRelateActionTmpl', data: actionRelateSettings }"></div>
    <!-- /ko-->
</script>

<script id="surveyQuestionTmpl" type="text/html">
    <div data-bind="visible: IsLoading()" style="text-align:center">
        <i class="fa fa-2x fa-spinner fa-spin"></i>
    </div>
    <!--ko if: !IsLoading()-->
    <div class="col s12" style="padding-bottom:5px"><span class="FieldName"><span data-bind="text:QuestionNumber"></span>.&nbsp;&nbsp;<span data-bind="text:Name"></span></span><span data-bind="visible: (Description() != null)"> - </span><span data-bind="html: Description()"></span></div>

    <div class="col s12">
        <div class="row">
            <!--ko if: DisplayStyle() == 'Radio List'-->
            <div data-bind="foreach: Values">
                <div class="col s12" style="padding:2px" data-bind="text: Name,jqxRadioButton: {checked: Checked, theme: theme, groupName: 'surveyValues' }"></div>
            </div>
            <!-- /ko-->
            <!--ko if: DisplayStyle() == 'Check List'-->
            <div data-bind="foreach: Values">
                <div class="col s12" style="padding:2px" data-bind="text: Name,jqxCheckBox: { checked: Checked, theme: theme,width: field_width, height: field_height}"></div>
            </div>
            <!-- /ko-->
            <div class="col s12" style="padding-top:2px">Comments (optional):</div>
            <div class="col s12">
                <textarea data-bind="value: Comments"></textarea>
            </div>
        </div>
    </div>
    <!-- /ko-->
</script>

<script id="surveyTmpl" type="text/html">
    <div data-bind="visible: (Survey() != null), fadeVisible: (!IsLoading() && Survey() != null && !Survey().ShouldTileFade())" class="tile tile-detail">
        <div data-bind="visible: IsLoading()" style="text-align:center">
            <i class="fa fa-2x fa-spinner fa-spin"></i>
        </div>
        <header>Survey - <span data-bind="text :(Survey() ? Survey().Name : '')"></span></header>
        <div class="row" data-bind="visible: !IsLoading(), with: Survey ">
            <div data-bind="visible: IsLoading()" style="text-align:center">
                <i class="fa fa-2x fa-spinner fa-spin"></i>
            </div>
            <!--ko if: !IsLoading() && !IsCompleted() && Questions().length > 0 -->
            <div class="row" data-bind="template: {name: 'surveyQuestionTmpl', data: CurrentQuestion() ? CurrentQuestion() : null }"></div>
            <div class="col s12" style="padding-top:10px;">
                <button class="btn waves-effect waves-light brown lighten-4" style="padding:0 15px 0 15px;" data-bind="click: prev, visible: isPreviousVisible">Previous</button>
                <button class="btn waves-effect waves-light brown lighten-1" style="padding:0 15px 0 15px;" data-bind="click: next, visible: isNextVisible, enable: isNextEnabled">Next</button>
                <button class="btn waves-effect waves-light brown lighten-1" style="padding:0 15px 0 15px;" data-bind="click: submit,visible: isSubmitVisible, enable: isSubmitEnabled">Submit</button>
                <i data-bind="text: pagingInfo()"></i>
            </div>
            <!-- /ko-->
            <!-- ko if: Questions().length == 0 && !IsLoading()-->
            <div class="col s12">Survey has no questions.  Please contact your administrator and ask them to update the survey: <span data-bind="text: Name()" style="font-weight:bold"></span></div>
            <!-- /ko-->
            <!-- ko if: IsCompleted()-->
            <div class="col s12">
                Thank for filling out the survey your entry has been factored into the sentiment score.
            </div>
            <!-- /ko-->
        </div>
    </div>
</script>


