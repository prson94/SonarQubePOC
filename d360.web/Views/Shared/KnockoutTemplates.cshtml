<script id="lineageEditTmpl" type="text/html">
    <div style="min-height: 250px; height: 250px">
        <div class="row">
            <div class="col s12">
                <table>
                    <tbody>
                        <tr>
                            <th colspan="12" style="text-align:center;">
                                Business Mapping
                            </th>
                        </tr>
                        <tr>
                            <th colspan="5">
                                <div style="background-color:black;color:white;">
                                    &nbsp;Source
                                </div>
                            </th>
                            <th colspan="2"></th>
                            <th colspan="5">
                                <div style="background-color:black;color:white;">
                                    &nbsp;Target
                                </div>
                            </th>
                        </tr>
                    </tbody>
                    <tbody data-bind="foreach: Items">
                        <tr data-bind="style: { backgroundColor: $index()%2==0 ? 'white' : '#eee'}">
                            <td colspan="2" style="vertical-align:top;width:16.67%;">
                                <div style="margin:5px">
                                    <div data-bind="jqxDropDownList: {
                                        theme: theme,
                                        source: SourceTypes,
                                        selectedIndex: SourceTypeIndex,
                                        dropDownHeight: 250,
                                        height: field_height,
                                        width: field_width98,
                                        displayMember: 'label',
                                        valueMember: 'value',
                                        enableBrowserBoundsDetection: true
                                    }"></div>
                                </div>
                            </td>
                            <td colspan="2" style="vertical-align:top;width:16.67%;">
                                <div style="margin:5px;">
                                    <div data-bind="jqxDropDownList: {
                                        theme: theme,
                                        source: SourceObjects,
                                        selectedIndex: SourceObjectIndex,
                                        dropDownHeight: 250,
                                        height: field_height,
                                        width: field_width98,
                                        displayMember: 'title',
                                        valueMember: 'value',
                                        enableBrowserBoundsDetection: true
                                    }"></div>
                                </div>
                            </td>
                            <td colspan="4" style="vertical-align:top;width:33.33%">
                                <div data-bind="if: (ShowAdvanced() == 'hide' && HasLoadedItems()),visible: (ShowAdvanced() == 'hide' && HasLoadedItems())" style="margin:5px;border:1px solid #ddd;">
                                    <div style="max-height:250px;overflow-y:auto;padding:3px;border-bottom:1px solid #ddd;">
                                        <table>
                                            <tbody data-bind="foreach: Items">
                                                <tr data-bind="foreach: Sources, style: { backgroundColor: $index()%2==0 ? 'white' : '#eee'}">
                                                    <td data-bind="text: ObjectName" style="border-radius:0"></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <table>
                                        <tbody data-bind="if: (ShowAdvanced() == 'hide' && HasLoadedItems())">
                                            <tr>
                                                <td>
                                                    <div style="margin:5px;">
                                                        <a style="cursor: pointer;" data-bind="click: SetShowAdvanced">+ Advanced</a>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div data-bind="if: (ShowAdvanced() == 'show' && HasLoadedItems())" style="margin: 5px;">
                                    <div style="max-height:250px;overflow-y:auto;padding:3px;border:1px solid #ddd;">
                                        <table style="border-radius:0 !important">
                                            <tbody data-bind="foreach: Items">
                                                <tr data-bind="style: { backgroundColor: $index()%2==0 ? 'white' : '#eee'}">
                                                    <td>
                                                        <ul data-bind="foreach: Sources" style="margin-top:0;margin-bottom:0">
                                                            <li data-bind="text: ObjectName"></li>
                                                        </ul>
                                                    </td>
                                                    <td>
                                                        <a style="cursor:pointer;font-weight:bold;color:black;" data-bind="visible: (AddMode() == ''), click: ShowAddSource">+</a>
                                                    </td>
                                                    <td>
                                                        <ul data-bind="foreach: Targets" style="margin-top:0;margin-bottom:0">
                                                            <li data-bind="text: ObjectName"></li>
                                                        </ul>
                                                    </td>
                                                    <td>
                                                        <a style="cursor:pointer;font-weight:bold;color:black;" data-bind="visible: (AddMode() == ''), click: ShowAddTarget">+</a>
                                                    </td>
                                                </tr>
                                                <tr data-bind="if: (AddMode() == 'source'), style: { backgroundColor: $index()%2==0 ? 'white' : '#eee'}">
                                                    <td colspan="4">
                                                        <div class="row" style="margin-bottom: 5px;">
                                                            <div class="col s9">
                                                                <div data-bind="jqxDropDownList: {
                                                                    theme: theme,
                                                                    source: NewItems,
                                                                    selectedIndex: NewItemIndex,
                                                                    dropDownHeight: 250,
                                                                    height: field_height,
                                                                    width: field_width98,
                                                                    displayMember: 'SourceName',
                                                                    valueMember: 'value',
                                                                    enableBrowserBoundsDetection: true
                                                                }"></div>
                                                            </div>
                                                            <div class="col s3">
                                                                <div style="display:inline-block; width:40%">
                                                                    <div data-bind="jqxButton: {theme: theme, }, click: AddSource">Add</div>
                                                                </div>
                                                                <div style="display:inline-block; width:55%">
                                                                    <div data-bind="jqxButton: {theme: theme, }, click: AddCancel">Cancel</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr data-bind="if: (AddMode() == 'target'), style: { backgroundColor: $index()%2==0 ? 'white' : '#eee'}">
                                                    <td colspan="4">
                                                        <div class="row" style="margin-bottom: 5px;">
                                                            <div class="col s9">
                                                                <div data-bind="jqxDropDownList: {
                                                                    theme: theme,
                                                                    source: NewItems,
                                                                    selectedIndex: NewItemIndex,
                                                                    dropDownHeight: 250,
                                                                    height: field_height,
                                                                    width: field_width98,
                                                                    displayMember: 'SourceName',
                                                                    valueMember: 'value',
                                                                    enableBrowserBoundsDetection: true
                                                                }"></div>
                                                            </div>
                                                            <div class="col s3">
                                                                <div style="display:inline-block;width:40%">
                                                                    <div data-bind="jqxButton: {theme: theme, }, click: AddTarget">Add</div>
                                                                </div>
                                                                <div style="display:inline-block;width:55%">
                                                                    <div data-bind="jqxButton: {theme: theme, }, click: AddCancel">Cancel</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <table style="border:1px solid #ddd;border-top:0;">
                                        <tbody data-bind="if: (ShowAdd() === true)">
                                            <tr>
                                                <td colspan="4">
                                                    <div class="row" style="margin: 5px;">
                                                        <div class="col s6">
                                                            <div class="FieldName">Source</div>
                                                            <div data-bind="jqxDropDownList: {
                                                                    theme: theme,
                                                                    source: AddSourceItems,
                                                                    selectedIndex: AddSourceIndex,
                                                                    dropDownHeight: 250,
                                                                    height: field_height,
                                                                    width: field_width98,
                                                                    displayMember: 'SourceName',
                                                                    valueMember: 'value',
                                                                    enableBrowserBoundsDetection: true
                                                                }"></div>
                                                        </div>
                                                        <div class="col s6">
                                                            <div class="FieldName">Target</div>
                                                            <div data-bind="jqxDropDownList: {
                                                                    theme: theme,
                                                                    source: AddTargetItems,
                                                                    selectedIndex: AddTargetIndex,
                                                                    dropDownHeight: 250,
                                                                    height: field_height,
                                                                    width: field_width98,
                                                                    displayMember: 'SourceName',
                                                                    valueMember: 'value',
                                                                    enableBrowserBoundsDetection: true
                                                                }"></div>
                                                        </div>
