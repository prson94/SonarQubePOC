    <div class="count-tile">
        <!-- ko if: Rows().length -->
        <!-- ko foreach: Rows-->
        <!-- ko if: $index() == 0 -->
        <div class="Row">
            <div class="col l8 s8">&nbsp;</div>
            <!-- ko if: Total == null && New != null -->
            <div class="col l4 s4 center-align title">New</div>
            <!-- /ko -->
            <!-- ko if: Total != null && New == null -->
