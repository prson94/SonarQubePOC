                            <button class="btn btn-small grey lighten-2 black-text btn-flat waves-light waves-effect" style="height:auto;padding:1px 5px;line-height:1.4;text-transform:none;font-size:90%" data-bind="click: function() { DeleteHidden(false); hideEdit(); hideReply(); }, visible: (DeleteHidden() && IsDeletable() && ShowAddCommentControls())"><i style="font-size:80%;" class="fa fa-remove"></i> Delete</button>
                        </span>
                        <span style="float:right;">
                            <button data-bind="style: {display: tagsAreHidden() ? 'inline-block' : 'none' }, click: displayTags" class="btn btn-small grey lighten-2 black-text btn-flat waves-light waves-effect" style="height:auto;padding:1px 5px;line-height:1.4;text-transform:none;font-size:90%">
                                <span data-bind="visible: tagsAreHidden, text: CurrentTagCountText"></span>
                                <i class="fa fa-arrow-down" style="font-size:80%"></i>
                            </button>
                            <button data-bind="style: {display: tagsAreHidden() ? 'none' : 'inline-block' }, click: hideTags" class="btn btn-small grey lighten-2 black-text btn-flat waves-light waves-effect" style="height:auto;padding:1px 5px;line-height:1.4;text-transform:none;font-size:90%">
                                <span data-bind="visible: tagsAreDisplayed">hide tags</span>
                                <i class="fa fa-arrow-up" style="font-size:80%"></i>
                            </button>
                        </span>
                    </div>
                    <div style="display:inline-block;" data-bind="fadeVisible: tagsAreDisplayed">
                        <!-- ko template: {name: 'commentTagTmpl', foreach: CurrentTags } -->
                        <!-- /ko -->
                    </div>
                </td>
            </tr>
            <tr data-bind="visible: !DeleteHidden()">
                <td style="text-align:center;" colspan="2">
                    <div style="font-size:1.1rem;">Are you sure you want to delete this comment?</div>
                    <button class="btn btn-small grey white-text waves-effect waves-light" type="button" data-bind="click: function () { DeleteHidden(true); }, disable: IsProcessing" style="width:70px; margin: 0 5px 5px 0; padding:0 6px;">Cancel</button>
                    <button class="btn btn-small red white-text waves-effect waves-light" type="button" data-bind="click: function() { IsDeleted(true); updateComment(); }, disable: IsProcessing" style="width:70px; margin: 0 5px 5px 0; padding:0 6px;"><i class="fa fa-spinner fa-spin" data-bind="visible: IsProcessing"></i><span data-bind="visible: !IsProcessing()">Delete</span></button>
                </td>
            </tr>
            <tr>
                <td colspan="2" style="text-align:left;" data-bind="visible: !EditHidden()">

                    <!-- ko template: {name: 'commentTagTmpl', foreach: tags } -->
                    <!-- /ko -->

                </td>
            </tr>
            <tr>
                <td colspan="2" class="ChildComments">
                    <table data-bind="visible: !EditHidden()" class="ChildComments" style="width: 100%; word-wrap:break-word;table-layout: fixed;">
                        <tr>
                            <td class="input-field" style="width:100%" colspan="2">
                                <textarea style="width:100%" data-bind="value: Body, htmlarea: Body"></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="text-align:left;">
                                <div style="white-space:nowrap;display:inline-block;width:100%">
                                    <input data-bind="value: newTag, valueUpdate: 'afterkeydown', event : { keyup: setIndex }" placeholder="Add another tag" style="border: none; border: 1px solid #adacac; line-height:1.5; padding:2px;margin:5px 0; width:100%;" />
                                    <i class="fa fa-tags" style="position:relative; z-index:1; left: -25px; top: 0; color: rgba(80, 80, 80, 0.85); width: 0; font-size:larger"></i>
                                </div>
                                <div class="tagSuggestionDisplay" data-bind="visible: tagSuggestionsPresent" style="position:absolute; z-index:100; border-left:solid 1px #dedede; border-right:solid 1px #dedede; border-bottom:solid 1px #dedede; overflow-y: scroll; background-color: #fff; max-height:250px; box-shadow: 5px 5px 3px grey; border-radius: 3px;">
                                    <div style="padding:4px; border-top:solid 1px #dedede; font-size:12px; ">
                                        <!-- ko template: {name: 'commentTagSuggestionTmpl', foreach: tagSuggestions } -->
                                        <!-- /ko -->
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>
                                <button class="btn btn-small blue white-text waves-effect waves-light" type="button" data-bind="click: updateComment, disable: IsProcessing" style="float:right;width:70px; margin: 0 5px 5px 0; padding:0 6px;"><i class="fa fa-edit" title="Edit" data-bind="visible: !IsProcessing()"></i><i class="fa fa-spinner fa-spin" data-bind="visible: IsProcessing"></i></button>
                                <button class="btn btn-small grey white-text waves-effect waves-light" type="button" data-bind="click: hideEdit, disable: IsProcessing" style="float:right;width:70px; margin: 0 5px 5px 0; padding:0 6px;">Cancel</button>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td colspan="2" class="ChildComments">
                    <a class="commentNotification" data-bind="click: loadNewComments, visible: NewComments().length > 0"> <span data-bind="text: NewComments().length"></span> new comment(s)</a>
                    <table class="ChildComment" style="width: 100%; word-wrap:break-word;table-layout: fixed;" data-bind="visible: (!ReplyHidden() && ShowAddCommentControls())">
                        <tr>
                            <td colspan="2" style="text-align:left;">
                                <!-- ko template: {name: 'commentTagTmpl', foreach: tags } -->
                                <!-- /ko -->
                                <!-- <button class="btn btn-small grey lighten-2 black-text btn-flat waves-light waves-effect" data-bind="visible: HasNewTags, click: updateComment, text: NewTagCountText">Save</button>
                                -->

                            </td>
                        </tr>

                        <tr>
                            <td colspan="2" class="ChildComments" style="text-align:left;">
                                <textarea style="width:100%" data-bind="htmlareasimple: newCommentMessage"></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="text-align:left;">
                                <div style="display:inline-block;width:100%">
                                    <input data-bind="value: newTag, valueUpdate: 'afterkeydown', event : { keyup: setIndex }" placeholder="Add another tag" style="border: none; border: 1px solid #adacac; line-height:1.5; padding:2px;margin:5px 0; width:100%;" />
                                    <i class="fa fa-tags" style="position:relative; z-index:1; left: -25px; top: 0; color: rgba(80, 80, 80, 0.85); width: 0; font-size:larger"></i>
                                </div>
                                <div class="tagSuggestionDisplay" data-bind="visible: tagSuggestionsPresent" style="position:absolute; z-index:100; border-left:solid 1px #dedede; border-right:solid 1px #dedede; border-bottom:solid 1px #dedede; overflow-y: scroll; background-color: #fff; max-height:250px; box-shadow: 5px 5px 3px grey; border-radius: 3px;">
                                    <div style="padding:4px; border-top:solid 1px #dedede; font-size:12px; ">
                                        <!-- ko template: {name: 'commentTagSuggestionTmpl', foreach: tagSuggestions } -->
                                        <!-- /ko -->
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>
                                <button class="btn btn-small grey white-text waves-effect waves-light" type="button" data-bind="click: hideReply, disable: IsProcessing" style="width:70px; margin: 0 5px 5px 0; padding:0 6px;">Cancel</button>
                                <button class="btn btn-small blue white-text waves-effect waves-light" type="button" data-bind="click: addComment, disable: (IsProcessing() || DisableReply())" style="width:70px; margin: 0 5px 5px 0; padding:0 6px;"><i class="fa fa-reply" title="Reply" data-bind="visible: !IsProcessing()"></i><i class="fa fa-spinner fa-spin" data-bind="visible: IsProcessing"></i></button>
                            </td>
                        </tr>
                    </table>
                    <div data-bind="template: {name: 'subCommentTmpl', foreach: Comments }"></div>
                </td>
            </tr>
        </table>
    </div>

</script>
