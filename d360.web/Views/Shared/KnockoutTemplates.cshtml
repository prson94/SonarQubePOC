                                                        <a style="cursor: pointer;" data-bind="click: SetHideAdvanced">- Advanced</a>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                            <td colspan="2" style="vertical-align:top;width:16.67%;">
