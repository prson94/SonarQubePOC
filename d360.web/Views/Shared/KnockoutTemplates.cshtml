<script id="commentTmpl" type="text/html">
    <div class="entry top-entry" data-bind="css: { 'entry-alt': $index()%2 }, visible: isVisible, attr: { id: ID }">
        <table style="table-layout:fixed;">
            <tr>
                <td rowspan="6" class="profile" style="width:24px;">
                    <i data-bind="css: getCommentTypeCss()" style="font-size:large;"></i>
                </td>
                <td style="vertical-align:top;">
                    <div>
                        <a style="font-weight:bold" data-bind="attr: { href: ObjectUrl, 'data-type': ObjectType, 'data-context': 'Preview', 'data-id': ObjectID }"><span data-bind="text: ObjectName"></span></a>
                        <span data-bind="visible: ShowObjectType">
                            (posted by
                            <a data-bind="attr: { 'data-type': 'Resource', 'data-context': 'Preview', 'data-id': CreatingResourceID, href: getResourceUrl() }, text: (CreatorIsOwner() ? ResourceName() + ' (owner)' : ResourceName)"></a>)
                        </span>
