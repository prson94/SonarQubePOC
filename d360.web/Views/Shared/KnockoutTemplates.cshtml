                <div data-bind="css: BootstrapClass, attr: {'id': AreaID, 'data-area': ID, 'style': HeightStyle}, foreach: Tiles">
                    <h3 data-bind="text: Name"></h3>
                    <div data-bind="attr: {'id': TileID, 'data-reporttype': ReportTileType, 'data-reporttileid': ID, 'data-data': Data, 'data-display': Display, 'data-xaxis': XAxis, 'data-settings': Settings}" data-design="0"></div>
