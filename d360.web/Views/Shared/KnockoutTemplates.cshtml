<script id="workflowStatusTile" type="text/x-handlebars-template">
    <div class="row">
        <div class="col s6">
            <div class="FieldName">Workflow</div>
            <div>
                {{WorkflowTypeName}}
                <div class="small">{{WorkflowTypeDescription}}</div>
            </div>

            <div class="FieldName">Started On</div>
            <div>{{DateStarted}}</div>

            <div class="FieldName">Completed On</div>
            <div>{{DateCompleted}}</div>
        </div>
        <div class="col s6">
            <div class="FieldName">Information About This Request</div>
            <table class="hoverable">
                <tbody>
                    {{#each Fields }}
                    <tr>
                        <td>{{Name}}</td>
                        <td>{{{Value}}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col s6">
            <div class="FieldName">Steps Completed</div>
            <table class="hoverable">
                <tbody>
                    {{#each Steps }}
                    <tr>
                        <td>{{Name}}</td>
                        <td>{{Date}}</td>
                        <td>{{TraceLevel}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        <div class="col s6">
            <div class="FieldName">Assignments</div>
            <table class="hoverable">
                <tbody>
                    {{#each Assignments }}
                    <tr>
                        <td>{{ActivityTypeName}}</td>
                        <td>{{ActivityTypeDescription}}</td>
                        <td>{{ResourceName}}</td>
                        <td>{{IsComplete}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</script>

