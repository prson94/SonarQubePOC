@model List<d360.core.entities.CommentCategory>

<script type="text/javascript">
    $(document).ready(function () {
        $("#dropDownButton").jqxDropDownButton({ width: 150, height: 25 });
        setDropdownContent("All");
        //$('#CategoryResults').SocialCategory({ followed: true });
        $('#CategoryResults').jqxTree();

        $('#CategoryResults').bind("select", function (evt) {
            try {
                var node = $(evt.args.element);//.find(".node");
                var id = node.data("categoryid");
                var ca = node.data("category");
                amplify.publish("SocialPostsFiltered", { category: ca, categoryid: id });

                var args = evt.args;
                var item = $('#CategoryResults').jqxTree('getItem', args.element);
                setDropdownContent(item.label);
            } catch (e) {
                logError("CommentCategoriesTree : select", e);
            }
        });
    });

    function setDropdownContent(text)
    {
        var dropDownContent = '<div style="position: relative; margin-left: 3px; margin-top: 5px;">' + text + '</div>';
        $("#dropDownButton").jqxDropDownButton('setContent', dropDownContent);
    }
</script>
<div id="dropDownButton">
    <div id="CategoryResults">
        <ul>
            <li data-categoryid='0' data-category='' item-selected="true"><a href='#'>All</a></li>
            @foreach (var g in Model)
            { 
                <li item-expanded="true" data-categoryid="@g.ObjectID" data-category="@g.ObjectType">
                    <a style='font-weight:600;' href="#">@g.Category</a> : @g.Count item(s)
                    <ul>
                    @foreach (var c in g.Items)
                    {
                        <li data-categoryid="@c.ObjectID" data-category="@c.ObjectType"><a href="#">@c.Name</a> : @c.Count item(s)</li>
                    }
                    </ul>
                </li>
            }
        </ul>
    </div>
</div>