@model d360.web.Models.FusionAttributeTypeEditorControl

@helper TypeNode(d360.core.entities.FusionAttributeType t)
{
    <li item-expanded='true' selected="@(t.ID == Model.SelectedID)">
        <span class="node" data-oid="@t.ID">@t.Name</span>
        <ul>
            @foreach (var s in Model.Types.Where(i => i.ParentID == t.ID).OrderBy(i => i.Name))
            {
                @TypeNode(s)
            }
        </ul>
    </li>
}
<input type="hidden" id="FusionAttributeTypeID" name="FusionAttributeTypeID" />
<div class="FieldNameRequired">@(Model.Title)</div>
<div id="FusionAttributeTypeDropdown">
    <div id="FusionAttributeType_Tree">
        <ul>
            @foreach (var t in Model.Types.Where(i => !i.ParentID.HasValue).OrderBy(i => i.Name))
            {
                @TypeNode(t)
            }
        </ul>
    </div>
</div>
<script type="text/javascript">
    var FusionAttributeType_SelectedID = "@(Model.SelectedID)";
    function FusionAttributeType_treeSelect(evt) {
        try {
            var n = $(evt.args.element).find("span.node");
            var id = null;


            if (n.data("oid")) {
                id = n.data("oid");
                $('#FusionAttributeTypeID').val(id);
            }
            var dropDownContent = '<div style="position: relative; margin-left: 3px; margin-top: 5px;">' + n.text() + '</div>';
            $("#FusionAttributeTypeDropdown").jqxDropDownButton('setContent', dropDownContent);
            $('#FusionAttributeTypeDropdown').jqxDropDownButton('close');
        }
        catch (e) {
            console.log(e);
        }
    }

    function FusionAttributeType_unsubscribe(data) {
        $("#FusionAttributeType_Tree").off("select", FusionAttributeType_treeSelect);
        amplify.unsubscribe(AmplifyActions.Unsubscribe, FusionAttributeType_unsubscribe);
    }

    $(function () {
        $("html, body").animate({ scrollTop: 0 }, "slow");

        $("#FusionAttributeTypeDropdown").jqxDropDownButton({ theme: theme, width: field_width, height: field_height });
        $("#FusionAttributeType_Tree").jqxTree({ theme: theme, width: field_width, height: maxTreeHeight, theme: list_theme, allowDrag: false, allowDrop: false });
        $('#FusionAttributeType_Tree').jqxTree('selectItem', $("#Tree").find('li:first')[0]);

        $("#FusionAttributeType_Tree").on("select", FusionAttributeType_treeSelect);
        amplify.subscribe(AmplifyActions.Unsubscribe, FusionAttributeType_unsubscribe);

        var items = $("#FusionAttributeType_Tree").jqxTree('getItems');
        if (items) {
            $.each(items, function () {
                var n = $(this.element).find("span.node");
                if (n.data("oid") == FusionAttributeType_SelectedID) {
                    $("#FusionAttributeType_Tree").jqxTree('selectItem', this.element);
                }
            });
        }
    });
</script>