@{
    var suffix = System.Configuration.ConfigurationManager.AppSettings["ResourceSuffix"];
}
<!DOCTYPE html>
<html class="no-js">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Data3Sixty, Inc.</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="Shortcut Icon" href="/favicon.ico" />
    <link href='https://fonts.googleapis.com/css?family=BenchNine:700' rel='stylesheet' type='text/css'>
    <link rel="stylesheet" href="/Content/styles/all@(suffix).css" />
    @RenderSection("CustomCSS", false)
    <script type="text/javascript" src="/scripts/all@(suffix).js"></script>
    @RenderSection("CustomHeaderLibraries", false)
    @RenderSection("Scripts", false)
    <script type="text/javascript">
        $(function () {
            $('.htmlArea').redactor({ minHeight: 200, convertVideoLinks: true });

            $('body').on('mouseenter', 'a[data-type]', function (event) {
                $(this).qtip({
                    content: {
                        // Set the text to an image HTML string with the correct src URL to the loading image you want to use
                        text: '<i class="fa fa-spinner fa-spin fa-4x"></i>',
                        ajax: {
                            url: "/resources/" + $(this).data("type") + "/" + $(this).data("id") + "/templates/tooltip/" + $(this).data("context")
                        }
                    },
                    position: {
                        at: 'bottom center', // Position the tooltip above the link
                        my: 'top center',
                        viewport: $(window), // Keep the tooltip on-screen at all times
                        effect: false // Disable positioning animation
                    },
                    overwrite: false,
                    show: {
                        event: event.type,  // show using same event as above.
                        solo: true,         // Only show one tooltip at a time
                        ready: true
                    },
                    hide: 'mouseout',
                    style: {
                        classes: 'qtip-blue qtip-rounded'
                    }
                    //addTooltip(this);
                });
            });

            amplify.subscribe("ShowMessage", function (data) {
                //{ title, message, type }
                var stickTime = '';
                if (data.type == 'error') stickTime = '30000';
                $.gritter.add({
                    type: data.type, title: data.title, text: data.message, sticky: false, time: stickTime
                });
            });
        });

        $(document).ajaxComplete(function () {
            $('.htmlArea').redactor({ minHeight: 200, convertVideoLinks: true });
        });

        $(window).resize(function () {
            amplify.publish("PageResized");
        });

    </script>
    <script type="text/javascript">
        //window.appInsights = { queue: [], applicationInsightsId: null, accountId: null, appUserId: null, configUrl: null, start: function (n) { function u(n) { t[n] = function () { var i = arguments; t.queue.push(function () { t[n].apply(t, i) }) } } function f(n, t) { if (n) { var u = r.createElement(i); u.type = "text/javascript"; u.src = n; u.async = !0; u.onload = t; u.onerror = t; r.getElementsByTagName(i)[0].parentNode.appendChild(u) } else t() } var r = document, t = this, i; t.applicationInsightsId = n; u("logEvent"); u("logPageView"); i = "script"; f(t.configUrl, function () { f("//az416426.vo.msecnd.net/scripts/ai.0.js") }); t.start = function () { } } };
        //appInsights.start("d4350e1d-1a0b-4eab-bc8f-489cf8aceb11");
        //appInsights.logPageView();
    </script>
</head>
<body>
    <header>
        <div class="row">
            <div id="Logo" class="col-lg-3">&nbsp;</div>
            <div class="col-lg-9 pull-right">
                <div class="pull-right">@RenderSection("SearchBar", false)</div>
                <div class="clearfix"></div>
                <div class="pull-right">
                    <nav id="TopNav">
                        @RenderSection("TopNavigation", false)
                    </nav>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </header>
    @RenderBody()
    <footer>
        <span>&copy; @DateTime.Now.Year - Data3Sixty, Inc.  All rights reserved.</span>
        <div class="socialbar">
            <a href="http://www.facebook.com/pages/Data3Sixty-Inc/260525100649601" class="btn"><i class="fa fa-facebook-square"></i></a>
            <a href="http://twitter.com/data3sixty" class="btn"><i class="fa fa-twitter-square"></i></a>
            <a href="https://www.linkedin.com/company/data3sixty" class="btn"><i class="fa fa-linkedin-square"></i></a>
            @RenderSection("FooterNavigation", false)
        </div>
    </footer>
</body>
</html>