@model d360.core.entities.ObjectModel

<script type="text/javascript">
    $(function () {

        var url = '/monitor/@(Model.ObjectType)/@(Model.ObjectID)/assignments.json';

        //#region Grid

        var srcAssignmentsPart = {
            datatype: 'json',
            url: url,
            datafields:
            [
                { name: 'ID', type: 'number' },
                { name: 'ResourceType', type: 'string' },
                { name: 'ResourceName', type: 'string' },
                { name: 'DateCreated' }
            ]
        };

        var adapterAssignmentsPart = new $.jqx.dataAdapter(srcAssignmentsPart);

        $("#Assignments").jqxGrid({
            altrows: true,
            width: grid_width,
            autoheight: true,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            source: adapterAssignmentsPart,
            theme: list_theme,
            columns: [
                { datafield: "ResourceName", text: "Name" },
                { datafield: "ResourceType", text: "Type", width: 125 },
                { datafield: "DateCreated", text: "Assigned On", width: 125, cellsrenderer: shortdaterenderer }
            ]
        });

        //#endregion

        //#region Event Subscriptions

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case "assignmentform":
                        $('#Assignments').jqxGrid('updatebounddata');
                        break;
                }
            } catch (e) {
                logError("Assignments", e);
            }
        });

        //#endregion
    });
</script>
<div id="Assignments"></div>