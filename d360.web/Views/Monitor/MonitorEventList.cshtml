@model List<d360.core.entities.FieldTypeWithRelation>
@{
    var columns = "";    
    var dataFields = "";
    Model.ForEach(i => {
        if ((i.Name != "ID") && (i.Name != "EventTypeID") && (i.Name != "EventGroupID") && (i.Name != "ResolutionID"))
        {
            columns += "{ datafield: '" + i.Name + "', text: '" + i.FriendlyName + "'";
            //if (i.Name == "Status")
            //{
            //    columns += " filtertype: 'list', filteritems: ['Open', 'Assigned', 'Closed'] ";
            //}
            if (i.Name == "DateCreated")
            {
                columns += " , cellsrenderer: daterenderer "; //filtertype: 'date', 
            }
            columns += "},";
        }
        dataFields += "{ name: '" + i.Name + "'},";  
    });
    columns = columns.Remove(columns.Length - 1, 1);
    dataFields = dataFields.Remove(dataFields.Length - 1, 1);

    var type = ViewData["ObjectType"];
    var id = ViewData["ObjectID"];
}
<script type="text/javascript">
    var selectedEventID = "@(ViewData["EventID"])";

    $(document).ready(function () {
        //#region Event Grid Definition

        var srcEventGrid = {
            datatype: 'json',
            url: '/monitor/@(type)/@(id)/events.json',
            datafields:
            [
                @Html.Raw(dataFields)
            ]
        };

        var adapterEventGrid = new $.jqx.dataAdapter(srcEventGrid);

        var eventListWidth = $("#EventList").parent().width();
        $("#EventList").jqxGrid({
            altrows: true,
            width: grid_width,
            autoheight: true,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            pageable: true,
            groupable: true,
            groupsexpandedbydefault: true,
            scrollmode: 'deferred',
            enabletooltips: true,
            columnsresize: true,
            pagesize: 25,
            pagesizeoptions: ['10', '25', '50', '100'],
            source: adapterEventGrid,
            theme: list_theme,
            columns: [
                @Html.Raw(columns)
            ],
            ready: function () {
                try {
                    var filtergroup = new $.jqx.filter();
                    var filter_or_operator = 1;
                    var filtervalue = 'Open';
                    var filtercondition = 'EQUAL';
                    var filter1 = filtergroup.createfilter('stringfilter', filtervalue, filtercondition);
                    filtergroup.addfilter(filter_or_operator, filter1);

                    $("#EventList").jqxGrid('addfilter', 'Status', filtergroup);
                    $("#EventList").jqxGrid('applyfilters');
                    $('#EventList').jqxGrid('refreshfilterrow');
                    $("#EventList").jqxGrid('autoresizecolumns');

                    if (selectedEventID != "") {
                        var eventRows = $('#EventList').jqxGrid('getboundrows');
                        for (var i in eventRows) {
                            var rowData = eventRows[i];
                            if (rowData.ID == selectedEventID) {
                                var selectedIndex = i;
                                var paginginformation = $('#EventList').jqxGrid('getpaginginformation');
                                var pagesize = paginginformation.pagesize;

                                $('#EventList').jqxGrid('gotopage', Math.ceil(selectedIndex / pagesize));
                                $("#EventList").jqxGrid('selectrow', selectedIndex);
                            }
                        }
                        eventRows = null;
                    }

                    $("#EventList").jqxGrid('autoresizecolumns');
                } catch (e) {
                    logError("MonitorEventList", e);
                }
            }
        });

        $('#EventList').on('rowselect', function (event) {
            try {
                var args = event.args;
                var row = args.rowindex;

                var data = $('#EventList').jqxGrid('getrowdata', row);

                if (data) {
                    data.context = 'eventform';
                    amplify.publish('RowSelectedAction', data);
                }
            } catch (e) {
                logError("MonitorEventList", e);
            }

        });

        //#endregion

        //#region Event Subscriptions

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case "eventform":
                    case "resolutionform":
                        $('#EventList').jqxGrid('updatebounddata');
                        break;
                }
            } catch (e) {
                logError("MonitorEventList", e);
            }
        });

        //#endregion

    });
</script>
<div class="tile tile-detail">
    <header>Events</header>
    <article id="EventList"></article>
</div>