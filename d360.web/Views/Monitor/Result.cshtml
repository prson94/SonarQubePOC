@model d360.core.entities.QualityException
@{
    var name = Html.Raw(Model.Description);
    ViewBag.Title = name;
}

@section Scripts {
<script type="text/javascript">
    var id = '@(Model.ID)';
    var type = 'QualityException';
    $(document).ready(function () {
        $("#ContentArea").PageNavigation({ tabCookieName: 'resultSelectedTab', type: type, id: id });
        $("#ModuleNavigation").jqxNavigationBar({ width: 500, height: 300, expandMode: 'multiple', expandedIndexes: [0] });
        $('#Relations').load('/Relations/RelationTree?type=' + type + '&id=' + id);
        $("#RandomQuestion").RandomSurveyQuestion({ objectType: type, objectID: id });
        $('#PageTools').PageTools({ type: type, id: id });
        $('#Assignments').load('/monitor/results/@(ViewData["TypeID"])/@(ViewData["ID"])/groups');
    });
</script>
}

@section Title{
@name
}

@section Directions{
}

@section Breadcrumb {
@Resources.navigation.Quality :: <span>@Resources.navigation.Quality_Monitor</span>
}

@section Sidebar{
<h1>Assigned Groups</h1>
<div id="Assignments"></div>
}