@model List<d360.core.entities.EventType>
@helper TypeNode(d360.core.entities.EventType t)
{
<li item-expanded='false'>
    <span data-id="@t.ID" data-parentid="@(t.ParentID.HasValue ? t.ParentID.Value : 0)" data-context="eventtypeform">@t.Name</span>
        <ul>
        @foreach (var s in Model.Where(i => i.ParentID == t.ID).OrderBy(i => i.Name))
        {
            @TypeNode(s)
        }                
        </ul>
</li>
}

<ul>
    @foreach (var t in Model.Where(i => !i.ParentID.HasValue).OrderBy(i => i.Name))
    {
        @TypeNode(t)
    }
</ul>
