@model d360.core.entities.ObjectModel

<script type="text/javascript">
    $(function () {

        var url = '/monitor/@(Model.ObjectType)/@(Model.ObjectID)/kb.json';

        //#region Grid

        var srcKBPart = {
            datatype: 'json',
            url: url,
            datafields:
            [
                { name: 'ID', type: 'number' },
                { name: 'Name', type: 'string' },
                { name: 'DateCreated' }
            ]
        };

        var adapterKBPart = new $.jqx.dataAdapter(srcKBPart);

        $("#KnowledgeBase").jqxGrid({
            altrows: true,
            width: grid_width,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            autoheight: true,
            source: adapterKBPart,
            theme: list_theme,
            columns: [
                { datafield: "Name", text: "Name" },
                { datafield: "DateCreated", text: "Assigned On", width: 125, cellsrenderer: shortdaterenderer }
            ]
        });

        //#endregion

        //#region Event Subscriptions

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case "assignmentform":
                        $('#KnowledgeBase').jqxGrid('updatebounddata');
                        break;
                }
            } catch (e) {
                logError("KnowledgeBase", e);
            }
        });

        //#endregion

    });
</script>
<div class="tile tile-detail">
    <header>KB</header>
    <article id="KnowledgeBase"></article>
</div>