@model List<d360.web.Models.EditableField>
<div class="small-overlay">
    <div class="ui segment">
        @Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = ContextList.Intersect, Description = "Please provide as much detail as possible in the form below.  You may select one or more relationships by clicking/highlighting the items in the list below.", Name = "Add Relationship" })

        <div class="FieldNameRequired">What Items Are You Relating?</div>
        <div id="ItemsDropdown">
            <div id="ItemsGrid"></div>
        </div>

        <div class="FieldNameRequired">How Important Is This Relationship?</div>
        <div id="ImportanceDropdown"></div>

        <div class="FieldNameRequired">Is There Anything Else We Should Know?</div>
        <textarea id="Description"></textarea>
    </div>
</div>
<script type="text/javascript">
    var Source = "@(ViewData["Source"])";
    var SourceID = "@(ViewData["SourceID"])";
    var TargetType = "@(ViewData["TargetType"])";
    var TargetTypeID = "@(ViewData["TargetTypeID"])";

    var FormValidationException = function (message) {
        this.message = message;
        this.toString = function () {
            return this.message;
        }
    };

    var AddRelationshipDestroy = function () {
        $("#ItemsGrid").jqxGrid('destroy');
        $('#ItemsDropdown').jqxDropDownButton('destroy');
        $('#Description').redactor('destroy');
        $('#ImportanceDropdown').jqxDropDownList('destroy');
    }

    $(function () {

        //#region Question 1

        $("#ItemsDropdown").jqxDropDownButton({ theme: theme, width: field_width, height: field_height });

        var ItemsSource = {
            datafields: [
                { name: 'Object' },
                { name: 'ObjectID' },
                { name: 'Name' },
                { name: 'Url' }
            ],
            datatype: "json",
            url: '/relations/PossibleRelationshipsBySource?source=' + Source + '&id=' + SourceID + '&targetType=' + TargetType + '&targetTypeID=' + TargetTypeID
        };

        var ItemsAdapter = new $.jqx.dataAdapter(ItemsSource);

        $("#ItemsGrid").jqxGrid({
            altrows: true,
            theme: theme,
            source: ItemsAdapter,
            filterable: true,
            showfilterrow: true,
            selectionmode: 'multiplerows',
            scrollmode: 'logical',
            sortable: true,
            pageable: false,
            pagerMode: 'advanced',
            theme: list_theme,
            width: '100%',
            height: 325,
            columns: [
                { text: 'Name', datafield: 'Name' }
            ]
        });

        $("#ItemsGrid").on('rowselect rowunselect', function (event) {
            try {
                var args = event.args;
                var rowindexes = $('#ItemsGrid').jqxGrid('getselectedrowindexes');

                $('#EditableFormSaveButton').disabled = (rowindexes.length <= 0);

                var dropDownContent = '<div style="position: relative; margin-left: 3px; margin-top: 5px;">' + rowindexes.length + ' selected items(s)</div>;';
                $("#ItemsDropdown").jqxDropDownButton('setContent', dropDownContent);
            } catch (e) {
                logError("AddRelationship", e);
            }
        });

        //#endregion

        //#region Question 2

        var ImportanceSource = {
            datatype: "json",
            datafields: [
                { name: 'Name' },
                { name: 'ID' }
            ],
            url: '/relations/Classifications',
            async: false
        };

        var ImportanceAdapter = new $.jqx.dataAdapter(ImportanceSource);

        $('#ImportanceDropdown').jqxDropDownList({ theme: theme, placeHolder: 'Choose Classification...', source: ImportanceAdapter, displayMember: 'Name', valueMember: 'ID', width: '100%', dropDownWidth: 250 });

        //#endregion

        //#region Question 3

        $('#Description').redactor({
            buttons: ['bold', 'italic', 'unorderedlist', 'link']
        });

        //#endregion


        //#region Form Events

        $('#EditableFormSaveButton').on('click', function () {

            $('#EditableFormSaveButton').attr('disabled', 'disabled');
            $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');

            var model = {
                Targets: [],
                Classification: $('#ImportanceDropdown').val(),
                Description: $('#Description').val()
            };

            try {

                var rowindexes = $('#ItemsGrid').jqxGrid('getselectedrowindexes');

                if (rowindexes.length <= 0) {
                    throw new FormValidationException('You must first select one or more items to relate.');
                }

                $(rowindexes).each(function () {
                    var data = $('#ItemsGrid').jqxGrid('getrowdata', this);
                    model.Targets.push({ ObjectType: data.Object, ObjectID: data.ObjectID });
                });

                $.ajax('/api/' + Source + '/' + SourceID + '/relationships', {
                    type: 'POST',
                    dataType: 'json',
                    data: model,
                    error: function (xhr, textStatus, error) {
                        amplify.publish("RelationshipFormStatus", { title: 'Error When Adding Relationships', message: xhr.statusText + xhr.responseText, success: false });
                        $('#EditableFormSaveButton').removeAttr('disabled');
                        $('#progress').html('');
                    },
                    success: function (data, statusText, xhr) {
                        AddRelationshipDestroy();
                        amplify.publish("RelationshipFormStatus", { title: 'Successfully Added Relationships', message: xhr.statusText + xhr.responseText, success: true });
                        amplify.publish("RelationshipSave", { action: 'Add', technical: (Source == 'Intersect'), targets: model.Targets });
                        $('#EditableFormSaveButton').removeAttr('disabled');
                        $('#progress').html('');
                    }
                });

            } catch (e) {
                amplify.publish("RelationshipFormStatus", { title: 'Validation Error', message: e, success: false });
                $('#EditableFormSaveButton').removeAttr('disabled');
                $('#progress').html('');
            }
        });

        $('#EditableFormCancelButton').on('click', function () {
            AddRelationshipDestroy();
            amplify.publish("RelationshipCancel");
        });

        //#endregion

    });
</script>
