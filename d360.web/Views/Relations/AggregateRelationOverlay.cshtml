@{
    var title = ViewData["Title"];
    var type = (d360.core.SystemObjects)ViewData["type"];
    var id = (int)ViewData["id"];
    var source = ViewData["source"];
    var targetType = (d360.core.SystemObjects)ViewData["targetType"];
    var targetID = (int)ViewData["targetID"];
    var criticalOnly = (bool)ViewData["criticalOnly"];
    var intersectTypeID = (int)ViewData["intersectTypeID"];
}
<div class="large-overlay">
    <div class="ui segment">
        <h4>@(title)</h4>
        <div class="form-instructions"></div>
        <div id="main-rel">
            <div class="row">
                <div class="col l12 m12 s12">
                    <div id="AggregateRelationsOverlayGrid"></div>
                </div>
            </div>
            <div class="row">
                <div class="col l12 m12 s12" style="padding-top:10px">&nbsp;</div>
            </div>
        </div>
        <div class="container-fluid" id="lineage" style="display:none;">
            <div style="background-color: #ebebeb;">
                <div class="pull-left" style="font-size: 1.2em; line-height: 1.2em; margin: 10px 0 0 10px" id="lineage_heading"></div>
                <div class="pull-right"><a class="detailclose btn waves-effect white-text blue">Close</a></div>
                <div class="clearfix"></div>
            </div>
            <div id="DiagramTile"></div>
        </div>
        <div class="container-fluid" id="attribute" style="display:none;">
            <div style="background-color: #ebebeb;">
                <div class="pull-left" style="font-size: 1.2em; line-height: 1.2em; margin: 10px 0 0 10px" id="attribute_heading"></div>
                <div class="pull-right"><a class="detailclose btn waves-effect white-text blue">Close</a></div>
                <div class="clearfix"></div>
            </div>
            <div id="RelationshipAttributesTile" class="tile"></div>
        </div>
        <div class="container-fluid" id="fusion" style="display:none;">
            <div style="background-color: #ebebeb;">
                <div class="pull-left" style="font-size: 1.2em; line-height: 1.2em; margin: 10px 0 0 10px" id="fusion_heading"></div>
                <div class="pull-right"><a class="detailclose btn waves-effect white-text blue">Close</a></div>
                <div class="clearfix"></div>
            </div>
            <div class="pull-left" style="width: 49%">
                <div class="tile" id="TechnicalRelationsGrid"></div>
            </div>
            <div class="pull-right" style="width: 49%">
                <div id="ChildRelationshipDetail" class="tile"></div>
                <div id="TechnicalRelationDetailWrapper" class="tile">
                    <header id="TechnicalRelationDetailHeader"></header>
                    <article id="TechnicalRelationDetail"></article>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var aggregateRelationshipCriticalOnly = "@criticalOnly.ToString()";
    var aggregateRelationshipOverlayType = "@type.ToString()";
    var aggregateRelationshipOverlayId = @id;
    var aggregateRelationshipOverlayTargetType = "@targetType.ToString()";
    var aggregateRelationshipOverlayTargetID = @targetID;
    var aggregateRelationshipIntersectTypeID = @intersectTypeID;
    var aggregateRelationshipSourceName = "@Html.Raw(source)";

    var aggregateRelationsModelType = function() {
        var self = this;

        self.TargetType = 'Intersect';
        self.TargetID = -1;
        self.TargetName = '';
    };
    var aggregateRelationsModel = new aggregateRelationsModelType();

    //#region Grid Loading Variables
    var aggregateRelationshipOverlaySource;
    var aggregateRelationshipOverlayAdapter;
    var technicalRelationsSource;
    var technicalRelationsAdapter;

    //#endregion

    //#region Event Handlers

    function aggregateRelationsOverlayGridBindingComplete(event) {
        if ($("#AggregateRelationsOverlayGrid").jqxGrid('getdisplayrows').length > 0) {

            try {
                // gets all rows loaded from the data source.
                var rows = $('#AggregateRelationsOverlayGrid').jqxGrid('getdisplayrows');
                var showParent = false;
                $.each(rows, function(){
                    if (this.TargetParentName > '') {
                        showParent = true;
                    }
                });
                if (!showParent) {
                    $('#AggregateRelationsOverlayGrid').jqxGrid('setcolumnproperty', 'TargetParentName', 'width', 250);
                    $('#AggregateRelationsOverlayGrid').jqxGrid('hidecolumn', 'TargetParentName');
                }
            } catch (e) {

            }

            $("#AggregateRelationsOverlayGrid").jqxGrid('selectrow', 0);
        }
    }

    function aggregateRelationsOverlayGridRowDoubleClick(event) {
        var row = $('#AggregateRelationsOverlayGrid').jqxGrid('getrowdata', event.args.rowindex);
        location.assign(row.TargetUrl);
    }

    function aggregateRelationsOverlayGridRowSelect(event) {
        var row = event.args.row;

        aggregateRelationsModel.TargetType = row.TargetType;
        aggregateRelationsModel.TargetID = (row.TargetType == 'TaxonomyType') ? row.TargetTypeID : row.IntersectID;
        aggregateRelationsModel.TargetName = row.TargetName;
    }

    function technicalRelationsGridBindingComplete(event) {
        if ($("#TechnicalRelationsGrid").jqxGrid('getdisplayrows').length > 0) {
            $("#TechnicalRelationsGrid").jqxGrid('selectrow', 0);
        }
    }

    function technicalRelationsGridRowSelect(event) {
        var row = event.args.row;
        $('#TechnicalRelationDetailWrapper').fadeIn(250);
        $('#TechnicalRelationDetailHeader').text(row.TargetTypeName + ' Information');
        $('#TechnicalRelationDetail').load('/parts/' + row.TargetObjectType + '/' + row.TargetObjectID + '/detail');
        ObjectDetail('ChildRelationshipDetail', 'Intersect', row.IntersectID);
    }

    function lineageShow(event) {
        $('#main-rel').hide();
        $('#lineage').show();
        $('#lineage_heading').text('Lineage for ' + aggregateRelationshipSourceName + ' / ' + aggregateRelationsModel.TargetName);
        LineageDiagram('DiagramTile', aggregateRelationsModel.TargetObjectType, aggregateRelationsModel.TargetObjectID, true);
    }

    function fusionShow(event) {
        $('#main-rel').hide();
        $('#fusion').show();
        $('#fusion_heading').text('Child Relationships for ' + aggregateRelationshipSourceName + ' / ' + aggregateRelationsModel.TargetName);
        var getselectedrowindexes = $('#AggregateRelationsOverlayGrid').jqxGrid('getselectedrowindexes');
        if(getselectedrowindexes.length > 0){
            var row = $('#AggregateRelationsOverlayGrid').jqxGrid('getrowdata', getselectedrowindexes[0]);
            $('#TechnicalRelationDetailWrapper').fadeOut(100);
            $('#TechnicalRelationDetail').html('');
            $('#TechnicalRelationsGrid').jqxGrid('clearselection');
            technicalRelationsSource.url = "/api/Intersect/" + row.IntersectID + "/relations";
            $('#TechnicalRelationsGrid').jqxGrid('updatebounddata');
        }
    }

    function attributeShow(event) {
        $('#main-rel').hide();
        $('#attribute').show();
        $('#attribute_heading').text('Attributes for ' + aggregateRelationshipSourceName + ' / ' + aggregateRelationsModel.TargetName);
        var getselectedrowindexes = $('#AggregateRelationsOverlayGrid').jqxGrid('getselectedrowindexes');
        if(getselectedrowindexes.length > 0){
            var row = $('#AggregateRelationsOverlayGrid').jqxGrid('getrowdata', getselectedrowindexes[0]);
            AttributesTile('RelationshipAttributesTile', contextList, null, "Intersect", row.IntersectID, 'Business Attributes', true);
        }
    }

    function closeDetailTab(event) {
        $(event.target).closest('div.container-fluid').hide();
        $('#main-rel').show();
    }

    function unsubscribe(data) {
        technicalRelationsAdapter = null;
        technicalRelationsSource = null;
        aggregateRelationshipOverlayAdapter = null;
        aggregateRelationshipOverlaySource = null;

        $("#AggregateRelationsOverlayGrid").off("bindingcomplete", aggregateRelationsOverlayGridBindingComplete);
        $('#AggregateRelationsOverlayGrid').off('rowdoubleclick', aggregateRelationsOverlayGridRowDoubleClick);
        $('#AggregateRelationsOverlayGrid').off('rowselect', aggregateRelationsOverlayGridRowSelect);
        $('#TechnicalRelationsGrid').off('rowselect', technicalRelationsGridRowSelect);
        $("#TechnicalRelationsGrid").off("bindingcomplete", technicalRelationsGridBindingComplete);

        $("#AggregateRelationsOverlayGrid").off("click", ".lineage", lineageShow);
        $("#AggregateRelationsOverlayGrid").off("click", ".fusion", fusionShow);
        $("#AggregateRelationsOverlayGrid").off("click", ".attribute", attributeShow);
        $("div.large-overlay").off("click", ".detailclose", closeDetailTab);

        amplify.unsubscribe(AmplifyActions.Unsubscribe, unsubscribe);
    }

    //#endregion

    function getDisplayFields() {
        return JSON.parse($.ajax({
            type: "GET",
            url: '/attributes/RelationshipAttributesFieldList?intersectTypeID=' + aggregateRelationshipIntersectTypeID,
            async: false
        }).responseText);
    }

    function getDynamicValues(){
        return JSON.parse($.ajax({ type:'GET',
            url: '/api/' + aggregateRelationshipOverlayType + '/' + aggregateRelationshipOverlayId + '/relationshipsAndAttributes/' + aggregateRelationshipOverlayTargetType + '/' + aggregateRelationshipOverlayTargetID + '/' + aggregateRelationshipCriticalOnly + '?$orderby=TargetName&intersectTypeID=' + aggregateRelationshipIntersectTypeID,
            async: false
        }).responseText);
    }

    $(function () {

        $("html, body").animate({ scrollTop: 0 }, "slow");

        //#region Main Grid

        $.getJSON('/api/IntersectType/' + aggregateRelationshipIntersectTypeID + '/grid/definition', function (gridinfo) {
            aggregateRelationshipOverlaySource = {
                datatype: 'json',
                url: '/api/' + aggregateRelationshipOverlayType + '/' + aggregateRelationshipOverlayId + '/relationships/' + aggregateRelationshipOverlayTargetType + '/' + aggregateRelationshipOverlayTargetID + '/' + aggregateRelationshipIntersectTypeID + '/' + aggregateRelationshipCriticalOnly,
                datafields: gridinfo.Fields
            };

            var addColumns = function(newColumns){
                var existing = $("#AggregateRelationsOverlayGrid").jqxGrid("columns");
                var end = existing.length;
                for(var i=0;i<newColumns.length;i++){
                    existing.splice(end,0, newColumns[i]);
                }
                return existing;
            }

            //add dynamic fields
            var fields = getDisplayFields();
            // i no likey  syncy
            var values = getDynamicValues();
            var gridColumns = [];

            var findDynamicValue = function(attributeID, TargetID){
                var val='';
                for(var i = 0 ; i < values.length;i++)
                {
                    if(values[i].TargetID==TargetID && values[i].AttributeTypeID==attributeID){
                        if(val.length) val+=', ';
                        val +=values[i].Value
                    }
                }
                return val;
            }

            var relationIconRowRender = function (type, id, uri, data) {
                return "<div class='RowMultiTools'>" + 
                    //(data.HasLineage ? "<i class='lineage fa fa-@Resources.Actions.Lineage_Icon' title='Lineage'></i> " : "") + 
                    (data.HasTechnicalRelationships ? "<i class='fusion fa fa-@Resources.Actions.Fusion_Icon' title='Child Relationships'></i> " :"") + 
                    (data.HasAttributes ? "<i class='attribute fa fa-@Resources.Actions.Attributes_Icon' title='Attributes'></i>" : "") + 
                    previewIconLink(type, id, uri) + 
                    " </div>";
            }

            var complexAttributeColumnRenderer = function(index, datafield, value, defaultvalue, column, data) {
                return "<div class='d3s-cell' style='overflow: hidden; text-overflow: ellipsis; padding-bottom: 2px; text-align: left; margin-right: 2px; margin-left: 4px; margin-top: 4px;'>" + (value ? "<div data-context='Preview' data-type='complexvalue' data-id='" + data.IntersectID + "/" + column.datafield + "' >Populated <i class='fusion fa fa-info-circle'></i></div>" : "") + "</div>";
            }

            var attributeColumnCellRenderer = function(index, datafield, value, defaultvalue, column, data) {
                return "<div class='d3s-cell' style='overflow: hidden; text-overflow: ellipsis; padding-bottom: 2px; text-align: left; margin-right: 2px; margin-left: 4px; margin-top: 4px;'>" + value + "</div>";
            }

            var multipleFieldColumnCellRenderer = function(index, datafield, value, defaultvalue, column, data) {
                return "<div class='d3s-cell' style='overflow: hidden; text-overflow: ellipsis; padding-bottom: 2px; text-align: left; margin-right: 2px; margin-left: 4px; margin-top: 4px;'>" + (value ?  "<div data-context='Preview' data-type='fieldvalues' data-id='" + data.IntersectID + "/" + column.datafield + "' >" + value + " <i class='fusion fa fa-info-circle'></i></div></div>" : "") + "</div>";
            }

            var headerTooltipRenderer = function(text) {
                return function (columnHeaderElement) {
                    if(text!=null && text.length>0)
                        $(columnHeaderElement).parent().jqxTooltip({ position: 'mouse', content: text });
                };
            };

            for(var i = 0 ; i < fields.length;i++){
                aggregateRelationshipOverlaySource.datafields.push({name:fields[i].attributeID});
                gridColumns.push({
                    text:fields[i].label,
                    datafield:fields[i].attributeID,
                    width:'250px',
                    filterable: !fields[i].isComplex,
                    cellsRenderer: fields[i].isComplex ? complexAttributeColumnRenderer : fields[i].fieldCount > 1 ? multipleFieldColumnCellRenderer : attributeColumnCellRenderer,
                    rendered: headerTooltipRenderer (fields[i].description)
                });
            }

            aggregateRelationshipOverlayAdapter = new $.jqx.dataAdapter(aggregateRelationshipOverlaySource, {
                beforeLoadComplete: function (records) {
                    var data = new Array();
                    for (var i = 0; i < records.length; i++) {
                        var row = records[i];
                        var bHasAttributes=false;
                        for(var j = 0 ; j < fields.length;j++){
                            var val=findDynamicValue(fields[j].attributeID,row.IntersectID);
                            bHasAttributes=(bHasAttributes || (val!=null&&val.length>0));
                            row[fields[j].attributeID]=val
                        }
                        row.Classification = row.Classification == @((int)d360.core.enums.IntersectClassification.Normal) ? "Normal" : "Critical";
                        row.HasAttributes = bHasAttributes;
                        row.HasLineage = true;
                        data.push(row);
                    }
                    return data;
                }
            });

            $('#AggregateRelationsOverlayGrid').on('mouseenter', '[data-gridtip]', function (event) {
                var tipText=$(event.currentTarget).attr('data-gridtip');
                $(this).qtip({ // Grab all elements with a non-blank data-tooltip attr.
                    content: {
                        text: tipText
                    },
                    position: {
                        at: 'left center',
                        my: 'right center',
                        viewport: $(window), // Keep the tooltip on-screen at all times
                        effect: false // Disable positioning animation
                    },
                    overwrite: false,
                    show: {
                        event: event.type,  // show using same event as above.
                        solo: false,         // Only show one tooltip at a time
                        ready: true
                    },
                    hide: {
                        fixed: true,
                        delay: 1000,
                    },
                    style: {
                        classes: 'qtip-blue qtip-rounded'
                    }
                });
            });

            try {
                var mainGridHeight = 500;

                //#region Static fields

                gridinfo.Columns.push({
                    datafield: "Role",
                    text: "Role",
                    width: '125px',
                    filtertype: 'checkedlist'
                });
                gridinfo.Columns.unshift({
                    datafield: "Classification",
                    text: "Classification",
                    width: '100px',
                    filtertype: 'checkedlist'
                });
                gridinfo.Columns.unshift({
                    datafield: "TargetParentName",
                    text: "Parent",
                    filtertype: 'checkedlist',
                    width: '200px',
                    cellsRenderer: function (index, datafield, value, defaultvalue, column, data) {
                        return "<div class='d3s-cell'>" + data.TargetParentName + "</div>";
                    }
                });
                gridinfo.Columns.unshift({
                    datafield: "TargetName",
                    text: "Name",
                    width: '350px',
                    pinned: true,
                    cellsRenderer: function (index, datafield, value, defaultvalue, column, data) {
                        return "<div class='d3s-cell' style='overflow: hidden; text-overflow: ellipsis; padding-bottom: 2px; text-align: left; margin-right: 2px; margin-left: 4px; margin-top: 4px;' " + (data.Description != null ? "data-gridtip='" + data.Description + "'" : "") +" >" + data.TargetName + "</div>";
                    }
                });
                gridinfo.Columns.unshift({
                    text: '',
                    groupable: false,
                    datafield: 'IntersectID',
                    width: '60px',
                    filterable: false,
                    pinned: true,
                    cellsRenderer: function (index, datafield, value, defaultvalue, column, data) {
                        return relationIconRowRender(data.TargetObjectType, data.TargetObjectID, data.TargetUrl,data);
                    }
                });

                //#endregion

                $('#AggregateRelationsOverlayGrid').jqxGrid({
                    altrows: true,
                    width: grid_width,
                    height: mainGridHeight,
                    showheader: true,
                    showfilterrow: true,
                    sortable: true,
                    columnsresize: true,
                    filterable: true,
                    pageable: false,
                    scrollmode: 'deferred',
                    deferreddatafields: ['TargetName'],
                    source: aggregateRelationshipOverlayAdapter,
                    theme: theme,
                    columns: gridinfo.Columns
                });

                $("#AggregateRelationsOverlayGrid").jqxGrid({ columns: addColumns(gridColumns) });
            } catch (e) {
            }
        });

        //#endregion

        //#region Technical Relations Grid

        technicalRelationsSource = {
            datatype: 'json',
            url: null,
            datafields: [
                { name: 'IntersectID' },
                { name: 'TargetName' },
                { name: 'TargetObjectID' },
                { name: 'TargetObjectType' },
                { name: 'TargetTypeID' },
                { name: 'TargetType' },
                { name: 'TargetTypeName' },
                { name: 'TargetUrl' }
            ]
        };

        technicalRelationsAdapter = new $.jqx.dataAdapter(technicalRelationsSource);

        try {
            $('#TechnicalRelationsGrid').jqxGrid({
                width: grid_width,
                autoheight: true,
                autorowheight: true,
                sortable: true,
                altrows: true,
                filterable: true,
                showfilterrow: true,
                pagesizeoptions: ['10', '20', '50'],
                pagesize: 20,
                pageable: true,
                autorowheight: true,
                columnsresize: true,
                source: technicalRelationsAdapter,
                theme: list_theme,
                groupable: false,
                groupsrenderer: function (text, group, expanded, data) {
                    var style = "background-color: " + data.subItems[0].IconBackColor + "; color: " + data.subItems[0].IconForeColor;
                    var html = "";
                    html += "<h2>";
                    html += group;
                    html += "</h2>";
                    return html;
                },
                groupsexpandedbydefault: false,
                columns: [
                    { text: 'Type', groupable: true, datafield: 'TargetTypeName', width: '100px' },
                    {
                        text: 'Name',
                        groupable: false,
                        datafield: 'TargetName',
                        cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                            return previewLinkRenderer(data.TargetObjectType, data.TargetObjectID, data.TargetUrl, data.TargetName);
                        }
                    }
                ]
            });
        } catch (e) {
        }

        //#endregion

        //#region Event Registration

        $("#AggregateRelationsOverlayGrid").on("bindingcomplete", aggregateRelationsOverlayGridBindingComplete);
        $('#AggregateRelationsOverlayGrid').on('rowdoubleclick', aggregateRelationsOverlayGridRowDoubleClick);
        $('#AggregateRelationsOverlayGrid').on('rowselect', aggregateRelationsOverlayGridRowSelect);
        $('#TechnicalRelationsGrid').on('rowselect', technicalRelationsGridRowSelect);
        $("#TechnicalRelationsGrid").on("bindingcomplete", technicalRelationsGridBindingComplete);

        //tool clicks
        $("#AggregateRelationsOverlayGrid").on("click", ".lineage", lineageShow);
        $("#AggregateRelationsOverlayGrid").on("click", ".fusion", fusionShow);
        $("#AggregateRelationsOverlayGrid").on("click", ".attribute", attributeShow);
        $("div.large-overlay").on("click", ".detailclose", closeDetailTab);

        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);

        //#endregion

    });
</script>