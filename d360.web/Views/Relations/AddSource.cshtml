<div class="small-overlay">
    <div class="ui segment">
        @Html.Partial("FormHeader", new d360.web.Models.FormHeaderEditorModel { Context = ContextList.SourceToTarget, Description = string.Format("Relationships will be created between the source and target below, and between {0} and the objects below,  if they do not yet exist.", ViewBag.ObjectName), Name = string.Format("Add Source for {0}", ViewBag.ObjectName) })

        <div class="row">
            <div class="col l4 m4 s6">
                <div class="FieldNameRequired">Source</div>
                <div id="SubjectDropdown"></div>
            </div>
            <div class="col l4 m4 s6">
                <div class="FieldNameRequired">Role</div>
                <div id="PredicateDropdown"></div>
            </div>
            <div class="col l4 m4 s6">
                <div class="FieldNameRequired">Target</div>
                <div id="ObjectDropdown"></div>
            </div>
        </div>
        @*<div class="FieldNameRequired">Source Or Target?</div>
        <div id="SourceOrTargetButton">
            <button style="padding:4px 16px;">Source</button>
            <button style="padding:4px 16px;">Target</button>
        </div>*@
        <div id="ResultWrapper" style="visibility: hidden">
            <div class="FieldName">Result</div>
            <div id="Result"></div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var objectName = "@(ViewBag.ObjectName)";
    var object = "@(ViewBag.Object)";
    var objectID = "@(ViewBag.ObjectID)";

    var FormValidationException = function (message) {
        this.message = message;
        this.toString = function () {
            return this.message;
        }
    };

    var AddSourceDestroy = function () {
        //$('#SubjectDropdown').jqxDropDownList('destroy');
        //$('#SourceOrTargetButton').jqxButtonGroup('destroy');
        //$('#PredicateDropdown').jqxDropDownList('destroy');
    }

    var createResultText = function () {
        //var index = $('#SourceOrTargetButton').jqxButtonGroup('getSelection');

        var stValue = $("#SubjectDropdown").jqxDropDownList('val');
        var otValue = $("#ObjectDropdown").jqxDropDownList('val');
        var prValue = $("#PredicateDropdown").jqxDropDownList('val');
        var resultHtml = "";

        if (stValue && otValue && prValue) {
            var st = $("#SubjectDropdown").jqxDropDownList('getItemByValue', stValue);
            var ot = $("#ObjectDropdown").jqxDropDownList('getItemByValue', otValue);
            var predicate = $("#PredicateDropdown").jqxDropDownList('getItemByValue', prValue);
            
            resultHtml = "<u>" + st.label + "</u> " + predicate.label + " " + "<u>" + ot.label + "</u>";
            //switch (index) {
            //    case 0:
            //        resultHtml = "<u>" + st.label + "</u> " + predicate.label + " " + "<u>" + objectName + "</u>";

            //        break;
            //    default:
            //        resultHtml = "<u>" + objectName + "</u> " + predicate.label + " " + "<u>" + st.label + "</u>";
            //        break;
            //}
        }

        $('#Result').html(resultHtml);
        $('#ResultWrapper').css("visibility", (resultHtml != "") ? "visible" : "hidden");
    }

    $(function () {

        //#region Subject

        var SubjectSource = {
            datafields: [
                //{ name: 'IntersectID' },
                //{ name: 'TargetObjectType' },
                //{ name: 'TargetObjectID' },
                //{ name: 'TargetName' }
                { name: 'Object' },
                { name: 'ObjectID' },
                { name: 'Name' }
            ],
            datatype: "json",
            url: '/api/allitems'
            //url: '/api/' + object + '/' + objectID + '/relations'
        };

        var SubjectAdapter = new $.jqx.dataAdapter(
            SubjectSource,
            {
                beforeLoadComplete: function (records) {
                    for (var i = 0; i < records.length; i++) {
                        var record = records[i];
                        record.Value = record.Object + '|' + record.ObjectID;
                        //record.Value = record.IntersectID + '|' + record.TargetObjectType + '|' + record.TargetObjectID;
                    }
                    return records;
                }
            }
        );

        $("#SubjectDropdown").jqxDropDownList({
            theme: theme,
            source: SubjectAdapter,
            width: field_width,
            height: field_height,
            valueMember: 'Value',
            displayMember: 'Name',
            filterable: true,
            dropDownWidth: 400,
            searchMode: 'containsignorecase'
        });

        //#endregion

        //#region SourceTargetButton

        //$('#SourceOrTargetButton').jqxButtonGroup({ theme: theme, mode: 'radio', enableHover: true });
        //$('#SourceOrTargetButton').jqxButtonGroup('setSelection', 0);

        //#endregion

        //#region Predicates

        var PredicatesSource = {
            datafields: [
                { name: 'value' },
                { name: 'group' },
                { name: 'text' }
            ],
            datatype: "json",
            url: '/relations/sources/predicates'
        };

        var PredicatesAdapter = new $.jqx.dataAdapter(PredicatesSource);

        $("#PredicateDropdown").jqxDropDownList({ theme: theme, source: PredicatesAdapter, width: field_width, height: field_height, valueMember: 'value', displayMember: 'text' });

        //#endregion

        //#region Object

        var ObjectSource = {
            datafields: [
                //{ name: 'IntersectID' },
                //{ name: 'TargetObjectType' },
                //{ name: 'TargetObjectID' },
                //{ name: 'TargetName' }
                { name: 'Object' },
                { name: 'ObjectID' },
                { name: 'Name' }
            ],
            datatype: "json",
            url: '/api/allitems'
            //url: '/api/' + object + '/' + objectID + '/relations'
        };

        var ObjectAdapter = new $.jqx.dataAdapter(
            ObjectSource,
            {
                beforeLoadComplete: function (records) {
                    for (var i = 0; i < records.length; i++) {
                        var record = records[i];
                        record.Value = record.Object + '|' + record.ObjectID;
                    }
                    return records;
                }
            }
        );

        $("#ObjectDropdown").jqxDropDownList({
            theme: theme,
            source: ObjectAdapter,
            width: field_width,
            height: field_height,
            valueMember: 'Value',
            displayMember: 'Name',
            filterable: true,
            dropDownWidth: 400,
            searchMode: 'containsignorecase'
        });

        //#endregion

        //#region Form Events

        $('#EditableFormSaveButton').on('click', function () {

            $('#EditableFormSaveButton').attr('disabled', 'disabled');
            $('#progress').html('<i class="fa fa-spinner fa-spin fa-4x"></i>');

            try {

                var model = {
                    Target: object,
                    TargetID: objectID,
                    Subject: "",
                    SubjectID: 0,
                    Object: '',
                    ObjectID: 0,
                    PredicatePhraseID: 0,
                    IntersectID: 0
                }

                //var index = $('#SourceOrTargetButton').jqxButtonGroup('getSelection');
                var stValue = $("#SubjectDropdown").jqxDropDownList('val');
                var otValue = $("#ObjectDropdown").jqxDropDownList('val');
                var prValue = $("#PredicateDropdown").jqxDropDownList('val');

                if (stValue && otValue && prValue) {
                    var st = $("#SubjectDropdown").jqxDropDownList('getItemByValue', stValue);
                    var ot = $("#ObjectDropdown").jqxDropDownList('getItemByValue', otValue);
                    var predicate = $("#PredicateDropdown").jqxDropDownList('getItemByValue', prValue);


                    var stArray = st.value.split('|');
                    //var IntersectID = stArray[0];
                    var _subject = stArray[0];//[1];
                    var _subjectID = stArray[1];//[2];

                    var otArray = ot.value.split('|');
                    var _object = otArray[0];//[1];
                    var _objectID = otArray[1];//[2];

                    model.Subject = _subject;
                    model.SubjectID = _subjectID;
                    model.Object = _object;
                    model.ObjectID = _objectID;

                    //switch (index) {
                    //    case 0: // Source
                    //        model.Subject = TargetObjectType;
                    //        model.SubjectID = TargetObjectID;

                    //        model.Object = object;
                    //        model.ObjectID = objectID;
                    //        break;
                    //    default: // Target
                    //        model.Subject = object;
                    //        model.SubjectID = objectID;

                    //        model.Object = TargetObjectType;
                    //        model.ObjectID = TargetObjectID;
                    //        break;
                    //}
                    //model.IntersectID = IntersectID;
                    model.PredicatePhraseID = predicate.value;

                    $.ajax('/relations/sources', {
                        type: 'POST',
                        dataType: 'json',
                        data: model,
                        error: function (xhr, textStatus, error) {
                            amplify.publish("SourceFormStatus", { title: 'Error When Adding Source', message: xhr.statusText + xhr.responseText, success: false });
                        },
                        success: function (data, statusText, xhr) {
                            amplify.publish("SourceFormStatus", {
                                title: ((data.success) ? 'Successfully Added Source' : 'Error When Adding Source'),
                                message: data.message,
                                success: data.success
                            });
                            if (data.success) {
                                amplify.publish("SourceSave");
                                AddSourceDestroy();
                            }
                        }
                    }).always(function () {
                        $('#EditableFormSaveButton').removeAttr('disabled');
                        $('#progress').html('');
                    });
                }
                else {
                    amplify.publish("RelationshipFormStatus", { title: 'Error When Adding Source', message: "You have not filled out the form completely.", success: false });
                    $('#progress').html('');
                }
            } catch (e) {
                amplify.publish("SourceFormStatus", { title: 'Validation Error', message: e, success: false });
                $('#EditableFormSaveButton').removeAttr('disabled');
                $('#progress').html('');
            }
        });

        $('#EditableFormCancelButton').on('click', function () {
            AddSourceDestroy();
            amplify.publish("SourceCancel");
        });

        $('#SubjectDropdown').on('change', function (event) {
            createResultText();
        });

        $('#SubjectDropdown').one('bindingComplete', function (event) {
            var item = $("#SubjectDropdown").jqxDropDownList('getItemByValue', object + '|' + objectID);
            if (item) {
                $("#SubjectDropdown").jqxDropDownList('selectItem', item);
            }
        });

        $('#PredicateDropdown').on('change', function () {
            createResultText();
        });

        $('#ObjectDropdown').on('change', function (event) {
            createResultText();
        });

        $('#ObjectDropdown').one('bindingComplete', function (event) {
            var item = $("#ObjectDropdown").jqxDropDownList('getItemByValue', object + '|' + objectID);
            if (item) {
                $("#ObjectDropdown").jqxDropDownList('selectItem', item);
            }
        });

        //$('#SourceOrTargetButton').on('buttonclick', function () {
        //    createResultText();
        //});

        //#endregion

    });
</script>
