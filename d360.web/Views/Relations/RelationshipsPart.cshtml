@model List<d360.core.entities.GetRelationshipModel>
@{
    var CanCreateRelationships = (bool)ViewData["CanCreateRelationships"];
    var Type = ViewData["Type"].ToString();
    var ID = ViewData["ID"];
}
<div id="RelationshipsNavigationBar">
    @{
        var indexNumber = 0;
        var indexes = "";
        var groups = Model
            .Select(i => new { i.GroupKey, i.IconBackColor, i.IconForeColor, i.IconText, i.TypeName })
            .Distinct()
            .OrderBy(i => i.TypeName)
            .ToList();
        foreach (var g in groups)
        {
            indexes += (string.IsNullOrEmpty(indexes) ? "" : ", ") + indexNumber;
            <text>
                <div>
                    <div style="display: inline-block; vertical-align: middle; text-align: center; font-size: 9px; font-weight: 700; line-height: 30px; height: 30px; width: 30px; border-radius: 7px; background-color: @(g.IconBackColor); color: @(g.IconForeColor)">@g.IconText</div>
                    <span style="vertical-align: bottom; font-weight: 600; font-size: 15px; line-height: 30px;">@g.TypeName</span>
                </div>
                <div>
                    <table id="@g.GroupKey">
                        <thead>
                            <tr>
                                <th align="left">Name</th>
                                <th align="right"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Where(i => i.GroupKey == g.GroupKey).OrderBy(i => i.ObjectName))
                            {
                                <tr>
                                    <td>@r.ObjectName</td>
                                    <td>
                                        @if (r.IntersectID.HasValue)
                                        {
                                            <a data-type='Intersect' data-context='Preview' data-id='@r.IntersectID' href='@r.Url'><i class='fa fa-lg fa-info-circle'></i></a>
                                            if (CanCreateRelationships)
                                            {
                                                <a onclick='ClickGridTool(event)' data-context='@(ContextList.ActionEditRelate)' data-uri='/Relations/EditRelationship?source=@Type&sourceID=@ID&intersectID=@r.IntersectID'><i class='fa fa-lg fa-pencil'></i></a>
                                                <a onclick='ClickGridTool(event)' data-context='@(ContextList.ActionUnrelate)' data-id='@r.IntersectID' data-uri='/api/@Type/@ID/relationships/@r.IntersectID'><i class='fa fa-lg fa-trash-o'></i></a>
                                            }
                                        }
                                        else
                                        {
                                            <a data-type='@r.ObjectType' data-context='Preview' data-id='@r.ObjectID' href='@r.Url'><i class='fa fa-lg fa-info-circle'></i></a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </text>
            indexNumber++;
        }
    }
</div>
<script type="text/javascript">
    $(function () {
        $('#RelationshipsNavigationBar').jqxNavigationBar({ theme: 'bootstrap', width: '100%', expandMode: 'multiple', expandedIndexes: [@(indexes)] });

@{
    foreach (var g in groups)
    {
        <text>
        $('#@(g.GroupKey)').jqxDataTable({
            theme: list_theme,
            width: grid_width,
            altrows: false,
            sortable: true,
            selectionMode: 'singleRow',
            columns: [
                  { text: 'Name', dataField: 'Name' },
                  {
                      text: '',
                      dataField: '',
                      width: 90//,
                      //cellsRenderer: function (row, column, value, rowData) {
                      //    var html = "<div style='margin: 5px; margin-bottom: 3px;'>";
                      //    var html = rowData.IntersectID;
                      //    html += "</div>";
                      //    return html;
                      //}
                  }
            ]
        });
        </text>
    }
}
        });
</script>