@model d360.core.entities.ObjectDetail

<div id='TreeGridItemViewer' class="large-overlay">
    <div class="ui segment">

        <div class="form-header-info" style="width:98%">
            <h4>Relationships for @Model.Name</h4>
            <p>All relationships for the @Model.Name @Model.TypeName.ToLower() are displayed below.  To add a new relationship please select a type of relationship in the menu below.</p>
        </div>
        <div id="RelationshipOverlayMenu"></div>
        <div id="ViewNonLineage" style="margin-top:20px">
            <div id="TreeGrid"></div>
        </div>
        <div id="ViewSelectionDetail" style="display:none">
            <div class="container-fluid" id="Lineage" style="display:none;">
                <div class="row" style="margin-top: 20px">
                    <div class="col l11 m11">
                        <ol class="breadcrumb" style="padding:0;">
                            <li class="breadcrumb-name"></li>
                            <li class="active">Lineage</li>
                        </ol>
                    </div>
                    <div class="col l1 m1"><a class="detailclose btn waves-effect white-text blue">Close</a></div>
                </div>
                <div id="DiagramTile"></div>
            </div>
            <div class="container-fluid" id="Attributes" style="display:none;">
                <div class="row" style="margin-top: 20px">
                    <div class="col l11 m11">
                        <ol class="breadcrumb" style="padding:0;">
                            <li class="breadcrumb-name"></li>
                            <li class="active">Business Attributes</li>
                        </ol>
                    </div>
                    <div class="col l1 m1"><a class="detailclose btn waves-effect white-text blue">Close</a></div>
                </div>
                <div id="RelationshipAttributesTile" class="tile"></div>
            </div>
            <div class="container-fluid" id="Fusion" style="display:none;">
                <div class="row" style="margin-top: 20px">
                    <div class="col l11 m11">
                        <ol class="breadcrumb" style="padding:0;">
                            <li class="breadcrumb-name"></li>
                            <li class="active">Relationships</li>
                        </ol>
                    </div>
                    <div class="col l1 m1"><a class="detailclose btn waves-effect white-text blue">Close</a></div>
                </div>
                <div class="pull-left" style="width: 49%">
                    <div class="tile">
                        <article id="TechnicalRelationsGrid"></article>
                    </div>
                </div>
                <div class="pull-right" style="width: 49%">
                    <div class="pull-left" style="width: 38%">
                        <div id="TechnicalRelationActionWrapper" class="tile">
                            <header id="TechnicalRelationActionHeader">Actions</header>
                            <div class="tile-detail" id="TechnicalRelationAction"></div>
                        </div>
                    </div>
                    <div class="pull-right" style="width: 60%">
                        <div id="TechnicalRelationIntersectDetailWrapper" class="tile" style="display:none;">
                            <header id="TechnicalRelationIntersectDetailHeader"></header>
                            <article id="TechnicalRelationIntersectDetail"></article>
                        </div>
                    </div>
                    <div class="clearfix"></div>

                    <div id="TechnicalRelationDetailWrapper" class="tile" style="display:none;">
                        <header id="TechnicalRelationDetailHeader"></header>
                        <article id="TechnicalRelationDetail"></article>
                    </div>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
        <div id="ViewLineage" class="tile" style="display:none; margin-top:20px">
            <div id="TreeGridLineage"></div>
        </div>
    </div>
</div>
<div id="TreeGridRelationshipEditor"></div>

<script type="text/javascript">
    var type = "@(Model.ParentType)";
    var typeID = "@(Model.ID)";
    var intersectID = 0;
    var selectedView = 'Fusion';

    var RelationshipsSource;
    var RelationshipsAdapter;
    var technicalRelationsSource;
    var technicalRelationsAdapter;

    //#region Amplify Methods

    //function cancelAction(data) {
    //    try {
    //        switch (data.context) {
    //            case contextList.SourceToTarget:
    //                switchToViewer();
    //                break;
    //        }
    //    } catch (e) {
    //        logError("RelationOverlay : CancelAction", e);
    //    }
    //}

    function commandExecuted(data) {
        try {
            switch (data.context) {
                case contextList.ActionUnrelate:
                    $('#TreeGridAttributesDetail').html('');
                    $('#TreeGrid').one('bindingcomplete', function (event) {
                        var rows = $("#TreeGrid").jqxGrid('getrows');
                        if (rows.length > 0) {
                            $("#TreeGrid").jqxGrid('selectrow', 0);
                        }
                    });
                    $("#TreeGrid").jqxGrid('updatebounddata');
                    amplify.publish('SaveAction', { context: "intersectform" });
                    break;
                case "deletetechnicalrelation":
                    $("#TechnicalRelationsGrid").jqxGrid('updatebounddata');
                    amplify.publish('SaveAction', { context: "intersectform" });
                    break;
            }
        } catch (e) {
            logError("RelationOverlay : CommandExecuted", e);
        }
    }

    function localAction(data) {
        try {
            switch (data.context) {
                case contextList.ActionLink:
                    location.assign(data.uri);
                    break;
                case "edittechnicalrelation":
                case contextList.ActionEditRelate:
                case contextList.ActionRelate:
                    switchToEditor(data.uri);
                    break;
            }
        } catch (e) {
            logError("RelationOverlay : LocalAction", e);
        }
    };

    function relationshipCancel(data) {
        try {
            switchToViewer();
        } catch (e) {
            logError("RelationOverlay : RelationshipCancel", e);
        }
    }

    function relationshipFormStatus(data) {
        try {
            amplify.publish("ShowMessage", { type: (data.success ? 'confirm' : 'error'), title: data.title || 'Modifying Relationships', message: data.message });
        } catch (e) {
            logError("RelationOverlay : RelationshipFormStatus", e);
        }
    }

    function relationshipSave(data) {
        try {
            switchToViewer();
            if (data.action == 'Add') {
                if (data.technical) {
                    $("#TechnicalRelationsGrid").jqxGrid('updatebounddata');
                }
                else {
                    $('#TreeGrid').one('bindingcomplete', function (event) {
                        var selectActiveRow = false;

                        if (data.targets.length > 0) {
                            selectActiveRow = true;
                        }

                        if (selectActiveRow) {
                            try {
                                var boundRows = $("#TreeGrid").jqxGrid('getboundrows', data.id);
                                var index = -1;

                                $.each(boundRows, function () {
                                    if (this.TargetObjectType == data.targets[0].ObjectType && this.TargetObjectID == data.targets[0].ObjectID) {
                                        index = $('#TreeGrid').jqxGrid('getrowboundindexbyid', this.uid);
                                    }
                                });

                                if (index >= 0) {
                                    $("#TreeGrid").jqxGrid('selectrow', index);
                                }
                            } catch (e) { }
                        }
                        else {
                            var rows = $("#TreeGrid").jqxGrid('getrows');
                            if (rows.length > 0) {
                                $("#TreeGrid").jqxGrid('selectrow', 0);
                            }
                        }
                    });
                    $("#TreeGrid").jqxGrid('updatebounddata');

                    technicalRelationsSource.url = null;
                    $("#TechnicalRelationsGrid").jqxGrid('updatebounddata');
                    $('#TreeGridAttributesDetail').html('');
                }
            }
            amplify.publish('SaveAction', { context: "intersectform" });
        } catch (e) {
            logError("RelationOverlay : RelationshipSave", e);
        }
    }

    function sourceCancel(data) {
        try {
            switchToViewer();
        } catch (e) {
            logError("RelationOverlay : SourceCancel", e);
        }
    }

    function sourceFormStatus(data) {
        try {
            amplify.publish("ShowMessage", { type: (data.success ? 'confirm' : 'error'), title: data.title || 'Modifying Source', message: data.message || "Modified source." });
        } catch (e) {
            logError("RelationOverlay : SourceFormStatus", e);
        }
    }

    function sourceSave(data) {
        try {
            switchToViewer();
            $('#RelationshipLineageTile').show();
            $('#ViewNonLineage').hide();
            LineageDiagram('TreeGridLineage', type, typeID, null, false);
            amplify.publish('SaveAction', { context: contextList.SourceToTarget });
        } catch (e) {
            logError("RelationOverlay : SourceSave", e);
        }
    }

    //function saveAction(data) {
    //    try {
    //        switch (data.context) {
    //            case contextList.SourceToTarget:
    //                switchToViewer();
    //                break;
    //        }
    //    } catch (e) {
    //        logError("RelationOverlay : SaveAction", e);
    //    }
    //}

    //#endregion

    //#region Control Event Methods

    function treeGridRowDoubleClick(event) {
        var row = $('#TreeGrid').jqxGrid('getrowdata', event.args.rowindex);
        location.assign(row.TargetUrl);
    }

    function treeGridRowSelect(event) {
        //var row = event.args.row;
        //try {
        //    intersectID = row.IntersectID;
        //    switch (selectedView) {
        //        case 'Attributes':
        //            AttributesTile('RelationshipAttributesTile', contextList, null, "Intersect", intersectID, 'Business Attributes');
        //            break;
        //        case 'Fusion':
        //            technicalRelationsSource.url = '/api/Intersect/' + intersectID + '/relations';
        //            $('#TechnicalRelationsGrid').jqxGrid('updatebounddata');
        //            break;
        //        case 'Lineage': // Refresh lineage
        //            LineageDiagram('TreeGridLineage', type, typeID, null, false);
        //            break;
        //    }

        //    //relationsModel.TargetType = row.TargetType;
        //    //relationsModel.TargetID = (row.TargetType == 'TaxonomyType') ? row.TargetTypeID : row.IntersectID;
        //}
        //catch (e) {
        //    logError("RelationOverlay : TreeGrid.rowSelect", e);
        //    console.log('IDs no longer exist.');
        //}
    }

    function technicalRelationsGridBindingComplete(event) {
        if ($("#TechnicalRelationsGrid").jqxGrid('getdisplayrows').length > 0) {
            $('#TechnicalRelationDetailWrapper').fadeIn(100);
            $('#TechnicalRelationIntersectDetailWrapper').fadeIn(100);
            $("#TechnicalRelationsGrid").jqxGrid('selectrow', 0);
        }
        else {
            $('#TechnicalRelationDetailWrapper').fadeOut(100);
            $('#TechnicalRelationIntersectDetailWrapper').fadeOut(100);
        }
    }

    function technicalRelationsGridRowSelect(event) {
        var row = event.args.row;
        $('#TechnicalRelationDetailHeader').text(row.TargetTypeName + ' Information');
        $('#TechnicalRelationDetail').load('/parts/' + row.TargetObjectType + '/' + row.TargetObjectID + '/detail');

        $('#TechnicalRelationIntersectDetailHeader').text('Relationship Information');
        $('#TechnicalRelationIntersectDetail').load('/parts/Intersect/' + row.IntersectID + '/detail');
    }

    function unsubscribe(data) {
        technicalRelationsAdapter = null;
        technicalRelationsSource = null;
        RelationshipsAdapter = null;
        RelationshipsSource = null;

        amplify.unsubscribe('RelationshipFormStatus', relationshipFormStatus);
        amplify.unsubscribe('RelationshipCancel', relationshipCancel);
        amplify.unsubscribe('RelationshipSave', relationshipSave);

        amplify.unsubscribe("SourceFormStatus", sourceFormStatus);
        amplify.unsubscribe("SourceCancel", sourceCancel);
        amplify.unsubscribe("SourceSave", sourceSave);

        //amplify.unsubscribe('CancelAction', cancelAction);
        //amplify.unsubscribe('SaveAction', saveAction);
        amplify.unsubscribe('CommandExecuted', commandExecuted);
        amplify.unsubscribe(AmplifyActions.Local, localAction);

        $('#TreeGrid').off('rowselect', treeGridRowSelect);
        $('#TreeGrid').off('rowdoubleclick', treeGridRowDoubleClick);

        $('#TechnicalRelationsGrid').off('rowselect', technicalRelationsGridRowSelect);
        $("#TechnicalRelationsGrid").off("bindingcomplete", technicalRelationsGridBindingComplete);

        $("#TreeGrid").off("click", ".lineage", activateIconTool);
        $("#TreeGrid").off("click", ".fusion", activateIconTool);
        $("#TreeGrid").off("click", ".attribute", activateIconTool);
        $("div.large-overlay").off("click", ".detailclose", closeDetailTab);

        amplify.unsubscribe(AmplifyActions.Unsubscribe, unsubscribe);
    }

    //#endregion

    //#region Utility Methods

    function closeDetailTab(event) {
        $(event.target).closest('div.container-fluid').hide();
        $('#ViewSelectionDetail').hide();
        $('#ViewNonLineage').show();
    }

    var loadRelationshipOverlayMenu = function () {
        try {
            var relationUri = '/relations/OptionsToRelate';

            $.getJSON(relationUri, function (data) {

                var addMenuItem = { html: '<span>Add Relationships</span>', items: data };
                var items = [
                    addMenuItem,
                    { html: '<span data-a="Source">Add Source</span>' },
                    {
                        html: '<span>Views</span>', items: [
                            { html: '<span data-a="Relationships">All Relationships</span>' },
                            { html: '<span data-a="Lineage">Full Lineage</span>' }
                        ]
                    }
                    //{
                    //    html: '<span>Reports</span>', items: [
                    //        { html: 'Sample Report' }
                    //    ]
                    //}
                ];

                $('#RelationshipOverlayMenu').jqxMenu({
                    source: items,//data,
                    theme: theme,
                    width: '100%',
                    animationHideDelay: 1000
                });

                $('#RelationshipOverlayMenu').on('itemclick', function (event) {
                    var li = $(event.args);
                    var span = $(li.find('span'));
                    selectedView = span.data('a');

                    if (selectedView) {
                        var url = '';

                        switch (selectedView) {
                            case 'Intersect':
                                url = '/Relations/AddRelationship?source=' + type + '&sourceID=' + typeID + '&target=' + span.data('t') + '&targetID=' + span.data('i');
                                break;
                            case 'Source':
                                url = '/relations/sources/' + type + '/' + typeID + '/add';
                                break;
                        }

                        if (url != '') {
                            selectedView = 'Fusion'; //Reset to default
                            $('#TreeGridItemViewer').fadeOut(10);
                            $('#TreeGridRelationshipEditor').fadeIn(10);
                            $('#TreeGridRelationshipEditor').load(url);
                        }
                        else {
                            $('#ViewSelectionDetail').hide();

                            switch (selectedView) {
                                case 'Relationships':
                                    $('#ViewNonLineage').show();
                                    $('#ViewLineage').hide();
                                    break;
                                case 'Lineage':
                                    $('#ViewLineage').show();
                                    $('#ViewNonLineage').hide();
                                    LineageDiagram('TreeGridLineage', type, typeID, null, false);
                                    break;
                            }
                        }
                    }
                });
            });
        } catch (e) {
            logError("RelationOverlay : loadRelationshipOverlayMenu", e);
        }
    }

    var switchToViewer = function () {
        $('#TreeGridRelationshipEditor').html('');
        $('#TreeGridRelationshipEditor').fadeOut(1);
        $('#TreeGridItemViewer').fadeIn(500);
    }

    var switchToEditor = function (uri) {
        try {
            $('#TreeGridItemViewer').fadeOut(10);
            $('#TreeGridRelationshipEditor').fadeIn(10);
            $('#TreeGridRelationshipEditor').load(uri, function (response, status, xhr) {
                if (status == "error") {
                    amplify.publish("ShowMessage", { title: "Something unexpected happened!", message: xhr.status + ' ' + xhr.statusText, type: 'error' });
                    switchToViewer();
                }
            });
        } catch (e) {

        }
    }

    function setBreadCrumb(parent, row) {
        $(parent).find('.breadcrumb-name').html(row.TargetName);
    }

    var activateIconTool = function (tool) {
        var $icon = $(this);

        $('#ViewNonLineage').hide();
        $('#ViewSelectionDetail').show();

        var getselectedrowindexes = $('#TreeGrid').jqxGrid('getselectedrowindexes');

        if (getselectedrowindexes.length > 0) {
            var row = $('#TreeGrid').jqxGrid('getrowdata', getselectedrowindexes[0]);
            if ($icon.hasClass('attribute')) {
                $('#Attributes').show();
                setBreadCrumb('#Attributes', row);
                AttributesTile('RelationshipAttributesTile', contextList, null, "Intersect", row.IntersectID, 'Business Attributes');
            }
            else if ($icon.hasClass('fusion')) {
                $('#Fusion').show();
                setBreadCrumb('#Fusion', row);
                $('#TechnicalRelationsGrid').jqxGrid('clearselection');
                technicalRelationsSource.url = "/api/Intersect/" + row.IntersectID + "/relations";
                $('#TechnicalRelationsGrid').jqxGrid('updatebounddata');

                $.getJSON('/relations/PossibleRelationshipsByIntersect?id=' + row.IntersectID, function (itemsData) {
                    var html = "<ul>";
                    $.each(itemsData, function () {
                        //Context, Icon, Title, Type, Uri
                        html += "<li><button style='border:none; background-color:transparent; margin-left: 5px; padding-left: 5px' title='" + this.Title + "' data-context='" + this.Context + "' data-" + this.Type + " data-uri='" + this.Uri + "'><i class='fa fa-" + this.Icon + "'></i>" + this.Title + "</button></li>"
                    });
                    html += "</ul>";
                    $('#TechnicalRelationAction').html(html);
                });
            }
            else if ($icon.hasClass('lineage')) {
                $('#Lineage').show();
                setBreadCrumb('#Lineage', row);
                LineageDiagram('DiagramTile', 'Intersect', row.IntersectID, null);
            }
        }
    }

    //#endregion

    $(function () {

        $("html, body").animate({ scrollTop: 0 }, "slow");

        loadRelationshipOverlayMenu();

        var iconAttributes = '@Resources.Actions.Attributes_Icon';
        var iconFusion = '@Resources.Actions.Fusion_Icon';
        var iconLineage = '@Resources.Actions.Lineage_Icon';

        //#region Relations Tree Grid

        RelationshipsSource = {
            datatype: 'json',
            url: '/api/' + type + '/' + typeID + '/relations',
            datafields: [
                { name: 'IntersectID' },
                { name: 'Description' },
                { name: 'Role' },
                { name: 'TargetName' },
                { name: 'TargetObjectID' },
                { name: 'TargetObjectType' },
                { name: 'TargetTypeID' },
                { name: 'TargetType' },
                { name: 'TargetTypeName' },
                { name: 'Classification' },
                { name: 'TargetUrl' },
                { name: 'HasTechnicalRelationships' }
            ]
        };
        RelationshipsAdapter = new $.jqx.dataAdapter(RelationshipsSource, {
            beforeLoadComplete: function (records) {
                $.each(records, function () {
                    this.Classification = (this.Classification === 1 ? 'Critical' : 'Normal');
                });
                records[0]['firstname'] = "Michael";
                return records;
            }
        });

        $("#TreeGrid").jqxGrid({
            groupable: false,
            autoheight: true,
            autorowheight: true,
            altrows: true,
            showfilterrow: true,
            source: RelationshipsAdapter,
            theme: theme,
            selectionmode: 'singlerow',
            width: grid_width,
            filterable: true,
            sortable: true,
            pageable: true,
            columns: [
                { text: 'Type', datafield: 'TargetTypeName', width: '150px', filtertype: 'checkedlist' }, //, hidden: true
                { text: 'Name', width: '250px', datafield: 'TargetName' },
                { text: 'Criticality', width: '125px', datafield: 'Classification', filtertype: 'checkedlist' },
                { text: 'Description', datafield: 'Description' },
                //{ text: 'Role', datafield: 'Role', width: '100px', filtertype: 'checkedlist' },
                {
                    text: '',
                    groupable: false,
                    datafield: 'IntersectID',
                    width: '100px',
                    filterable: false,
                    sortable: false,
                    cellsRenderer: function (index, datafield, value, defaultvalue, column, data) {
                        if (data.IntersectID) {
                            var html = "";

                            html += "<div class='RowMultiTools'>";
                            //html += (data.HasLineage ? "<i class='lineage fa fa-" + iconLineage + "' title='Lineage'></i> " : "");
                            html += "<i class='fusion fa fa-" + iconFusion + "' title='Fusion'></i> ";
                            html += "<i class='attribute fa fa-" + iconAttributes + "' title='Attributes'></i>";
                            html += "<a title='Edit relationship' data-context='editrelation' data-local data-uri='/relations/EditRelationship?id=" + data.IntersectID + "'><i class='fa fa-pencil'></i></a>";
                            html += "<a title='Remove relationship' data-context='deleterelation' data-command data-method='DELETE' data-uri='/api/relationships/" + data.IntersectID + "'><i class='fa fa-trash-o'></i></a>";
                            html += "</div>";

                            return html;
                        }
                        else {
                            return previewIconRenderer(data.TargetObjectType, data.TargetObjectID, data.TargetUrl);
                        }
                    }
                }
            ]
        });

        //#endregion

        //#region Technical Relationship Grid Configuration

        technicalRelationsSource = {
            datatype: 'json',
            url: null,
            datafields: [
                { name: 'IntersectID' },
                { name: 'Description' },
                { name: 'TargetName' },
                { name: 'TargetObjectID' },
                { name: 'TargetObjectType' },
                { name: 'TargetTypeID' },
                { name: 'TargetType' },
                { name: 'TargetTypeName' },
                { name: 'Classification' },
                { name: 'TargetUrl' }
            ]
        };

        technicalRelationsAdapter = new $.jqx.dataAdapter(technicalRelationsSource);

        $("#TechnicalRelationsGrid").jqxGrid({
            width: grid_width,
            autoheight: true,
            sortable: true,
            altrows: true,
            filterable: true,
            showfilterrow: true,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            pageable: true,
            autorowheight: true,
            columnsresize: true,
            source: technicalRelationsAdapter,
            theme: list_theme,
            groupable: false,
            columns: [
                { text: 'Type', groupable: true, datafield: 'TargetTypeName' },
                { text: 'Name', groupable: false, datafield: 'TargetName' },
                {
                    text: '',
                    groupable: false,
                    datafield: 'IntersectID',
                    width: '60px',
                    filterable: false,
                    cellsRenderer: function (index, datafield, value, defaultvalue, column, data) {
                        var html = "";

                        html += "<div class='RowMultiTools'>";
                        html += "<a title='Edit relationship' data-context='edittechnicalrelation' data-local data-uri='/relations/EditRelationship?id=" + data.IntersectID + "'><i class='fa fa-pencil'></i></a>";
                        html += "<a title='Remove relationship' data-context='deletetechnicalrelation' data-command data-method='DELETE' data-uri='/api/relationships/" + data.IntersectID + "'><i class='fa fa-trash-o'></i></a>";
                        html += "</div>";

                        return html;
                    }
                }
            ]
        });

        //#endregion

        //#region Event Registration

        $('#TreeGrid').on('rowselect', treeGridRowSelect);
        $('#TreeGrid').on('rowdoubleclick', treeGridRowDoubleClick);
        amplify.subscribe("RelationshipFormStatus", relationshipFormStatus);
        amplify.subscribe("RelationshipCancel", relationshipCancel);
        amplify.subscribe("RelationshipSave", relationshipSave);
        amplify.subscribe("SourceFormStatus", sourceFormStatus);
        amplify.subscribe("SourceCancel", sourceCancel);
        amplify.subscribe("SourceSave", sourceSave);
        //amplify.subscribe("CancelAction", cancelAction);
        //amplify.subscribe("SaveAction", saveAction);
        amplify.subscribe("CommandExecuted", commandExecuted);
        amplify.subscribe(AmplifyActions.Local, localAction);
        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);

        $('#TechnicalRelationsGrid').on('rowselect', technicalRelationsGridRowSelect);
        $("#TechnicalRelationsGrid").on("bindingcomplete", technicalRelationsGridBindingComplete);

        $("#TreeGrid").on("click", ".lineage", activateIconTool);
        $("#TreeGrid").on("click", ".fusion", activateIconTool);
        $("#TreeGrid").on("click", ".attribute", activateIconTool);
        $("div.large-overlay").on("click", ".detailclose", closeDetailTab);

        //#endregion
    });
</script>
