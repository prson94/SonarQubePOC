@model d360.core.entities.ObjectDetail
<div id='TreeGridItemViewer' class="large-overlay">
    <div class="ui segment">

        <div class="form-header-info">
            <h4>Relationships for @Model.Name</h4>
            <p>All relationships for the @Model.Name @Model.TypeName are displayed below.  To add a new relationship please select a type of relationship to the right.</p>
        </div>
        <div id="AddRelationshipMenu"></div>
        <div id="RelationshipLineageTile" class="tile" style="display:none; margin-top:20px">
            <h2>Lineage</h2>
            <div id="TreeGridLineage"></div>
        </div>
        <div id="ViewNonLineage" class="row" style="margin-top:20px">
            <div class="col l3 m4">
                <div id="TreeGrid"></div>
            </div>
            <div class="col l9 m8">
                <div id="Attributes" style="display:none;" class="col s12">
                    <h2>Attributes</h2>
                    <div id="RelationshipDetailTile" class="tile"></div>
                    <div id="RelationshipAttributesTile" class="tile"></div>
                </div>
                <div id="Fusion" class="col s12">
                    <h2>Technical Relationships</h2>
                    <div id="TechnicalRelationshipsTile" class="tile">
                        <div id="TechnicalRelationshipsGrid"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="TreeGridRelationshipEditor"></div>

<script type="text/javascript">
    var type = "@(Model.ParentType)";
    var typeID = "@(Model.ID)";
    var intersectID = 0;
    var selectedView = 'Fusion';

    var RelationshipsSource;
    var RelationshipsAdapter;
    var TechnicalRelationshipsGridSource;
    var TechnicalRelationshipsGridAdapter;

    //#region Amplify Methods

    function cancelAction(data) {
        try {
            switch (data.context) {
                case contextList.ResponsibilityTransformation:
                case contextList.IntersectSourcingResponsibility:
                case contextList.SourceToTarget:
                    switchToViewer();
                    break;
            }
        } catch (e) {
            logError("RelationOverlay : CancelAction", e);
        }
    }

    function commandExecuted(data) {
        try {
            switch (data.context) {
                case contextList.ActionUnrelate:
                    $('#TreeGridAttributesDetail').html('');
                    $('#TreeGrid').one('bindingcomplete', function (event) {
                        var rows = $("#TreeGrid").jqxGrid('getrows');
                        if (rows.length > 0) {
                            $("#TreeGrid").jqxGrid('selectrow', 0);
                        }
                    });
                    $("#TreeGrid").jqxGrid('updatebounddata');
                    amplify.publish('SaveAction', { context: "intersectform" });
                    break;
            }
        } catch (e) {
            logError("RelationOverlay : CommandExecuted", e);
        }
    }

    function localAction(data) {
        try {
            switch (data.context) {
                case contextList.ActionLink:
                    location.assign(data.uri);
                    break;
                case contextList.IntersectSourcingResponsibility:
                case contextList.ActionResponsibility:
                case contextList.ActionEditRelate:
                case contextList.ActionRelate:
                case contextList.ResponsibilityTransformation:
                case contextList.SourceToTarget:
                    switchToEditor(data.uri);
                    break;
            }
        } catch (e) {
            logError("RelationOverlay : LocalAction", e);
        }
    };

    function relationshipCancel(data) {
        try {
            switchToViewer();
        } catch (e) {
            logError("RelationOverlay : RelationshipCancel", e);
        }
    }

    function relationshipFormStatus(data) {
        try {
            amplify.publish("ShowMessage", { type: (data.success ? 'confirm' : 'error'), title: data.title || 'Modifying Relationships', message: data.message });
        } catch (e) {
            logError("RelationOverlay : RelationshipFormStatus", e);
        }
    }

    function relationshipSave(data) {
        try {
            switchToViewer();
            if (data.action == 'Add') {
                if (data.technical) {
                    $("#TechnicalRelationshipsGrid").jqxGrid('updatebounddata');
                }
                else {
                    $('#TreeGrid').one('bindingcomplete', function (event) {
                        var selectActiveRow = false;

                        if (data.targets.length > 0) {
                            selectActiveRow = true;
                        }

                        if (selectActiveRow) {
                            try {
                                var boundRows = $("#TreeGrid").jqxGrid('getboundrows', data.id);
                                var index = -1;

                                $.each(boundRows, function () {
                                    if (this.TargetObjectType == data.targets[0].ObjectType && this.TargetObjectID == data.targets[0].ObjectID) {
                                        index = $('#TreeGrid').jqxGrid('getrowboundindexbyid', this.uid);
                                    }
                                });

                                if (index >= 0) {
                                    $("#TreeGrid").jqxGrid('selectrow', index);
                                }
                            } catch (e) { }
                        }
                        else {
                            var rows = $("#TreeGrid").jqxGrid('getrows');
                            if (rows.length > 0) {
                                $("#TreeGrid").jqxGrid('selectrow', 0);
                            }
                        }
                    });
                    $("#TreeGrid").jqxGrid('updatebounddata');

                    TechnicalRelationshipsGridSource.url = null;
                    $("#TechnicalRelationshipsGrid").jqxGrid('updatebounddata');
                    $('#TreeGridAttributesDetail').html('');
                }
            }
            amplify.publish('SaveAction', { context: "intersectform" });
        } catch (e) {
            logError("RelationOverlay : RelationshipSave", e);
        }
    }

    function sourceCancel(data) {
        try {
            switchToViewer();
        } catch (e) {
            logError("RelationOverlay : SourceCancel", e);
        }
    }

    function sourceFormStatus(data) {
        try {
            amplify.publish("ShowMessage", { type: (data.success ? 'confirm' : 'error'), title: data.title || 'Modifying Source', message: data.message });
        } catch (e) {
            logError("RelationOverlay : SourceFormStatus", e);
        }
    }

    function sourceSave(data) {
        try {
            switchToViewer();
            LineageDiagram('TreeGridLineage', type, typeID, null);
            amplify.publish('SaveAction', { context: contextList.SourceToTarget });
        } catch (e) {
            logError("RelationOverlay : SourceSave", e);
        }
    }

    function saveAction(data) {
        try {
            switch (data.context) {
                case contextList.SourceToTarget:
                    switchToViewer();
                    break;
            }
        } catch (e) {
            logError("RelationOverlay : SaveAction", e);
        }
    }

    //#endregion

    //#region Control Event Methods

    function treeGridRowDoubleClick(event) {
        var row = $('#TreeGrid').jqxGrid('getrowdata', event.args.rowindex);
        location.assign(row.TargetUrl);
    }

    function treeGridRowSelect(event) {
        var row = event.args.row;
        try {
            intersectID = row.IntersectID;
            switch (selectedView) {
                case 'Attributes':
                    AttributesTile('RelationshipAttributesTile', contextList, null, "Intersect", intersectID, 'Business Attributes');
                    break;
                case 'Fusion':
                    TechnicalRelationshipsGridSource.url = '/api/Intersect/' + intersectID + '/relations';
                    $('#TechnicalRelationshipsGrid').jqxGrid('updatebounddata');
                    break;
                case 'Lineage': // Refresh lineage
                    LineageDiagram('TreeGridLineage', type, typeID, null);
                    break;
            }

            //relationsModel.TargetType = row.TargetType;
            //relationsModel.TargetID = (row.TargetType == 'TaxonomyType') ? row.TargetTypeID : row.IntersectID;
        }
        catch (e) {
            logError("RelationOverlay : TreeGrid.rowSelect", e);
            console.log('IDs no longer exist.');
        }
    }

    function unsubscribe(data) {
        TechnicalRelationshipsGridAdapter = null;
        TechnicalRelationshipsGridSource = null;
        RelationshipsAdapter = null;
        RelationshipsSource = null;

        amplify.unsubscribe('RelationshipFormStatus', relationshipFormStatus);
        amplify.unsubscribe('RelationshipCancel', relationshipCancel);
        amplify.unsubscribe('RelationshipSave', relationshipSave);

        amplify.unsubscribe("SourceFormStatus", sourceFormStatus);
        amplify.unsubscribe("SourceCancel", sourceCancel);
        amplify.unsubscribe("SourceSave", sourceSave);

        amplify.unsubscribe('CancelAction', cancelAction);
        amplify.unsubscribe('SaveAction', saveAction);
        amplify.unsubscribe('CommandExecuted', commandExecuted);
        amplify.unsubscribe(AmplifyActions.Local, localAction);

        $('#TreeGrid').off('rowselect', treeGridRowSelect);
        $('#TreeGrid').off('rowdoubleclick', treeGridRowDoubleClick);

        amplify.unsubscribe(AmplifyActions.Unsubscribe, unsubscribe);
    }

    //#endregion

    //#region Utility Methods

    var addNodeToTree = function (attTree, data, parentNodeID) {
        try {
            var elementByID = null;
            if (parentNodeID) elementByID = attTree.find(parentNodeID)[0];
            $(data).each(function () {
                var html = '<span class="node" data-type="' + this.ObjectType + '" data-typeid="' + this.ObjectID + '" data-owner="' + this.ParentObjectType + '" data-ownerid="' + this.ParentObjectID + '">' + '<b>' + this.ObjectTypeName + ' : </b>' + this.Name + '</span>';
                if (elementByID)
                    attTree.jqxTree('addTo', { expanded: true, id: this.ObjectType + this.ObjectID, html: html }, elementByID);
                else
                    attTree.jqxTree('addTo', { expanded: true, id: this.ObjectType + this.ObjectID, html: html });

                if (this.Items) {
                    addNodeToTree(attTree, this.Items, '#' + this.ObjectType + this.ObjectID);
                }
            });
        } catch (e) {
            logError("RelationOverlay : addNodeToTree", e);
        }
    }

    var loadAddRelationDropdown = function () {
        try {
            var relationUri = '/relations/OptionsToRelate';

            $.getJSON(relationUri, function (data) {

                var addMenuItem = { html: '<span>Add Relationships</span>', items: data };
                var items = [
                    addMenuItem,
                    { html: '<span data-a="Source">Add Source</span>' },
                    {
                        html: '<span>Views</span>', items: [
                            { html: '<span data-a="Attributes">Attributes</span>' },
                            { html: '<span data-a="Fusion">Technical Relationships</span>' },
                            { html: '<span data-a="Lineage">Lineage</span>' }
                        ]
                    }
                    //{
                    //    html: '<span>Reports</span>', items: [
                    //        { html: 'Sample Report' }
                    //    ]
                    //}
                ];

                $('#AddRelationshipMenu').jqxMenu({
                    source: items,//data,
                    theme: theme,
                    width: '100%',
                    animationHideDelay: 1000
                });

                $('#AddRelationshipMenu').on('itemclick', function (event) {
                    var li = $(event.args);
                    var span = $(li.find('span'));
                    selectedView = span.data('a');

                    if (selectedView) {
                        var url = '';

                        switch (selectedView) {
                            case 'Intersect':
                                url = '/Relations/AddRelationship?source=' + type + '&sourceID=' + typeID + '&target=' + span.data('t') + '&targetID=' + span.data('i');
                                break;
                            case 'Source':
                                url = '/relations/sources/' + type + '/' + typeID + '/add';
                                break;
                        }

                        if (url != '') {
                            selectedView = 'Fusion'; //Reset to default
                            $('#TreeGridItemViewer').fadeOut(10);
                            $('#TreeGridRelationshipEditor').fadeIn(10);
                            $('#TreeGridRelationshipEditor').load(url);
                        }
                        else {
                            switch (selectedView) {
                                case 'Attributes':
                                    $('#RelationshipLineageTile').hide();
                                    $('#ViewNonLineage').show();
                                    $('#Attributes').show();
                                    $('#Fusion').hide();
                                    AttributesTile('RelationshipAttributesTile', contextList, null, "Intersect", intersectID, 'Business Attributes');
                                    break;
                                case 'Fusion':
                                    $('#RelationshipLineageTile').hide();
                                    $('#ViewNonLineage').show();
                                    $('#Fusion').show();
                                    $('#Attributes').hide();
                                    TechnicalRelationshipsGridSource.url = '/api/Intersect/' + intersectID + '/relations';
                                    $('#TechnicalRelationshipsGrid').jqxGrid('updatebounddata');
                                    break;
                                case 'Lineage':
                                    $('#RelationshipLineageTile').show();
                                    $('#ViewNonLineage').hide();
                                    LineageDiagram('TreeGridLineage', type, typeID, null);
                                    break;
                            }
                        }
                    }
                });
            });
        } catch (e) {
            logError("RelationOverlay : loadAddRelationDropdown", e);
        }
    }

    var performAttributeSelectNodeAction = function (selectedNode) {
        try {
            var owner = null;
            var ownerid = null;
            owner = selectedNode.data("owner");
            ownerid = selectedNode.data("ownerid");

            var type = null;
            var typeid = null;
            type = selectedNode.data("type");
            typeid = selectedNode.data("typeid");

            var attributeID = null;
            if (type == "Attribute") {
                attributeID = typeid;
            }

            $('#TreeGridAttributeToolbar').AttributeToolbar('loadTools', type, typeid, owner, ownerid, attributeID);

            if (type == "Attribute") {
                $('#TreeGridAttributesDetail').Detail('reload', type, typeid);
            }
            else {
                $('#TreeGridAttributesDetail').Detail('clear');
            }
        } catch (e) {
            logError("RelationOverlay : performAttributeSelectNodeAction", e);
        }
    }

    var switchToViewer = function () {
        $('#TreeGridRelationshipEditor').html('');
        $('#TreeGridRelationshipEditor').fadeOut(1);
        $('#TreeGridItemViewer').fadeIn(500);
    }

    var switchToEditor = function (uri) {
        try {
            $('#TreeGridItemViewer').fadeOut(10);
            $('#TreeGridRelationshipEditor').fadeIn(10);
            $('#TreeGridRelationshipEditor').load(uri, function (response, status, xhr) {
                if (status == "error") {
                    amplify.publish("ShowMessage", { title: "Something unexpected happened!", message: xhr.status + ' ' + xhr.statusText, type: 'error' });
                    switchToViewer();
                }
            });
        } catch (e) {

        }
    }

    //#endregion

    $(function () {

        $("html, body").animate({ scrollTop: 0 }, "slow");

        //#region Relations Tree Grid

        RelationshipsSource = {
            datatype: 'json',
            url: '/api/' + type + '/' + typeID + '/relations',
            datafields: [
                { name: 'IntersectID' },
                { name: 'Description' },
                { name: 'Role' },
                { name: 'TargetName' },
                { name: 'TargetObjectID' },
                { name: 'TargetObjectType' },
                { name: 'TargetTypeID' },
                { name: 'TargetType' },
                { name: 'TargetTypeName' },
                { name: 'Classification' },
                { name: 'TargetUrl' }
            ]
        };
        RelationshipsAdapter = new $.jqx.dataAdapter(RelationshipsSource);

        $("#TreeGrid").jqxGrid({
            groupable: false,
            //groupsrenderer: function (text, group, expanded, data) {
            //    var style = "background-color: " + data.subItems[0].IconBackColor + "; color: " + data.subItems[0].IconForeColor;
            //    var html = "";
            //    html += "<h2>";
            //    html += group;
            //    html += "</h2>";
            //    return html;
            //},
            //groupsexpandedbydefault: false,
            autoheight: true,
            autorowheight: true,
            altrows: true,
            showfilterrow: true,
            source: RelationshipsAdapter,
            theme: theme,
            selectionmode: 'singlerow',
            height: '500px',
            width: grid_width,
            filterable: true,
            //filtermode: 'excel',
            sortable: true,
            pageable: true,
            //groups: ['TypeName'],
            columns: [
                { text: 'Type', groupable: true, datafield: 'TargetTypeName', width: '100px', filtertype: 'checkedlist' }, //, hidden: true
                { text: 'Name', groupable: false, datafield: 'TargetName' },
                { text: 'Role', groupable: false, datafield: 'Role', width: '100px', filtertype: 'checkedlist' },
                {
                    text: '',
                    groupable: false,
                    datafield: 'IntersectID',
                    width: '22px',
                    filterable: false,
                    sortable: false,
                    cellsRenderer: function (index, datafield, value, defaultvalue, column, data) {
                        if (data.IntersectID) {
                            return gearsRenderer("Intersect", data.IntersectID);
                        }
                        else {
                            return previewIconRenderer(data.TargetObjectType, data.TargetObjectID, data.TargetUrl);
                        }
                    }
                }
            ]
        });

        $("#TreeGrid").one("bindingcomplete", function (event) {
            if ($("#TreeGrid").jqxGrid('getdisplayrows').length > 0) {
                $("#TreeGrid").jqxGrid('selectrow', 0);
            }
        });

        //#endregion

        //#region Technical Relationship Grid Configuration

        TechnicalRelationshipsGridSource = {
            datatype: 'json',
            url: null,
            datafields: [
                { name: 'IntersectID' },
                { name: 'Description' },
                { name: 'TargetName' },
                { name: 'TargetObjectID' },
                { name: 'TargetObjectType' },
                { name: 'TargetTypeID' },
                { name: 'TargetType' },
                { name: 'TargetTypeName' },
                { name: 'Classification' },
                { name: 'TargetUrl' }
            ]
        };

        TechnicalRelationshipsGridAdapter = new $.jqx.dataAdapter(TechnicalRelationshipsGridSource);

        $("#TechnicalRelationshipsGrid").jqxGrid({
            width: grid_width,
            autoheight: true,
            sortable: true,
            altrows: true,
            filterable: true,
            showfilterrow: true,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            pageable: true,
            autorowheight: true,
            columnsresize: true,
            source: TechnicalRelationshipsGridAdapter,
            theme: list_theme,
            groupable: false,
            columns: [
                { text: 'Type', groupable: true, datafield: 'TargetTypeName', width: '100px' }, //, hidden: true
                { text: 'Name', groupable: false, datafield: 'TargetName', width: '300px' },
                { text: 'Description', groupable: false, datafield: 'Description' },
                {
                    text: '',
                    groupable: false,
                    datafield: 'IntersectID',
                    width: '30px',
                    filterable: false,
                    cellsRenderer: function (index, datafield, value, defaultvalue, column, data) {
                        return gearsRenderer("Intersect", data.IntersectID);
                    }
                }
            ]
        });

        //#endregion

        loadAddRelationDropdown();

        $('#RelationshipDetailTile').Detail();

        //#region Event Registration

        $('#TreeGrid').on('rowselect', treeGridRowSelect);
        $('#TreeGrid').on('rowdoubleclick', treeGridRowDoubleClick);
        amplify.subscribe("RelationshipFormStatus", relationshipFormStatus);
        amplify.subscribe("RelationshipCancel", relationshipCancel);
        amplify.subscribe("RelationshipSave", relationshipSave);
        amplify.subscribe("SourceFormStatus", sourceFormStatus);
        amplify.subscribe("SourceCancel", sourceCancel);
        amplify.subscribe("SourceSave", sourceSave);
        amplify.subscribe("CancelAction", cancelAction);
        amplify.subscribe("SaveAction", saveAction);
        amplify.subscribe("CommandExecuted", commandExecuted);
        amplify.subscribe(AmplifyActions.Local, localAction);
        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);

        //#endregion
    });
</script>
