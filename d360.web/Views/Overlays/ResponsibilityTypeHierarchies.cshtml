<div class="small-overlay">
    <div class="ui segment">
        <h4>Responsibility Type Display Order</h4>
        <div class="form-instructions"></div>
        <div id="HierarchyViewer" class="root-tile">
            <header><div id="HierarchyOverlayGridTools"></div></header>
            <div id="HierarchyOverlayGrid"></div>
        </div>
        <div id="HierarchyEditor"></div>
    </div>
</div>


<script type="text/javascript">
    var _context = "@(ContextList.ResponsibilityTypeHierarchy)";
    var HierarchyOverlayGridSource;
    var HierarchyOverlayGridAdapter;

    var switchToViewer = function () {
        $('#HierarchyEditor').html('');
        $('#HierarchyEditor').fadeOut(1);
        $('#HierarchyViewer').fadeIn(500);
    }

    var switchToEditor = function (uri) {
        try {
            $('#HierarchyViewer').fadeOut(10);
            $('#HierarchyEditor').fadeIn(10);
            $('#HierarchyEditor').load(uri, function (response, status, xhr) {
                if (status == "error") {
                    amplify.publish("ShowMessage", { title: "Something unexpected happened!", message: xhr.status + ' ' + xhr.statusText, type: 'error' });
                    switchToViewer();
                }
            });
        } catch (e) {

        }
    }

    function cancelAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToViewer();
                    $('#HierarchyOverlayGrid').jqxGrid('updatebounddata');
                    break;
            }
        } catch (e) {
            logError("AttributeTypeCategoriesOverlay : CancelAction", e);
        }
    }

    function localAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToEditor(data.uri);
                    break;
            }
        } catch (e) {
            logError("AttributeTypeCategoriesOverlay : LocalAction", e);
        }
    };

    function saveAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToViewer();
                    $('#HierarchyOverlayGrid').jqxGrid('updatebounddata');
                    break;
            }
        } catch (e) {
            logError("ResponsibilityTypeHierarchiesOverlay : SaveAction", e);
        }
    }

    function unsubscribe() {
        HierarchyOverlayGridAdapter = null;
        HierarchyOverlayGridSource = null;

        amplify.unsubscribe('CancelAction', cancelAction);
        amplify.unsubscribe('SaveAction', saveAction);
        amplify.unsubscribe('ToolAction', localAction);
        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.unsubscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
    }

    $(function () {
        var permissions = new PermissionsModel();

        var loadAfterPermissionsRetrieved = function () {

            var tools = [];
            if (permissions.HasPermission("Root", "Create")) {
                tools.push({ icon: 'plus', uri: '/form/AddResponsibilityTypeHierarchy', context: _context, title: 'Add responsibility type order' });
            }
            TileTools('#HierarchyOverlayGridTools', tools);

            //#region Grid

            HierarchyOverlayGridSource = {
                datatype: "json",
                type: 'get',
                datafields: [
                    { name: 'StartName' },
                    { name: 'StartID' },
                    { name: 'EndName' },
                    { name: 'EndID' }
                ],
                url: '/api/ResponsibilityTypeHierarchies'
            };

            HierarchyOverlayGridAdapter = new $.jqx.dataAdapter(HierarchyOverlayGridSource);

            $('#HierarchyOverlayGrid').jqxGrid({
                altrows: true,
                source: HierarchyOverlayGridAdapter,
                width: overlay_grid_width,
                autoheight: true,
                autorowheight: true,
                pagesizeoptions: ['10', '20', '50'],
                pagesize: 20,
                filterable: true,
                showfilterrow: true,
                sortable: true,
                pageable: false,
                theme: list_theme,
                columns: [
                    { datafield: "StartName", text: "Start" },
                    { datafield: "EndName", text: "End" },
                    {
                        filterable: false, sortable: false, width: '40px',
                        datafield: "ID", text: "",
                        cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                            var tools = [];

                            if (permissions.HasPermission("Root", "Delete")) {
                                tools.push({ icon: 'trash-o', urlprefix: '/form/DeleteResponsibilityTypeHierarchy?s=' + data.StartID + '&e=' + data.EndID, title: 'Remove responsibility type order' });
                            }

                            return renderToolsHtml(value, tools, _context, data);
                        }
                    }
                ]
            });

            //#endregion

            amplify.subscribe('CancelAction', cancelAction);
            amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
            amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
            amplify.subscribe('SaveAction', saveAction);
            amplify.subscribe('ToolAction', localAction);
        }

        permissions.GetPermissionsForObject('ResponsibilityType', 0).then(loadAfterPermissionsRetrieved);

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
