<div class="small-overlay">
    <div class="ui segment">
        <h4>Attribute Type Categories</h4>
        <div class="form-instructions"></div>
        <div id="CategoryViewer" class="root-tile">
            <header><div id="CategoryOverlayGridTools"></div></header>
            <div id="CategoryOverlayGrid"></div>
        </div>
        <div id="CategoryEditor"></div>
    </div>
</div>


<script type="text/javascript">
    var _context = "@(ContextList.AttributeTypeCategory)";
    var CategoryOverlayGridSource;
    var CategoryOverlayGridAdapter;

    var switchToViewer = function () {
        $('#CategoryEditor').html('');
        $('#CategoryEditor').fadeOut(1);
        $('#CategoryViewer').fadeIn(500);
    }

    var switchToEditor = function (uri) {
        try {
            $('#CategoryViewer').fadeOut(10);
            $('#CategoryEditor').fadeIn(10);
            $('#CategoryEditor').load(uri, function (response, status, xhr) {
                if (status == "error") {
                    amplify.publish("ShowMessage", { title: "Something unexpected happened!", message: xhr.status + ' ' + xhr.statusText, type: 'error' });
                    switchToViewer();
                }
            });
        } catch (e) {

        }
    }

    function cancelAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToViewer();
                    $('#CategoryOverlayGrid').jqxGrid('updatebounddata');
                    break;
            }
        } catch (e) {
            logError("AttributeTypeCategoriesOverlay : CancelAction", e);
        }
    }

    function localAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToEditor(data.uri);
                    break;
            }
        } catch (e) {
            logError("AttributeTypeCategoriesOverlay : LocalAction", e);
        }
    };

    function saveAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToViewer();
                    $('#CategoryOverlayGrid').jqxGrid('updatebounddata');
                    break;
            }
        } catch (e) {
            logError("AttributeTypeCategoriesOverlay : SaveAction", e);
        }
    }

    function unsubscribe() {
        CategoryOverlayGridAdapter = null;
        CategoryOverlayGridSource = null;

        amplify.unsubscribe('CancelAction', cancelAction);
        amplify.unsubscribe('SaveAction', saveAction);
        amplify.unsubscribe('ToolAction', localAction);
        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.unsubscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
    }

    $(function () {
        var permissions = new PermissionsModel();

        var loadAfterPermissionsRetrieved = function () {

            var tools = [];
            if (permissions.HasPermission("Root", "Create")) {
                tools.push({ icon: 'plus', uri: '/form/AddAttributeTypeCategory', context: _context, title: 'Add attribute type category' });
            }
            TileTools('#CategoryOverlayGridTools', tools);

            //#region Grid

            CategoryOverlayGridSource = {
                datatype: "json",
                type: 'get',
                datafields: [
                    { name: 'Name' },
                    { name: 'Description' },
                    { name: 'ID' }
                ],
                url: '/api/AttributeTypeCategories?$orderby=Name'
            };

            CategoryOverlayGridAdapter = new $.jqx.dataAdapter(CategoryOverlayGridSource);

            $('#CategoryOverlayGrid').jqxGrid({
                altrows: true,
                source: CategoryOverlayGridAdapter,
                width: overlay_grid_width,
                autoheight: true,
                autorowheight: true,
                pagesizeoptions: ['10', '20', '50'],
                pagesize: 20,
                filterable: true,
                showfilterrow: true,
                sortable: true,
                pageable: false,
                theme: list_theme,
                columns: [
                    { datafield: "Name", text: "Name", width: '25%' },
                    { datafield: "Description", text: "Description" },
                    {
                        filterable: false, sortable: false, width: '80px',
                        datafield: "ID", text: "",
                        cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                            var tools = [];

                            if (permissions.HasPermission("Root", "Update")) {
                                tools.push({ icon: 'pencil', urlprefix: '/form/EditAttributeTypeCategory?id={0}', title: 'Edit attribute type category' });
                            }
                            if (permissions.HasPermission("Root", "Delete")) {
                                tools.push({ icon: 'trash-o', urlprefix: '/form/DeleteAttributeTypeCategory?id={0}', title: 'Remove attribute type category' });
                            }

                            return renderToolsHtml(value, tools, _context, data);
                        }
                    }
                ]
            });

            //#endregion

            amplify.subscribe('CancelAction', cancelAction);
            amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
            amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
            amplify.subscribe('SaveAction', saveAction);
            amplify.subscribe('ToolAction', localAction);
        }

        permissions.GetPermissionsForObject('AttributeType', 0).then(loadAfterPermissionsRetrieved);

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
