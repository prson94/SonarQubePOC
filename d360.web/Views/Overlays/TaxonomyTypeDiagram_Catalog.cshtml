<div class="large-overlay">
    <div class="ui segment tile">
        <header id="Hierarchy_header">Hierarchy</header>
        <div id="Hierarchy_wrapper_fullscreen" style="z-index:1000000;background-color:white;">
            <div id="Hierarchy_ribbon_expander" style="width:100%;">
                <div style="font-size:1.1em;">
                    <i class="fa fa-gear"></i> Diagram Controls
                </div>
                <div style="width: 100%;height:120px" id="Hierarchy_ribbon">
                    <ul>
                        <li>View</li>
                    </ul>
                    <div>
                        <!-- div ribbon container -->
                        <div>
                            <!-- 0-View -->
                            <table style="width:auto;height:115px;">
                                <tbody>
                                    <tr style="font-size:.8em;padding-top:2px;height:15px;">
                                        <td colspan="2" style="padding-left:5px;">Overview</td>
                                        <td colspan="2" style="padding-left:5px;">Zoom</td>
                                        <td colspan="2" style="padding-left:5px;">Other</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:5px;">
                                            <div style="border: 1px solid #ccc;margin:2px;">
                                                <div id="Hierarchy_overview" style="width:100px;height:80px"></div>
                                            </div>
                                        </td>
                                        <td style="width:1px;border-left:1px solid #ccc;"></td>
                                        <td style="padding:0 5px 0 5px">
                                            <table style="height:80px;">
                                                <tbody>
                                                    <tr>
                                                        <td style="text-align: center;">
                                                            <button id="Hierarchy_ribbon_zoom_100"><i class="fa fa-search"></i> 100%</button>
                                                            <button id="Hierarchy_ribbon_zoom_fit"><i class="fa fa-expand"></i> Fit</button>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>
                                                            <button id="Hierarchy_ribbon_zoom_out"><i class="fa fa-search-minus"></i></button>
                                                            <input id="Hierarchy_ribbon_zoom_slider" type="range" max="2250" min="750" value="1500" style="width:150px; display:inline-block;" />
                                                            <button id="Hierarchy_ribbon_zoom_in" style="display:inline-block"><i class="fa fa-search-plus"></i></button>
                                                            <span id="Hierarchy_ribbon_zoom_text" style="display: inline-block;">100%</span>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                        <td style="width:1px;border-left:1px solid #ccc;"></td>
                                        <td style="padding:5px;vertical-align:top;">
                                            <button id="Hierarchy_ribbon_fullscreen" style="vertical-align:top; display:none"><i class="fa fa-2x fa-arrows-alt"></i><br />Fullscreen</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <table>
                <tbody>
                    <tr style="vertical-align:top;height:700px">
                        <td>
                            <div id="Hierarchy_wrapper" style="height:420px;resize:vertical; overflow: auto">
                                <div id="Hierarchy_dgm" style="height:400px; overflow: no-display"></div>
                            </div>
                        </td>
                        <td style="width:350px;vertical-align:top;height:100%">
                            <div id="Hierarchy_sidebar" style="height:100%; overflow-y: scroll;">
                                <div id="Hierarchy_info">
                                    <div><i class="fa fa-info-circle"></i> Info</div>
                                    <div style="padding: 10px" id="Hierarchy_info_body"></div>
                                </div>
                                <div id="Hierarchy_responsibilities">
                                    <div><i class="fa fa-retweet"></i> Responsibilities</div>
                                    <div style="padding:10px">
                                        <div id="Hierarchy_responsibilities_body"></div>
                                    </div>
                                </div>
                                <div id="Hierarchy_relationships">
                                    <div><i class="fa fa-retweet"></i> Relationships</div>
                                    <div style="padding:10px">
                                        <div id="Hierarchy_relationships_body"></div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <script type="text/javascript">
            var id = @(ViewData["ID"]);
            var myDiagram;
            var rSource;
            var rAdapter;
            var fullscreen = false;
            var g = go.GraphObject.make;  // for conciseness in defining templates

            $("html, body").animate({ scrollTop: 0 }, "slow");

            //#region Controls 

            $("#Hierarchy_ribbon_zoom_100").jqxButton({ theme: theme, height: "100%", width: "40%" });
            $("#Hierarchy_ribbon_zoom_fit").jqxButton({ theme: theme, height: "100%", width: "40%" });
            $("#Hierarchy_ribbon_fullscreen").jqxButton({ theme: theme, height: "100%", width: 64 });
            $("#Hierarchy_ribbon_zoom_out").jqxRepeatButton({ delay: 3, theme: theme });
            $("#Hierarchy_ribbon_zoom_in").jqxRepeatButton({ delay: 3, theme: theme });

            $("#Hierarchy_info").jqxExpander({ theme: theme }).jqxExpander('collapse');
            $("#Hierarchy_responsibilities").jqxExpander({ theme: theme }).jqxExpander('collapse');
            $("#Hierarchy_relationships").jqxExpander({ theme: theme }).jqxExpander('collapse');
            $("#Hierarchy_ribbon_expander").jqxExpander({ theme: theme}).jqxExpander('collapse');

            $('#Hierarchy_ribbon').jqxRibbon({
                width: "100%",
                height: 64,
                animationType: "fade",
                selectionMode: "click",
                position: "top",
                theme: theme,
                mode: "default",
                selectedIndex: 0
            });

            //#endregion

            var oldHeight = $('#Hierarchy_wrapper').height();
            var oldWidth = $('#Hierarchy_wrapper').width();

            //#region Control Event Handlers

            $('#Hierarchy_ribbon_fullscreen').on('click', function () {
                fullscreen = !fullscreen;
                if (fullscreen) {
                    $('#Hierarchy_ribbon_fullscreen').html('<i class="fa fa-2x fa-sign-out"></i><br />Exit Fullscreen');
                    $('#Hierarchy_ribbon_fullscreen').css('position', 'fixed')
                        .css('left', '0')
                        .css('top', '0')
                        .css('width', '100%')
                        .css('height', '100%');
                    $('#Hierarchy_dgm').height($('#Hierarchy_wrapper_fullscreen').height());
                    $('#Hierarchy_wrapper').height($('#Hierarchy_wrapper_fullscreen').height());
                    $('#Hierarchy_sidebar').height($('#Hierarchy_wrapper_fullscreen').height());
                } else {
                    $('#Hierarchy_ribbon_fullscreen').html('<i class="fa fa-2x fa-arrows-alt"></i><br />Fullscreen');
                    $('#Hierarchy_wrapper_fullscreen').attr('style', 'z-index:1000000;background-color:white;');
                    $('#Hierarchy_wrapper').height(520);
                    $('#Hierarchy_sidebar').height(520);
                }
                myDiagram.requestUpdate();

            });

            $('#Hierarchy_ribbon_zoom_slider').on('input', function () {
                var val = $(this).val();
                $('#Hierarchy_ribbon_zoom_text').text(Math.round((val / 1500) * 100) + '%');
                myDiagram.scale = (val / 1500);
            });

            $('#Hierarchy_ribbon_zoom_in').on('click', function () {
                var val = parseInt($('#Hierarchy_ribbon_zoom_slider').val()) + 5;
                $('#Hierarchy_ribbon_zoom_slider').val(val);
                $('#Hierarchy_ribbon_zoom_text').text(Math.round((val / 1500) * 100) + '%');
                myDiagram.scale = (val / 1500);
            });

            $('#Hierarchy_ribbon_zoom_out').on('click', function () {
                var val = $('#Hierarchy_ribbon_zoom_slider').val();
                $('#Hierarchy_ribbon_zoom_slider').val(val - 5);
                $('#Hierarchy_ribbon_zoom_text').text(Math.round((val / 1500) * 100) + '%');
                myDiagram.scale = (val / 1500);
            });

            $('#Hierarchy_wrapper').on('mouseup', function () {
                var height = $('#Hierarchy_wrapper').height();
                if (height != oldHeight) {
                    $('#Hierarchy_dgm').height(height - 20);
                    oldHeight = height;
                    myDiagram.requestUpdate();
                }
            });

            $('#Hierarchy_ribbon_zoom_100').on('click', function () {
                $('#Hierarchy_ribbon_zoom_slider').val(1500);
                myDiagram.scale = 1.0;
                $('#Hierarchy_ribbon_zoom_text').text('100%');
            });

            $('#Hierarchy_ribbon_zoom_fit').on('click', function () {
                myDiagram.zoomToFit();
                $('#Hierarchy_ribbon_zoom_text').text(Math.round(myDiagram.scale * 100) + '%');
            });

            //#endregion

            //#region Diagram Event Handlers

            function onLayoutCompleted() {
                //myDiagram.scale = 1;
                //myDiagram.scrollToRect(myDiagram.findNodeForKey(0).actualBounds);

                //console.log(myDiagram.documentBounds.height);
                //console.log(myDiagram.viewportBounds.height);
                //var height = $('#' + controlID_diagram).height($(window).innerHeight());
            }

            function onDoubleClick(e) {
                //var obj = e.diagram.selection.first().data;
                ////console.log(obj);
                //if (obj != null) {
                //    type = obj.type;
                //    id = obj.id;
                //    populateDiagram();
                //}
            }

            function onSelectionChange(e) {
                var node = e.diagram.selection.first();

                $("#Hierarchy_ribbon_remove").hide(200);
                $("#Hierarchy_fusion_table").hide(200);

                if (node == null) {
                    return;
                }

                var data = node.data;

                $('#Hierarchy_info').jqxExpander('expand');
                $.ajax({
                    url: '/resources/Taxonomy/' + data.key + '/templates/tooltip/Preview',
                    data: null,
                    success: function (html) {
                        $('#Hierarchy_info_body').html(html);
                    },
                    async: true
                });

                //#region Responsibilities

                $('#Hierarchy_responsibilities').jqxExpander('expand');

                rSource = {
                    datatype: 'json',
                    url: '/api/Taxonomy/' + data.key + '/ownership?showHidden=false',
                    datafields:
                    [
                        { name: 'ResponsibilityID' },
                        { name: 'AssigningItemType' },
                        { name: 'AssigningItemID' },
                        { name: 'AssigningItemName' },
                        { name: 'AssigningItemUrl' },
                        { name: 'ResponsibleObjectType' },
                        { name: 'ResponsibleObjectID' },
                        { name: 'ResponsibleObjectName' },
                        { name: 'PrimaryOwnerResourceID' },
                        { name: 'PrimaryOwnerResourceName' },
                        { name: 'PrimaryOwnerResourceUrl' },
                        { name: 'ObjectType' },
                        { name: 'ObjectID' },
                        { name: 'Role' },
                        { name: 'ResponsibleObjectUrl' }
                    ]
                };

                rAdapter = new $.jqx.dataAdapter(rSource);

                $('#Hierarchy_responsibilities_body').jqxGrid({
                    altrows: true,
                    width: grid_width,
                    autoheight: true,
                    sortable: true,
                    filterable: true,
                    showfilterrow: true,
                    pagesizeoptions: ['10', '20', '50'],
                    pagesize: 20,
                    pageable: true,
                    pagermode: "simple",
                    selectionmode: 'none',
                    autorowheight: true,
                    source: rAdapter,
                    theme: list_theme,
                    columns: [
                        { columntype: 'dropdownlist', filtertype: 'checkedlist', datafield: "Role", text: "Role", width: '34%' },
                        { columntype: 'dropdownlist', filtertype: 'checkedlist', datafield: "ResponsibleObjectName", text: "Resource", width: '33%',
                            cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                                return previewLinkRenderer(data.ResponsibleObjectType, data.ResponsibleObjectID, data.ResponsibleObjectUrl, data.ResponsibleObjectName);
                            }
                        },
                        { columntype: 'dropdownlist', filtertype: 'checkedlist', datafield: "PrimaryOwnerResourceName", text: "Group Owner", width: '33%',
                            cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                                if (data.PrimaryOwnerResourceName && data.PrimaryOwnerResourceName != '')
                                    return previewLinkRenderer('Resource', data.PrimaryOwnerResourceID, data.PrimaryOwnerResourceUrl, data.PrimaryOwnerResourceName);
                                else
                                    return '';
                            }
                        }
                    ]
                });

                //#endregion

                //#region Relationships

                $('#Hierarchy_relationships').jqxExpander('expand');

                var relSource = {
                    datatype: 'json',
                    url: '/api/Taxonomy/' + data.key + '/relations',
                    datafields: [
                        { name: 'IntersectID' },
                        { name: 'TargetTypeName' },
                        { name: 'TargetName' },
                        { name: 'TargetUrl' }
                    ]
                };
                var relAdapter = new $.jqx.dataAdapter(relSource);

                $("#Hierarchy_relationships_body").jqxGrid({
                    groupable: false,
                    autoheight: true,
                    autorowheight: true,
                    altrows: true,
                    showfilterrow: true,
                    pagermode: "simple",
                    source: relAdapter,
                    theme: theme,
                    selectionmode: 'singlerow',
                    width: grid_width,
                    filterable: true,
                    sortable: true,
                    pageable: true,
                    columns: [
                        { text: 'Type', datafield: 'TargetTypeName', width: '50%', filtertype: 'checkedlist' },
                        { text: 'Name', width: '49%', datafield: 'TargetName' }
                    ]
                });

                //#endregion
            }

            function onViewportBoundsChanged() {
                var s = myDiagram.scale;
                var h = 500;
                if (s > 1) {
                    h = h * s;
                }
                $('#Hierarchy_ribbon_zoom_text').text(Math.round(myDiagram.scale * 100) + '%');
                $('#Hierarchy_ribbon_zoom_slider').val(Math.round(myDiagram.scale * 1500));
            };

            //#endregion

            $.getJSON('/diagrams/InformationCatalogDiagramData?id=' + id, function (nodeDataArray) {
                delete nodeDataArray[0].parent;

                myDiagram =
                    g(go.Diagram,
                        "Hierarchy_dgm",
                        { allowCopy: false, layout: g(go.TreeLayout, { angle: 90, nodeSpacing: 10, layerSpacing: 40, layerStyle: go.TreeLayout.LayerUniform }) }
                    );

                myDiagram.nodeTemplate =
                  g(go.Node, "Auto",
                    { deletable: false },
                    new go.Binding("text", "name"),
                    g(go.Shape, "Rectangle",
                      { fill: "lightgray", stroke: "black", stretch: go.GraphObject.Fill, alignment: go.Spot.Center }
                    ),
                    g(go.TextBlock,
                        { font: "bold 8pt Helvetica, bold Arial, sans-serif", textAlign: "center", margin: 6, maxSize: new go.Size(90, NaN) },
                        new go.Binding("text", "name")
                    )
                  );

                myDiagram.linkTemplate = g(go.Link,
                    { routing: go.Link.Orthogonal, corner: 5, selectable: false },
                    g(go.Shape)
                );

                myOverview =  g(go.Overview, 'Hierarchy_overview', { observed: myDiagram, contentAlignment: go.Spot.Center });

                myDiagram.addDiagramListener('ViewportBoundsChanged', onViewportBoundsChanged);
                myDiagram.addDiagramListener('ChangedSelection', onSelectionChange);
                myDiagram.addDiagramListener('ObjectDoubleClicked', onDoubleClick);
                myDiagram.addDiagramListener('LayoutCompleted', onLayoutCompleted);


                myDiagram.model = new go.TreeModel(nodeDataArray);
            });
        </script>
    </div>
</div>