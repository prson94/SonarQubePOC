<div class="small-overlay">
    <div class="ui segment">
        <div id="PredicatesViewer">
            <h4><i class="fa fa-@(Resources.Actions.Predicates_Icon) grey-text"></i>&#160;Predicates</h4>
            <div class="form-instructions"></div>
            <div class="root-tile">
                <div class="TileTools">
                    <a style="margin-left: 10px" class="btn-floating waves-effect waves-light brown lighten-1" data-context="@(ContextList.Predicate)" data-local data-uri="/form/AddPredicate"><i class="fa fa-plus" title="Add predicate"></i></a>
                </div>
                <div id="PredicatesGrid"></div>
            </div>
        </div>
        <div id="PredicatesEditor"></div>
    </div>
</div>

<script type="text/javascript">
    var PredicatesGridSource;
    var PredicatesGridAdapter;

    $(function () {

        function localAction(data) {
            try {
                switch (data.context) {
                    case contextList.Predicate:
                        switchToEditor(data.uri);
                        break;
                }
            } catch (e) {
                logError("PredicatesOverlay : localAction", e);
            }
        };

        function localCancel(data) {
            try {
                switch (data.context) {
                    case contextList.Predicate:
                        switchToViewer();
                        break;
                }
            } catch (e) {
                logError("PredicatesOverlay : localCancel", e);
            }
        }

        function localSave(data) {
            try {
                switch (data.context) {
                    case contextList.Predicate:
                        switchToViewer();
                        $('#PredicatesGrid').jqxGrid('updatebounddata');
                        break;
                }
            } catch (e) {
                logError("PredicatesOverlay : localSave", e);
            }
        }

        var switchToEditor = function (uri) {
            try {
                $('#PredicatesViewer').fadeOut(10);
                $('#PredicatesEditor').fadeIn(10);
                $('#PredicatesEditor').load(uri, function (response, status, xhr) {
                    if (status == "error") {
                        amplify.publish("ShowMessage", { title: "Something unexpected happened!", message: xhr.status + ' ' + xhr.statusText, type: 'error' });
                        switchToViewer();
                    }
                });
            } catch (e) {
                logError("PredicatesOverlay : switchToEditor", e);
            }
        }

        var switchToViewer = function () {
            $('#PredicatesEditor').html('');
            $('#PredicatesEditor').fadeOut(1);
            $('#PredicatesViewer').fadeIn(500);
        }

        function unsubscribe(data) {
            PredicatesGridAdapter = null;
            PredicatesGridSource = null;

            amplify.unsubscribe(AmplifyActions.Local, localAction);
            amplify.unsubscribe(AmplifyActions.Cancel, localCancel);
            amplify.unsubscribe(AmplifyActions.Save, localSave);
            amplify.unsubscribe(AmplifyActions.Unsubscribe, unsubscribe);
            amplify.unsubscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
        }

        //#region Grid

        PredicatesGridSource = {
            datatype: 'json',
            url: "/relations/predicates",
            datafields: [
                { name: "ID", type: "number" },
                { name: "Name", type: "string" },
                { name: "Inverse", type: "string" },
                { name: "Type", type: "string" },
                { name: "IsUsed", type: "bool" },
                { name: "IsSystem", type: "bool" }
            ]
        };

        PredicatesGridAdapter = new $.jqx.dataAdapter(PredicatesGridSource);

        $('#PredicatesGrid').jqxGrid({
            altrows: true,
            source: PredicatesGridAdapter,
            width: grid_width,
            autoheight: true,
            autorowheight: true,
            filterable: true,
            sortable: true,
            pageable: true,
            pagesize: 5,
            theme: list_theme,
            columns: [
                { text: 'Name', dataField: 'Name' },
                { text: 'Inverse', dataField: 'Inverse' },
                { text: 'Type', dataField: 'Type' },
                {
                    text: '',
                    dataField: 'ID',
                    width: '80px',
                    cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                        if (data.IsSystem) {
                            return "";
                        }
                        else {
                            var html = "";

                            html += "<div class='RowMultiTools'>";
                            html += "<a title='Edit predicate' data-context='" + contextList.Predicate + "' data-local data-uri='/form/EditPredicate?id=" + data.ID + "'><i class='fa fa-pencil'></i></a>";
                            if (!data.IsUsed) {
                                html += "<a title='Remove predicate' data-context='" + contextList.Predicate + "' data-local data-uri='/form/DeletePredicate?id=" + data.ID + "'><i class='fa fa-trash-o'></i></a>";
                            }
                            html += "</div>";

                            return html;
                        }
                    }
                }
            ]
        });

        //#endregion

        amplify.subscribe(AmplifyActions.Local, localAction);
        amplify.subscribe(AmplifyActions.Cancel, localCancel);
        amplify.subscribe(AmplifyActions.Save, localSave);
        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>