<div class="large-overlay">
    <div class="ui segment">
        <div id="PromotionViewer">
            <h4>Promotion Rules</h4>
            <div class="form-instructions"></div>
            <div class="row">
                <div class="col s12">
                    <div class="root-tile">
                        <header><div id="PromotionsOverlayGridTools"></div></header>
                        <div id="PromotionsOverlayGrid"></div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col s12 m12 l6">
                    <div class="root-tile">
                        <header>
                            <span id="PromotionItemsOverlayGridTitle"></span>
                            <div id="PromotionItemsOverlayGridTools"></div>
                        </header>
                        <div id="PromotionItemsOverlayGrid"></div>
                    </div>
                </div>
                <div class="col s12 m12 l6">
                    <div class="root-tile">
                        <header>
                            <span id="PromotionMappingsOverlayGridTitle"></span>
                            <div id="PromotionMappingsOverlayGridTools"></div>
                        </header>
                        <div id="PromotionMappingsOverlayGrid"></div>
                    </div>
                </div>
            </div>
        </div>
        <div id="PromotionEditor"></div>
    </div>
</div>

<script type="text/javascript">
    var fusionTypeID = "@(ViewBag.FusionTypeID)";
    var fusionID = "@(ViewBag.FusionID)";
    var _overlayContext = "@(ContextList.FusionPromotionRule)";
    var _itemContext = "@(ContextList.FusionPromotionRuleItem)";
    var _mappingContext = "@(ContextList.FusionPromotionRuleMapping)";
    var PromotionsOverlayGridSource;
    var PromotionsOverlayGridAdapter;
    var PromotionItemsOverlayGridSource;
    var PromotionItemsOverlayGridAdapter;
    var PromotionMappingsOverlayGridSource;
    var PromotionMappingsOverlayGridAdapter;
    var permissions;

    var switchToViewer = function () {
        $('#PromotionEditor').html('');
        $('#PromotionEditor').fadeOut(1);
        $('#PromotionViewer').fadeIn(500);
    }

    var switchToEditor = function (uri) {
        try {
            $('#PromotionViewer').fadeOut(10);
            $('#PromotionEditor').fadeIn(10);
            $('#PromotionEditor').html(progressIndicatorHtml);
            $('#PromotionEditor').load(uri, function (response, status, xhr) {
                if (status == "error") {
                    amplify.publish("ShowMessage", { title: "Something unexpected happened!", message: xhr.status + ' ' + xhr.statusText, type: 'error' });
                    switchToViewer();
                }
            });
        } catch (e) {

        }
    }

    function cancelAction(data) {
        try {
            switch (data.context) {
                case _overlayContext:
                case _itemContext:
                case _mappingContext:
                    switchToViewer();
                    break;
            }
        } catch (e) {
            logError("FusionConfigurationPromotionOverlay : CancelAction", e);
        }
    }

    function localAction(data) {
        try {
            switch (data.context) {
                case _overlayContext:
                case _itemContext:
                case _mappingContext:
                    switchToEditor(data.uri);
                    break;
            }
        } catch (e) {
            logError("FusionConfigurationPromotionOverlay : LocalAction", e);
        }
    };

    function overlayBindingComplete(event) {
        var rowCount = $('#PromotionsOverlayGrid').jqxGrid('getdisplayrows').length;
        if (rowCount > 0) {
            $('#PromotionsOverlayGrid').jqxGrid('selectrow', 0);
        }
    }

    var overlayRowSelect = function (event) {
        var args = event.args;              // event arguments.
        //var rowBoundIndex = args.rowindex;  // row's bound index.
        var data = args.row;             // row's data.

        if (permissions.HasPermission("Root", "Create")) {
            var itemTools = [];
            itemTools.push({ icon: 'plus', uri: '/form/AddFusionAttributePromotionRuleItem?id=' + data.ID, context: _itemContext, title: 'Add target item' });
            TileTools('#PromotionItemsOverlayGridTools', itemTools);

            var mappingTools = [];
            mappingTools.push({ icon: 'plus', uri: '/form/AddFusionAttributePromotionRuleMapping?id=' + data.ID, context: _mappingContext, title: 'Add field mapping' });
            TileTools('#PromotionMappingsOverlayGridTools', mappingTools);
        }

        $('#PromotionItemsOverlayGridTitle').text('Target Items for Selected Rule');
        PromotionItemsOverlayGridSource.url = '/api/fusion/' + data.ID + '/PromotionRuleItems';
        $('#PromotionItemsOverlayGrid').jqxGrid('updatebounddata');

        $('#PromotionMappingsOverlayGridTitle').text('Field Mappings for Selected Rule');
        PromotionMappingsOverlayGridSource.url = '/api/fusion/' + data.ID + '/PromotionRuleMappings';
        $('#PromotionMappingsOverlayGrid').jqxGrid('updatebounddata');
    }

    function saveAction(data) {
        try {
            switch (data.context) {
                case _overlayContext:
                    switchToViewer();
                    $('#PromotionsOverlayGrid').jqxGrid('updatebounddata');
                    break;
                case _itemContext:
                    switchToViewer();
                    $('#PromotionItemsOverlayGrid').jqxGrid('updatebounddata');
                    break;
                case _mappingContext:
                    switchToViewer();
                    $('#PromotionMappingsOverlayGrid').jqxGrid('updatebounddata');
                    break;
            }
        } catch (e) {
            logError("FusionConfigurationPromotionOverlay : SaveAction", e);
        }
    }

    function unsubscribe() {
        PromotionItemsOverlayGridAdapter = null;
        PromotionItemsOverlayGridSource = null;
        PromotionMappingsOverlayGridAdapter = null;
        PromotionMappingsOverlayGridSource = null;
        PromotionsOverlayGridAdapter = null;
        PromotionsOverlayGridSource = null;

        amplify.unsubscribe('CancelAction', cancelAction);
        $('#PromotionsOverlayGrid').off('rowselect', overlayRowSelect);
        $("#PromotionsOverlayGrid").off("bindingcomplete", overlayBindingComplete);
        amplify.unsubscribe('SaveAction', saveAction);
        amplify.unsubscribe('ToolAction', localAction);
        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.unsubscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
    }

    $(function () {
        permissions = new PermissionsModel();

        var loadAfterPermissionsRetrieved = function () {

            var tools = [];
            if (permissions.HasPermission("Root", "Create")) {
                tools.push({ icon: 'plus', uri: '/form/fusion/' + fusionTypeID + '/configurations/' + fusionID + '/promotions/add', context: _overlayContext, title: 'Add promotion rule' });
            }
            TileTools('#PromotionsOverlayGridTools', tools);

            //#region Grid

            PromotionsOverlayGridSource = {
                datatype: 'json',
                url: "/api/fusion/" + fusionTypeID + "/configurations/" + fusionID + "/promotion",
                datafields: [
                    { name: "ID", type: "number" },
                    { name: "ObjectType", type: "string" },
                    { name: "ObjectID", type: "number" },
                    { name: "ObjectName", type: "string" },
                    { name: "PromotionObjectType", type: "string" },
                    { name: "PromotionObjectID", type: "number" },
                    { name: "PromotionName", type: "string" },
                    { name: "PromotionParentObjectType", type: "string" },
                    { name: "PromotionParentObjectID", type: "number" },
                    { name: "PromotionParentName", type: "string" }
                ]
            };

            PromotionsOverlayGridAdapter = new $.jqx.dataAdapter(PromotionsOverlayGridSource);

            $('#PromotionsOverlayGrid').jqxGrid({
                altrows: true,
                source: PromotionsOverlayGridAdapter,
                width: grid_width,
                autoheight: true,
                autorowheight: true,
                filterable: true,
                sortable: true,
                pageable: true,
                theme: list_theme,
                columns: [
                    { text: 'Promoting', dataField: 'ObjectName' },
                    { text: 'To', dataField: 'PromotionName', width: '30%' },
                    { text: 'Under', dataField: 'PromotionParentName', width: '30%' },
                    {
                        text: '',
                        dataField: 'ID',
                        width: '80px',
                        cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                            var tools = [
                                { icon: 'pencil', urlprefix: '/form/EditFusionPromotionRule?id=' + data.ID },
                                { icon: 'trash-o', urlprefix: '/form/DeleteFusionPromotionRule?id=' + data.ID }
                            ];
                            return renderToolsHtml(value, tools, _overlayContext, data);
                        }
                    }
                ]
            });

            //#endregion

            //#region Items Grid

            PromotionItemsOverlayGridSource = {
                datatype: 'json',
                url: null,
                datafields: [
                    { name: "ID", type: "number" },
                    { name: "FusionAttributePromotionRuleID", type: "number" },
                    { name: "FusionAttributeID", type: "number" },
                    { name: "FusionAttributeName", type: "string" },
                ]
            };

            PromotionItemsOverlayGridAdapter = new $.jqx.dataAdapter(PromotionItemsOverlayGridSource);

            $('#PromotionItemsOverlayGrid').jqxGrid({
                altrows: true,
                source: PromotionItemsOverlayGridAdapter,
                width: grid_width,
                autoheight: true,
                autorowheight: true,
                filterable: false,
                sortable: true,
                pageable: false,
                theme: list_theme,
                columns: [
                    { text: 'Limiting Attribute', dataField: 'FusionAttributeName' },
                    {
                        text: '',
                        dataField: 'ID',
                        width: '40px',
                        cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                            var tools = [
                                //{ icon: 'pencil', urlprefix: '/form/EditFusionAttributePromotionRuleItem?id=' + data.ID },
                                { icon: 'trash-o', urlprefix: '/form/DeleteFusionAttributePromotionRuleItem?id=' + data.ID }
                            ];
                            return renderToolsHtml(value, tools, _itemContext, data);
                        }
                    }
                ]
            });

            //#endregion

            //#region Mappings Grid

            PromotionMappingsOverlayGridSource = {
                datatype: 'json',
                url: null,
                datafields: [
                    { name: "ID", type: "number" },
                    { name: "FusionAttributePromotionRuleID", type: "number" },
                    { name: "SourceFieldTypeID", type: "number" },
                    { name: "SourceFieldName", type: "string" },
                    { name: "TargetFieldTypeID", type: "number" },
                    { name: "TargetFieldName", type: "string" }
                ]
            };

            PromotionMappingsOverlayGridAdapter = new $.jqx.dataAdapter(PromotionMappingsOverlayGridSource);

            $('#PromotionMappingsOverlayGrid').jqxGrid({
                altrows: true,
                source: PromotionMappingsOverlayGridAdapter,
                width: grid_width,
                autoheight: true,
                autorowheight: true,
                filterable: false,
                sortable: true,
                pageable: false,
                theme: list_theme,
                columns: [
                    { text: 'Source', dataField: 'SourceFieldName' },
                    { text: 'Target', dataField: 'TargetFieldName' },
                    {
                        text: '',
                        dataField: 'ID',
                        width: '80px',
                        cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                            var tools = [
                                { icon: 'pencil', urlprefix: '/form/EditFusionAttributePromotionRuleMapping?id=' + data.ID },
                                { icon: 'trash-o', urlprefix: '/form/DeleteFusionAttributePromotionRuleMapping?id=' + data.ID }
                            ];
                            return renderToolsHtml(value, tools, _mappingContext, data);
                        }
                    }
                ]
            });

            //#endregion

            amplify.subscribe('CancelAction', cancelAction);
            amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
            amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
            $('#PromotionsOverlayGrid').on('rowselect', overlayRowSelect);
            $("#PromotionsOverlayGrid").on("bindingcomplete", overlayBindingComplete);
            amplify.subscribe('SaveAction', saveAction);
            amplify.subscribe('ToolAction', localAction);
        }

        permissions.GetPermissionsForObject('Fusion', fusionID).then(loadAfterPermissionsRetrieved);

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
