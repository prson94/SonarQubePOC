<div class="large-overlay">
    <div class="ui segment">
        <h4>Usage for @(ViewBag.Name)</h4>
        <div class="form-instructions"></div>
        <div id="UsageGrid"></div>
    </div>
</div>
<script type="text/javascript">
    var lookupTypeID = '@(ViewBag.ID)';
    var UsageGridSource;
    var UsageGridAdapter;

    function unsubscribe() {
        UsageGridAdapter = null;
        UsageGridSource = null;

        amplify.unsubscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.unsubscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
        $('#UsageGrid').jqxGrid('destroy');
    }

    $(function () {
        UsageGridSource = {
            datatype: 'json',
            url: '/api/lookups/' + lookupTypeID + '/allocations',
            datafields:
            [
                { name: 'FieldTypeID' },
                { name: 'FieldTypeName' },
                { name: 'LookupTypeID' },
                { name: 'LookupTypeName' },
                { name: 'LookupObjectType' },
                { name: 'ObjectID' },
                { name: 'ObjectName' },
                { name: 'ObjectType' },
                { name: 'ObjectTypeName' },
                { name: 'ObjectUrl' }
            ]
        };

        UsageGridAdapter = new $.jqx.dataAdapter(UsageGridSource);

        $('#UsageGrid').jqxGrid({
            width: grid_width,
            autoheight: true,
            sortable: true,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            filterable: true,
            showfilterrow: true,
            pageable: true,
            altrows: true,
            source: UsageGridAdapter,
            theme: list_theme,
            columns: [
                { datafield: "ObjectTypeName", text: "Referencing Type" },
                {
                    datafield: "ObjectName",
                    text: "Referencing Object",
                    cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                        return previewLinkRenderer(data.ObjectType, data.ObjectID, '#', value);
                    }
                },
                { datafield: "FieldTypeName", text: "Referencing Field" }
            ]
        });

        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>