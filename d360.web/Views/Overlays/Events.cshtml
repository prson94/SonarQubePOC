@model d360.core.entities.ObjectModel
<div class="large-overlay">
    <div class="ui segment">
        <h4>Events</h4>
        <div class="form-instructions"></div>
        <div id="EventsOverlayHeadersGrid"></div>

        <h5 id="EventsOverlayHeaderName" class="overlay-tabs tile-tabs">Choose a header above</h5>

        <div class="row">
            <div class="col s12">
                <ul id="EventHeaderTabs" class="tabs">
                    <li class="tab col s4"><a class="active" href="#EventOverlayItems" data-index="0" style="position: relative">Items</a></li>
                    <li class="tab col s4"><a href="#EventOverlayBoard" data-index="1" style="position: relative">Community</a></li>
                </ul>
            </div>
            <div id="EventOverlayItems" class="col s12 active">
                <div id="EventsOverlayItemsGrid"></div>
            </div>
            <div id="EventOverlayBoard" class="col s12">
                <div id="EventsOverlaySocial" data-bind="template: {name: 'boardTmpl' }"></div>
            </div>
        </div>
    </div>
</div>



<script type="text/javascript">
    var EventOverlayBaseUrl = '/api/@(Model.ObjectType)/@(Model.ObjectID)/events';

    var EventOverlaySocial;
    var EventsOverlayHeadersGridSource;
    var EventsOverlayHeadersGridAdapter;

    $('#EventHeaderTabs').tabs();

    function eventsOverlayHeadersGridBindingComplete(event) {
        var rowCount = $('#EventsOverlayHeadersGrid').jqxGrid('getdisplayrows').length;
        if (rowCount > 0) {
            $('#EventsOverlayHeadersGrid').jqxGrid('selectrow', 0);
        }
    }

    function eventsOverlayHeadersGridRowSelect(event) {
        var data = event.args.row;

        $('#EventsOverlayHeaderName').text("Details For " + data.Name);
        EventsGrid('EventsOverlayItemsGrid', getContextList(), data.ID, null, false, true);
        EventOverlaySocial.changeObject('EventGroup', data.ID);
    }

    function unsubscribe() {
        EventOverlaySocial = null;
        EventsOverlayHeadersGridAdapter = null;
        EventsOverlayHeadersGridSource = null;

        $('#EventsOverlayHeadersGrid').off('rowselect', eventsOverlayHeadersGridRowSelect);
        amplify.unsubscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.unsubscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
    }

    $(function () {

        EventOverlaySocial = new BoardViewModel();
        ko.applyBindings(EventOverlaySocial, document.getElementById('EventsOverlaySocial'));

        //#region Header Grid

        EventsOverlayHeadersGridSource = {
            datatype: "json",
            type: 'get',
            datafields: [
                { name: "ID" },
                { name: 'Name' },
                { name: 'Rule' },
                { name: 'Status' },
                { name: 'Count' },
                { name: 'Date', type: 'date' }
            ],
            url: EventOverlayBaseUrl + '/headers'
        };

        EventsOverlayHeadersGridAdapter = new $.jqx.dataAdapter(EventsOverlayHeadersGridSource);

        $('#EventsOverlayHeadersGrid').jqxGrid({
            source: EventsOverlayHeadersGridAdapter,
            width: overlay_grid_width,
            height: '200px',
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            sortable: true,
            altrows: true,
            pageable: false,
            theme: list_theme,
            columns: [
                { datafield: "Date", text: "Date", cellsformat: 'MMM d yyyy hh:mm:ss tt', filtertype: 'range' },
                { datafield: "Rule", text: "Rule", filtertype: 'checkedlist' },
                { datafield: "Name", text: "Name" },
                { datafield: "Status", text: "Status", width: 60, filtertype: 'checkedlist' },
                { datafield: "Count", text: "# Items", width: 60, filtertype: 'number' }
            ]
        });

        //#endregion

        $("#EventsOverlayHeadersGrid").one("bindingcomplete", eventsOverlayHeadersGridBindingComplete);
        $('#EventsOverlayHeadersGrid').on('rowselect', eventsOverlayHeadersGridRowSelect);
        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
