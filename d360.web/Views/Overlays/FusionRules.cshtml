<div class="large-overlay">
    <div class="ui segment">
        <div id="PromotionViewer">
            <h4>Rules</h4>
            <div class="form-instructions"></div>
            <div class="row">
                <div class="col s8">
                    <div class="root-tile">
                        <header>
                            <span>&nbsp;</span>
                            <div id="RulesGridTools"></div>
                        </header>
                        <div id="RulesGrid"></div>
                    </div>
                </div>
                <div class="col s4">
                    <div class="root-tile">
                        <header>
                            <span id="RuleItemsGridTitle">Items for selected rule</span>
                            <div id="RuleItemsGridTools"></div>
                        </header>
                        <div id="RuleItemsGrid"></div>
                    </div>
                </div>
            </div>            
            <div class="row">
                <div class="col s12">
                    <div class="root-tile">
                        <header>
                            <span id="RuleStepGridTitle">Steps for selected rule</span>
                            <div id="RuleStepGridTools"></div>
                        </header>
                        <div id="RuleStepGrid"></div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col s12">
                    <div class="root-tile">
                        <header>
                            <span id="RuleStepMappingGridTitle">Mappings for selected step</span>
                            <div id="RuleStepMappingGridTools"></div>
                        </header>
                        <div id="RuleStepMappingGrid"></div>
                    </div>
                </div>
            </div>
        </div>

        <div id="PromotionEditor"></div>
    </div>
</div>

<script type="text/javascript">
    var _overlayContext = "@(ContextList.FusionPromotionRule)";
    var _ruleoverlayContext = "@(ContextList.FusionRule)";
    var _itemContext = "@(ContextList.FusionPromotionRuleItem)";
    var _mappingContext = "@(ContextList.FusionPromotionRuleMapping)";
    var _stepContext = "@(ContextList.FusionRuleStep)";
    var FusionRuleGridSource;
    var FusionRuleGridAdapter;
    var FusionRuleStepGridAdapter;
    var FusionRuleStepGridSource;
    var RuleItemsGridSource;
    var RuleItemsGridAdapter;
    var MappingsGridSource;
    var MappingsGridAdapter;

    var permissions;

    var switchToViewer = function () {
        $('#PromotionEditor').html('');
        $('#PromotionEditor').fadeOut(1);
        $('#PromotionViewer').fadeIn(500);
    }

    var switchToEditor = function (uri) {
        try {
            $('#PromotionViewer').fadeOut(10);
            $('#PromotionEditor').fadeIn(10);
            $('#PromotionEditor').html(progressIndicatorHtml);
            $('#PromotionEditor').load(uri, function (response, status, xhr) {
                if (status == "error") {
                    amplify.publish("ShowMessage", { title: "Something unexpected happened!", message: xhr.status + ' ' + xhr.statusText, type: 'error' });
                    switchToViewer();
                }
            });
        } catch (e) {

        }
    }

    function cancelAction(data) {
        try {
            switch (data.context) {
                case _overlayContext:
                case _itemContext:
                case _mappingContext:
                case _stepContext:
                case _ruleoverlayContext:
                    switchToViewer();
                    break;
            }
        } catch (e) {
            logError("FusionConfigurationPromotionOverlay : CancelAction", e);
        }
    }

    function localAction(data) {
        try {
            switch (data.context) {
                case _overlayContext:
                case _itemContext:
                case _mappingContext:
                case _stepContext:
                case _ruleoverlayContext:
                    switchToEditor(data.uri);
                    break;
            }
        } catch (e) {
            logError("FusionConfigurationPromotionOverlay : LocalAction", e);
        }
    };


    function saveAction(data) {
        try {
            console.log(data);
            switch (data.context) {
                case _ruleoverlayContext:
                case _overlayContext:
                    switchToViewer();
                    $('#RuleStepGrid').jqxGrid('updatebounddata');
                    $('#RulesGrid').jqxGrid('updatebounddata');
                    break;
                case _itemContext:
                    switchToViewer();
                    $('#RuleItemsGrid').jqxGrid('updatebounddata');
                    break;
                case _mappingContext:
                    switchToViewer();
                    $('#RuleStepMappingGrid').jqxGrid('updatebounddata');
                    break;
                case _stepContext:
                    switchToViewer();
                    $('#RuleStepGrid').jqxGrid('updatebounddata');
                    break;
            }
        } catch (e) {
            logError("FusionConfigurationPromotionOverlay : SaveAction", e);
        }
    }
    
    function ruleBindingComplete(event) {
        var rowCount = $('#RulesGrid').jqxGrid('getdisplayrows').length;
        if (rowCount > 0) {
            $('#RulesGrid').jqxGrid('selectrow', 0);
        }
    }

    function stepBindingComplete(event) {
        var rowCount = $('#RuleStepGrid').jqxGrid('getdisplayrows').length;
        if (rowCount > 0) {
            $('#RuleStepGrid').jqxGrid('selectrow', 0);
        }
    }

    var ruleRowSelect = function (event) {
        var args = event.args;              // event arguments.
        var data = args.row;             // row's data.

        if (permissions.HasPermission("Root", "Create")) {
            var itemTools = [];
            itemTools.push({ icon: 'plus', uri: '/form/fusion/rule/' + data.ID  + '/step/add', context: _itemContext, title: 'Add step' });
            TileTools('#RuleStepGridTools', itemTools);

            var itemTools = [];
            itemTools.push({ icon: 'plus', uri: '/form/AddFusionRuleItem?id=' + data.ID, context: _itemContext, title: 'Add target item' });
            TileTools('#RuleItemsGridTools', itemTools);
        }

        RuleItemsGridSource.url = '/api/fusion/' + data.ID + '/FusionRuleItems';
        $('#RuleItemsGrid').jqxGrid('updatebounddata');

        FusionRuleStepGridSource.url = "/api/fusion/rules/" + data.ID + "/steps";
        $('#RuleStepGrid').jqxGrid('updatebounddata');
    }

    var stepRowSelect = function (event) {
        var args = event.args;              // event arguments.
        var data = args.row;             // row's data.

        if (permissions.HasPermission("Root", "Create")) {            
            var mappingTools = [];
            mappingTools.push({ icon: 'plus', uri: '/form/AddFusionRuleStepMapping?id=' + data.ID, context: '@(ContextList.FusionPromotionRuleMapping)', title: 'Add field mapping' });
            TileTools('#RuleStepMappingGridTools', mappingTools);
        }        
        MappingsGridSource.url = '/api/fusion/' + data.ID + '/FusionRuleStepMappings';
        $('#RuleStepMappingGrid').jqxGrid('updatebounddata');
    }

    function unsubscribe() {
        FusionRuleGridAdapter = null;
        FusionRuleGridSource = null;
        FusionRuleStepGridAdapter = null;
        FusionRuleStepGridSource = null;
        RuleItemsGridSource = null;
        RuleItemsGridAdapter = null;

        amplify.unsubscribe('CancelAction', cancelAction);

        amplify.unsubscribe('SaveAction', saveAction);
        amplify.unsubscribe('ToolAction', localAction);
        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.unsubscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
    }

    $(function () {
        permissions = new PermissionsModel();

        var loadAfterPermissionsRetrieved = function () {

            var tools = [];
            if (permissions.HasPermission("Root", "Create")) {
                tools.push({ icon: 'plus', uri: '/form/fusion/@(ViewBag.FusionTypeID)/configurations/@(ViewBag.FusionID)/rule/add', context: _overlayContext, title: 'Add promotion rule' });
            }
            TileTools('#RulesGridTools', tools);

            //#region Grid

            FusionRuleGridSource = {
                datatype: 'json',
                url: "/api/fusion/@(ViewBag.FusionID)/rules/",
                datafields: [
                    { name: "ID", type: "number" },
                    { name: "ObjectName", type: "string" },
                    { name: "Description", type: "string" },
                    { name: "Enabled", type: "bool" }
                ]
            };

            FusionRuleGridAdapter = new $.jqx.dataAdapter(FusionRuleGridSource);

            $('#RulesGrid').jqxGrid({
                altrows: true,
                source: FusionRuleGridAdapter,
                width: grid_width,
                autoheight: true,
                autorowheight: true,
                filterable: true,
                sortable: true,
                pageable: true,
                pagesize: 5,
                theme: list_theme,
                columns: [
                    { text: 'Enabled', columntype: 'checkbox', dataField: 'Enabled', width: 100 },
                    { text: 'Name', dataField: 'ObjectName' },
                    { text: 'Description', dataField: 'Description' },
                    {
                        text: '',
                        dataField: 'ID',
                        width: '80px',
                        cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                            var tools = [                                
                                { icon: 'pencil', urlprefix: '/form/EditFusionRule?id=' + data.ID },
                                { icon: 'trash-o', urlprefix: '/form/DeleteFusionRule?id=' + data.ID }
                            ];
                            return renderToolsHtml(value, tools, _overlayContext, data);
                        }
                    }
                ]
            });

            //#endregion

            //#region Items Grid

            RuleItemsGridSource = {
                datatype: 'json',
                url: null,
                datafields: [
                    { name: "ID", type: "number" },
                    { name: "FusionAttributePromotionRuleID", type: "number" },
                    { name: "FusionAttributeID", type: "number" },
                    { name: "FusionAttributeName", type: "string" },
                ]
            };

            RuleItemsGridAdapter = new $.jqx.dataAdapter(RuleItemsGridSource);

            $('#RuleItemsGrid').jqxGrid({
                altrows: true,
                source: RuleItemsGridAdapter,
                width: grid_width,
                autoheight: true,
                autorowheight: true,
                filterable: false,
                sortable: true,
                pageable: true,
                pagesize: 5,
                theme: list_theme,
                columns: [
                    { text: 'Limiting Attribute', dataField: 'FusionAttributeName' },
                    {
                        text: '',
                        dataField: 'ID',
                        width: '40px',
                        cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                            var tools = [
                                { icon: 'trash-o', urlprefix: '/form/DeleteFusionRuleItem?id=' + data.ID }
                            ];
                            return renderToolsHtml(value, tools, _itemContext, data);
                        }
                    }
                ]
            });

            //#endregion

            //RuleStepGrid

            FusionRuleStepGridSource = {
                datatype: 'json',
                url: null,
                //url: "/api/fusion/rules/" + data.ID + "/steps",
                datafields: [
                    { name: "ID", type: "number" },
                    { name: "RuleID", type: "number" },
                    { name: "Action", type: "string" },
                    { name: "Description", type: "string" },
                    { name: "Step", type: "number" }
                ]
            };

            FusionRuleStepGridAdapter = new $.jqx.dataAdapter(FusionRuleStepGridSource);
            var rowscount = 0;
            $('#RuleStepGrid').jqxGrid({
                altrows: true,
                source: FusionRuleStepGridAdapter,
                width: grid_width,
                autoheight: true,
                autorowheight: true,
                filterable: true,
                sortable: true,
                pageable: true,
                pagesize: 5,
                theme: list_theme,
                columns: [
                    { text: 'Action', dataField: 'Action', width: 200 },
                    { text: 'Step', dataField: 'Step', width: 100 },
                    { text: 'Description', dataField: 'Description' },
                     {
                         text: '',
                         dataField: 'ID',
                         width: '150px',
                         cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                             var tools = [                                 
                                 { icon: 'pencil', urlprefix: '/form/fusion/rule/' + data.RuleID + '/step/edit/' + data.ID },
                                 { icon: 'trash-o', urlprefix: '/form/fusion/rule/' + data.RuleID + '/step/delete/' + data.ID }
                             ];
                             if(index > 0) tools.push({ icon: 'caret-square-o-up', urlprefix: '/form/fusion/rule/' + data.RuleID + '/step/move/up/' + data.ID });

                             if(index == 0){
                                 var datainformations = $('#RuleStepGrid').jqxGrid('getdatainformation');
                                 rowscount = datainformations == null ? 0 : datainformations.rowscount;
                             }

                             if(rowscount != (index +1))
                                tools.push({ icon: 'caret-square-o-down', urlprefix: '/form/fusion/rule/' + data.RuleID + '/step/move/down/' + data.ID });

                             return renderToolsHtml(value, tools, _overlayContext, data);
                         }
                     }
                ]
            });


            //#endregion

            //#region Mapping Grid

            MappingsGridSource = {
                datatype: 'json',
                url: null, //'/api/fusion//FusionRuleStepMappings',
                datafields: [
                    { name: "ID", type: "number" },
                    { name: "FusionAttributePromotionRuleID", type: "number" },
                    { name: "SourceFieldTypeID", type: "number" },
                    { name: "SourceFieldName", type: "string" },
                    { name: "TargetFieldTypeID", type: "number" },
                    { name: "TargetFieldName", type: "string" }
                ]
            };

            MappingsGridAdapter = new $.jqx.dataAdapter(MappingsGridSource);

            $('#RuleStepMappingGrid').jqxGrid({
                altrows: true,
                source: MappingsGridAdapter,
                width: grid_width,
                autoheight: true,
                autorowheight: true,
                filterable: false,
                sortable: true,
                pageable: false,
                pagesize: 5,
                theme: list_theme,
                columns: [
                    { text: 'Source', dataField: 'SourceFieldName' },
                    { text: 'Target', dataField: 'TargetFieldName' },
                    {
                        text: '',
                        dataField: 'ID',
                        width: '80px',
                        cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                            var tools = [
                                { icon: 'pencil', urlprefix: '/form/EditFusionRuleStepMapping?id=' + data.ID },
                                { icon: 'trash-o', urlprefix: '/form/DeleteFusionRuleStepMapping?id=' + data.ID }
                            ];
                            return renderToolsHtml(value, tools, '@(ContextList.FusionPromotionRuleMapping)', data);
                        }
                    }
                ]
            });


            //#endregion



            amplify.subscribe('CancelAction', cancelAction);
            amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
            amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);

            $('#RulesGrid').on('rowselect', ruleRowSelect);
            $("#RulesGrid").on("bindingcomplete", ruleBindingComplete);

            $('#RuleStepGrid').on('rowselect', stepRowSelect);
            $("#RuleStepGrid").on("bindingcomplete", stepBindingComplete);
            

            amplify.subscribe('SaveAction', saveAction);
            amplify.subscribe('ToolAction', localAction);
        }

        permissions.GetPermissionsForObject('Fusion', @(ViewBag.FusionID)).then(loadAfterPermissionsRetrieved);

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
