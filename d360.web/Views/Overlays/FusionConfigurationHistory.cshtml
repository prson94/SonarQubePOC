<div class="medium-overlay">
    <div class="ui segment">
        <h4>Fusion Configuration History</h4>
        <div class="form-instructions"></div>
        <div id="HistoryViewer">
            <div class="row">
                <div class="col s12 m12 l6">
                    <div id="AgentHistoryTile" class="root-tile">
                        <header>Agent History</header>
                        <div id="AgentHistoryGrid"></div>
                    </div>
                </div>
                <div class="col s12 m12 l6">
                    <div id="ExecutionHistoryTile" class="root-tile">
                        <header>Execution History<div class="TileTools"><button id="history-refresh-button" class="btn-floating waves-effect waves-light brown lighten-1"><i class="fa fa-refresh"></i></button></div></header>
                        <div id="ExecutionHistoryGrid"></div>
                    </div>
                </div>
            </div>
        </div>
        <div id="HistoryEditor"></div>
    </div>
</div>


<script type="text/javascript">
    var fusionTypeID = "@(ViewBag.FusionTypeID)";
    var fusionID = "@(ViewBag.FusionID)";
    var _context = "FusionExecution";
    var AgentHistoryGridSource;
    var AgentHistoryGridAdapter;
    var ExecutionHistoryGridSource;
    var ExecutionHistoryGridAdapter;

    var switchToViewer = function () {
        $('#HistoryEditor').html('');
        $('#HistoryEditor').fadeOut(1);
        $('#HistoryViewer').fadeIn(500);
    }

    var switchToEditor = function (uri) {
        try {
            $('#HistoryViewer').fadeOut(10);
            $('#HistoryEditor').fadeIn(10);
            $('#HistoryEditor').load(uri, function (response, status, xhr) {
                if (status == "error") {
                    amplify.publish("ShowMessage", { title: "Something unexpected happened!", message: xhr.status + ' ' + xhr.statusText, type: 'error' });
                    switchToViewer();
                }
            });
        } catch (e) {

        }
    }

    function cancelAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToViewer();
                    $('#HistoryOverlayGrid').jqxGrid('updatebounddata');
                    break;
            }
        } catch (e) {
            logError("FusionConfigurationHistoryOverlay : CancelAction", e);
        }
    }

    function historyRefreshButtonClick() {
        $("#ExecutionHistoryGrid").jqxGrid('updatebounddata');
    }

    function localAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToEditor(data.uri);
                    break;
            }
        } catch (e) {
            logError("FusionConfigurationHistoryOverlay : LocalAction", e);
        }
    };

    function saveAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToViewer();
                    $('#HistoryOverlayGrid').jqxGrid('updatebounddata');
                    break;
            }
        } catch (e) {
            logError("FusionConfigurationHistoryOverlay : SaveAction", e);
        }
    }

    function unsubscribe() {
        AgentHistoryGridSource = null;
        AgentHistoryGridAdapter = null;
        ExecutionHistoryGridSource = null;
        ExecutionHistoryGridAdapter = null;

        $('#history-refresh-button').off('click', historyRefreshButtonClick);
        amplify.unsubscribe('CancelAction', cancelAction);
        amplify.unsubscribe('SaveAction', saveAction);
        amplify.unsubscribe('ToolAction', localAction);
        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.unsubscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
    }

    $(function () {
        var permissions = new PermissionsModel();

        var loadAfterPermissionsRetrieved = function () {

            //var tools = [];
            //if (permissions.HasPermission("Root", "Create")) {
            //    tools.push({ icon: 'plus', uri: '/form/AddAttributeTypeCategory', context: _context, title: 'Add attribute type category' });
            //}
            //TileTools('#HistoryOverlayGridTools', tools);

            //#region AgentHistory Grid Configuration

            AgentHistoryGridSource = {
                datatype: 'json',
                url: '/services/fusion/agenthistory?$filter=FusionID eq ' + fusionID + '&$top=100&$orderby=DateStarted desc',
                datafields: [
                    { name: "FusionID", type: "number" },
                    { name: "FusionType", type: "string" },
                    { name: "Fusion", type: "string" },
                    { name: "DateStarted", type: "date" },
                    { name: "DateCompleted", type: "date" },
                    { name: "MachineQueuedOn", type: "string" },
                    { name: "Success", type: "bool" },
                    { name: "Message", type: "string" }
                ]
            };

            AgentHistoryGridAdapter = new $.jqx.dataAdapter(AgentHistoryGridSource);

            $("#AgentHistoryGrid").jqxGrid({
                altrows: true,
                width: grid_width,
                autoheight: true,
                sortable: true,
                filterable: true,
                showfilterrow: true,
                pageable: true,
                pagesizeoptions: ['5'], //, '10', '20'
                pagesize: 5,
                columnsresize: true,
                source: AgentHistoryGridAdapter,
                theme: list_theme,
                groupable: false,
                columns: [
                    { text: 'Started On', datafield: 'DateStarted', cellsformat: 'MM/dd/yy HH:mm:ss', filtertype: 'range', width: '35%' },
                    { text: 'Completed On', datafield: 'DateCompleted', cellsformat: 'MM/dd/yy HH:mm:ss', filtertype: 'range', width: '35%' },
                    { text: 'Agent', datafield: 'MachineQueuedOn', filtertype: 'checkedlist', width: '15%' },
                    { text: 'Success?', datafield: 'Success', columntype: 'checkbox', filtertype: 'bool', width: '15%' }
                ]
            });

            //#endregion

            //#region ExecutionHistory Grid Configuration

            ExecutionHistoryGridSource = {
                datatype: 'json',
                url: '/services/fusion/executionhistory?$filter=FusionID eq ' + fusionID + '&$top=100&$orderby=DateStarted desc',
                datafields: [
                    { name: "ID", type: "number" },
                    { name: "RawLogFileName", type: "string" },
                    { name: "DateStarted", type: "date" },
                    { name: "DateCompleted", type: "date" },
                    { name: "FusionID", type: "number" },
                    { name: "FusionType", type: "string" },
                    { name: "Fusion", type: "string" },
                    { name: "Adds", type: "number" },
                    { name: "Updates", type: "number" },
                    { name: "Deletes", type: "number" },
                    { name: "ErrorCount", type: "number" },
                    { name: "ResultCount", type: "number" }
                ]
            };

            ExecutionHistoryGridAdapter = new $.jqx.dataAdapter(ExecutionHistoryGridSource);

            $("#ExecutionHistoryGrid").jqxGrid({
                altrows: true,
                width: grid_width,
                autoheight: true,
                sortable: true,
                filterable: true,
                showfilterrow: true,
                pageable: true,
                pagesizeoptions: ['5'], //, '10', '20'
                pagesize: 5,
                columnsresize: true,
                source: ExecutionHistoryGridAdapter,
                theme: list_theme,
                groupable: false,
                columns: [
                    { text: 'Started On', datafield: 'DateStarted', cellsformat: 'MM/dd/yy HH:mm:ss', filtertype: 'range', width: '25%' },
                    { text: 'Completed On', datafield: 'DateCompleted', cellsformat: 'MM/dd/yy HH:mm:ss', filtertype: 'range', width: '25%' },
                    //{ text: '# Added', datafield: 'Adds', columntype: 'numberinput', filtertype: 'number' },
                    //{ text: '# Updated', datafield: 'Updates', columntype: 'numberinput', filtertype: 'number' },
                    //{ text: '# Deleted', datafield: 'Deletes', columntype: 'numberinput', filtertype: 'number' },
                    { text: '# Errors', datafield: 'ErrorCount', columntype: 'numberinput', filtertype: 'number' },
                    { text: '# Results', datafield: 'ResultCount', columntype: 'numberinput', filtertype: 'number' },
                    {
                        text: '',
                        dataField: 'ID',
                        width: '40px',
                        filterable: false,
                        cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                            var tools = [];
                            tools.push({ title: 'More info on this execution', icon: 'info', urlprefix: '/fusion/FusionExecution?id=' + data.ID });
                            //if (data.RawLogFileName.length > 0) {
                            //    tools.push({ title: 'View raw agent submission log', icon: 'file-code-o', urlprefix: '/fusion/FusionExecutionRawLog?id=' + data.ID });
                            //}
                            return renderToolsHtml(value, tools, "FusionExecution", data);
                        }
                    }
                ]
            });

            //#endregion

            amplify.subscribe('CancelAction', cancelAction);
            amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
            amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
            amplify.subscribe('SaveAction', saveAction);
            amplify.subscribe('ToolAction', localAction);
            $('#history-refresh-button').on('click', historyRefreshButtonClick);
        }

        permissions.GetPermissionsForObject('Fusion', fusionID).then(loadAfterPermissionsRetrieved);

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
