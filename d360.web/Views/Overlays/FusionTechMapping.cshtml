<div class="large-overlay">
    <div class="ui segment" id="HistoryViewer">                
            <div class="left form-header-info">
                <h4>Fusion Technical Mapping</h4>
            </div>
            <div class="right">
                <button type="button" id="CancelButton" data-bind="click: cancel" class="btn waves-effect waves-light brown lighten-4">Close</button>
            </div>
            <div class="clear"></div>
            <div class="form-instructions"></div>
            <div class="row">
                <div class="col s12">
                    <div class="root-tile">
                        <header>
                            <div id="TechMappingTools" class="TileTools"></div>
                        </header>
                        <div id="TechmappingGrid"></div>
                    </div>
                </div>
            </div>
        </div>            
    <div id="HistoryEditor"></div>
</div>


<script type="text/javascript">    
    var _context = "FusionTechnicalMapping";
    var artifactSource;
    var artifactAdapter;
    var gridSource;
    var gridDataAdapter;

    var switchToViewer = function () {
        $('#HistoryEditor').html('');
        $('#HistoryEditor').fadeOut(1);
        $('#HistoryViewer').fadeIn(500);
        console.log("refreshing grid");
        $('#TechmappingGrid').jqxGrid('updatebounddata');
    }

    var switchToEditor = function (uri) {
        try {
            $('#HistoryViewer').fadeOut(10);
            $('#HistoryEditor').fadeIn(10);
            $('#HistoryEditor').load(uri, function (response, status, xhr) {
                if (status == "error") {
                    amplify.publish("ShowMessage", { title: "Something unexpected happened!", message: xhr.status + ' ' + xhr.statusText, type: 'error' });
                    switchToViewer();
                }
            });
        } catch (e) {

        }
    }
        
    function unsubscribe() {
        artifactSource = null;
        artifactAdapter = null;
        gridSource = null;
        gridDataAdapter = null;

        $('#addMapping').off('click');
        $('#CancelButton').off('click');
        $('#SaveButton').off('click');
        $('#DeleteRow').off('click');

        amplify.unsubscribe('ToolAction', localAction);
        amplify.unsubscribe(AmplifyActions.Unsubscribe, unsubscribe);
    }

    function cancelAction(data) {
        try {
            console.log(data.context);
            switch (data.context) {
                case _context:
                    switchToViewer();                    
                    return false;
                    break;
            }
        } catch (e) {
            logError("FetchTechMapping : CancelAction", e);
        }
    }
        
    function saveAction(data) {
        try {
            console.log(data.context);
            switch (data.context) {
                case _context:
                    switchToViewer();                    
                    return false;
                    break;
            }
        } catch (e) {
            logError("FetchTechMapping : SaveAction", e);
        }
    }

    function localAction(data) {
        try {
            console.log(data.context);
            switch (data.context) {
                case _context:
                    switchToEditor(data.uri);
                    return false;
                    break;
            }
        } catch (e) {
            logError("FetchTechMapping : LocalAction", e);
        }
    };
        
    function DeleteRow(event) {
        var selectedrowindex = $("#TechmappingGrid").jqxGrid('getselectedrowindex');
        var rowscount = $("#TechmappingGrid").jqxGrid('getdatainformation').rowscount;
        if (selectedrowindex >= 0 && selectedrowindex < rowscount) {
            var id = $("#TechmappingGrid").jqxGrid('getrowid', selectedrowindex);
            var commit = $("#TechmappingGrid").jqxGrid('deleterow', id);
        }
    }
    

    $(function () {
        $("#addMapping").click(function (event) {
            var rowdata = {
                SourceObject: 'Artifact',
                TargetObject: 'Artifact'
            }
            $("#TechmappingGrid").jqxGrid('addrow', null, rowdata, 'top');
            event.preventDefault();
        });

        $("#CancelButton").click(function (event) {
            amplify.publish("CancelAction", { context: _context + "_close" });
            event.preventDefault();
        });

        $("#SaveButton").click(function (event) {
            amplify.publish("CancelAction", { context: _context });
            event.preventDefault();
        });

        $("#DeleteRow").click(function (event) {
            console.log(event);
            event.preventDefault();
        });

        var rowEdit = function (row) {            
            var datarow = $("#TechmappingGrid").jqxGrid('getrowdata', row);
            console.log(datarow);
            var sourceObject = datarow.SourceObject ? datarow.SourceObject : '';
            var targetObject = datarow.TargetObject ? datarow.TargetObject : '';         
            if (sourceObject.toLowerCase() != 'artifact' || targetObject.toLowerCase() != 'artifact') return false;
        }
        

        artifactSource =
            {
                datatype: "json",
                url: '/api/fusion/fusionowningartifacts',
                datafields: [
                    { name: 'Name', type: 'string' },
                    { name: 'ID', type: 'number' }
                ]                
            };
        artifactAdapter = new $.jqx.dataAdapter(artifactSource, {
            autoBind: true
        });
        

        gridSource =
        {
          //  localdata: data,
            dataType: 'json',
            url: '/api/fusion/technicalmapping',            
            datafields:
            [
                { name: 'Transformation', type: 'string' },
                { name: 'SourceObjectName', type: 'string' },
                { name: 'SourceObject', type: 'string' },
                { name: 'SourceObjectID', type: 'number' },                
                { name: 'SourceFusionAttributeTextPath', type: 'string' },
                { name: 'TargetObjectName', type: 'string' },
                { name: 'TargetObject', type: 'string' },
                { name: 'TargetObjectID', type: 'number' },
                { name: 'MapRuleItemID', type: 'number' },
                { name: 'TargetFusionAttributeTextPath', type: 'string' },
                { name: 'MapID', type: 'number' }                
            ]
        };
        gridDataAdapter = new $.jqx.dataAdapter(gridSource);
        // initialize jqxGrid
        $("#TechmappingGrid").jqxGrid(
        {
            width: grid_width,
            source: gridDataAdapter,
            columnsresize: true,
            pageable: true,
            pagerButtonsCount: 10,
            altRows: true,
            filterable: true,
            pagerMode: 'advanced',            
            filterMode: 'simple',         
            theme: list_theme,
            selectionmode: 'singlerow',            
            columns: [
                { text: 'Transformation', datafield: 'Transformation', columntype: 'textbox', width: '20%' },
                //{ text: 'Group Key', datafield: 'MapID', width: '5%' },
              {
                  text: 'Source Object', columntype: 'combobox', displayfield:'SourceObjectName', datafield: 'SourceObjectID', width: '20%', cellbeginedit: rowEdit,
                  createeditor: function (row, value, editor) {
                        editor.jqxComboBox({ source: artifactAdapter, displayMember: 'Name', valueMember: 'ID' });
                  }
              },
              { text: 'Source Fusion Attribute Textpath', datafield: 'SourceFusionAttributeTextPath', columntype: 'textbox', width: '20%' },
              {
                  text: 'Target Object', columntype: 'combobox', displayfield: 'TargetObjectName', datafield: 'TargetObjectID', width: '15%', cellbeginedit: rowEdit,
                  createeditor: function (row, value, editor) {
                      editor.jqxComboBox({ source: artifactAdapter, displayMember: 'Name', valueMember: 'ID' });
                  }
              },
              { text: 'Target Fusion Attribute Textpath', datafield: 'TargetFusionAttributeTextPath', columntype: 'textbox', width: '20%' },              
              {
                  text: '', dataField: '', width: '5%', filterable: false, editable : false,
                  cellsRenderer: function (index, datafield, value, defaultvalue, column, data){                      
                      var tools = [{ title: 'Remove technical mapping', icon: 'trash-o', urlprefix: 'form/deletetechnicalmapping?id=' + data.MapRuleItemID }];
                      
                      return renderToolsHtml(value, tools, _context, data);                      
                  }
              }
            ]
        });
    
        var tools = [{ icon: 'plus', uri: "/form/AddTechnicalMapping", context: _context, title: 'Add technical mapping' }];
        
        TileTools('#TechMappingTools', tools);

        amplify.subscribe('CancelAction', cancelAction, 1);
        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
        amplify.subscribe('SaveAction', saveAction, 1);
        amplify.subscribe('ToolAction', localAction, 1);


        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
