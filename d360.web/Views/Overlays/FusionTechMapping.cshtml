<div class="large-overlay">
    <div class="ui segment" id="HistoryViewer">                
            <div class="left form-header-info">
                <h4>Technical Mappings</h4>
            </div>
            <div class="clear"></div>
            <div class="form-instructions"></div>
            <div class="row">
                <div class="col s12">
                    <div class="root-tile">
                        <header>
                            <div id="TechMappingTools" class="TileTools"></div>
                        </header>
                        <div id="TechmappingGrid"></div>
                    </div>
                </div>
            </div>
        </div>            
    <div id="HistoryEditor"></div>
</div>


<script type="text/javascript">    
    var _context = "FusionTechnicalMapping";    
    var gridSource;
    var gridDataAdapter;

    var switchToViewer = function () {
        $('#HistoryEditor').html('');
        $('#HistoryEditor').fadeOut(1);
        $('#HistoryViewer').fadeIn(500);
        console.log("refreshing grid");
        $('#TechmappingGrid').jqxGrid('updatebounddata');
    }

    var switchToEditor = function (uri) {
        try {
            $('#HistoryViewer').fadeOut(10);
            $('#HistoryEditor').fadeIn(10);
            $('#HistoryEditor').load(uri, function (response, status, xhr) {
                if (status == "error") {
                    amplify.publish("ShowMessage", { title: "Something unexpected happened!", message: xhr.status + ' ' + xhr.statusText, type: 'error' });
                    switchToViewer();
                }
            });
        } catch (e) {

        }
    }
        
    function unsubscribe() {        
        gridSource = null;
        gridDataAdapter = null;

        $('#addMapping').off('click');
        $('#CancelButton').off('click');
        $('#SaveButton').off('click');
        $('#DeleteRow').off('click');

        amplify.unsubscribe('ToolAction', localAction);
        amplify.unsubscribe(AmplifyActions.Unsubscribe, unsubscribe);
    }

    function cancelAction(data) {
        try {
            switch (data.context) {
                case contextList.MapRule:
                case contextList.MapRuleItem:
                    switchToViewer();                    
                    return false;
                    break;
            }
        } catch (e) {
            logError("FetchTechMapping : CancelAction", e);
        }
    }
        
    function saveAction(data) {
        try {
            switch (data.context) {
                case contextList.MapRule:
                case contextList.MapRuleItem:
                    switchToViewer();
                    $("#TechmappingGrid").jqxTreeGrid('updateBoundData');
                    return false;
                    break;
            }
        } catch (e) {
            logError("FetchTechMapping : SaveAction", e);
        }
    }

    function localAction(data) {
        try {
            switch (data.context) {
                case contextList.MapRule:
                case contextList.MapRuleItem:
                    switchToEditor(data.uri);
                    return false;
                    break;
            }
        } catch (e) {
            logError("FetchTechMapping : LocalAction", e);
        }
    };
        
    function DeleteRow(event) {
        var selectedrowindex = $("#TechmappingGrid").jqxGrid('getselectedrowindex');
        var rowscount = $("#TechmappingGrid").jqxGrid('getdatainformation').rowscount;
        if (selectedrowindex >= 0 && selectedrowindex < rowscount) {
            var id = $("#TechmappingGrid").jqxGrid('getrowid', selectedrowindex);
            var commit = $("#TechmappingGrid").jqxGrid('deleterow', id);
        }
    }

    $(function () {
        var permissions = new PermissionsModel();

        var loadAfterPermissionsRetrieved = function () {

            $("#addMapping").click(function (event) {
                var rowdata = {
                    SourceObject: 'Artifact',
                    TargetObject: 'Artifact'
                }
                $("#TechmappingGrid").jqxGrid('addrow', null, rowdata, 'top');
                event.preventDefault();
            });

            gridSource = {
                dataType: 'json',
                url: '/api/fusion/technicalmapping',
                datafields: [
                    { name: 'Type', type: 'string' },
                    { name: 'ID', type: 'number' },
                    { name: 'TextID', type: 'string' },
                    { name: 'ParentTextID', type: 'string' },

                    { name: 'Transformation', type: 'string' },

                    { name: 'SourceFusion', type: 'string' },
                    { name: 'SourceFusionAttributeID', type: 'number' },
                    { name: 'SourceObjectName', type: 'string' },
                    { name: 'SourceObject', type: 'string' },
                    { name: 'SourceObjectID', type: 'number' },
                    { name: 'SourceFusionAttributeTextPath', type: 'string' },

                    { name: 'TargetFusion', type: 'string' },
                    { name: 'TargetFusionAttributeID', type: 'number' },
                    { name: 'TargetObjectName', type: 'string' },
                    { name: 'TargetObject', type: 'string' },
                    { name: 'TargetObjectID', type: 'number' },
                    { name: 'TargetFusionAttributeTextPath', type: 'string' }
                ],
                hierarchy: {
                    keyDataField: { name: 'TextID' },
                    parentDataField: { name: 'ParentTextID' }
                },
            };

            gridDataAdapter = new $.jqx.dataAdapter(gridSource);

            $("#TechmappingGrid").jqxTreeGrid({
                width: grid_width,
                source: gridDataAdapter,
                filterable: true,
                theme: theme,
                altRows: true,
                columns: [
                    {
                        text: 'Group',
                        dataField: 'ID',
                        width: '4%',
                        cellsRenderer: function (row, column, value, data) {
                            if (data.Type == "MapRule") {
                                if (data.ID > 0)
                                    return data.ID;
                                else
                                    return "NONE";
                            }
                            else {
                                return "";
                            }
                        }
                    },
                    { text: 'Transformation', dataField: 'Transformation', columntype: 'textbox', width: '16%' },

                    { text: 'Source Object', columntype: 'combobox', dataField: 'SourceObjectName', datafield: 'SourceObjectID', width: '10%' },
                    { text: 'Source Configuration', columntype: 'combobox', dataField: 'SourceFusion', width: '10%' },
                    { text: 'Source Attribute', dataField: 'SourceFusionAttributeTextPath', columntype: 'textbox' },

                    { text: 'Target Object', columntype: 'combobox', dataField: 'TargetObjectName', datafield: 'TargetObjectID', width: '10%' },
                    { text: 'Target Configuration', columntype: 'combobox', dataField: 'TargetFusion', width: '10%' },
                    { text: 'Target Attribute', dataField: 'TargetFusionAttributeTextPath', columntype: 'textbox' },

                    {
                        text: '',
                        dataField: '',
                        width: '120px',
                        filterable: false,
                        editable: false,
                        cellsRenderer: function (row, column, value, data) {
                            var tools = [];

                            if (data.Type == "MapRule") {
                                if (data.ID > 0) {
                                    if (permissions.HasPermission("Root", "Create")) {
                                        tools.push({ icon: 'plus', urlprefix: '/form/AddMapRuleItem?id=' + data.ID, title: 'Add rule item' });
                                    }
                                    if (permissions.HasPermission("Root", "Update")) {
                                        tools.push({ icon: 'pencil', urlprefix: '/form/EditMapRule?id=' + data.ID, title: 'Edit rule' });
                                    }
                                    if (permissions.HasPermission("Root", "Delete")) {
                                        tools.push({ icon: 'trash-o', urlprefix: 'form/DeleteMapRule?id=' + data.ID, title: 'Remove rule' });
                                    }

                                    return renderToolsHtml(value, tools, contextList.MapRule, data);
                                }
                            }
                            else {
                                if (permissions.HasPermission("Root", "Update")) {
                                    tools.push({ icon: 'pencil', urlprefix: '/form/EditMapRuleItem?id=' + data.ID, title: 'Edit rule item' });
                                }
                                if (permissions.HasPermission("Root", "Delete")) {
                                    tools.push({ icon: 'trash-o', urlprefix: 'form/DeleteMapRuleItem?id=' + data.ID, title: 'Remove rule item' });
                                }

                                return renderToolsHtml(value, tools, contextList.MapRuleItem, data);
                            }

                            return "";
                        }
                    }
                ]
            });

            var tools = [];
            if (permissions.HasPermission("Root", "Create")) {
                tools.push({ icon: 'plus', uri: "/form/AddMapRule", context: contextList.MapRule, title: 'Add rule' });
            }
            TileTools('#TechMappingTools', tools);

            amplify.subscribe('CancelAction', cancelAction, 1);
            amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
            amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
            amplify.subscribe('SaveAction', saveAction, 1);
            amplify.subscribe('ToolAction', localAction, 1);
        }

        permissions.GetPermissionsForObject('FusionType', 0).then(loadAfterPermissionsRetrieved);

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
