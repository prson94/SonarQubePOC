@model d360.core.entities.ObjectModel
<div class="medium-overlay">
    <div class="ui segment">
        <h4 id="OverlayTitle">Score History</h4>
        <div class="form-instructions"></div>
        <div class="row">
            <div class="col s6">
                <h2>Score History</h2>
                <div id="HistoryChart" style="width: 100%; height: 400px;"></div>
            </div>
            <div class="col s6">
                <h2>Point Breakdown</h2>
                <div id="BreakdownGrid" class="tile"></div>
                <div style="float: left; width:49%; text-align: center; vertical-align: middle">
                    <div id="AverageScore" style="height: 150px; width: 100%"></div>
                </div>
                <div style="float: right; width:49%; text-align: center; vertical-align: middle">
                    <div id="ObjectScore" style="height: 150px; width: 100%"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var PointBreakdownByObjectUrl = '/queries/@(Model.ObjectType)/@(Model.ObjectID)/PointBreakdownByObject';
    var ScoreHistoryByObjectUrl = '/queries/@(Model.ObjectType)/@(Model.ObjectID)/ScoreHistoryByObject';
    var DetailUrl = '/queries/@(Model.ObjectType)/@(Model.ObjectID)/AverageScoreByObjectType';

    function unsubscribe() {

    }

    $(function () {

        $.getJSON(DetailUrl, function (data) {
            $('#OverlayTitle').text("Score History for " + data.ObjectName);

            drawKpi('#AverageScore', "Average Score", data.AverageScore, 100 - data.AverageScore, true); //"Average Score for " + data.ObjectTypeName + "(s)"

            drawKpi('#ObjectScore', "Score", data.ObjectScore, 100 - data.ObjectScore, true); //Score for " + data.ObjectName
        });

        //#region Chart

        var baseUnit = 'day';
        var tickInterval = 3;

        var source = {
            datatype: "json",
            datafields: [
                { name: 'Date' },
                { name: 'Score' }
            ],
            url: ScoreHistoryByObjectUrl
        };
        var dataAdapter = new $.jqx.dataAdapter(source);
        try {
            $('#HistoryChart').jqxChart({
                title: "",
                description: "",
                showBorderLine: false,
                enableAnimations: true,
                showLegend: true,
                padding: { left: 15, top: 5, right: 20, bottom: 5 },
                titlePadding: { left: 10, top: 0, right: 0, bottom: 10 },
                source: dataAdapter,
                colorScheme: 'scheme05',
                xAxis: {
                    textRotationAngle: 60,
                    dataField: 'Date',
                    //formatFunction: function (value) {
                    //    return months[value.getMonth()] + '\'' + value.getFullYear().toString().substring(2);
                    //},
                    //toolTipFormatFunction: function (value) {
                    //    return value.getDate() + '-' + months[value.getMonth()];
                    //},
                    //minValue: '01-01-2011',
                    //maxValue: '01-01-2012',
                    type: 'date',
                    baseUnit: baseUnit,
                    showTickMarks: true,
                    tickMarksInterval: 3,
                    tickMarksColor: '#888888',
                    unitInterval: 10,
                    showGridLines: true,
                    gridLinesInterval: 1,
                    gridLinesColor: '#ebebeb',
                    valuesOnTicks: true
                },
                seriesGroups: [
                    {
                        alignEndPointsWithIntervals: false,
                        type: 'splinearea',
                        valueAxis:
                        {
                            visible: true,
                            unitInterval: 20,
                            maxValue: 100,
                            description: 'Governance Score'
                        },
                        series: [
                                { dataField: 'Score', displayText: 'Score', opacity: 0.7 },
                        ]
                    }
                ]
            });
        } catch (e) {

        }


        //#endregion

        //#region Grid

        var BreakdownGridSource = {
            datatype: "json",
            type: 'get',
            datafields: [
                { name: 'Name' },
                { name: 'MaxScore' },
                { name: 'Score' }
            ],
            url: PointBreakdownByObjectUrl
        };

        BreakdownGridAdapter = new $.jqx.dataAdapter(BreakdownGridSource);

        try {
            $('#BreakdownGrid').jqxGrid({
                altrows: true,
                selectionmode: 'none',
                source: BreakdownGridAdapter,
                width: '100%',
                autoheight: true,
                pagesizeoptions: ['5', '10', '20'],
                pagesize: 10,
                sortable: true,
                pageable: false,
                theme: list_theme,
                columns: [
                    { datafield: "Name", text: "Analytic" },
                    {
                        datafield: "Score",
                        text: "Score",
                        cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                            return "<div style='overflow: hidden; text-overflow: ellipsis; padding-bottom: 2px; text-align: left; margin-right: 2px; margin-left: 4px; margin-top: 4px;'>" + data.Score + " out of <b>" + data.MaxScore + "</b> points.</div>";
                        }
                    }
                ]
            });
        } catch (e) {

        }

        //#endregion

        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
