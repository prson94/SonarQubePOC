@{
    Layout = "~/Views/Shared/Diagram.cshtml";
}
<div id="zoomBtn">
    <input class="zoomBtn" rel="out" type="button" value="-" />
    <input class="zoomBtn" rel="in" type="button" value="+" />
    <input class="zoomBtn" rel="reset" type="button" value="reset" />
</div>
<div id="CatalogDiagram"></div>
<script type="text/javascript">
    information_catalog_diagram('#CatalogDiagram', @(ViewData["ID"]));
</script>
