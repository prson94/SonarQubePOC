<div class="small-overlay">
    <div class="ui segment">
        <h4>Model Classifications</h4>
        <div class="form-instructions"></div>
        <div id="ClassViewer" class="root-tile">
            <header><div id="ClassOverlayGridTools"></div></header>
            <div id="ClassOverlayGrid"></div>
        </div>
        <div id="ClassEditor"></div>
    </div>
</div>


<script type="text/javascript">
    var _context = "@(ContextList.TaxonomyTypeClass)";
    var ClassOverlayGridSource;
    var ClassOverlayGridAdapter;

    var switchToViewer = function () {
        $('#ClassEditor').html('');
        $('#ClassEditor').fadeOut(1);
        $('#ClassViewer').fadeIn(500);
    }

    var switchToEditor = function (uri) {
        try {
            $('#ClassViewer').fadeOut(10);
            $('#ClassEditor').fadeIn(10);
            $('#ClassEditor').load(uri, function (response, status, xhr) {
                if (status == "error") {
                    amplify.publish("ShowMessage", { title: "Something unexpected happened!", message: xhr.status + ' ' + xhr.statusText, type: 'error' });
                    switchToViewer();
                }
            });
        } catch (e) {

        }
    }

    function cancelAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToViewer();
                    $('#ClassOverlayGrid').jqxGrid('updatebounddata');
                    break;
            }
        } catch (e) {
            logError("TaxonomyTypeClassesOverlay : CancelAction", e);
        }
    }

    function localAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToEditor(data.uri);
                    break;
            }
        } catch (e) {
            logError("TaxonomyTypeClassesOverlay : LocalAction", e);
        }
    };

    function saveAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToViewer();
                    $('#ClassOverlayGrid').jqxGrid('updatebounddata');
                    break;
            }
        } catch (e) {
            logError("TaxonomyTypeClassesOverlay : SaveAction", e);
        }
    }

    function unsubscribe() {
        ClassOverlayGridAdapter = null;
        ClassOverlayGridSource = null;

        amplify.unsubscribe('CancelAction', cancelAction);
        amplify.unsubscribe('SaveAction', saveAction);
        amplify.unsubscribe('ToolAction', localAction);
        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.unsubscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
    }

    $(function () {
        var permissions = new PermissionsModel();

        var loadAfterPermissionsRetrieved = function () {

            var tools = [];
            if (permissions.HasPermission("Root", "Create")) {
                tools.push({ icon: 'plus', uri: '/form/AddTaxonomyTypeClass', context: _context, title: 'Add model Class' });
            }
            TileTools('#ClassOverlayGridTools', tools);

            //#region Grid

            ClassOverlayGridSource = {
                datatype: "json",
                type: 'get',
                datafields: [
                    { name: 'Name' },
                    { name: 'ID' }
                ],
                url: '/api/TaxonomyTypeClasses?$orderby=Name'
            };

            ClassOverlayGridAdapter = new $.jqx.dataAdapter(ClassOverlayGridSource);

            $('#ClassOverlayGrid').jqxGrid({
                altrows: true,
                source: ClassOverlayGridAdapter,
                width: overlay_grid_width,
                autoheight: true,
                autorowheight: true,
                pagesizeoptions: ['10', '20', '50'],
                pagesize: 20,
                filterable: true,
                showfilterrow: true,
                sortable: true,
                pageable: false,
                theme: list_theme,
                columns: [
                    { datafield: "Name", text: "Name" },
                    {
                        filterable: false, sortable: false, width: '80px',
                        datafield: "ID", text: "",
                        cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                            var tools = [];

                            if (permissions.HasPermission("Root", "Update")) {
                                tools.push({ icon: 'pencil', urlprefix: '/form/EditTaxonomyTypeClass?id={0}', title: 'Edit model class' });
                            }
                            if (permissions.HasPermission("Root", "Delete")) {
                                tools.push({ icon: 'trash-o', urlprefix: '/form/DeleteTaxonomyTypeClass?id={0}', title: 'Remove model class' });
                            }

                            return renderToolsHtml(value, tools, _context, data);
                        }
                    }
                ]
            });

            //#endregion

            amplify.subscribe('CancelAction', cancelAction);
            amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
            amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
            amplify.subscribe('SaveAction', saveAction);
            amplify.subscribe('ToolAction', localAction);
        }

        permissions.GetPermissionsForObject('TaxonomyTypeClass', 0).then(loadAfterPermissionsRetrieved);

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
