<div class="small-overlay">
    <div class="ui segment">
        <h4>Synchronization Filters</h4>
        <div class="form-instructions"></div>
        <div id="FiltersViewer" class="root-tile">
            <header><div id="FiltersOverlayGridTools"></div></header>
            <div id="FiltersOverlayGrid"></div>
        </div>
        <div id="FiltersEditor"></div>
    </div>
</div>

<script type="text/javascript">
    var fusionTypeID = "@(ViewBag.FusionTypeID)";
    var fusionID = "@(ViewBag.FusionID)";
    var _context = "@(ContextList.FusionFilter)";
    var FiltersOverlayGridSource;
    var FiltersOverlayGridAdapter;

    var switchToViewer = function () {
        $('#FiltersEditor').html('');
        $('#FiltersEditor').fadeOut(1);
        $('#FiltersViewer').fadeIn(500);
    }

    var switchToEditor = function (uri) {
        try {
            $('#FiltersViewer').fadeOut(10);
            $('#FiltersEditor').fadeIn(10);
            $('#FiltersEditor').load(uri, function (response, status, xhr) {
                if (status == "error") {
                    amplify.publish("ShowMessage", { title: "Something unexpected happened!", message: xhr.status + ' ' + xhr.statusText, type: 'error' });
                    switchToViewer();
                }
            });
        } catch (e) {

        }
    }

    function cancelAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToViewer();
                    $('#FiltersOverlayGrid').jqxGrid('updatebounddata');
                    break;
            }
        } catch (e) {
            logError("FusionConfigurationFiltersOverlay : CancelAction", e);
        }
    }

    function localAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToEditor(data.uri);
                    break;
            }
        } catch (e) {
            logError("FusionConfigurationFiltersOverlay : LocalAction", e);
        }
    };

    function saveAction(data) {
        try {
            switch (data.context) {
                case _context:
                    switchToViewer();
                    $('#FiltersOverlayGrid').jqxGrid('updatebounddata');
                    break;
            }
        } catch (e) {
            logError("FusionConfigurationFiltersOverlay : SaveAction", e);
        }
    }

    function unsubscribe() {
        FiltersOverlayGridAdapter = null;
        FiltersOverlayGridSource = null;

        amplify.unsubscribe('CancelAction', cancelAction);
        amplify.unsubscribe('SaveAction', saveAction);
        amplify.unsubscribe('ToolAction', localAction);
        amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
        amplify.unsubscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
    }

    $(function () {
        var permissions = new PermissionsModel();

        var loadAfterPermissionsRetrieved = function () {

            var tools = [];
            if (permissions.HasPermission("Root", "Create")) {
                tools.push({ icon: 'plus', uri: '/form/AddFusionFilter?f=' + fusionID, context: _context, title: 'Add synchronization filter' });
            }
            TileTools('#FiltersOverlayGridTools', tools);

            //#region Grid

            FiltersOverlayGridSource = {
                datatype: 'json',
                url: '/api/fusion/' + fusionTypeID + '/configurations/' + fusionID + '/filters',
                datafields: [
                    { name: "FusionID", type: "number" },
                    { name: "FusionAttributeTypeID", type: "number" },
                    { name: "Name", type: "string" },
                    { name: "Filter", type: "string" }
                ]
            };

            FiltersOverlayGridAdapter = new $.jqx.dataAdapter(FiltersOverlayGridSource);

            $('#FiltersOverlayGrid').jqxGrid({
                altrows: true,
                source: FiltersOverlayGridAdapter,
                width: overlay_grid_width,
                autoheight: true,
                autorowheight: true,
                pagesizeoptions: ['10', '20', '50'],
                pagesize: 20,
                filterable: true,
                showfilterrow: true,
                sortable: true,
                pageable: false,
                theme: list_theme,
                columns: [
                    { text: 'Name', datafield: 'Name' },
                    { text: 'Filter', datafield: 'Filter' },
                    {
                        text: '',
                        dataField: 'FusionID',
                        width: '80px',
                        cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                            var tools = [
                                { icon: 'pencil', urlprefix: '/form/EditFusionFilter?f=' + data.FusionID + '&a=' + data.FusionAttributeTypeID },
                                { icon: 'trash-o', urlprefix: '/form/DeleteFusionFilter?f=' + data.FusionID + '&a=' + data.FusionAttributeTypeID }
                            ];
                            return renderToolsHtml(value, tools, _context, data);
                        }
                    }
                ]
            });

            //#endregion

            amplify.subscribe('CancelAction', cancelAction);
            amplify.subscribe(AmplifyActions.Unsubscribe, unsubscribe);
            amplify.subscribe(AmplifyActions.OverlayUnsubscribe, unsubscribe);
            amplify.subscribe('SaveAction', saveAction);
            amplify.subscribe('ToolAction', localAction);
        }

        permissions.GetPermissionsForObject('Fusion', fusionID).then(loadAfterPermissionsRetrieved);

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
