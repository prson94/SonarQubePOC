@model d360.core.entities.ObjectModel
<div class="large-overlay">
    <div class="ui segment">
        <h4>Execution Details</h4>
        <div class="form-instructions"></div>
        <div class="row">
            <div class="col s12">
                <div id="OverlayDetail"></div>
            </div>
        </div>

        <div class="tile tile-detail">
            <header>Results</header>
            <div id="ResultsTile"></div>
        </div>

        <div class="tile tile-detail">
            <header>Errors</header>
            <div id="ErrorsTile"></div>
        </div>
    </div>
</div>


<script type="text/javascript">
    var overDetailType = '@(Model.ObjectType)';
    var overDetailID = @(Model.ObjectID);

    $(function () {
        
        $("html, body").animate({ scrollTop: 0 }, "slow");
        
        ObjectDetail('OverlayDetail', overDetailType, overDetailID);

        //#region ResultsTile Configuration

        var ResultsTileSource = {
            datatype: 'json',
            url: '/services/fusion/executions/' + overDetailID + '/results',//results?$filter=ExecutionID eq ' + overDetailID,
            datafields: [
                { name: "ID" },
                { name: "FusionAttribute", type: "string" },
                { name: "FusionAttributeType", type: "string" },
                { name: "ExecutionID", type: "number" },
                { name: "FusionAttributeID", type: "number" },
                { name: "Body", type: "string" },
                { name: "FieldTypeID", type: "number" },
                { name: "FieldName", type: "string" },
                { name: "Action", type: "string" },
                { name: "OldValue", type: "string" },
                { name: "NewValue", type: "string" },
                { name: "FusionID", type: "number" },
                { name: "Fusion", type: "string" },
                { name: "FusionTypeID", type: "number" },
                { name: "FusionType", type: "string" }
            ],
            beforeprocessing: function (data) {
                this.totalrecords = data.total;
            },
            filter: function () {
                $("#ResultsTile").jqxGrid('updatebounddata');
            },
            sort: function () {
                $("#ResultsTile").jqxGrid('updatebounddata');
            }
        };

        var ResultsTileAdapter = new $.jqx.dataAdapter(ResultsTileSource);

        $("#ResultsTile").jqxGrid({
            altrows: true,
            width: grid_width,
            autorowheight: true,
            autoheight: true,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            pageable: true,
            pagesizeoptions: ['5', '10', '20'],
            pagesize: 5,
            virtualmode: true,
            rendergridrows: function() {
                return ResultsTileAdapter.records; 
            },
            autorowheight: true,
            columnsresize: true,
            source: ResultsTileAdapter,
            theme: list_theme,
            groupable: false,
            columns: [
                { text: 'Type', datafield: 'FusionAttributeType', filtertype: 'list', width: '20%' },
                { text: 'Attribute', datafield: 'FusionAttribute', width: '30%' },
                { text: 'Action', datafield: 'Action', filtertype: 'list', width: '10%' },
                { text: 'Field', datafield: 'FieldName', width: '14%', filtertype: 'list' },
                { text: 'Old Value', datafield: 'OldValue', width: '13%' },
                { text: 'New Value', datafield: 'NewValue', width: '13%' }
            ]
        });

        //#endregion

        //#region ErrorsTile Configuration

        var ErrorsTileSource = {
            datatype: 'json',
            url: '/services/fusion/executionerrors?$filter=ExecutionID eq ' + overDetailID,
            datafields: [
                { name: "Date", type: "date" },
                { name: "Error", type: "string" }
            ]
        };

        var ErrorsTileAdapter = new $.jqx.dataAdapter(ErrorsTileSource);

        $("#ErrorsTile").jqxGrid({
            altrows: true,
            width: grid_width,
            autoheight: true,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            pageable: true,
            pagesizeoptions: ['5', '10', '20'],
            pagesize: 5,
            autorowheight: true,
            columnsresize: true,
            source: ErrorsTileAdapter,
            theme: list_theme,
            groupable: false,
            columns: [
                { text: 'Date', datafield: 'Date', cellsformat: 'MM/dd/yy HH:mm:ss', filtertype: 'range', width: '25%' },
                { text: 'Message', datafield: 'Error' }
            ]
        });

        //#endregion
    });
</script>
