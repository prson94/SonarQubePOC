<style type="text/css" media="screen">
    #Log {
        width: 100%;
        height: 400px;
    }
</style>
<div class="medium-overlay">
    <div class="ui segment">
        <h4>Fusion Processing Errors</h4>
        <div class="form-instructions"></div>
        <div id="FusionProcessErrorsGrid"></div>
    </div>
</div>


<script type="text/javascript">
    //var logFileUrl = "@(ViewBag.LogFileUrl)";
    var id = "@(ViewBag.ID)";
    $(function () {
        var FusionProcessErrorsGridSource;
        var FusionProcessErrorsGridAdapter;

        FusionProcessErrorsGridSource = {
            datatype: 'json',
            url: '/services/fusion/executionerrors?$top=100&$orderby=Date desc',
            datafields: [
                { name: "FusionID", type: "number" },
                { name: "FusionType", type: "string" },
                { name: "Fusion", type: "string" },
                { name: "Date", type: "date" },
                { name: "ExecutionID", type: "number" },
                { name: "Error", type: "string" }
            ]
        };

        FusionProcessErrorsGridAdapter = new $.jqx.dataAdapter(FusionProcessErrorsGridSource);

        $("#FusionProcessErrorsGrid").jqxGrid({
            altrows: true,
            width: grid_width,
            autoheight: true,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            pageable: true,
            pagesizeoptions: ['5', '10', '20'],
            pagesize: 10,
            columnsresize: true,
            source: FusionProcessErrorsGridAdapter,
            theme: list_theme,
            groupable: false,
            columns: [
                { text: 'ID', datafield: 'ExecutionID', width: '3%' },
                { text: 'Error', datafield: 'Error', width: '47%' },
                { text: 'Type', datafield: 'FusionType', filtertype: 'checkedlist', width: '15%' },
                { text: 'Configuration', datafield: 'Fusion', filtertype: 'checkedlist', width: '20%' },
                { text: 'Date', datafield: 'Date', cellsformat: 'MM/dd/yy h:mm:ss tt', filtertype: 'range', width: '15%' }                
            ]
        });

        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
