<div class="medium-overlay">
    <div class="ui segment">
        <h4>Fusion Agent Errors</h4>
        <div class="form-instructions"></div>
        <div id="AgentErrorsGrid"></div>
    </div>
</div>


<script type="text/javascript">    
    var id = "@(ViewBag.ID)";
    $(function () {

        var AgentErrorsGridSource;
        var AgentErrorsGridAdapter;
        
        AgentErrorsGridSource = {
            datatype: 'json',
            url: '/services/fusion/agenterrors?$top=100&$orderby=Date desc',
            datafields: [
                { name: "FusionID", type: "number" },
                { name: "FusionType", type: "string" },
                { name: "Fusion", type: "string" },
                { name: "Date", type: "date" },                
                { name: "MachineName", type: "string" },                
                { name: "Message", type: "string" }
            ]
        };

        AgentErrorsGridAdapter = new $.jqx.dataAdapter(AgentErrorsGridSource);

        $("#AgentErrorsGrid").jqxGrid({
            altrows: true,
            width: grid_width,
            autoheight: true,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            pageable: true,
            pagesizeoptions: ['5', '10', '20'],
            pagesize: 10,
            columnsresize: true,
            source: AgentErrorsGridAdapter,
            theme: list_theme,
            groupable: false,
            columns: [                
                { text: 'Error', datafield: 'Message', width: '35%' },
                { text: 'Type', datafield: 'FusionType', filtertype: 'checkedlist', width: '15%' },
                { text: 'Configuration', datafield: 'Fusion', filtertype: 'checkedlist', width: '20%' },
                { text: 'Date', datafield: 'Date', cellsformat: 'MM/dd/yy h:mm:ss tt', filtertype: 'range', width: '15%' },                
                { text: 'Host', datafield: 'MachineName', filtertype: 'checkedlist', width: '15%' }
            ]
        });
        
        $("html, body").animate({ scrollTop: 0 }, "slow");
    });
</script>
