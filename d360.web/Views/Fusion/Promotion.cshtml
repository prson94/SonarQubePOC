<div class="small-overlay">
    <div class="ui segment">
        <h4 id="FusionPromotionOverlayTitle">Promotion Rules</h4>
        <div class="form-instructions"></div>
        <div id="PrGrid"></div>
    </div>
</div>
<script type="text/javascript">
    var prGridUri = "/api/fusion/@(ViewData["FusionTypeID"])/configurations/@(ViewData["FusionID"])/promotion";

    $(function () {

        var PrSource = {
            datatype: 'json',
            url: prGridUri,
            datafields: [
                { name: "ID", type: "number" },
                { name: "ObjectType", type: "string" },
                { name: "ObjectID", type: "number" },
                { name: "ObjectName", type: "string" },
                { name: "ParentObjectType", type: "string" },
                { name: "ParentObjectID", type: "number" },
                { name: "ParentName", type: "string" },
                { name: "PromotionObjectType", type: "string" },
                { name: "PromotionObjectID", type: "number" },
                { name: "PromotionName", type: "string" },
                { name: "PromotionParentObjectType", type: "string" },
                { name: "PromotionParentObjectID", type: "number" },
                { name: "PromotionParentName", type: "string" }
            ]
        };
        var PrAdapter = new $.jqx.dataAdapter(PrSource);
        $("#PrGrid").jqxGrid({
            altrows: true,
            source: PrAdapter,
            theme: theme,
            autoheight: true,
            width: grid_width,
            showfilterrow: false,
            filterable: false,
            selectionmode: 'singlerow',
            scrollmode: 'logical',
            sortable: true,
            pageable: false,
            pagerMode: 'advanced',
            columns: [
                {
                    text: 'Description',
                    dataField: 'ObjectName',
                    cellsrenderer: function (index, datafield, value, defaultvalue, column, data) {
                        var html = '';
                        html += 'Promoting ' + data.ObjectName;
                        if (data.ParentName) {
                            html += 'under ' + data.ParentName;
                        }
                        html += ' to a ' + data.PromotionName;
                        if (data.PromotionParentName) {
                            html += ', under ' + data.PromotionParentName;
                        }
                        html += '.';
                        return html;
                    }
                }
            ]
        });

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case contextList.FusionPromotionRule:
                        $('#PrGrid').jqxGrid('updatebounddata');
                        break;
                }
            } catch (e) {
                logError("Promotion", e);
            }
        });
    });
</script>
