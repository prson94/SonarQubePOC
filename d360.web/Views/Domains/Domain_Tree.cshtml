@model d360.web.Models.DomainsListViewModel
<ul>
@foreach (var itm in Model.Groups)
{
    <li item-expanded="true" id="DomainGroup|@itm.ID">
        <span class="node" data-context="@ContextList.DomainGroup" data-id="DomainGroup|@itm.ID">@itm.Name</span>
        @if (Model.Lists.Any(i => i.DomainGroupID == itm.ID))
        {
            <ul>
                @foreach (var l in Model.Lists.Where(i => i.DomainGroupID == itm.ID))
                {
                    <li id="Domain|@l.ID"><span class="node" data-context="@ContextList.Domain" data-id="Domain|@l.ID">@l.Name</span></li>
                }
            </ul>
        }
    </li>
} 
    <li item-expanded="true" id="DomainGroup|0">
        <span class="node" data-context="@ContextList.DomainGroup" data-id="DomainGroup|0">Unallocated Lists</span>
        @if (Model.Lists.Any(i => !i.DomainGroupID.HasValue))
        {
            <ul>
                @foreach (var l in Model.Lists.Where(i => !i.DomainGroupID.HasValue))
                {
                    <li id="Domain|@l.ID"><span class="node" data-context="@ContextList.Domain" data-id="Domain|@l.ID">@l.Name</span></li>
                }
            </ul>
        }
    </li>        
</ul>
