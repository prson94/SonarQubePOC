<script type="text/javascript">
    $(document).ready(function () {

        //#region Grid

        var tooltipTemplatesPagingRenderer = function () {
            return renderMinimalPagingHtml($("#TooltipTemplatesGrid"));
        }

        var tooltipTemplatesToolsRenderer = function (index, datafield, value, defaultvalue, column, data) {

            var tools = [
                { icon: 'pencil', urlprefix: '/form/templates/tooltip/{0}/edit' },
                { icon: 'trash-o', urlprefix: '/form/templates/tooltip/{0}/delete' }
            ];

            return renderToolsHtml(value, tools, '@ContextList.TooltipTemplate');
        }

        var srcTooltipTemplatesGrid =
                    {
                        datatype: 'json',
                        url: '/api/templates/tooltip',
                        datafields:
                        [
                            { name: 'ID' },
                            { name: 'Name' },
                            { name: 'Action' },
                            { name: 'Description' }
                        ]
                    };

        var adapterTooltipTemplatesGrid = new $.jqx.dataAdapter(srcTooltipTemplatesGrid);

        $("#TooltipTemplatesGrid").jqxGrid({
            altrows: true,
            width: grid_width,
            autoheight: true,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            pageable: true,
            //pagerrenderer: tooltipTemplatesPagingRenderer,
            //columnresize: true,
            source: adapterTooltipTemplatesGrid,
            theme: list_theme,
            columns: [
                { datafield: "Name", text: "Name", width: 150 },
                { datafield: "Action", text: "Action", width: 100 },
                { datafield: "Description", text: "Description" },
                { text: '', dataField: 'ID', width: 120, cellsrenderer: tooltipTemplatesToolsRenderer }
            ]
        });

        //#endregion

        //#region Event Subscriptions

        $("#TooltipTemplatesGrid").on("rowselect", function (event) {
            try {
                var args = event.args;
                var row = args.rowindex;
                var data = $("#TooltipTemplatesGrid").jqxGrid('getrowdata', row);
                amplify.publish("RowSelectedAction", { context: '@ContextList.TooltipTemplate', id: data.ID, rowdata: data });
            } catch (e) {
                logError("TooltipTemplates : rowSelect", e);
            }
        });

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case "@ContextList.TooltipTemplate":
                        $('#TooltipTemplatesGrid').jqxGrid('updatebounddata');
                        break;
                }
            } catch (e) {
                logError("TooltipTemplates : SaveAction", e);
            }
        });

        //#endregion

    });
</script>
<div id="TooltipTemplatesGrid"></div>