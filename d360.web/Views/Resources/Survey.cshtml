@{
    var name = "Governance";//Resources.PageInfo.Administration_TaxonomyType_Title;
    ViewBag.Title = string.Format("{0} :: {1}", Resources.Section.Administration, name);    
}

@section Scripts {
<script type="text/javascript">
    var context = 'surveyform';
    $(document).ready(function () {

        $("#ContentArea").PageNavigation({ tabCookieName: 'surveySelectedTab', context: context, type: null, id: null, emptymessage: 'Please choose an item in the sidebar.' });
        $('#PageTools').PageTools({ type: 'OwnershipType', id: 0, context: context });

        //#region Grid Logic

        var surveyToolsRenderer = function (index, datafield, value, defaultvalue, column, data) {

            var tools = [
                { icon: 'pencil', urlprefix: '/governance/EditOwnershipType?id={0}' },
                { icon: 'trash-o', urlprefix: '/governance/DeleteOwnershipType?id={0}' }
            ];

            return renderToolsHtml(value, tools, childArtifactContext, data);
        };

        var srcSurveysPart = {
            datatype: 'json',
            url: '/api/ownership/types',
            datafields:
            [
                { name: 'ID' },
                { name: 'Description' },
                { name: 'ResourceAllowed' },
                { name: 'GroupAllowed' }
            ]
        };
        var adapterSurveysPart = new $.jqx.dataAdapter(srcSurveysPart);

        $("#Types").jqxGrid({
            altrows: true,
            width: grid_width,
            autoheight: true,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            source: adapterSurveysPart,
            theme: list_theme,
            columns: [
                { datafield: "Description", text: "Name" },
                { datafield: "ID", text: "", width: 120, cellsrenderer: surveyToolsRenderer }
            ]
        });

        //#endregion

        //#region Event Subscriptions

        amplify.subscribe("RowSelectedAction", function (data) {
            try {
                if (data.context == context) {
                    $('#ContentArea').PageNavigation("reload", 'OwnershipType', data.id);
                    $('#PageTools').PageTools("reload", 'OwnershipType', data.id, context);
                }
            } catch (e) {
                logError("Survey : RowSelectedAction", e);
            }
        });

        amplify.subscribe("RowUnselectedAction", function (data) {
            try {
                if (data.context == context) {
                    $('#ContentArea').PageNavigation("reload", 'OwnershipType', 0);
                    $('#PageTools').PageTools("reload", 'OwnershipType', 0, context);
                }
            } catch (e) {
                logError("Survey : RowUnselectedAction", e);
            }
        });

        //#endregion

    });
</script>
}

@section Title{
@name
}

@section Directions{

}

@section Breadcrumb {
<ol class="breadcrumb">
    <li><a href="#">@(Resources.Section.Administration)</a></li>
    <li class="active">@name</li>
</ol>
}

@section Sidebar{
    <h1>Allowed Types</h1>
    <div id="Types"></div>
}