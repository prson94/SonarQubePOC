@model List<d360.core.entities.FieldTypeWithRelation>
@{
    var columns = "";
    var dataFields = "";
    Model.ForEach(i =>
    {
        if (i.Name != "ID")
        {
            columns += "{" + string.Format(" datafield: '{0}', text: '{1}'", i.Name, (string.IsNullOrEmpty(i.FriendlyName) ? i.Name : i.FriendlyName)) + "},";
            //columns += "{ datafield: '" + i.Name + "', text: '" + (string.IsNullOrEmpty(i.FriendlyName) ? i.Name : i.FriendlyName) + "'},";
        }
        dataFields += "{ name: '" + i.Name + "'},";
    });
    //columns = columns.Remove(columns.Length - 1, 1); //in this case, we want the ending comma b/c we are specifically placing the ID column in the list.
    dataFields = dataFields.Remove(dataFields.Length - 1, 1);
}

<script type="text/javascript">
    var lookupTypeID = '@(ViewData["ID"])';
    var lookupContext = '@ContextList.Lookup';

    $(document).ready(function () {

        var lookupDataFields = [@Html.Raw(dataFields)];

        //#region Grid

        var lookupsToolsRenderer = function (index, datafield, value, defaultvalue, column, data) {
            
        }

        var srcLookupsGrid = {
            datatype: 'json',
            url: '/resources/lookups/' + lookupTypeID + '/items.json',
            datafields: lookupDataFields
        };

        var adapterLookupsGrid = new $.jqx.dataAdapter(srcLookupsGrid);

        $("#LookupItems").jqxGrid({
            altrows: true,
            width: grid_width,
            autoheight: true,
            sortable: true,
            pagesizeoptions: ['10', '20', '50'],
            pagesize: 20,
            filterable: true,
            showfilterrow: true,
            pageable: true,
            source: adapterLookupsGrid,
            theme: list_theme,
            columns: [
                @Html.Raw(columns)
                { text: '', dataField: 'ID', width: 80, cellsrenderer: lookupsToolsRenderer }
            ]
        });

        //#endregion

        //#region Event Subscriptions

        amplify.subscribe("SaveAction", function (data) {
            try {
                switch (data.context) {
                    case contextList.Lookup:
                        $('#LookupItems').jqxGrid('updatebounddata');
                        break;
                }
            } catch (e) {
                logError("LookupItems : SaveAction", e);
            }
        });

        //#endregion

    });
</script>

<div id="LookupItems"></div>