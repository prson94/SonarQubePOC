<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Data3Sixty, Inc.</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="description" content="Data3Sixty: Data Collaboration Suite : API Services Help" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="Shortcut Icon" href="/favicon.ico" />
    <link href="https://fonts.googleapis.com/css?family=Roboto+Condensed" rel="stylesheet" type="text/css">
    <link rel="stylesheet" href="/Content/styles/all.min.css" />
    @RenderSection("scripts", required: false)
</head>
<body>
    <div style="position: fixed; left: 0px; top: 0px; width: 100px; height: 100%; z-index: 0" class="grey darken-2"></div>
    <div id="TopNav">
        <div id="nav">
            <div class="container-fluid">
                <div class="row" id="TopLine">
                    <div class="col s3 blue1 top-line">&nbsp;</div>
                    <div class="col s3 blue2 top-line">&nbsp;</div>
                    <div class="col s3 blue3 top-line">&nbsp;</div>
                    <div class="col s3 blue4 top-line">&nbsp;</div>
                </div>
                <div class="nav-top">
                    <div class="logo"></div>
                </div>
            </div>
            <div id="TopMenu" class="main-nav"></div>
        </div>
    </div>
    <table class="d3s-page">
        <tr style="vertical-align: top">
            <td class="d3s-sidebar">
                <div id="SideIcons"></div>
            </td>
            <td class="d3s-contentarea">
                <div id="ContentHeader"></div>
                <div id="main">
                    @RenderBody()
                </div>
            </td>
        </tr>
    </table>
</body>
</html>