{
  "compileOnSave": false,
  "compilerOptions": {
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "node",
    "target": "es5",
    "noImplicitAny": false,
    "sourceMap": true,
    "mapRoot": "",
    "experimentalDecorators": true,
    "lib": [
      "es2016",
      "dom"
    ],
    "outDir": "dist",
    "skipLibCheck": true,
    "rootDir": ".",
    // types option has been previously configured
    "types": [
      // add node as an option
      "node"
    ],
    // typeRoots option has been previously configured
    "typeRoots": [
      // add path to @types
      "../../node_modules/@types"
    ]
  },
  "angularCompilerOptions": {
    "strictTemplates": false,
    "strictInjectionParameters": false

  },
  "include": [
    ".",
    "../node_modules/gojs/extensionsTS/LinkLabelOnPathDraggingTool.ts"
  ]
}