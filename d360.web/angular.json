{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "govern": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "less"
        }
      },
      "root": "",
      "sourceRoot": "Scripts",
      "prefix": "d3s",
      "i18n": {
		"sourceLocale": "en",
		"locales": {
			"nl-NL": {
				"translation": "locale/messages.nl-NL.xlf",
				"baseHref": ""
			},
			"de-DE": {
				"translation": "locale/messages.de-DE.xlf",
				"baseHref": ""
			},
			"es-ES": {
				"translation": "locale/messages.es-ES.xlf",
				"baseHref": ""
			},
			"fr-FR": {
				"translation": "locale/messages.fr-FR.xlf",
				"baseHref": ""
			},
			"it-IT": {
				"translation": "locale/messages.it-IT.xlf",
				"baseHref": ""
			}
		}
      },
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "outputPath": "Scripts/dist",
            "index": "index.html",
            "main": "Scripts/main.ts",
            "polyfills": "Scripts/polyfills.ts",
            "tsConfig": "Scripts/tsconfig.json",
            "localize": true,
            "assets": [],
			"styles": [
			  "Content/styles/angular.less"
			],
			"allowedCommonJsDependencies": [
				"highcharts",
				"gojs",
				"powerbi-client",
				"quill",
				"codemirror",
				"codemirror/*"
			],
            "scripts": [
            ],
            "vendorChunk": true,
            "extractLicenses": false,
            "buildOptimizer": false,
			"sourceMap": true,
			"optimization": false,
            "namedChunks": true,
            "extraWebpackConfig": "webpack.config.js",
            "commonChunk": false
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "Scripts/environments/environment.ts",
                  "with": "Scripts/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": true,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": true,
              "buildOptimizer": true,
			  "extraWebpackConfig": "webpack.prod.config.js",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "6mb"
                }
              ]
            },
			"development": {
				"optimization": false,
				"outputHashing": "none",
				"sourceMap": true,
				"namedChunks": true,
				"extractLicenses": true,
				"vendorChunk": true,
				"buildOptimizer": false,
				"polyfills": "Scripts/polyfills.dev.ts",
				"localize": false,
				"outputPath": "Scripts/dist/en",
				"progress": true
			},
			"en": {
				"localize": [
					"en"
				]
			},
			"nl-NL": {
				"localize": [
					"nl-NL"
				]
			},
			"de-DE": {
				"localize": [
					"de-DE"
				]
			},
			"es-ES": {
				"localize": [
					"es-ES"
				]
			},
			"fr-FR": {
				"localize": [
					"fr-FR"
				]
			},
			"it-IT": {
				"localize": [
					"it-IT"
				]
			}
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "options": {
            "browserTarget": "govern:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "govern:build:production",
              "extraWebpackConfig": "webpack.prod.config.js"
            }
          }
        },
        "extract-i18n": {
          "builder": "ngx-build-plus:extract-i18n",
          "options": {
            "browserTarget": "govern:build",
            "extraWebpackConfig": "webpack.config.js"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
