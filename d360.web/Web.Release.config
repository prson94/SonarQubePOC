<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="ResourceSuffix" value=".min" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="AppInsightsInstrumentationKey" xdt:Transform="Remove" xdt:Locator="Match(key)" />
    <add key="EventBusTopicName" value="events" xdt:Transform="Remove" xdt:Locator="Match(key)" />
    <add key="EventBusTopicEnabled" value="events" xdt:Transform="Remove" xdt:Locator="Match(key)" />
    <add key="BulkLoadQueue" value="events" xdt:Transform="Remove" xdt:Locator="Match(key)" />
    <add key="FusionLoadQueue" value="events" xdt:Transform="Remove" xdt:Locator="Match(key)" />
    <add key="security:surpressApiErrorDetails" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <trace enabled="false" xdt:Transform="Replace"/>
    <authentication>
      <forms requireSSL="true" xdt:Transform="SetAttributes" />
    </authentication>
    <httpCookies requireSSL="true" xdt:Transform="SetAttributes" />
  </system.web>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="Replace" xdt:Transform="Replace" >
      <clear/>
      <error
        statusCode="500"
        path="/Error"
        responseMode="ExecuteURL"/>
    </httpErrors>
    <rewrite xdt:Transform="Replace">
      <rules>
        <rule name="HTTP to HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}"
              redirectType="Permanent" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Add Strict-Transport-Security when HTTPS" enabled="true">
          <match serverVariable="RESPONSE_Strict_Transport_Security"
              pattern=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="on" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" value="max-age=31536000" />
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>