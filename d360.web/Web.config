<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <section name="autofac" type="Autofac.Configuration.SectionHandler, Autofac.Configuration" />
  </configSections>
  <autofac defaultAssembly="d360.web">
    <modules>
      <module type="d360.web.Models.Modules.EnvironmentModule">
        <properties>
          <property name="Mode" value="AzureHosted" />
        </properties>
      </module>
    </modules>
  </autofac>
  <appSettings>
    <add key="vs:EnableBrowserLink" value="false" />
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="PreserveLoginUrl" value="true" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="notificationSender" value="no-reply@data3sixty.com" />
    <add key="ResourceSuffix" value="" />
    <add key="UseRawCompression" value="false" />
    <add key="AppInsightsInstrumentationKey" value="cf5453f2-5c66-4357-bb20-1a736cf2885b" />
    <add key="powerbi:AccessKey" value="" />
    <add key="powerbi:ApiUrl" value="https://api.powerbi.com" />
    <add key="powerbi:WorkspaceCollection" value="" />
    <add key="powerbi:WorkspaceId" value="" />    
    <add key="RouteDebugger:Enabled" value="false" />
    <add key="EventBusTopicName" value="events-debug" />
    <add key="EventBusTopicEnabled" value="true" />
    <add key="UseCdn" value="false" />
  </appSettings>
  <location path="favicon.ico">
    <system.web>
      <authorization>
        <allow users="*" />
        <allow users="?" />
      </authorization>
      <httpRuntime requestValidationMode="2.0" />
    </system.web>
  </location>
  <system.web>
    <trace enabled="true" writeToDiagnosticsTrace="true" localOnly="false" pageOutput="false" />
    <compilation debug="true" targetFramework="4.5.1">
      <assemblies>
        <add assembly="Microsoft.Build.Framework, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Runtime, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
      </assemblies>
    </compilation>
    <authentication mode="Forms">
      <forms defaultUrl="/" loginUrl="/sso" name=".D360" timeout="480" slidingExpiration="true" protection="All" />
    </authentication>
    <machineKey validationKey="34AD2959B55BF794942954F121C55A4FA2E5082157318EE914B85403A0C686DF02C30AF0D086E5F3C0803A540EC4C4F548C044233BE5FE8893739779DEE8ADEC" decryptionKey="BC5464C1AD770A8F2A1C374EEDA5A52BBAC1EBB15B975A56FD8EBEB88A83CA80" validation="SHA1" decryption="AES" />
    <!--<machineKey validation="HMACSHA512"
                validationKey="20AE5432AFFA134A23CF48EFAA17F43B2E64D3FFD67EDF85B9BEB4C672CB7AC28B1ED574DD09DAD2B052162BFBB90003441ACC43B2C5ABDED76244AE3555A75DE0BDB49481DB45CCF54CE562D48F69947037A6E6584DF3DAF7D9EE2040B84FB8B9B77160ECF8302752F9D060DFFE9BE3C6BF17D09437E5AE3C00FD98C597CEAD"
                decryption="AES"
                decryptionKey="F767CBF9F9B88F6D2F6D6E92A9671D4CEB5F4F81AE17EC1656F828D8BD3B472E6F46ED1B98701DF91B5DDE603762BEB1718269D47D7124C5DE3B3DD8CCBB5D43"
    />-->
    <customErrors mode="Off" redirectMode="ResponseRewrite" />
    <httpCookies httpOnlyCookies="true" />
    <httpRuntime maxRequestLength="2097151" targetFramework="4.5" encoderType="System.Web.Security.AntiXss.AntiXssEncoder,System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" enableVersionHeader="false" />
    <pages controlRenderingCompatibilityVersion="4.0" enableViewState="false">
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
    <sessionState mode="Off"></sessionState>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="true" />
    <staticContent>
      <remove fileExtension=".eot" />
      <remove fileExtension=".svg" />
      <remove fileExtension=".ttf" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".ttf" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".woff" mimeType="application/x-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/x-woff" />
      <mimeMap fileExtension=".otf" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".gzip" mimeType="application/x-gzip" />
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="ApplicationInsightsWebTracking" />
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" preCondition="managedHandler" />
    </modules>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="If-Modified-Since" value="01 Jan 1970 00:00:00 GMT" />
        <add name="Expires" value="0" />
      </customHeaders>
    </httpProtocol>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <httpCompression>
      <dynamicTypes>
        <add enabled="true" mimeType="application/javascript" />
        <add enabled="true" mimeType="application/json" />
        <add enabled="true" mimeType="text/html" />
      </dynamicTypes>
      <staticTypes>
        <add enabled="true" mimeType="application/javascript" />
        <add enabled="true" mimeType="application/json" />
        <add enabled="true" mimeType="text/html" />
      </staticTypes>
    </httpCompression>    
  </system.webServer>  
  <system.web.extensions>
    <scripting>
      <webServices>
        <jsonSerialization maxJsonLength="2147483644" />
      </webServices>
    </scripting>
  </system.web.extensions>
