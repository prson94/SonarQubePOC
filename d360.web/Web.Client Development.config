<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="ResourceSuffix" value=".min" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="UseRawCompression" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="AppInsightsInstrumentationKey" value="bf1917be-5223-4b0e-a376-99ae4947b47d" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="EventBusTopicName" value="events-dev" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="cdn:enabled" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="cdn:url" value="https://cdn.data3sixty.com/dev-client" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <trace enabled="false" xdt:Transform="Replace"/>
    <authentication>
      <forms requireSSL="true" xdt:Transform="SetAttributes" />
    </authentication>
    <httpCookies requireSSL="true" xdt:Transform="SetAttributes" />
  </system.web>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="Replace" xdt:Transform="Replace" >
      <clear/>
      <error
        statusCode="500"
        path="/Error"
        responseMode="ExecuteURL"/>
    </httpErrors>
  </system.webServer>
</configuration>